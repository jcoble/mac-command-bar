#!/bin/sh
# Keep task commits traceable and preserve the architecture-guide check.

message_file="$1"
guide="main-architecture-explained.html"

# Git creates merge messages itself; regular task commits carry the record.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

message=$(git stripspace --strip-comments < "$message_file")

if printf '%s\n' "$message" | grep -Eiq '^Co-Authored-By:'; then
  echo 'commit stopped: remove the Co-Authored-By trailer.' >&2
  exit 1
fi

last_line=$(printf '%s\n' "$message" | tail -n 1)
case "$last_line" in
  'Committed-by: '?*) ;;
  *)
    echo 'commit stopped: the final message line must be Committed-by: <actual committer>.' >&2
    exit 1
    ;;
esac

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
case "$branch" in
  tsk-[0-9]*)
    task_id=$(printf '%s\n' "$branch" | sed -n 's/^tsk-\([0-9][0-9]*\).*$/\1/p')
    if ! printf '%s\n' "$message" | grep -Eq "^Task: TSK-$task_id https://app[.]notion[.]com/p/[0-9a-fA-F]{32}([?].*)?$"; then
      echo "commit stopped: add Task: TSK-$task_id https://app.notion.com/p/<task-page-id>." >&2
      exit 1
    fi
    ;;
esac

if ! git diff --cached --quiet -- "$guide"; then
  exit 0
fi

if printf '%s\n' "$message" | grep -qi '^Architecture: unchanged'; then
  exit 0
fi

cat >&2 <<MSG
commit stopped: $guide is the app's architecture source of truth and this commit does not update it.

  Either stage your update to the guide (and add a row to its change log):
      git add $guide
  or, when this commit changes nothing the guide describes (styling, copy, tests, tooling),
  say so with this line in the commit message body:
      Architecture: unchanged
MSG
exit 1
