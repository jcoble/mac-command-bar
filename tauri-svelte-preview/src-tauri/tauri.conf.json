{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacCommandBar Webview Preview",
  "version": "0.1.0",
  "identifier": "dev.blackcolours.MacCommandBarWebviewPreview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacCommandBar Webview Preview",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
