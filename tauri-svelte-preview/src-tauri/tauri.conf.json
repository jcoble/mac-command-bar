{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assembly",
  "version": "0.1.0",
  "identifier": "dev.blackcolours.MacCommandBarWebviewPreview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm prepare:release-adapters && pnpm build",
    "devUrl": "http://127.0.0.1:5177/",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Assembly",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "url": "/",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/conversation-attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "resources": [
      "adapters/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
