{
  "name": "mac-command-bar-tauri-svelte-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && tsc --noEmit",
    "orch:event": "node scripts/orchestrationEvent.mjs",
    "test:paste-cleanup": "node --experimental-strip-types scripts/pasteCleanup.test.mjs",
    "test:agent-session-focus": "node --experimental-strip-types scripts/agentSessionFocus.test.mjs",
    "test:git-graph-view-model": "node --experimental-strip-types scripts/gitGraphViewModel.test.mjs",
    "test:git-task-links": "node --experimental-strip-types scripts/gitTaskLinks.test.mjs",
    "test:orchestration-event": "node scripts/orchestrationEvent.test.mjs",
    "test:orchestration-view": "node --experimental-strip-types scripts/orchestrationView.test.mjs",
    "test:worktree-cleanup-plan": "node --experimental-strip-types scripts/worktreeCleanupPlan.test.mjs",
    "test:worktree-cleanup-runbook": "node --experimental-strip-types scripts/worktreeCleanupRunbook.test.mjs",
    "test:worktree-safety": "node --experimental-strip-types scripts/worktreeSafety.test.mjs",
    "test:local-source-fs": "node --experimental-strip-types scripts/localSourceFs.test.mjs",
    "test:live-terminals": "node --experimental-strip-types scripts/liveConversationTerminals.test.mjs",
    "test:source-dock-layout": "node --experimental-strip-types scripts/sourceDockLayout.test.mjs",
    "test:source-dockview": "node --experimental-strip-types scripts/sourceDockviewWorkspace.test.mjs",
    "test:source-pane-sizing": "node --experimental-strip-types scripts/sourcePaneSizing.test.mjs",
    "test:source-markdown-preview": "node --experimental-strip-types scripts/sourceMarkdownPreview.test.mjs",
    "test:source-data": "node --experimental-strip-types scripts/sourceData.test.mjs",
    "test:source-ui": "node scripts/sourceUi.test.mjs",
    "test:workspace-snapshot": "node --experimental-strip-types scripts/workspaceSnapshot.test.mjs",
    "test:workspace-snapshot-plan": "node --experimental-strip-types scripts/workspaceSnapshotPlan.test.mjs",
    "test:tauri-source": "node --experimental-strip-types scripts/tauriSource.test.mjs",
    "test:tauri-config": "node scripts/tauriDevConfig.test.mjs",
    "test:tauri-app": "pnpm test:tauri-source && pnpm test:tauri-config && pnpm build && pnpm test:native-lsp && cargo build --manifest-path src-tauri/Cargo.toml",
    "test:native-lsp": "MCB_RUN_CSHARP_LSP_SMOKE=1 cargo test --manifest-path src-tauri/Cargo.toml lsp -- --nocapture",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:attach": "tauri dev --config src-tauri/tauri.dev.attach.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-progress": "^0.2.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-fonts": "^0.1.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.18.1",
    "dockview-core": "^6.6.1",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.2",
    "svelte": "^5.56.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
