   108	function syncLegacy(nextUrl?: string, bumpFrame = false): void {
   109	  const active = browser.workspace.activeTabId
   110	    ? browser.workspace.tabs[browser.workspace.activeTabId] ?? null
   111	    : null;
   112	  const url = nextUrl ?? active?.url ?? '';
   113	  if (bumpFrame && browser.url === url && url) browser.frameKey += 1;
   114	  else if (bumpFrame && browser.url !== url) browser.frameKey += 1;
   115	  browser.url = url;
   116	  browser.inputUrl = active?.inputUrl ?? url;
   117	  browser.activated = browser.workspace.activated;
   118	  browser.error = browser.workspace.error ?? '';
   119	}
   120	
   121	function persist(url: string): boolean {
   122	  if (typeof localStorage === 'undefined') return false;
   123	  try {
   124	    if (url) localStorage.setItem(BROWSER_URL_STORAGE_KEY, url);
   125	    else localStorage.removeItem(BROWSER_URL_STORAGE_KEY);
   126	    return true;
   127	  } catch {
   128	    browser.error = STORAGE_WRITE_FAILED_MESSAGE;
   129	    return false;
   130	  }
   131	}
