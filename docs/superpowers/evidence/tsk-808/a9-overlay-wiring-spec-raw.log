   463	        height: Math.max(1, context.workspace.floatingBounds.y + context.workspace.floatingBounds.height)
   464	      }
   465	    );
   466	  }
   467	  const transition = transitionBrowserPresentation(
   468	    context.workspace.presentation,
   469	    context.workspace.previousPresentation,
   470	    mode
