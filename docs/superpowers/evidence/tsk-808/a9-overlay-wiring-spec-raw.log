   139	        resetLayout: () => {
   140	          frame?.resetLayout();
   141	          centerDock?.resetLayout();
   142	        },
   143	        showCenterPanel: (id: string) => centerDock?.activatePanel(id),
   144	        captureCenterLayout: () => centerDock?.captureLayout() ?? null,
   145	        restoreCenterLayout: (snapshot) => centerDock?.restoreLayout(snapshot),
   146	        setRegionWidth: (id, width, limits) => frame?.setRegionWidth(id, width, limits),
   147	        setRegionHeight: (id, height, limits) => frame?.setRegionHeight(id, height, limits),
   148	        setRegionLimits: (id, limits) => frame?.setRegionLimits(id, limits),
   149	        regionWidth: (id) => frame?.regionWidth(id) ?? null
   150	      });
   151	    } catch (error) {
   152	      onError?.(error instanceof Error ? error.message : String(error));
   153	    }
   154	
   155	    return () => {
   156	      observer?.disconnect();
   157	      centerDock?.dispose();
   158	      centerDock = null;
   159	      frame?.dispose();
   160	      frame = null;
   161	    };
   162	  });
