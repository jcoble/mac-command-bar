   377	export function closeBrowserTab(
   378	  first: string | BrowserWorkspaceState | BrowserModelContext,
   379	  second?: string | BrowserModelContext
   380	): BrowserWorkspaceState {
   381	  const context = isWorkspace(first) || isContext(first) ? contextFor(first, second) : contextFor(second);
   382	  const tabId = typeof first === 'string' ? first : typeof second === 'string' ? second : '';
   383	  const tab = context.workspace.tabs[tabId];
   384	  if (!tab) return context.workspace;
   385	  callBackend(context, () => context.backend!.close_browser_tab(backendTarget(tab)), (error) => setWorkspaceError(context, error));
   386	  delete context.workspace.tabs[tabId];
   387	  context.workspace.tabOrder = context.workspace.tabOrder.filter((id) => id !== tabId);
   388	  if (context.workspace.activeTabId === tabId) {
   389	    const nextId = context.workspace.tabOrder[Math.max(0, context.workspace.tabOrder.length - 1)] ?? null;
   390	    context.workspace.activeTabId = nextId;
   391	  }
   392	  updateActiveGeneration(context, activeTab(context));
   393	  if (!context.workspace.activeTabId) context.workspace.interaction = 'browse';
   394	  return context.workspace;
   395	}
