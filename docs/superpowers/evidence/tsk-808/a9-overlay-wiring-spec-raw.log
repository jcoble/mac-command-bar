   360	export function selectBrowserTab(
   361	  first: string | BrowserWorkspaceState | BrowserModelContext,
   362	  second?: string | BrowserModelContext
   363	): BrowserWorkspaceState {
   364	  const context = isWorkspace(first) || isContext(first) ? contextFor(first, second) : contextFor(second);
   365	  const tabId = typeof first === 'string' ? first : typeof second === 'string' ? second : '';
   366	  if (!tabId || !context.workspace.tabs[tabId]) throw new BrowserModelError('That browser tab is no longer available');
   367	  context.workspace.activeTabId = tabId;
   368	  updateActiveGeneration(context, context.workspace.tabs[tabId]);
   369	  context.workspace.error = null;
   370	  const tab = context.workspace.tabs[tabId];
   371	  if (context.workspace.activated) {
   372	    callBackend(context, () => context.backend!.show_browser_tab(backendTarget(tab)), (error) => setWorkspaceError(context, error));
   373	  }
   374	  return context.workspace;
   375	}
