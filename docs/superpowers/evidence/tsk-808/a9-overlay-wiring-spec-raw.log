   484	export function expandBrowserFrom(
   485	  first?: BrowserPresentationMode | BrowserWorkspaceState | BrowserModelContext,
   486	  second?: BrowserPresentationMode | BrowserModelContext
   487	): BrowserWorkspaceState {
   488	  const context = isWorkspace(first) || isContext(first) ? contextFor(first, second) : contextFor(second);
   489	  const requested = typeof first === 'string' ? first : typeof second === 'string' ? second : undefined;
   490	  const from = requested && ['docked', 'collapsed', 'floating', 'maximized'].includes(requested)
   491	    ? (requested as BrowserPresentationMode)
   492	    : context.workspace.presentation;
   493	  const target = from === 'maximized' ? 'maximized' : 'floating';
   494	  context.workspace.previousPresentation = from === 'collapsed' ? 'docked' : from;
   495	  return setBrowserPresentationMode(context, target);
   496	}
