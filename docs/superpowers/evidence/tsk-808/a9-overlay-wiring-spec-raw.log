   150	export function restoreBrowserState(snapshot: SessionBrowserWorkspace | null | undefined): void {
   151	  const nextUrl = normalizeBrowserUrl(snapshot?.url ?? '');
   152	  browser.workspace.activated = snapshot?.activated === true && nextUrl.length > 0;
   153	  browser.workspace.error = null;
   154	  const current = browser.workspace.activeTabId
   155	    ? browser.workspace.tabs[browser.workspace.activeTabId] ?? null
   156	    : null;
   157	  try {
   158	    if (nextUrl && !current) {
   159	      createBrowserTab(modelContext(), { url: nextUrl });
   160	    } else if (nextUrl && current && current.url !== nextUrl) {
   161	      navigateActiveBrowserTab(modelContext(), nextUrl);
   162	    }
   163	    if (!nextUrl && current) {
