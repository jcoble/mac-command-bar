   286	export function deactivateBrowserWorkspace(
   287	  target?: BrowserWorkspaceState | BrowserModelContext
   288	): BrowserWorkspaceState {
   289	  const context = contextFor(target);
   290	  callBackend(context, () => context.backend!.hide_browser_workspace({ workspaceId: context.workspace.workspaceId }), (error) => setWorkspaceError(context, error));
   291	  context.workspace.activated = false;
   292	  context.workspace.interaction = 'browse';
   293	  context.workspace.pendingSelection = null;
   294	  context.workspace.pendingMarkup = null;
   295	  return context.workspace;
   296	}
