     2	import { createBrowserWorkspace } from '../src/lib/shell/browser/browserTypes.ts';
     3	import { createBrowserModel } from '../src/lib/shell/browser/browserModel.ts';
     4	
     5	const workspace = createBrowserWorkspace({ workspaceId: 'workspace-1', ownedId: 'owned-1' });
     6	const model = createBrowserModel({ workspace, now: () => '2026-08-05T00:00:00.000Z' });
     7	model.createBrowserTab({ url: 'https://example.com/' });
     8	model.beginBrowserElementPicker('annotation');
     9	model.acceptBrowserElementSelection({
    10	  selector: '#save',
    11	  accessibleName: 'Save',
    12	  textSnippet: 'Save changes'
    13	});
    14	const queued = model.queueBrowserAnnotation({ note: 'Make this button easier to find', intent: 'change' });
    15	
    16	let draft = 'Please review this page.';
    17	const stagedAttachments = [];
    18	const bridge = {
    19	  read: () => ({ ownedId: 'owned-1', generation: model.workspace.activeGeneration, draft, attachments: stagedAttachments }),
    20	  setDraft: (_ownedId, value) => {
    21	    draft = value;
    22	  },
    23	  setAttachments: (_ownedId, value) => {
    24	    stagedAttachments.splice(0, stagedAttachments.length, ...value);
    25	  }
    26	};
    27	
    28	const preview = model.stageBrowserFeedbackPreview({ bridge, draftSnapshot: draft });
    29	assert.equal(preview.status, 'ready');
    30	assert.match(preview.mergedDraft, /Make this button easier to find/);
    31	assert.equal(model.workspace.queue.length, 1, 'preview never removes the queue item');
    32	const committed = await preview.commit();
    33	assert.equal(committed.status, 'staged');
    34	assert.equal(model.workspace.queue.length, 0, 'only commit removes the queue item');
    35	assert.match(draft, /Annotated browser page/);
    36	
    37	model.beginBrowserElementPicker('annotation');
    38	model.acceptBrowserElementSelection({ selector: '#question' });
    39	model.queueBrowserAnnotation({ note: 'Is this label clear?', intent: 'question' });
    40	const stalePreview = model.stageBrowserFeedbackPreview({ bridge, generation: model.workspace.activeGeneration - 1, draftSnapshot: draft });
    41	assert.equal(stalePreview.status, 'stale-target');
    42	assert.equal(stalePreview.queueRetained, true);
    43	
    44	const conflictPreview = model.stageBrowserFeedbackPreview({ bridge, draftSnapshot: 'a different draft' });
    45	assert.equal(conflictPreview.status, 'draft-conflict');
    46	assert.equal(conflictPreview.queueRetained, true);
    47	draft = `${draft} changed outside preview`;
    48	assert.equal((await conflictPreview.commit()).status, 'draft-conflict');
    49	assert.equal(model.workspace.queue.length, 1);
    50	
    51	const markupModel = createBrowserModel({
    52	  workspace: createBrowserWorkspace({ workspaceId: 'workspace-markup', ownedId: 'owned-markup' }),
    53	  now: () => '2026-08-05T00:00:00.000Z'
    54	});
    55	markupModel.createBrowserTab({ url: 'https://example.com/' });
    56	await markupModel.captureBrowserWorkspace({ forMarkup: true });
    57	const markup = markupModel.queueBrowserAnnotation({
    58	  capture: {
    59	    mimeType: 'image/png',
    60	    bytes: [1, 2, 3],
    61	    width: 10,
    62	    height: 10,
    63	    sourceHash: 'capture-1'
    64	  },
    65	  note: 'Circle this area',
    66	  intent: 'context'
    67	});
    68	assert.equal(markup.kind, 'markup');
    69	assert.equal(markupModel.workspace.queue.length, 1);
    70	
    71	console.log('browserFeedback: all tests passed');
