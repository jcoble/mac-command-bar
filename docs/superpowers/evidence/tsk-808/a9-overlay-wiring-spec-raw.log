--- checkSvelteNext ---
     1	#!/usr/bin/env node
     2	/**
     3	 * checkSvelteNext.mjs — type-check the Svelte components the /next shell owns.
     4	 *
     5	 * WHY THIS WRAPPER EXISTS
     6	 * `pnpm run check` runs `tsc --noEmit`, and TypeScript cannot read a `.svelte`
     7	 * file at all. So until now nothing type-checked the ~45 components this shell
     8	 * is made of: a prop name that no longer matches the library it comes from
     9	 * would compile, build, and render wrong.
    10	 *
    11	 * `svelte-check` closes that gap, but it checks the WHOLE project, and the old
    12	 * shell (`src/routes/+page.svelte` and the components only it mounts) has a
    13	 * long-standing backlog of its own type errors. Running the tool bare would
    14	 * report a hundred-odd problems nobody on this branch caused, which is the same
    15	 * as reporting nothing.
    16	 *
    17	 * So: run `svelte-check` over everything (it has to build one program anyway),
    18	 * then keep only the errors that land in the files the /next shell owns, listed
    19	 * in OWNED below. Exit 1 if any of those has an error; exit 0 otherwise.
    20	 * Warnings are printed for the owned paths but never fail the run — accessibility
    21	 * and unused-CSS notes are advice, not a broken build.
    22	 *
    23	 * The old shell's own errors are counted and reported as one line at the end so
    24	 * the backlog stays visible without being in the way. If you fix the old shell,
    25	 * widen OWNED.
    26	 *
    27	 * Usage: node scripts/checkSvelteNext.mjs   (or `pnpm run check:svelte`)
    28	 */
    29	
    30	import { spawn } from 'node:child_process';
    31	import { fileURLToPath } from 'node:url';
    32	import path from 'node:path';
    33	
    34	const projectRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
    35	
    36	/**
    37	 * The files the /next shell owns. A path counts as owned when it starts with one
    38	 * of these, compared against the project-relative path svelte-check prints.
    39	 */
    40	const OWNED = [
    41	  'src/lib/shell/',
    42	  'src/lib/components/ui/',
    43	  'src/routes/next/',
    44	  'src/lib/utils.ts'
    45	];
    46	
    47	function isOwned(file) {
    48	  return OWNED.some((prefix) =>
    49	    prefix.endsWith('/') ? file.startsWith(prefix) : file === prefix
    50	  );
    51	}
    52	
    53	/**
    54	 * svelte-check's `--output machine` format, one record per line:
    55	 *   <timestamp> <SEVERITY> "<file>" <line>:<column> "<message>"
    56	 * plus a final `<timestamp> COMPLETED <n> FILES <n> ERRORS ...` line.
    57	 */
    58	const RECORD = /^\d+\s+(ERROR|WARNING)\s+"((?:[^"\\]|\\.)*)"\s+(\d+):(\d+)\s+"((?:[^"\\]|\\.)*)"\s*$/;
    59	
    60	function unescape(value) {
    61	  return value.replace(/\\n/g, '\n').replace(/\\"/g, '"').replace(/\\\\/g, '\\');
    62	}
    63	
    64	function run() {
    65	  return new Promise((resolve, reject) => {
    66	    const child = spawn(
    67	      process.execPath,
    68	      [
    69	        path.join(projectRoot, 'node_modules', 'svelte-check', 'bin', 'svelte-check'),
    70	        '--tsconfig',
    71	        './tsconfig.json',
    72	        '--output',
    73	        'machine'
    74	      ],
    75	      { cwd: projectRoot, stdio: ['ignore', 'pipe', 'pipe'] }
    76	    );
    77	
    78	    let out = '';
    79	    let err = '';
    80	    child.stdout.on('data', (chunk) => (out += chunk));
    81	    child.stderr.on('data', (chunk) => (err += chunk));
    82	    child.on('error', reject);
    83	    child.on('close', () => resolve({ out, err }));
    84	  });
    85	}
    86	
    87	const { out, err } = await run();
    88	
    89	const ownedErrors = [];
    90	const ownedWarnings = [];
    91	let otherErrors = 0;
    92	let completed = null;
    93	
    94	for (const line of out.split('\n')) {
    95	  if (line.startsWith('COMPLETED') || / COMPLETED /.test(line)) {
    96	    completed = line.trim();
    97	    continue;
    98	  }
    99	  const match = RECORD.exec(line.trim());
   100	  if (!match) continue;
   101	  const [, severity, file, row, column, message] = match;
   102	  const entry = { file, row, column, message: unescape(message) };
   103	  if (!isOwned(file)) {
   104	    if (severity === 'ERROR') otherErrors += 1;
   105	    continue;
   106	  }
   107	  if (severity === 'ERROR') ownedErrors.push(entry);
   108	  else ownedWarnings.push(entry);
   109	}
   110	
   111	if (!completed) {
   112	  console.error('svelte-check did not finish. Its output was:');
   113	  console.error(out.trim() || '(nothing on stdout)');
   114	  if (err.trim()) console.error(err.trim());
   115	  process.exit(2);
   116	}
   117	
   118	const show = (entry, label) =>
   119	  console.log(`${label} ${entry.file}:${entry.row}:${entry.column}  ${entry.message.split('\n')[0]}`);
   120	
   121	for (const entry of ownedWarnings) show(entry, 'warning');
   122	for (const entry of ownedErrors) show(entry, 'ERROR  ');
   123	
   124	console.log('');
   125	console.log(
   126	  `Files the /next shell owns: ${ownedErrors.length} error(s), ${ownedWarnings.length} warning(s).`
   127	);
   128	console.log(
   129	  `Elsewhere in the project (not checked by this gate): ${otherErrors} error(s) — the old shell's own backlog.`
   130	);
   131	
   132	// ── The font floor ───────────────────────────────────────────────────────────
   133	// The shell's rule is 13px body / 12px meta, and the class-based Tailwind trap
   134	// is documented — but a raw `font-size: 11px` in a component's <style> block is
   135	// invisible to a type checker, which is exactly how two panes shipped below the
   136	// floor. Walk the owned .svelte files and fail on any hardcoded size under 12px.
   137	import { readdirSync, readFileSync, statSync } from 'node:fs';
   138	
   139	function svelteFilesUnder(dir) {
   140	  const out = [];
   141	  for (const name of readdirSync(dir)) {
   142	    const full = path.join(dir, name);
   143	    if (statSync(full).isDirectory()) out.push(...svelteFilesUnder(full));
   144	    else if (name.endsWith('.svelte')) out.push(full);
   145	  }
   146	  return out;
   147	}
   148	
   149	const fontFloorHits = [];
   150	for (const prefix of OWNED) {
   151	  if (!prefix.endsWith('/')) continue;
   152	  const dir = path.join(projectRoot, prefix);
   153	  let files = [];
   154	  try {
   155	    files = svelteFilesUnder(dir);
   156	  } catch {
   157	    continue;
   158	  }
   159	  for (const file of files) {
   160	    const text = readFileSync(file, 'utf8');
   161	    for (const match of text.matchAll(/font-size:\s*(\d+)px/g)) {
   162	      if (Number(match[1]) < 12) {
   163	        const row = text.slice(0, match.index).split('\n').length;
   164	        fontFloorHits.push(`${path.relative(projectRoot, file)}:${row}  font-size: ${match[1]}px`);
   165	      }
   166	    }
   167	  }
   168	}
   169	
   170	if (fontFloorHits.length > 0) {
   171	  console.log('');
   172	  console.log('Text below the 12px floor (the shell rule is 13px body / 12px meta):');
   173	  for (const hit of fontFloorHits) console.log(`ERROR   ${hit}`);
   174	}
   175	
   176	if (ownedErrors.length > 0 || fontFloorHits.length > 0) {
   177	  console.log('');
   178	  console.log('Checking the /next shell failed. Fix the problems listed above.');
   179	  process.exit(1);
   180	}
