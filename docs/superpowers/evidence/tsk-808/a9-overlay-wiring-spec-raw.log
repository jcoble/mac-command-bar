   397	export function navigateActiveBrowserTab(
   398	  first: string | BrowserWorkspaceState | BrowserModelContext,
   399	  second?: string | BrowserModelContext
   400	): BrowserTabState | null {
   401	  const context = typeof first === 'string' && (isWorkspace(second) || isContext(second)) ? contextFor(second) : contextFor(isWorkspace(first) || isContext(first) ? first : undefined);
   402	  const url = typeof first === 'string' ? first : typeof second === 'string' ? second : '';
