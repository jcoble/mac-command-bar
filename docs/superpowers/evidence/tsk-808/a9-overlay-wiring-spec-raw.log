    86	/**
    87	 * Deterministic backend used by model tests and browser preview builds.  It
    88	 * records command order and keeps tab history, but never creates a native view
    89	 * or touches the network.
    90	 */
    91	export class InMemoryBrowserBackend implements BrowserBackend {
    92	  readonly calls: BrowserBackendCall[] = [];
    93	  readonly tabs = new Map<string, FakeTabRecord>();
    94	  readonly captures = new Map<string, BrowserMarkupCapture>();
    95	
    95	
    96	  private record(command: string, input: unknown): void {
    97	    this.calls.push({ command, input: copy(input) });
    98	  }
    99	
   100	  create_browser_tab(input: BrowserBackendTabInput): BrowserBackendTabResult {
   101	    this.record('create_browser_tab', input);
   102	    const current = this.tabs.get(input.tabId);
   103	    if (current) return { tabId: current.tabId, generation: current.generation };
   104	    const record: FakeTabRecord = {
   105	      workspaceId: input.workspaceId,
   106	      tabId: input.tabId,
   107	      generation: input.generation,
   108	      url: input.url,
   109	      visible: true,
   110	      bounds: input.bounds ? { ...input.bounds } : null,
   111	      viewport: input.viewport ? { ...input.viewport } : null,
   112	      history: input.url ? [input.url] : [],
   113	      historyIndex: input.url ? 0 : -1
   114	    };
   115	    this.tabs.set(input.tabId, record);
   116	    return { tabId: input.tabId, generation: input.generation };
   117	  }
   118	
   119	  set_browser_tab_bounds(input: BrowserBackendBoundsInput): void {
   120	    this.record('set_browser_tab_bounds', input);
   121	    const tab = this.tabs.get(input.tabId);
   122	    if (tab) tab.bounds = { ...input.bounds };
   123	  }
   124	
   125	  set_browser_tab_viewport(input: BrowserBackendViewportInput): void {
   126	    this.record('set_browser_tab_viewport', input);
   127	    const tab = this.tabs.get(input.tabId);
   128	    if (tab) tab.viewport = { ...input.viewport };
   129	  }
   130	
   131	  show_browser_tab(input: BrowserBackendTarget): void {
   132	    this.record('show_browser_tab', input);
   133	    const tab = this.tabs.get(input.tabId);
   134	    if (tab) tab.visible = true;
   135	  }
   136	
   137	  hide_browser_workspace(input: { workspaceId: string }): void {
   138	    this.record('hide_browser_workspace', input);
   139	    for (const tab of this.tabs.values()) {
   140	      if (tab.workspaceId === input.workspaceId) tab.visible = false;
   141	    }
   142	  }
   143	
   144	  navigate_browser_tab(input: BrowserBackendNavigationInput): void {
   145	    this.record('navigate_browser_tab', input);
   146	    const tab = this.tabs.get(input.tabId);
   147	    if (!tab) return;
   148	    tab.url = input.url;
   149	    tab.history = tab.history.slice(0, tab.historyIndex + 1);
   150	    tab.history.push(input.url);
   151	    tab.historyIndex = tab.history.length - 1;
   152	  }
   153	
   154	  reload_browser_tab(input: BrowserBackendTarget): void {
   155	    this.record('reload_browser_tab', input);
   156	  }
   157	
   158	  go_back_browser_tab(input: BrowserBackendTarget): void {
   159	    this.record('go_back_browser_tab', input);
   160	    const tab = this.tabs.get(input.tabId);
   161	    if (tab && tab.historyIndex > 0) {
   162	      tab.historyIndex -= 1;
   163	      tab.url = tab.history[tab.historyIndex];
   164	    }
   165	  }
   166	
   167	  go_forward_browser_tab(input: BrowserBackendTarget): void {
   168	    this.record('go_forward_browser_tab', input);
   169	    const tab = this.tabs.get(input.tabId);
   170	    if (tab && tab.historyIndex < tab.history.length - 1) {
   171	      tab.historyIndex += 1;
   172	      tab.url = tab.history[tab.historyIndex];
   173	    }
   174	  }
   175	
   176	  close_browser_tab(input: BrowserBackendTarget): void {
   177	    this.record('close_browser_tab', input);
   178	    this.tabs.delete(input.tabId);
   179	  }
   180	
   181	  arm_browser_element_picker(input: BrowserBackendPickerInput): void {
   182	    this.record('arm_browser_element_picker', input);
   183	  }
   184	
   185	  cancel_browser_element_picker(input: BrowserBackendTarget): void {
   186	    this.record('cancel_browser_element_picker', input);
   187	  }
   188	
   189	  capture_browser_viewport(input: BrowserBackendTarget): BrowserMarkupCapture {
   190	    this.record('capture_browser_viewport', input);
   191	    const existing = this.captures.get(input.tabId);
   192	    if (existing) return copy(existing);
   193	    const capture: BrowserMarkupCapture = {
   194	      mimeType: 'image/png',
   195	      bytes: [137, 80, 78, 71, input.tabId.length & 0xff, input.generation & 0xff],
   196	      width: 1,
   197	      height: 1,
   198	      sourceHash: `fake-capture:${input.tabId}:${input.generation}`
   199	    };
   200	    this.captures.set(input.tabId, capture);
   201	    return copy(capture);
   202	  }
   203	
   204	  open_browser_tab_devtools(input: BrowserBackendTarget): void {
   205	    this.record('open_browser_tab_devtools', input);
   206	  }
   207	
   208	  open_browser_tab_external(input: BrowserBackendTarget): void {
   209	    this.record('open_browser_tab_external', input);
   210	  }
   211	}
