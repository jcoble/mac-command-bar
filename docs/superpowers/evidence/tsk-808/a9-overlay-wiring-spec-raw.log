   447	export function setBrowserPresentationMode(
   448	  first: BrowserPresentationMode | BrowserWorkspaceState | BrowserModelContext,
   449	  second?: BrowserPresentationMode | BrowserModelContext,
   450	  third?: BrowserPresentationOptions
   451	): BrowserWorkspaceState {
   452	  const context = isWorkspace(first) || isContext(first) ? contextFor(first, second) : contextFor(second);
   453	  const mode = (typeof first === 'string' ? first : typeof second === 'string' ? second : 'docked') as BrowserPresentationMode;
   454	  if (!['docked', 'floating', 'maximized', 'collapsed'].includes(mode)) {
   455	    throw new BrowserModelError('Unknown browser presentation mode');
