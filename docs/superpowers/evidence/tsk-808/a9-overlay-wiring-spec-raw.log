   298	export function createBrowserTab(
   299	  first?: string | BrowserWorkspaceState | BrowserModelContext | CreateBrowserTabInput,
   300	  second?: CreateBrowserTabInput | BrowserBackend
   301	): BrowserTabState {
   302	  const parsed = parseWorkspaceAndInput<CreateBrowserTabInput>(first, second, {});
   303	  const context = parsed.context;
   304	  const input = typeof first === 'string' ? { url: first } : parsed.input;
   305	  const workspace = context.workspace;
   306	  const tabId = input.tabId?.trim() || idFor(context, 'tab');
   307	  const existing = workspace.tabs[tabId];
   308	  if (existing) {
   309	    workspace.activeTabId = existing.id;
   310	    workspace.activated = true;
   311	    return existing;
   312	  }
   313	  const url = input.url?.trim() ? ensureSafeBrowserUrl(input.url) : '';
   314	  const viewportInput = input.viewport;
   315	  const viewport: BrowserViewport =
   316	    typeof viewportInput === 'object' && viewportInput !== null && 'preset' in viewportInput
   317	      ? resolveBrowserViewport(viewportInput as { preset?: string; width?: number | null; height?: number | null })
   318	      : resolveBrowserViewport((viewportInput as BrowserViewportPreset | undefined) ?? 'responsive');
   319	  const generation = Math.max(workspace.activeGeneration + 1, input.generation ?? 1);
   320	  const tab: BrowserTabState = {
   321	    id: tabId,
   322	    workspaceId: workspace.workspaceId,
   323	    url,
   324	    inputUrl: url,
   325	    title: input.title?.trim() || (url ? new URL(url).hostname : 'New browser tab'),
   326	    loadState: url ? 'loading' : 'idle',
   327	    canGoBack: false,
   328	    canGoForward: false,
   329	    viewport,
   330	    annotations: [],
   331	    generation,
   332	    error: null
   333	  };
   334	  workspace.tabs[tabId] = tab;
   335	  workspace.tabOrder = [...workspace.tabOrder, tabId];
   336	  workspace.activeTabId = tabId;
   337	  workspace.activeGeneration = generation;
   338	  workspace.activated = true;
   339	  workspace.error = null;
   340	  callBackend(
   341	    context,
   342	    () => context.backend!.create_browser_tab({
   343	      workspaceId: workspace.workspaceId,
   344	      tabId,
   345	      generation,
   346	      url,
   347	      bounds: workspace.floatingBounds,
   348	      viewport,
   349	      profileId: workspace.profileSummary?.id ?? null
   350	    }),
   351	    (error) => {
   352	      tab.error = describeError(error);
   353	      tab.loadState = 'error';
   354	      setWorkspaceError(context, error);
   355	    }
   356	  );
   357	  return tab;
   358	}
