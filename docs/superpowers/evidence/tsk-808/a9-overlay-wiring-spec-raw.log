   179	  const savedUrl = loadStoredBrowserUrl();
   180	  try {
   181	    activateBrowserWorkspace(modelContext());
   182	    if (savedUrl && !browser.workspace.activeTabId) {
   183	      createBrowserTab(modelContext(), { url: savedUrl });
   184	    }
   185	    syncLegacy();
   186	  } catch (error) {
   187	    browser.workspace.error = error instanceof Error ? error.message : String(error);
   188	    syncLegacy();
   189	  }
   190	}
