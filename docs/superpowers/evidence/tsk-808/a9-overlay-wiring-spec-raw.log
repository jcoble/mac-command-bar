    72	interface FakeTabRecord extends BrowserBackendTarget {
    73	  url: string;
    74	  visible: boolean;
    75	  bounds: BrowserFloatingBounds | null;
    76	  viewport: BrowserViewport | null;
    77	  history: string[];
