### tauri-svelte-preview/scripts/normalizeBrowserUrl.test.mjs
     1	import assert from 'node:assert/strict';
     2	import { normalizeBrowserUrl } from '../src/lib/shell/browser/normalizeBrowserUrl.ts';
     3	
     4	// empty / whitespace input is not a URL
     5	{
     6	  assert.equal(normalizeBrowserUrl(''), '');
     7	  assert.equal(normalizeBrowserUrl('   '), '');
     8	  assert.equal(normalizeBrowserUrl('\t\n'), '');
     9	}
    10	
    11	// a bare port becomes localhost on that port
    12	{
    13	  assert.equal(normalizeBrowserUrl(':5177'), 'http://localhost:5177/');
    14	  assert.equal(normalizeBrowserUrl('  :3000  '), 'http://localhost:3000/');
    15	  assert.equal(normalizeBrowserUrl(':5177/next'), 'http://localhost:5177/next');
    16	}
    17	
    18	// loopback host shorthands get the http scheme
    19	{
    20	  assert.equal(normalizeBrowserUrl('localhost:5177'), 'http://localhost:5177/');
    21	  assert.equal(normalizeBrowserUrl('localhost'), 'http://localhost/');
    22	  assert.equal(normalizeBrowserUrl('LOCALHOST:5177'), 'http://localhost:5177/');
    23	  assert.equal(normalizeBrowserUrl('127.0.0.1:8080/health'), 'http://127.0.0.1:8080/health');
    24	  assert.equal(normalizeBrowserUrl('0.0.0.0:9000'), 'http://0.0.0.0:9000/');
    25	  assert.equal(normalizeBrowserUrl('[::1]:5177'), 'http://[::1]:5177/');
    26	}
    27	
    28	// full URLs survive, normalized by the URL parser
    29	{
    30	  assert.equal(normalizeBrowserUrl('http://example.com'), 'http://example.com/');
    31	  assert.equal(normalizeBrowserUrl('https://example.com/a?b=1#c'), 'https://example.com/a?b=1#c');
    32	  assert.equal(normalizeBrowserUrl('HTTPS://Example.COM/Path'), 'https://example.com/Path');
    33	  assert.equal(normalizeBrowserUrl(' http://localhost:5177/next '), 'http://localhost:5177/next');
    34	}
    35	
    36	// anything that is not http or https is rejected
    37	{
    38	  assert.equal(normalizeBrowserUrl('file:///Users/me/index.html'), '');
    39	  assert.equal(normalizeBrowserUrl('mailto:someone@example.com'), '');
    40	  assert.equal(normalizeBrowserUrl('javascript:alert(1)'), '');
    41	  assert.equal(normalizeBrowserUrl('ftp://example.com'), '');
    42	  assert.equal(normalizeBrowserUrl('tauri://localhost'), '');
    43	}
    44	
    45	// unparseable text is rejected rather than thrown
    46	{
    47	  assert.equal(normalizeBrowserUrl('not a url'), '');
    48	  assert.equal(normalizeBrowserUrl('/Users/me/project'), '');
    49	  assert.equal(normalizeBrowserUrl('::::'), '');
    50	  assert.equal(normalizeBrowserUrl('example.com'), '', 'a bare non-loopback host is not assumed to be http');
    51	}
    52	
    53	// the result of normalizing is stable: feeding it back changes nothing
    54	{
    55	  for (const input of [':5177', 'localhost:5177/next', 'https://example.com/a']) {
    56	    const once = normalizeBrowserUrl(input);
    57	    assert.equal(normalizeBrowserUrl(once), once, `stable for ${input}`);
    58	  }
    59	}
    60	
    61	console.log('normalizeBrowserUrl: all tests passed');
### tauri-svelte-preview/scripts/sessionWorkspaces.test.mjs
     1	import assert from 'node:assert/strict';
     2	
     3	import {
     4	  captureWorkspace,
     5	  diffPathFor,
     6	  emptyRetainedWorkspaces,
     7	  OPEN_PATHS_CAP,
     8	  planWorkspaceRestore,
     9	  pruneWorkspaces,
    10	  readWorkspaces,
    11	  RETAINED_WORKSPACES_CAP,
    12	  retainTabs,
    13	  SESSION_WORKSPACES_STORAGE_KEY,
    14	  takeRetainedTabs,
    15	  writeWorkspaces
    16	} from '../src/lib/shell/sessionWorkspaces.ts';
    17	
    18	/** A storage stub that can be handed junk, or made to refuse writes. */
    19	function storageStub(initial = {}, { refuseWrites = false } = {}) {
    20	  const items = new Map(Object.entries(initial));
    21	  return {
    22	    items,
    23	    getItem: (key) => (items.has(key) ? items.get(key) : null),
    24	    setItem: (key, value) => {
    25	      if (refuseWrites) throw new Error('storage is full');
    26	      items.set(key, value);
    27	    },
    28	    removeItem: (key) => items.delete(key)
    29	  };
    30	}
    31	
    32	/** Editor entries with only the field the capture reads. */
    33	function openFiles(...paths) {
    34	  return paths.map((path) => ({ path }));
    35	}
    36	
    37	// A capture is exactly what was on screen: the strip in order, the file showing,
    38	// the open folders as a list, the highlighted file, the scroll offset, and the
    39	// file the Diff tab was showing. A capture that says nothing about a diff still
    40	// carries both diff fields, as nulls — the Diff tab is one tab for the whole
    41	// shell, so "this session was not looking at one" is an answer it needs told.
    42	{
    43	  const snapshot = captureWorkspace({
    44	    openFiles: openFiles('/repo/a.ts', '/repo/b.ts'),
    45	    activePath: '/repo/b.ts',
    46	    expandedFolderIds: new Set(['folder:src', 'folder:src/lib']),
    47	    selectedPath: '/repo/b.ts',
    48	    scrollTop: 120
    49	  });
    50	  assert.deepEqual(snapshot, {
    51	    openPaths: ['/repo/a.ts', '/repo/b.ts'],
    52	    activePath: '/repo/b.ts',
    53	    expandedFolderIds: ['folder:src', 'folder:src/lib'],
    54	    selectedPath: '/repo/b.ts',
    55	    scrollTop: 120,
    56	    diffPath: null,
    57	    diffRoot: null
    58	  });
    59	}
    60	
    61	// An empty workspace captures cleanly rather than as holes.
    62	{
    63	  const snapshot = captureWorkspace({
    64	    openFiles: [],
    65	    activePath: null,
    66	    expandedFolderIds: new Set(),
    67	    selectedPath: null,
    68	    scrollTop: 0
    69	  });
    70	  assert.deepEqual(snapshot, {
    71	    openPaths: [],
    72	    activePath: null,
    73	    expandedFolderIds: [],
    74	    selectedPath: null,
    75	    scrollTop: 0,
    76	    diffPath: null,
    77	    diffRoot: null
    78	  });
    79	}
    80	
    81	// Twelve is the cap, and it is the twelve most recent — the END of the strip,
    82	// where new files land.
    83	{
    84	  const paths = Array.from({ length: 20 }, (_, index) => `/repo/file-${index}.ts`);
    85	  const snapshot = captureWorkspace({
    86	    openFiles: openFiles(...paths),
    87	    activePath: '/repo/file-19.ts',
    88	    expandedFolderIds: new Set(),
    89	    selectedPath: null,
    90	    scrollTop: 0
    91	  });
    92	  assert.equal(OPEN_PATHS_CAP, 12);
    93	  assert.deepEqual(snapshot.openPaths, paths.slice(8), 'the last twelve survive');
    94	}
    95	
    96	// The file on screen is never the one dropped, even when it sits outside the
    97	// twelve most recent — coming back to a session and not seeing the file you
    98	// left showing would be the one obvious failure.
    99	{
   100	  const paths = Array.from({ length: 20 }, (_, index) => `/repo/file-${index}.ts`);
   101	  const snapshot = captureWorkspace({
   102	    openFiles: openFiles(...paths),
   103	    activePath: '/repo/file-0.ts',
   104	    expandedFolderIds: new Set(),
   105	    selectedPath: null,
   106	    scrollTop: 0
   107	  });
   108	  assert.equal(snapshot.openPaths.length, 12, 'still twelve');
   109	  assert.equal(snapshot.openPaths[0], '/repo/file-0.ts', 'and it keeps its place in the strip');
   110	  assert.deepEqual(
   111	    snapshot.openPaths.slice(1),
   112	    paths.slice(9),
   113	    'one of the recent twelve makes room for it'
   114	  );
   115	}
   116	
   117	// A file showing that is not in the strip at all is not invented into it.
   118	{
   119	  const snapshot = captureWorkspace({
   120	    openFiles: openFiles('/repo/a.ts'),
   121	    activePath: '/repo/gone.ts',
   122	    expandedFolderIds: new Set(),
   123	    selectedPath: null,
   124	    scrollTop: 0
   125	  });
   126	  assert.deepEqual(snapshot.openPaths, ['/repo/a.ts']);
   127	}
   128	
   129	// A negative scroll offset is not a place anything can scroll to.
   130	{
   131	  const snapshot = captureWorkspace({
   132	    openFiles: [],
   133	    activePath: null,
   134	    expandedFolderIds: new Set(),
   135	    selectedPath: null,
   136	    scrollTop: -40
   137	  });
   138	  assert.equal(snapshot.scrollTop, 0);
   139	}
   140	
   141	// What was written is what comes back.
   142	{
   143	  const storage = storageStub();
   144	  const all = {
   145	    'owned-1': captureWorkspace({
   146	      openFiles: openFiles('/repo/a.ts'),
   147	      activePath: '/repo/a.ts',
   148	      expandedFolderIds: new Set(['folder:src']),
   149	      selectedPath: '/repo/a.ts',
   150	      scrollTop: 20
   151	    })
   152	  };
   153	  assert.equal(writeWorkspaces(storage, all), true);
   154	  assert.ok(storage.items.has(SESSION_WORKSPACES_STORAGE_KEY), 'stored under the shared key');
   155	  assert.deepEqual(readWorkspaces(storage), all);
   156	}
   157	
   158	// A storage that refuses the write says so rather than throwing into the shell.
   159	{
   160	  const storage = storageStub({}, { refuseWrites: true });
   161	  assert.equal(writeWorkspaces(storage, {}), false);
   162	}
   163	
   164	// Nothing stored, unreadable JSON, and a stored value that is not a map of
   165	// sessions all come back as "no session has a workspace yet".
   166	{
   167	  assert.deepEqual(readWorkspaces(storageStub()), {});
   168	  assert.deepEqual(
   169	    readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: '{not json' })),
   170	    {}
   171	  );
   172	  assert.deepEqual(readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: 'null' })), {});
   173	  assert.deepEqual(readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: '[1,2]' })), {});
   174	  assert.deepEqual(readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: '"text"' })), {});
   175	}
   176	
   177	// A storage that throws on read is a storage with nothing in it.
   178	{
   179	  const storage = {
   180	    getItem() {
   181	      throw new Error('storage is unavailable');
   182	    },
   183	    setItem() {},
   184	    removeItem() {}
   185	  };
   186	  assert.deepEqual(readWorkspaces(storage), {});
   187	}
   188	
   189	// One rotten entry costs only itself; the sessions beside it still come back.
   190	{
   191	  const stored = JSON.stringify({
   192	    'owned-junk': null,
   193	    'owned-array': [],
   194	    'owned-text': 'nonsense',
   195	    'owned-good': {
   196	      openPaths: ['/repo/a.ts'],
   197	      activePath: '/repo/a.ts',
   198	      expandedFolderIds: ['folder:src'],
   199	      selectedPath: null,
   200	      scrollTop: 12
   201	    }
   202	  });
   203	  const all = readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: stored }));
   204	  assert.deepEqual(Object.keys(all), ['owned-good']);
   205	}
   206	
   207	// Fields of the wrong type inside an otherwise fine entry are replaced with the
   208	// empty version of themselves, so a half-corrupt record still restores a session
   209	// rather than breaking the switch.
   210	{
   211	  const stored = JSON.stringify({
   212	    'owned-1': {
   213	      openPaths: ['/repo/a.ts', 7, null, '/repo/b.ts'],
   214	      activePath: 42,
   215	      expandedFolderIds: 'folder:src',
   216	      selectedPath: {},
   217	      scrollTop: 'far down'
   218	    }
   219	  });
   220	  const all = readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: stored }));
   221	  assert.deepEqual(all['owned-1'], {
   222	    openPaths: ['/repo/a.ts', '/repo/b.ts'],
   223	    activePath: null,
   224	    expandedFolderIds: [],
   225	    selectedPath: null,
   226	    scrollTop: 0,
   227	    // Written before the Diff tab was remembered at all, so it reads back as
   228	    // "was not looking at one" — correct for that record, and the safe answer.
   229	    diffPath: null,
   230	    diffRoot: null
   231	  });
   232	}
   233	
   234	// A stored strip longer than the cap is trimmed on the way in too, so an entry
   235	// written by an older build cannot grow without limit.
   236	{
   237	  const paths = Array.from({ length: 30 }, (_, index) => `/repo/file-${index}.ts`);
   238	  const stored = JSON.stringify({
   239	    'owned-1': {
   240	      openPaths: paths,
   241	      activePath: '/repo/file-29.ts',
   242	      expandedFolderIds: [],
   243	      selectedPath: null,
   244	      scrollTop: 0
   245	    }
   246	  });
   247	  const all = readWorkspaces(storageStub({ [SESSION_WORKSPACES_STORAGE_KEY]: stored }));
   248	  assert.deepEqual(all['owned-1'].openPaths, paths.slice(18));
   249	}
   250	
   251	// Pruning keeps the sessions still on the rail and drops the rest, so removing a
   252	// session takes its workspace with it.
   253	{
   254	  const snapshot = captureWorkspace({
