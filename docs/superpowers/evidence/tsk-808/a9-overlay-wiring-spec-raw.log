   243	/** Open the owned browser workspace without creating a page until requested. */
   244	export function activateBrowserWorkspace(
   245	  first?: BrowserWorkspaceState | BrowserModelContext | ActivateBrowserWorkspaceInput,
   246	  second?: BrowserModelContext | BrowserBackend | ActivateBrowserWorkspaceInput
   247	): BrowserWorkspaceState {
   248	  let context: BrowserModelContext;
   249	  let input: ActivateBrowserWorkspaceInput;
   250	  if (isContext(first)) {
   251	    context = first;
   252	    input = second && !isContext(second) && !isBackend(second)
   253	      ? (second as ActivateBrowserWorkspaceInput)
   254	      : {};
   255	  } else if (isWorkspace(first)) {
   256	    context = contextFor(first, second);
   257	    input = {};
   258	  } else {
   259	    context = isContext(second) || isBackend(second) ? contextFor(second) : contextFor();
   260	    input = first ?? {};
   261	  }
   262	  const workspace = context.workspace;
   263	  if (input.workspaceId?.trim() && Object.keys(workspace.tabs).length === 0) workspace.workspaceId = input.workspaceId.trim();
   264	  if (input.ownedId !== undefined) workspace.ownedId = input.ownedId?.trim() || null;
   265	  if (input.profileSummary !== undefined) {
   266	    workspace.profileSummary = input.profileSummary ? { ...input.profileSummary } : null;
   267	  }
   268	  // A cold launch always starts in the dock, even if a stale serialized value
   269	  // happened to contain the maximized mode.
   270	  if (!workspace.activated && workspace.presentation === 'maximized') {
   271	    workspace.presentation = 'docked';
   272	    workspace.previousPresentation = null;
   273	  }
   274	  workspace.activated = true;
   275	  workspace.error = null;
   276	  if (input.initialUrl?.trim() && !workspace.activeTabId) {
   277	    createBrowserTab(context, { url: input.initialUrl });
   278	  }
   279	  const tab = activeTab(context);
   280	  if (tab) {
   281	    callBackend(context, () => context.backend!.show_browser_tab(backendTarget(tab)), (error) => setWorkspaceError(context, error));
   282	  }
   283	  return workspace;
   284	}
