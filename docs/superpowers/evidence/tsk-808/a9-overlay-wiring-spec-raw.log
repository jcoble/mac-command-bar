   165	    }
   166	  } catch (error) {
   167	    browser.workspace.error = error instanceof Error ? error.message : String(error);
   168	  }
   169	  if (snapshot?.inputUrl && browser.workspace.activeTabId) {
   170	    const active = browser.workspace.tabs[browser.workspace.activeTabId];
   171	    if (active) active.inputUrl = snapshot.inputUrl;
   172	  }
   173	  if (snapshot?.activated !== true) browser.workspace.activated = false;
   174	  syncLegacy(nextUrl);
   175	}
