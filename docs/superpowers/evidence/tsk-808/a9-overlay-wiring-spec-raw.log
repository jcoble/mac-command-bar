### tauri-svelte-preview/scripts/panelActivation.test.mjs
     1	import assert from 'node:assert/strict';
     2	
     3	import { createPanelActivation } from '../src/lib/shell/panelActivation.ts';
     4	
     5	/** Records every loader call so a test can say exactly what ran. */
     6	function recorder() {
     7	  const calls = [];
     8	  return {
     9	    calls,
    10	    activators: {
    11	      editor: (root) => calls.push(['editor', root]),
    12	      git: (root) => calls.push(['git', root]),
    13	      browser: () => calls.push(['browser', null]),
    14	      explorer: (root) => calls.push(['explorer', root]),
    15	      context: (selection) => calls.push(['context', selection.root]),
    16	      worktrees: (selection) => calls.push(['worktrees', selection.root]),
    17	      stacks: (root) => calls.push(['stacks', root]),
    18	      problems: (root) => calls.push(['problems', root])
    19	    }
    20	  };
    21	}
    22	
    23	function selection(root, projects = []) {
    24	  return { root, projects };
    25	}
    26	
    27	// Launch: the dock announcing a restored tab, and start-up re-attaching a
    28	// session, must both load nothing at all.
    29	{
    30	  const { calls, activators } = recorder();
    31	  const panels = createPanelActivation(activators, () => selection('/repo/one'));
    32	  panels.panelShown('browser');
    33	  panels.panelShown('editor');
    34	  panels.sessionPicked();
    35	  assert.deepEqual(calls, [], 'nothing loads before the shell says launch is over');
    36	  assert.deepEqual(panels.loadedPanels(), [], 'and nothing counts as opened');
    37	}
    38	
    39	// A tab brought to the front after launch loads that tab, and only that tab.
    40	{
    41	  const { calls, activators } = recorder();
    42	  const panels = createPanelActivation(activators, () => selection('/repo/one'));
    43	  panels.allowPanelLoads();
    44	  panels.panelShown('editor');
    45	  assert.deepEqual(calls, [['editor', '/repo/one']], 'only the tab the user opened loads');
    46	  panels.panelShown('browser');
    47	  assert.deepEqual(calls.at(-1), ['browser', null], 'the browser panel takes no project');
    48	  assert.deepEqual(panels.loadedPanels(), ['editor', 'browser']);
    49	}
    50	
    51	// The terminal tab is never re-loaded from here, and an unknown id is ignored.
    52	{
    53	  const { calls, activators } = recorder();
    54	  const panels = createPanelActivation(activators, () => selection('/repo/one'));
    55	  panels.allowPanelLoads();
    56	  panels.panelShown('session');
    57	  panels.panelShown('something-else');
    58	  assert.deepEqual(calls, [], 'the terminal tab and unknown tabs load nothing');
    59	}
    60	
    61	// Source control is a section of the left column, not a tab: nothing can bring
    62	// it to the front, so a tab activation named "git" loads nothing and does not
    63	// count as an opened tab either.
    64	{
    65	  const { calls, activators } = recorder();
    66	  const panels = createPanelActivation(activators, () => selection('/repo/one'));
    67	  panels.allowPanelLoads();
    68	  panels.panelShown('git');
    69	  assert.deepEqual(calls, [], 'source control has no tab to be shown');
    70	  assert.deepEqual(panels.loadedPanels(), []);
    71	}
    72	
    73	// With no session picked yet, a tab still opens — with no project.
    74	{
    75	  const { calls, activators } = recorder();
    76	  const panels = createPanelActivation(activators, () => selection(''));
    77	  panels.allowPanelLoads();
    78	  panels.panelShown('editor');
    79	  panels.panelShown('browser');
    80	  assert.deepEqual(calls, [
    81	    ['editor', null],
    82	    ['browser', null]
    83	  ]);
    84	}
    85	
    86	// Picking a session loads the panels that come with it. The shell does not open
    87	// on the Source control view or the Context view, so neither of those is one of
    88	// them.
    89	{
    90	  const { calls, activators } = recorder();
    91	  const panels = createPanelActivation(activators, () => selection('/repo/one'));
    92	  panels.allowSessionLoads();
    93	  panels.sessionPicked();
    94	  assert.deepEqual(
    95	    calls,
    96	    [['explorer', '/repo/one']],
    97	    'a view nobody is looking at costs nothing on a pick'
    98	  );
    99	  assert.deepEqual(panels.loadedPanels(), ['explorer']);
   100	}
   101	
   102	// Bringing source control into view after a session is picked loads it once, for
   103	// the folder that session is in. Looking away and back does not read the
