   170	<div class="parking-stage" aria-hidden="true">
   171	  <div class="slot" bind:this={sessionsSlot}>{@render sessions()}</div>
   172	  <div class="slot slot-center-dock" bind:this={centerSlot}></div>
   173	  <div class="slot" bind:this={toolsSlot}>{@render tools()}</div>
   174	  <div class="slot" bind:this={activitySlot}>{@render activity()}</div>
   175	  <div class="slot" bind:this={dockSlot}>{@render dock()}</div>
   176	  <div class="slot" bind:this={sessionSlot}>{@render center.session()}</div>
   177	  <div class="slot" bind:this={editorSlot}>{@render center.editor()}</div>
   178	  <div class="slot" bind:this={browserSlot}>{@render center.browser()}</div>
   179	  <div class="slot" bind:this={diffSlot}>{@render center.diff()}</div>
   180	  <div class="slot" bind:this={sessionLibrarySlot}>{@render center.sessionLibrary()}</div>
   181	  <div class="slot" bind:this={agentsSlot}>{@render center.agents()}</div>
   182	</div>
   183	
   184	<style>
   185	  .shell-frame {
   186	    height: 100%;
   187	    width: 100%;
   188	    overflow: hidden;
   189	    visibility: hidden; /* anti-flash: revealed when ready */
   190	  }
   191	  .shell-frame.ready {
   192	    visibility: visible;
   193	  }
   194	
