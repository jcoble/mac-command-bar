   225	    --dv-inactivegroup-visiblepanel-tab-background-color: var(--color-tab-unfocused-surface);
   226	    --dv-inactivegroup-hiddenpanel-tab-background-color: var(--color-bg);
   227	    --dv-tab-divider-color: transparent;
   228	    --dv-tabs-and-actions-container-height: 35px;
   229	    --dv-activegroup-visiblepanel-tab-color: var(--color-text);
   230	    --dv-activegroup-hiddenpanel-tab-color: var(--color-text-2);
   231	    --dv-inactivegroup-visiblepanel-tab-color: var(--color-tab-unfocused-text);
   232	    --dv-inactivegroup-hiddenpanel-tab-color: var(--color-text-2);
   233	    --dv-separator-border: var(--color-border);
