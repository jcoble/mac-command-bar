    40	export type OwnedSession = Omit<Partial<OwnedAgentRuntimeFields>, 'nativeSessionId'> & {
    41	  ownedId: string;
    42	  agent: AgentKind;
    43	  viaCmux: boolean;
    44	  source: 'scanned' | 'fresh';
    45	  title: string;
    46	  projectPath: string | null;
    47	  cwd: string;
    48	  resumeCommand: string | null;
    49	  nativeSessionId: string | null;
    50	  ptySessionId: string | null;
    51	  state: OwnedSessionState;
    52	  /**
    53	   * When the user marked this session done, as an ISO stamp; `null` while it is
    54	   * still being worked on.
    55	   *
    56	   * Deliberately NOT touched by anything that happens to the terminal. A process
    57	   * exiting says the terminal is over, not that the work is; a session whose
    58	   * agent has finished is still on the list until the user says otherwise, and a
    59	   * session marked done can still be running. Only the user's "Mark done" and
    60	   * "Reopen" write this field.
    61	   */
    62	  completedAt: string | null;
    63	  /**
    64	   * When the user archived this session out of the Done list into Settled, as
    65	   * an ISO stamp; `null` while it still belongs in Working or Done. Written
    66	   * only by the user's explicit "Settle"/"Unsettle" actions — never inferred
    67	   * from age, title, or process state. Old records without the field load as
    68	   * `null`.
    69	   */
    70	  settledAt: string | null;
    71	  /**
    72	   * What the scanner worked out about the session — the branch it is on, the
    73	   * task it belongs to, the pull request it opened. Copied off the scanned
    74	   * record when the session is adopted so a row keeps showing them afterwards,
    75	   * and `null` whenever the scanner found nothing or the session was started
    76	   * here rather than found on disk.
    77	   */
    78	  branch: string | null;
    79	  taskId: string | null;
    80	  pullRequest: string | null;
    81	  /**
    82	   * How many turns of the conversation the scanner saw, and the last one of them
    83	   * already written as the row shows it (`You: …` / `Agent: …`). Copied off the
    84	   * scanned record when the session is adopted, so the row keeps showing them
    85	   * afterwards.
    86	   *
    87	   * The count is a floor, not a total — the scanner reads a bounded window of
    88	   * each transcript. `null` whenever the scanner found no conversation, or the
    89	   * session was started here rather than found on disk.
    90	   */
    91	  messageCount: number | null;
    92	  latestTurnPreview: string | null;
    93	  /**
    94	   * When the scanner last saw anything happen in this conversation, as the
    95	   * stamp it reported. Copied off the scanned record when the session is
    96	   * adopted, so a row can say how old the work is.
    97	   *
    98	   * It is a reading of the transcript on disk taken at adopt time and nothing
    99	   * moves it afterwards — a session started here has none at all. `null`
   100	   * whenever the scanner had nothing to say, and the row then shows no stamp.
   101	   */
