   123	 * this never guesses from a command line the backend did not vouch for.
   124	 */
   125	export function playwrightKindOf(process: { label?: string | null }): PlaywrightKind {
   126	  const label = (process?.label ?? '').toLowerCase();
   127	  if (label.includes('browser')) return 'browser';
   128	  if (label.includes('daemon')) return 'daemon';
   129	  if (label.includes('mcp')) return 'mcp';
   130	  if (label.includes('server')) return 'server';
   131	  return 'other';
   132	}
   133	
   134	/** The name a person reads on the row. */
   135	export function describePlaywrightKind(kind: PlaywrightKind): string {
   136	  if (kind === 'browser') return "Playwright's own browser";
   137	  if (kind === 'daemon') return "Playwright's test-runner daemon";
   138	  if (kind === 'server') return "Playwright's command-line server";
   139	  if (kind === 'mcp') return "Playwright's browser-control server for agents";
   140	  return 'A Playwright helper process';
   141	}
   142	
   143	/** One sentence saying what the thing is, shown under the group's name. */
   144	export function explainPlaywrightKind(kind: PlaywrightKind): string {
   145	  if (kind === 'browser') {
   146	    return 'A Chrome or Chromium window Playwright started with its own throwaway profile. It is not the Chrome you browse in.';
   147	  }
   148	  if (kind === 'daemon') {
   149	    return 'The background helper the Playwright test runner keeps alive between runs.';
   150	  }
   151	  if (kind === 'server') {
   152	    return 'The Playwright command-line server a test run or a script connected to.';
   153	  }
   154	  if (kind === 'mcp') {
   155	    return 'The server an agent uses to drive a browser through Playwright.';
   156	  }
   157	  return 'A process the desktop app recognised as belonging to Playwright.';
   158	}
   159	
   160	/**
   161	 * The kind that best names a whole group: the thing that STARTED the session
