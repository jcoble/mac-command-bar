   237	// ── Stopping one running process ──────────────────────────────────────────────
   238	
   239	/** Record what the desktop app answered about stopping processes. */
   240	export function setProcessKillSupport(support: BackendSupport): void {
   241	  contextState.processKill = support;
   242	}
   243	
   244	/**
   245	 * Mark that a stop has been sent for `pid`. The previous outcome sentence is
   246	 * cleared at the same moment: leaving the last stop's result on screen while a
   247	 * new one is in flight reads as though the new one has already answered.
   248	 */
   249	export function beginProcessStop(pid: number): void {
   250	  contextState.stoppingPid = pid;
   251	  contextState.lastProcessMessage = null;
   252	}
   253	
   254	/** Land the outcome of a stop, whatever it was. */
   255	export function finishProcessStop(message: string): void {
   256	  contextState.stoppingPid = null;
   257	  contextState.lastProcessMessage = message;
   258	}
   259	
   260	/**
   261	 * Why the "stop this process" button cannot be pressed, or `null` when it can.
   262	 *
   263	 * One place, so the greyed-out button and its tooltip can never disagree, and so
   264	 * "we have not asked yet" never gets reported as "this app cannot do it".
   265	 */
   266	export function processStopUnavailableReason(support: BackendSupport): string | null {
   267	  if (support === 'available') return null;
   268	  if (support === 'unknown') {
   269	    return 'Still asking this app what it can do — press refresh at the top of the panel.';
   270	  }
   271	  return 'This build of the app cannot do this yet — restart the desktop app after updating.';
   272	}
   273	
   274	/** Drop everything back to launch state. Used by tests and by a full reset. */
   275	export function resetContext(): void {
   276	  contextState.activated = false;
   277	  contextState.projects = [];
   278	  contextState.activeRoot = null;
   279	  contextState.projectName = '';
   280	  contextState.runs = emptyCard<OrchestrationRun>();
   281	  contextState.runtime = emptyCard<RuntimeContext>();
   282	  contextState.agents = emptyCard<AgentSession>();
   283	  contextState.worktrees = emptyCard<ProjectWorktree>();
   284	  contextState.repositories = emptyCard<GitRepositorySummary>();
   285	  contextState.processKill = 'unknown';
   286	  contextState.stoppingPid = null;
   287	  contextState.lastProcessMessage = null;
   288	}
   289	
   290	// ── Plain-English summaries ───────────────────────────────────────────────────
   291	//
   292	// One sentence per card, shown above its rows. They take the smallest shape
   293	// they can read so they stay easy to test and tolerate raw backend records.
   294	
   295	/** Last folder name of a path — `/a/b/my-app` → `my-app`. */
   296	export function folderName(path: string | null | undefined): string {
   297	  if (!path) return '';
   298	  const parts = path.split('/').filter(Boolean);
   299	  return parts[parts.length - 1] ?? '';
   300	}

