    95	/**
    96	 * What this build of the desktop app can do, as a list of names.
    97	 *
    98	 * `null` means we are not in the desktop app. An empty list means the app is
    99	 * running but is too old to answer the question — which is itself the answer,
   100	 * so the error is swallowed here rather than shown to anyone.
   101	 */
   102	export async function readBackendCapabilities(): Promise<string[] | null> {
   103	  if (!isNativeTauriRuntime()) return null;
   104	  const { invoke } = await import('@tauri-apps/api/core');
   105	  try {
   106	    const capabilities = await invoke<string[]>('read_backend_capabilities');
   107	    return Array.isArray(capabilities) ? capabilities.filter((name) => typeof name === 'string') : [];
   108	  } catch {
   109	    // A build that has never heard of the question cannot do the new thing.
   110	    return [];
   111	  }
   112	}

