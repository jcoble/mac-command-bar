  4092	fn list_runtime_contexts_sync(
  4093	    projects: Vec<RuntimeContextProject>,
  4094	) -> Result<Vec<RuntimeContext>, String> {
  4095	    let output = Command::new("lsof")
  4096	        .args(["-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"])
  4097	        .output()
  4098	        .map_err(|error| format!("Could not run lsof: {error}"))?;
  4099	
  4100	    if !output.status.success() && output.stdout.is_empty() {
  4101	        return Err(format!(
  4102	            "Could not list listening processes: {}",
  4103	            String::from_utf8_lossy(&output.stderr).trim()
  4104	        ));
  4105	    }
  4106	
  4107	    let listeners = parse_lsof_tcp_listeners(&String::from_utf8_lossy(&output.stdout));
  4108	    let mut cwd_by_pid: HashMap<u32, Option<PathBuf>> = HashMap::new();
  4109	    let mut seen = HashSet::new();
  4110	    let mut contexts = Vec::new();
  4111	
  4112	    for listener in listeners {
  4113	        if !seen.insert((listener.pid, listener.port)) {
  4114	            continue;
  4115	        }
  4116	
  4117	        let cwd = cwd_by_pid
  4118	            .entry(listener.pid)
  4119	            .or_insert_with(|| process_cwd(listener.pid));
  4120	        let Some(cwd) = cwd.as_ref() else {
  4121	            continue;
  4122	        };
  4123	        let Some(project_match) = runtime_context_project_for_cwd(cwd, &projects) else {
  4124	            continue;
  4125	        };
  4126	
  4127	        contexts.push(RuntimeContext {
  4128	            pid: listener.pid,
  4129	            command: listener.command,
  4130	            port: listener.port,
  4131	            cwd: cwd.display().to_string(),
  4132	            project_id: project_match.project_id,
  4133	            project_name: project_match.project_name,
  4134	            root_label: project_match.root_label,
  4135	        });
  4136	    }
  4137	
  4138	    contexts.sort_by(|left, right| {
  4139	        left.project_name
  4140	            .cmp(&right.project_name)
  4141	            .then(left.root_label.cmp(&right.root_label))
  4142	            .then(left.port.cmp(&right.port))
  4143	            .then(left.command.cmp(&right.command))
  4144	    });
  4145	    Ok(contexts)
  4146	}
