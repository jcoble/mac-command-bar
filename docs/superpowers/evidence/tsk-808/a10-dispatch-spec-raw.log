   210	function isNonEmptyString(value: unknown): value is string {
   211	  return typeof value === 'string' && value.length > 0;
   212	}
   213	
   214	/**
   215	 * A count of turns worth showing: a whole number, at least one. Zero is nothing
   216	 * to say rather than something to print, so a row shows no count at all instead
   217	 * of "0 messages".
   218	 */
   219	function isTurnCount(value: unknown): value is number {
   220	  return typeof value === 'number' && Number.isInteger(value) && value > 0;
   221	}
   222	
   223	export function parseStoredOwnedSessions(raw: string | null): OwnedSession[] {
   224	  if (!raw) {
   225	    return [];
   226	  }
   227	  let data: unknown;
   228	  try {
   229	    data = JSON.parse(raw);
   230	  } catch {
   231	    return [];
   232	  }
   233	  if (!Array.isArray(data)) {
   234	    return [];
   235	  }
   236	  const result: OwnedSession[] = [];
   237	  for (const entry of data) {
   238	    if (typeof entry !== 'object' || entry === null) {
   239	      continue;
   240	    }
   241	    const candidate = entry as Record<string, unknown>;
   242	    if (!isNonEmptyString(candidate.ownedId) || !isNonEmptyString(candidate.cwd)) {
   243	      continue;
   244	    }
   245	    const agent = (KNOWN_AGENTS as string[]).includes(candidate.agent as string)
   246	      ? (candidate.agent as AgentKind)
   247	      : 'other';
   248	    const state = (KNOWN_STATES as string[]).includes(candidate.state as string)
   249	      ? (candidate.state as OwnedSessionState)
   250	      : 'exited';
   251	    const ptySessionId = isNonEmptyString(candidate.ptySessionId) ? candidate.ptySessionId : null;
   252	    const executionOwner = (KNOWN_EXECUTION_OWNERS as string[]).includes(
   253	      candidate.executionOwner as string
   254	    )
   255	      ? (candidate.executionOwner as AgentExecutionOwner)
   256	      : ptySessionId && state !== 'exited'
   257	        ? 'terminal'
   258	        : 'stopped';
   259	    const runtimeState = (KNOWN_RUNTIME_STATES as string[]).includes(candidate.runtimeState as string)
   260	      ? (candidate.runtimeState as AgentRuntimeState)
   261	      : executionOwner === 'terminal'
   262	        ? 'ready'
   263	        : 'closed';
   264	    result.push({
   265	      ownedId: candidate.ownedId,
   266	      agent,
   267	      viaCmux: candidate.viaCmux === true,
   268	      source: candidate.source === 'fresh' ? 'fresh' : 'scanned',
   269	      title: isNonEmptyString(candidate.title) ? candidate.title : '',
   270	      projectPath: isNonEmptyString(candidate.projectPath) ? candidate.projectPath : null,
   271	      cwd: candidate.cwd,
   272	      resumeCommand: isNonEmptyString(candidate.resumeCommand) ? candidate.resumeCommand : null,
   273	      nativeSessionId: isNonEmptyString(candidate.nativeSessionId) ? candidate.nativeSessionId : null,
   274	      ptySessionId,
   275	      state,
   276	      executionOwner,
   277	      runtimeState,
   278	      providerInstanceId: isNonEmptyString(candidate.providerInstanceId)
   279	        ? candidate.providerInstanceId
   280	        : null,
   281	      activeTurnId: isNonEmptyString(candidate.activeTurnId) ? candidate.activeTurnId : null,
   282	      capabilityRevision: nonNegativeInteger(candidate.capabilityRevision) ?? 0,
   283	      lastRuntimeError: isNonEmptyString(candidate.lastRuntimeError)
   284	        ? candidate.lastRuntimeError
   285	        : null,
   286	      // Sessions saved before this field existed have no value here at all, and
   287	      // that reads exactly like "not done" — which is the right answer for them.
   288	      completedAt: isNonEmptyString(candidate.completedAt) ? candidate.completedAt : null,
   289	      // Same "not there means not settled" reading for records saved before
   290	      // the Settled shelf existed.
   291	      settledAt: isNonEmptyString(candidate.settledAt) ? candidate.settledAt : null,
   292	      // Same story here: a session saved before the scanner sent these, or one
   293	      // the scanner had nothing to say about, simply shows no chips.
   294	      branch: isNonEmptyString(candidate.branch) ? candidate.branch : null,
   295	      taskId: isNonEmptyString(candidate.taskId) ? candidate.taskId : null,
   296	      pullRequest: isNonEmptyString(candidate.pullRequest) ? candidate.pullRequest : null,
   297	      messageCount: isTurnCount(candidate.messageCount) ? candidate.messageCount : null,
   298	      latestTurnPreview: isNonEmptyString(candidate.latestTurnPreview)
   299	        ? candidate.latestTurnPreview
   300	        : null,
   301	      lastActivity: isNonEmptyString(candidate.lastActivity) ? candidate.lastActivity : null,
   302	    });
   303	  }
   304	  return result;
   305	}
