  3330	fn archive_project_worktree_sync(
  3331	    root: PathBuf,
  3332	    path: PathBuf,
  3333	) -> Result<ProjectWorktreeArchiveResult, String> {
  3334	    validate_git_root(&root)?;
  3335	
  3336	    let root_metadata = std::fs::metadata(&root)
  3337	        .map_err(|error| format!("Could not read worktree root metadata: {error}"))?;
  3338	    if !root_metadata.is_dir() {
  3339	        return Err("Worktree root is not a directory".to_string());
  3340	    }
  3341	
  3342	    let path_metadata = std::fs::metadata(&path)
  3343	        .map_err(|error| format!("Could not read worktree path metadata: {error}"))?;
  3344	    if !path_metadata.is_dir() {
  3345	        return Err("Worktree path is not a directory".to_string());
  3346	    }
  3347	
  3348	    let canonical_root = std::fs::canonicalize(&root)
  3349	        .map_err(|error| format!("Could not resolve Git root: {error}"))?;
  3350	    let canonical_path = std::fs::canonicalize(&path)
  3351	        .map_err(|error| format!("Could not resolve worktree path: {error}"))?;
  3352	    if normalized_path_string(&canonical_root) == normalized_path_string(&canonical_path) {
  3353	        return Err("Refusing to archive the primary checkout as a removable worktree".to_string());
  3354	    }
  3355	
  3356	    let worktrees = list_project_worktrees_sync(root.clone())?;
  3357	    let worktree = worktrees
  3358	        .iter()
  3359	        .find(|worktree| {
  3360	            project_worktree_path_matches(&worktree.path, &path, Some(&canonical_path))
  3361	        })
  3362	        .ok_or_else(|| "Worktree path is not registered for this repository".to_string())?;
  3363	    let archive_path = project_worktree_archive_path(worktree)?;
  3364	    std::fs::create_dir_all(&archive_path)
  3365	        .map_err(|error| format!("Could not create worktree archive directory: {error}"))?;
  3366	
  3367	    write_git_command_output(
  3368	        &canonical_path,
  3369	        &["status", "--short", "--branch"],
  3370	        &archive_path.join("status.txt"),
  3371	    )?;
  3372	    write_git_command_output(
  3373	        &canonical_path,
  3374	        &["log", "--oneline", "--decorate", "--max-count=40"],
  3375	        &archive_path.join("commits.txt"),
  3376	    )?;
  3377	    write_git_command_output(
  3378	        &canonical_path,
  3379	        &["diff", "--binary"],
  3380	        &archive_path.join("unstaged.patch"),
  3381	    )?;
  3382	    write_git_command_output(
  3383	        &canonical_path,
  3384	        &["diff", "--cached", "--binary"],
  3385	        &archive_path.join("staged.patch"),
  3386	    )?;
