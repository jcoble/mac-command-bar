   119	fn start_terminal_session_typed<R: Runtime>(
   120	    app: tauri::AppHandle<R>,
   121	    registry: &TerminalRegistry,
   122	    request: TerminalStartRequest,
   123	    kind: TerminalKind,
   124	    tool_terminal_identity: Option<ToolTerminalIdentity>,
   125	) -> Result<TerminalSessionInfo, String> {
   126	    let cwd = terminal_cwd_from_request(&request.cwd)?;
   127	    let shell = terminal_shell_from_request(request.shell);
   128	    let run_command = terminal_command_from_request(request.command);
   129	    let size = terminal_size_from_request(request.cols, request.rows);
   130	    let session_id = tool_terminal_identity
   131	        .as_ref()
   132	        .map(|identity| identity.terminal_id.clone())
   133	        .unwrap_or_else(new_terminal_session_id);
   134	    let started_at = timestamp_millis();
   135	
   136	    let pty_system = native_pty_system();
   137	    let pair = pty_system
   138	        .openpty(size)
   139	        .map_err(|error| format!("Could not open terminal pty: {error}"))?;
   140	    let mut command = CommandBuilder::new(&shell);
   141	    for arg in terminal_shell_args(&shell, run_command.as_deref()) {
   142	        command.arg(arg);
   143	    }
   144	    command.cwd(&cwd);
   145	    command.env("TERM", "xterm-256color");
   146	    command.env("COLORTERM", "truecolor");
   147	    command.env("TERM_PROGRAM", "MacCommandBar");
   148	    command.env("CLICOLOR", "1");
   149	    command.env("CLICOLOR_FORCE", "1");
   150	    command.env("FORCE_COLOR", "3");
   151	    command.env("COLORFGBG", "15;0");
   152	    command.env_remove("NO_COLOR");
   153	    // Correlates the spawned agent process (and any hook files it writes) back to
   154	    // the CommandBar-owned session. Borrowed from CMUX's CMUX_WORKSPACE_ID.
   155	    if let Some(owned_id) = request
   156	        .owned_id
   157	        .as_deref()
   158	        .map(str::trim)
   159	        .filter(|value| !value.is_empty())
   160	    {
   161	        command.env("COMMANDBAR_SESSION_ID", owned_id);
   162	    }
   163	
   164	    let child = pair
   165	        .slave
   166	        .spawn_command(command)
   167	        .map_err(|error| format!("Could not start terminal shell: {error}"))?;
   168	    let pid = child.process_id();
   169	    let reader = pair
   170	        .master
   171	        .try_clone_reader()
   172	        .map_err(|error| format!("Could not clone terminal reader: {error}"))?;
   173	    let writer = pair
   174	        .master
   175	        .take_writer()
   176	        .map_err(|error| format!("Could not take terminal writer: {error}"))?;
   177	    let killer = child.clone_killer();
   178	    let scrollback = Arc::new(Mutex::new(String::new()));
   179	    drop(pair.slave);
   180	
   181	    let info = TerminalSessionInfo {
   182	        session_id: session_id.clone(),
   183	        cwd: cwd.display().to_string(),
   184	        shell,
   185	        cols: size.cols,
   186	        rows: size.rows,
   187	        pid,
   188	        started_at,
   189	        exited: false,
   190	        exit_code: None,
   191	        signal: None,
   192	        kind,
   193	        tool_terminal_identity,
   194	    };
   195	
   196	    registry.insert(
   197	        session_id.clone(),
   198	        TerminalSessionHandle {
   199	            info: info.clone(),
   200	            master: pair.master,
   201	            writer: Mutex::new(writer),
   202	            killer: Mutex::new(killer),
   203	            scrollback: Arc::clone(&scrollback),
   204	        },
   205	    )?;
   206	
   207	    spawn_terminal_reader(
   208	        app.clone(),
   209	        session_id.clone(),
   210	        Arc::clone(&scrollback),
   211	        reader,
   212	    );
   213	    spawn_terminal_waiter(app, registry.clone(), session_id, child);
   214	
   215	    Ok(info)
