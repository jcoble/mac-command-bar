  4772	fn parse_project_git_status(output: &str) -> Result<ProjectGitStatus, String> {
  4773	    let mut git_status = ProjectGitStatus {
  4774	        branch: None,
  4775	        ahead: 0,
  4776	        behind: 0,
  4777	        has_upstream: false,
  4778	        files: Vec::new(),
  4779	    };
