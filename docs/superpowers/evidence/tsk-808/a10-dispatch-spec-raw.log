  4493	    }
  4494	    if has_playwright_cli_server(args) {
  4495	        return "playwright/cli.js".to_string();
  4496	    }
  4497	
  4498	    args.split_whitespace()
  4499	        .next()
  4500	        .map(|command| {
  4501	            Path::new(command)
  4502	                .file_name()
  4503	                .and_then(|value| value.to_str())
  4504	                .unwrap_or(command)
  4505	                .to_string()
  4506	        })
  4507	        .unwrap_or_else(|| "process".to_string())
  4508	}
