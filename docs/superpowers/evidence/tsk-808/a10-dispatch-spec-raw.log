    27	#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
    28	pub struct WorktreeScanOptions {
    29	    pub include_disk_bytes: bool,
    30	}
    31	
    32	pub fn scan_worktrees(repo_path: &str) -> Vec<WorktreeRecord> {
    33	    scan_worktrees_with_options(repo_path, WorktreeScanOptions::default())
    34	}
    35	
    36	pub fn scan_worktrees_with_options(
    37	    repo_path: &str,
    38	    options: WorktreeScanOptions,
    39	) -> Vec<WorktreeRecord> {
    40	    let output = Command::new("git")
    41	        .args(["-C", repo_path, "worktree", "list", "--porcelain"])
    42	        .output();
    43	
    44	    let Ok(output) = output else {
    45	        return Vec::new();
    46	    };
    47	    if !output.status.success() {
    48	        return Vec::new();
    49	    }
    50	
    51	    let repo = Path::new(repo_path)
    52	        .file_name()
    53	        .and_then(|name| name.to_str())
    54	        .unwrap_or("repo")
    55	        .to_string();
    56	
    57	    parse_worktree_porcelain(&String::from_utf8_lossy(&output.stdout))
    58	        .into_iter()
    59	        .map(|mut record| {
    60	            record.repo = repo.clone();
    61	            let mut dirty_state = DirtyState::Clean;
    62	            if !record.is_prunable {
    63	                dirty_state = worktree_dirty_state(&record.path);
    64	                record.is_dirty = dirty_state.is_dirty();
    65	                record.has_unmerged_commits = has_unmerged_commits(&record.path);
    66	                record.disk_bytes = options
    67	                    .include_disk_bytes
    68	                    .then(|| disk_bytes(&record.path))
    69	                    .flatten();
    70	                record.last_activity = last_activity(&record.path);
    71	            }
    72	            record.delete_eligibility = delete_eligibility(
    73	                dirty_state,
    74	                record.has_unmerged_commits,
    75	                record.is_locked,
    76	                record.is_prunable,
    77	            );
    78	            record
    79	        })
    80	        .collect()
    81	}
    82	
    83	pub fn parse_worktree_porcelain(output: &str) -> Vec<WorktreeRecord> {
    84	    output
    85	        .split("\n\n")
    86	        .filter_map(|block| {
    87	            let mut path = None;
    88	            let mut branch = None;
    89	            let mut is_prunable = false;
    90	            let mut prunable_reason = None;
    91	            let mut is_locked = false;
    92	            let mut locked_reason = None;
    93	
    94	            for line in block.lines() {
    95	                if let Some(value) = line.strip_prefix("worktree ") {
    96	                    path = Some(value.to_string());
    97	                } else if let Some(value) = line.strip_prefix("branch ") {
    98	                    branch = Some(value.trim_start_matches("refs/heads/").to_string());
    99	                } else if line == "detached" {
   100	                    branch = Some("detached".to_string());
   101	                } else if line == "prunable" {
   102	                    is_prunable = true;
   103	                } else if let Some(value) = line.strip_prefix("prunable ") {
   104	                    is_prunable = true;
   105	                    prunable_reason = Some(value.to_string());
   106	                } else if line == "locked" {
   107	                    is_locked = true;
   108	                } else if let Some(value) = line.strip_prefix("locked ") {
   109	                    is_locked = true;
   110	                    locked_reason = Some(value.to_string());
   111	                }
   112	            }
   113	
   114	            path.map(|path| {
   115	                let branch = branch.unwrap_or_else(|| "unknown".to_string());
   116	                let task_id = task_id_from_text(&branch).or_else(|| task_id_from_text(&path));
   117	
   118	                WorktreeRecord {
   119	                    repo: String::new(),
   120	                    path,
   121	                    branch,
   122	                    task_id,
   123	                    is_dirty: false,
   124	                    has_unmerged_commits: false,
   125	                    is_prunable,
   126	                    prunable_reason,
   127	                    is_locked,
   128	                    locked_reason,
   129	                    last_activity: None,
   130	                    disk_bytes: None,
   131	                    delete_eligibility: "unknown".to_string(),
   132	                }
   133	            })
   134	        })
   135	        .collect()
   136	}
