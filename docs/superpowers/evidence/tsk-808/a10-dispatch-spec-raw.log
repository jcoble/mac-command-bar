   190	    countInvoke('kill_process');
   191	    const result = await killProcess(pid, expectedCommand);
   192	    if (result === null) {
   193	      finishProcessStop(DESKTOP_ONLY);
   194	      return;
   195	    }
   196	    finishProcessStop(result.message);
   197	  } catch (error) {
   198	    finishProcessStop(`Process ${pid} was not stopped: ${describeError(error)}`);
   199	  }
   200	  await loadRuntime();
   201	}
