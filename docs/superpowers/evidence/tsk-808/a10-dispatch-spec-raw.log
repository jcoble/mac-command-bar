  4421	fn signal_process(pid: u32, signal: &str) -> Result<(), String> {
  4422	    if pid == 0 || pid == std::process::id() {
  4423	        return Err(format!("Refusing to signal unsafe process {pid}"));
  4424	    }
  4425	
  4426	    let output = Command::new("kill")
  4427	        .args([format!("-{signal}"), pid.to_string()])
  4428	        .output()
  4429	        .map_err(|error| format!("Could not run kill -{signal} for pid {pid}: {error}"))?;
  4430	
  4431	    if output.status.success() {
  4432	        Ok(())
  4433	    } else {
  4434	        Err(format!(
  4435	            "kill -{signal} {pid} failed: {}",
  4436	            String::from_utf8_lossy(&output.stderr).trim()
  4437	        ))
  4438	    }
  4439	}
