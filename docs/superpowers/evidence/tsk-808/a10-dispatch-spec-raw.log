   130	    loadRuntime(),
   131	    loadAgents(),
   132	    loadWorktrees(),
   133	    loadRepositories(),
   134	    refreshPlaywrightCard(),
   135	    askWhatTheAppCanDo()
   136	  ]);
   137	}
