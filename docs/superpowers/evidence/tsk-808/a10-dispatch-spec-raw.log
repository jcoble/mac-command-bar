  4376	/// Stop one process, with the refusals spelled out.
  4377	///
  4378	/// Numbers 0 and 1 are not ordinary processes — 0 means "every process in my
  4379	/// group" to the kill signal and 1 is the system's own first process, so both
  4380	/// are refused before anything is sent. So is this app's own number, which
  4381	/// would otherwise close the window the reader clicked in.
  4382	fn kill_process_with<SignalProcess>(
  4383	    pid: u32,
  4384	    own_pid: u32,
  4385	    mut signal_process: SignalProcess,
  4386	) -> ProcessKillResult
  4387	where
  4388	    SignalProcess: FnMut(u32, &str) -> Result<(), String>,
  4389	{
  4390	    if pid <= 1 {
  4391	        return ProcessKillResult {
  4392	            ok: false,
  4393	            message: format!(
  4394	                "{pid} is not a process this app will stop — it is the system's own, and stopping it would take the machine down."
  4395	            ),
  4396	        };
  4397	    }
  4398	    if pid == own_pid {
  4399	        return ProcessKillResult {
  4400	            ok: false,
  4401	            message: "That number belongs to this app itself, so nothing was stopped.".to_string(),
  4402	        };
  4403	    }
  4404	
  4405	    match signal_process(pid, "TERM") {
  4406	        Ok(()) => ProcessKillResult {
  4407	            ok: true,
  4408	            message: format!(
  4409	                "Asked process {pid} to stop. It may take a moment to finish shutting down."
  4410	            ),
  4411	        },
  4412	        Err(reason) => ProcessKillResult {
  4413	            ok: false,
  4414	            message: format!(
  4415	                "Could not stop process {pid}. It may have already exited, or it may belong to another user. ({reason})"
  4416	            ),
  4417	        },
  4418	    }
  4419	}
