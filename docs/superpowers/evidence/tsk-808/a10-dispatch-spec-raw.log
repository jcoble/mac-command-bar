   138	#[derive(Debug, Clone, Copy, PartialEq, Eq)]
   139	enum DirtyState {
   140	    Clean,
   141	    UntrackedOnly,
   142	    Dirty,
   143	}
   144	
   145	impl DirtyState {
   146	    fn is_dirty(self) -> bool {
   147	        !matches!(self, DirtyState::Clean)
   148	    }
   149	}
   150	
   151	fn worktree_dirty_state(path: &str) -> DirtyState {
   152	    let output = Command::new("git")
   153	        .args(["-C", path, "status", "--short"])
   154	        .output();
   155	    output
   156	        .ok()
   157	        .filter(|output| output.status.success())
   158	        .map(|output| dirty_state_from_status(&String::from_utf8_lossy(&output.stdout)))
   159	        .unwrap_or(DirtyState::Clean)
   160	}
   161	
   162	fn dirty_state_from_status(status: &str) -> DirtyState {
   163	    let mut saw_status = false;
   164	
   165	    for line in status.lines().filter(|line| !line.trim().is_empty()) {
   166	        saw_status = true;
   167	        if !line.starts_with("?? ") {
   168	            return DirtyState::Dirty;
   169	        }
   170	    }
   171	
   172	    if saw_status {
   173	        DirtyState::UntrackedOnly
   174	    } else {
   175	        DirtyState::Clean
   176	    }
   177	}
   178	
   179	fn has_unmerged_commits(path: &str) -> bool {
   180	    let output = Command::new("git")
   181	        .args([
   182	            "-C",
   183	            path,
   184	            "log",
   185	            "--branches",
   186	            "--not",
   187	            "--remotes",
   188	            "--oneline",
   189	        ])
   190	        .output();
   191	    output
   192	        .ok()
   193	        .filter(|output| output.status.success())
   194	        .map(|output| !output.stdout.is_empty())
   195	        .unwrap_or(false)
   196	}
   197	
   198	fn disk_bytes(path: &str) -> Option<u64> {
   199	    let output = Command::new("du").args(["-sk", path]).output().ok()?;
   200	    if !output.status.success() {
   201	        return None;
   202	    }
   203	    let stdout = String::from_utf8_lossy(&output.stdout);
   204	    let kb = stdout.split_whitespace().next()?.parse::<u64>().ok()?;
   205	    Some(kb * 1024)
   206	}
   207	
   208	fn last_activity(path: &str) -> Option<String> {
   209	    let output = Command::new("git")
   210	        .args(["-C", path, "log", "-1", "--format=%cI"])
   211	        .output()
   212	        .ok()?;
   213	    if !output.status.success() {
   214	        return None;
   215	    }
   216	    let value = String::from_utf8_lossy(&output.stdout).trim().to_string();
   217	    (!value.is_empty()).then_some(value)
   218	}
