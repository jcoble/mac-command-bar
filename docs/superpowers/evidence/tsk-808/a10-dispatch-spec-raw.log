    13	pub fn validate_manifest(manifest: &AgentProviderManifest) -> Result<(), String> {
    14	    required(&manifest.id, "Provider id")?;
    15	    required(&manifest.display_name, "Provider display name")?;
    16	    required(&manifest.version, "Provider version")?;
    17	    required(&manifest.content_hash, "Provider content hash")?;
    18	    if manifest.content_hash.len() != 64
    19	        || !manifest
    20	            .content_hash
    21	            .bytes()
    22	            .all(|byte| byte.is_ascii_hexdigit())
    23	    {
    24	        return Err("Provider content hash must be a SHA-256 hex digest".to_string());
    25	    }
    26	    if manifest.version.eq_ignore_ascii_case("latest")
    27	        || manifest.args.iter().any(|arg| arg.contains("@latest"))
    28	        || manifest.executable.to_string_lossy().contains("npx")
    29	    {
    30	        return Err("Provider manifests must use a pinned packaged adapter".to_string());
    31	    }
    32	    if manifest.transport != ProviderTransport::BuiltIn {
    33	        validate_executable(&manifest.executable)?;
    34	    }
    35	    let _ = manifest.trusted_source;
    36	    Ok(())
    37	}
    38	
    39	pub fn validate_capabilities(capabilities: &AgentCapabilities) -> Result<(), String> {
    40	    if capabilities.revision == 0 {
    41	        return Err("Capability revision must be positive".to_string());
    42	    }
    43	    required(
    44	        &capabilities.implementation.name,
    45	        "Provider implementation name",
    46	    )?;
    47	    required(
    48	        &capabilities.implementation.version,
    49	        "Provider implementation version",
    50	    )?;
    51	    validate_config_options(&capabilities.config_options)
    52	}
    53	
    54	pub fn validate_config_options(options: &[AgentConfigOption]) -> Result<(), String> {
    55	    let mut ids = HashSet::new();
    56	    for option in options {
    57	        let id = required(&option.id, "Config option id")?;
    58	        required(&option.label, "Config option label")?;
    59	        required(&option.category, "Config option category")?;
    60	        if !ids.insert(id) {
    61	            return Err("Config option ids must be unique".to_string());
    62	        }
    63	        if let Some(choices) = &option.choices {
    64	            if choices.is_empty() {
    65	                return Err(format!("Config option {} has no choices", option.id));
    66	            }
    67	            if !choices.iter().any(|choice| choice.value == option.value) {
    68	                return Err(format!(
    69	                    "Config option {} has an invalid selected value",
    70	                    option.id
    71	                ));
    72	            }
    73	        }
    74	    }
    75	    Ok(())
    76	}
    77	
    78	pub fn replace_config_options(
    79	    capabilities: &mut AgentCapabilities,
    80	    replacement: Vec<AgentConfigOption>,
    81	) -> Result<(), String> {
    82	    validate_config_options(&replacement)?;
    83	    capabilities.config_options = replacement;
    84	    capabilities.revision = capabilities.revision.saturating_add(1);
    85	    Ok(())
    86	}
    87	
    88	pub fn validate_config_value(option: &AgentConfigOption, value: &Value) -> Result<(), String> {
    89	    if let Some(choices) = &option.choices {
    90	        if !choices.iter().any(|choice| &choice.value == value) {
    91	            return Err(format!("Unsupported value for config option {}", option.id));
    92	        }
    93	    }
    94	    Ok(())
    95	}
    96	
    97	fn validate_executable(path: &Path) -> Result<(), String> {
    98	    if path.as_os_str().is_empty() {
    99	        return Err("Provider executable is required".to_string());
   100	    }
   101	    if !path.is_absolute() {
   102	        return Err("Provider executable must use an absolute packaged path".to_string());
   103	    }
   104	    if !path.is_file() {
   105	        return Err("Provider executable does not exist".to_string());
   106	    }
   107	    Ok(())
   108	}
   109	
   110	fn required(value: &str, label: &str) -> Result<String, String> {
   111	    let value = value.trim();
   112	    if value.is_empty() {
   113	        Err(format!("{label} is required"))
   114	    } else {
   115	        Ok(value.to_string())
   116	    }
   117	}
