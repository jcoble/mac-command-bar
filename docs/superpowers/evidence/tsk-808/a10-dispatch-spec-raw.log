   180	/**
   181	 * Clear git's record of a worktree whose folder is already gone.
   182	 *
   183	 * It is the same command as the everyday remove — the desktop app recognises a
   184	 * folder-gone worktree and clears the record instead of deleting anything — but
   185	 * it is a separate function because what it DOES is different enough that the
   186	 * sentence afterwards has to be different too.
   187	 *
   188	 * That sentence is written here rather than passed through from the desktop
   189	 * app, because this is the one case where the app's own wording ("Pruned
   190	 * missing worktree metadata …") is both jargon and, on an older build,
   191	 * incomplete: it names one branch while having cleared several. What is said
   192	 * here follows what the app told us it can do, so it is right for both builds.
   193	 */
   194	export async function clearWorktreeEntry(path: string, branch: string): Promise<void> {
   195	  const root = (worktreeManager.root ?? '').trim();
   196	  if (!root || !path) return;
   197	  beginWorktreeAction(path, 'clear');
   198	  try {
   199	    countInvoke('remove_project_worktree');
   200	    const result = await removeWorktreeCommand(root, path);
   201	    if (result === null) {
   202	      failWorktreeAction(DESKTOP_ONLY_MESSAGE);
   203	      return;
   204	    }
   205	    // A new app says exactly what happened in plain words — including "there
   206	    // was nothing to clear" when git's records were already gone — so its own
   207	    // sentence is the honest one to show. Only the older build, whose message
   208	    // is jargon and names one branch while clearing several, gets ours.
   209	    const cleared = `Cleared git’s record of “${branch}”. Nothing on disk was touched.`;
