    80	/**
    81	 * Seconds from the elapsed time `ps` prints: `SS`, `MM:SS`, `HH:MM:SS` or
    82	 * `DD-HH:MM:SS`. Anything else returns `null` — an unreadable age is shown as
    83	 * unknown, never guessed.
    84	 */
    85	export function parseProcessElapsed(elapsed: string | null | undefined): number | null {
    86	  const text = (elapsed ?? '').trim();
    87	  if (!text) return null;
    88	
    89	  const [days, clock] = text.includes('-') ? text.split('-', 2) : ['0', text];
    90	  const dayCount = Number(days);
    91	  if (!Number.isFinite(dayCount) || dayCount < 0) return null;
    92	
    93	  const parts = clock.split(':');
    94	  if (parts.length > 3) return null;
    95	  let seconds = 0;
    96	  for (const part of parts) {
    97	    if (!/^\d+$/.test(part)) return null;
    98	    seconds = seconds * 60 + Number(part);
    99	  }
   100	  return dayCount * 86400 + seconds;
   101	}
   102	
   103	/** `90` → `1 minute`; `null` → `unknown age`. Always the right singular. */
   104	export function describeAge(seconds: number | null | undefined): string {
   105	  if (seconds === null || seconds === undefined || !Number.isFinite(seconds) || seconds < 0) {
   106	    return 'unknown age';
   107	  }
   108	  if (seconds < 60) return 'less than a minute';
   109	  if (seconds < 3600) return plural(Math.floor(seconds / 60), 'minute');
   110	  if (seconds < 86400) return plural(Math.floor(seconds / 3600), 'hour');
   111	  return plural(Math.floor(seconds / 86400), 'day');
   112	}
   113	
   114	function plural(value: number, singular: string, many = `${singular}s`): string {
   115	  return `${value} ${value === 1 ? singular : many}`;
   116	}
