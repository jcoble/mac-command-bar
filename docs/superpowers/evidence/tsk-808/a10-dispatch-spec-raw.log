     1	/**
     2	 * worktreeManagerStore.svelte.ts — runes state for the worktree manager pane.
     3	 *
     4	 * Same two rules as every other /next store:
     5	 *
     6	 * 1. **No backend, ever.** Nothing here invokes, fetches or reads storage.
     7	 *    Every desktop call lives in `worktreeManagerService.ts` and lands here as a
     8	 *    plain assignment.
     9	 * 2. **No `$effect`.** `$effect` is illegal in a `.svelte.ts` module. Nothing in
    10	 *    here reacts; it is a value bag with mutators.
    11	 *
    12	 * It holds the three lists RAW — worktrees, repository summaries, sessions —
    13	 * and never the joined rows. The join is a pure function
    14	 * (`worktreeManagerRows.ts`) the component runs inside a `$derived`, so there is
    15	 * exactly one copy of the answer and it can never go stale behind the data.
    16	 *
    17	 * Every import is type-only on purpose, which keeps the module compilable on its
    18	 * own the way `contextStore.svelte.ts` is.
    19	 *
    20	 * Nothing here is persisted, so no mutator has a `persist()` to call: what the
    21	 * pane shows is read fresh from the machine each time it is opened, and a filter
    22	 * box or an open detail row is not worth remembering across a restart.
    23	 */
    24	import type { GitRepositorySummary, ProjectWorktree } from '../../tauriSource.ts';
    25	import type { WorktreeSessionInput } from './worktreeManagerRows.ts';
    26	
    27	/** Which action is running, or '' when none is. */
    28	export type WorktreeActionKind = '' | 'remove' | 'clear' | 'force-remove' | 'archive';
    29	
    30	/**
    31	 * Whether this build of the desktop app can do a particular thing.
    32	 * `'unknown'` is the state before the app has been asked, and it is real screen
    33	 * time: the question is asked once when the pane first opens. Nothing pretends
    34	 * to know the answer while it is still `'unknown'`.
    35	 */
    36	export type BackendSupport = 'unknown' | 'available' | 'unavailable';
    37	
    38	/**
    39	 * Whether this build of the desktop app can force-remove a worktree. The
    40	 * destructive button stays switched off while this is `'unknown'`, because
    41	 * offering a button that might quietly do something gentler instead is worse
    42	 * than offering nothing.
    43	 */
    44	export type ForceRemoveSupport = BackendSupport;
    45	
    46	export interface WorktreeManagerState {
    47	  /** The pane has been shown and pointed at a folder at least once. */
    48	  activated: boolean;
    49	  /** The folder the worktrees were read for, or `null` before there is one. */
    50	  root: string | null;
    51	  /** Name of the project that folder belongs to, for the empty sentences. */
    52	  projectName: string;
    53	
    54	  // ── what was read ──────────────────────────────────────────────────────────
    55	  worktrees: ProjectWorktree[];
    56	  /** Repository summaries — the only place ahead/behind counts come from. */
    57	  repositories: GitRepositorySummary[];
    58	  /** The shell's own sessions, so a row can say who worked in that folder. */
    59	  sessions: WorktreeSessionInput[];
    60	
    61	  // ── how the read went ──────────────────────────────────────────────────────
    62	  loading: boolean;
    63	  /** Why the last read failed, in plain English. '' when it did not. */
    64	  error: string;
    65	  /**
    66	   * Why there is nothing to show through nobody's fault — the data only exists
    67	   * in the desktop app, or no project is selected yet. Non-empty means "show
    68	   * this sentence instead of an empty list".
    69	   */
    70	  unavailableReason: string;
    71	  /** Monotonic ticket of the newest read, so a slow one cannot overwrite it. */
    72	  requestId: number;
    73	  loadedAt: number | null;
    74	
    75	  // ── what the user is doing ─────────────────────────────────────────────────
    76	  /** Path of the row whose details are open, or '' when none is. */
    77	  selectedPath: string;
    78	  /** What is typed in the filter box. */
    79	  filter: string;
    80	  /** Path of the worktree an action is running on, or ''. */
    81	  busyPath: string;
    82	  busyAction: WorktreeActionKind;
    83	  /** What the last finished action did, in its own words from the desktop app. */
    84	  actionMessage: string;
    85	  /** Why the last action did not happen. '' when it did. */
    86	  actionError: string;
    87	
    88	  // ── what the desktop app can do ────────────────────────────────────────────
    89	  forceRemoveSupport: ForceRemoveSupport;
    90	  /**
    91	   * Whether clearing one folder-gone row clears only that row. When this is not
    92	   * `'available'`, the confirmation dialog says out loud that every other row
    93	   * whose folder is gone goes with it — see `describeRemovalQuestion`.
    94	   */
    95	  pruneSingleRowSupport: BackendSupport;
    96	}
    97	
    98	/** Shown on the destructive button while this build cannot actually force. */
    99	export const FORCE_REMOVE_UNAVAILABLE_TOOLTIP =
   100	  'This build of the app cannot do this yet — restart the desktop app after updating.';
   101	
   102	export function createWorktreeManagerState(): WorktreeManagerState {
   103	  return {
   104	    activated: false,
   105	    root: null,
   106	    projectName: '',
   107	    worktrees: [],
   108	    repositories: [],
   109	    sessions: [],
   110	    loading: false,
   111	    error: '',
   112	    unavailableReason: '',
   113	    requestId: 0,
   114	    loadedAt: null,
   115	    selectedPath: '',
   116	    filter: '',
   117	    busyPath: '',
   118	    busyAction: '',
   119	    actionMessage: '',
   120	    actionError: '',
   121	    forceRemoveSupport: 'unknown',
   122	    pruneSingleRowSupport: 'unknown'
   123	  };
   124	}
   125	
   126	/** The reactive state the pane reads and the service writes. */
   127	export const worktreeManager = $state<WorktreeManagerState>(createWorktreeManagerState());
   128	
   129	// ── mutations ────────────────────────────────────────────────────────────────
   130	
   131	/** Point the pane at a folder. Pure bookkeeping — it starts no read. */
   132	export function setWorktreeManagerInput(input: {
   133	  root: string | null;
   134	  projectName?: string;
   135	  sessions: WorktreeSessionInput[];
   136	}): void {
   137	  worktreeManager.activated = true;
   138	  const changedFolder = worktreeManager.root !== input.root;
   139	  worktreeManager.root = input.root;
   140	  worktreeManager.projectName = input.projectName?.trim() ?? '';
   141	  worktreeManager.sessions = input.sessions;
   142	  if (!changedFolder) return;
   143	  // A different repository has different rows; keeping the old selection would
   144	  // open a detail panel for a folder that is not on screen any more.
   145	  worktreeManager.selectedPath = '';
   146	  worktreeManager.actionMessage = '';
   147	  worktreeManager.actionError = '';
   148	}
   149	
   150	/** Take a ticket for a new read. Hand it back to whichever landing it reaches. */
   151	export function beginWorktreeLoad(): number {
   152	  worktreeManager.requestId += 1;
   153	  worktreeManager.loading = true;
   154	  worktreeManager.error = '';
   155	  worktreeManager.unavailableReason = '';
   156	  return worktreeManager.requestId;
   157	}
   158	
   159	/** Land a successful read. `false` when a newer read superseded it. */
   160	export function applyWorktreeLoad(
   161	  requestId: number,
   162	  worktrees: ProjectWorktree[],
   163	  repositories: GitRepositorySummary[]
   164	): boolean {
   165	  if (worktreeManager.requestId !== requestId) return false;
   166	  worktreeManager.worktrees = worktrees;
   167	  worktreeManager.repositories = repositories;
   168	  worktreeManager.loading = false;
   169	  worktreeManager.error = '';
   170	  worktreeManager.unavailableReason = '';
   171	  worktreeManager.loadedAt = Date.now();
   172	  return true;
   173	}
   174	
   175	/** Land a failed read. `false` when a newer read superseded it. */
   176	export function failWorktreeLoad(requestId: number, message: string): boolean {
   177	  if (worktreeManager.requestId !== requestId) return false;
   178	  worktreeManager.loading = false;
   179	  worktreeManager.error = message;
   180	  return true;
   181	}
   182	
   183	/** Land a read that could not run at all, and say plainly why. */
   184	export function markWorktreesUnavailable(requestId: number, reason: string): boolean {
   185	  if (worktreeManager.requestId !== requestId) return false;
   186	  worktreeManager.worktrees = [];
   187	  worktreeManager.repositories = [];
   188	  worktreeManager.loading = false;
   189	  worktreeManager.error = '';
   190	  worktreeManager.unavailableReason = reason;
   191	  return true;
   192	}
   193	
   194	/** Record what this build of the desktop app can do. */
   195	export function setForceRemoveSupport(support: ForceRemoveSupport): void {
   196	  worktreeManager.forceRemoveSupport = support;
   197	}
   198	
   199	/** Record whether clearing one folder-gone row leaves the other ones alone. */
   200	export function setPruneSingleRowSupport(support: BackendSupport): void {
   201	  worktreeManager.pruneSingleRowSupport = support;
   202	}
   203	
   204	/** Open one row's details, or close them by passing the open one again. */
   205	export function toggleWorktreeDetail(path: string): void {
   206	  worktreeManager.selectedPath = worktreeManager.selectedPath === path ? '' : path;
   207	}
   208	
   209	/** An action is starting on one worktree. Clears the last one's words. */
   210	export function beginWorktreeAction(path: string, action: WorktreeActionKind): void {
   211	  worktreeManager.busyPath = path;
   212	  worktreeManager.busyAction = action;
   213	  worktreeManager.actionMessage = '';
   214	  worktreeManager.actionError = '';
   215	}
   216	
   217	/** An action finished, and the desktop app said this about it. */
   218	export function finishWorktreeAction(message: string, worktrees?: ProjectWorktree[]): void {
   219	  worktreeManager.busyPath = '';
   220	  worktreeManager.busyAction = '';
   221	  worktreeManager.actionMessage = message;
   222	  worktreeManager.actionError = '';
   223	  // Every action command answers with the list as it now stands, so the pane
   224	  // never has to guess what changed or read the machine a second time.
   225	  if (worktrees) worktreeManager.worktrees = worktrees;
   226	}
   227	
   228	/** An action did not happen, for this reason. */
   229	export function failWorktreeAction(message: string): void {
   230	  worktreeManager.busyPath = '';
   231	  worktreeManager.busyAction = '';
   232	  worktreeManager.actionError = message;
   233	}
   234	
   235	/** Drop everything back to launch state. For tests and a full reset. */
   236	export function resetWorktreeManager(): void {
   237	  Object.assign(worktreeManager, createWorktreeManagerState());
   238	}

