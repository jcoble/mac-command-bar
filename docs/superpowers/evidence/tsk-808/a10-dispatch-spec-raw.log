  3145	        .as_ref()
  3146	        .map(|path| normalized_path_string(&canonical_root) == normalized_path_string(path))
  3147	        .unwrap_or(false)
  3148	    {
  3149	        return Err("Refusing to remove the primary checkout".to_string());
