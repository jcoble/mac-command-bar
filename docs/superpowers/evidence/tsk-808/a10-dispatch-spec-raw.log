  4830	
  4831	fn parse_git_branch_header(header: &str) -> GitBranchHeader {
  4832	    let mut branch_part = header.trim();
  4833	    let mut ahead = 0;
  4834	    let mut behind = 0;
  4835	
  4836	    if let Some(metadata_index) = branch_part.find(" [") {
  4837	        let metadata = branch_part[metadata_index + 2..].trim_end_matches(']');
  4838	        branch_part = &branch_part[..metadata_index];
  4839	        for item in metadata.split(',').map(str::trim) {
  4840	            if let Some(value) = item.strip_prefix("ahead ") {
  4841	                ahead = value.parse::<usize>().unwrap_or(0);
  4842	            } else if let Some(value) = item.strip_prefix("behind ") {
  4843	                behind = value.parse::<usize>().unwrap_or(0);
  4844	            }
  4845	        }
  4846	    }
  4847	
  4848	    let mut branch_parts = branch_part.splitn(2, "...");
  4849	    let branch_name_part = branch_parts.next().unwrap_or_default().trim();
  4850	    let has_upstream = branch_parts
  4851	        .next()
  4852	        .map(str::trim)
  4853	        .is_some_and(|upstream| !upstream.is_empty());
  4854	
  4855	    if let Some(branch) = branch_part.strip_prefix("No commits yet on ") {
  4856	        let branch = branch
  4857	            .split("...")
  4858	            .next()
  4859	            .unwrap_or(branch)
  4860	            .trim()
  4861	            .to_string();
  4862	        return GitBranchHeader {
  4863	            branch: Some(branch),
  4864	            ahead,
  4865	            behind,
  4866	            has_upstream,
  4867	        };
  4868	    }
  4869	
  4870	    let branch = Some(branch_name_part)
  4871	        .filter(|value| !value.is_empty())
  4872	        .map(str::to_string);
  4873	
  4874	    GitBranchHeader {
  4875	        branch,
  4876	        ahead,
  4877	        behind,
  4878	        has_upstream,
  4879	    }
  4880	}
