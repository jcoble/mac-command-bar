   218	pub fn list_terminal_sessions(
   219	    registry: &TerminalRegistry,
   220	) -> Result<Vec<TerminalSessionInfo>, String> {
   221	    let sessions = registry
   222	        .inner
   223	        .lock()
   224	        .map_err(|_| "Terminal session registry is unavailable".to_string())?;
   225	    Ok(sessions
   226	        .values()
   227	        .map(|session| session.info.clone())
   228	        .collect())
   229	}
   230	
   231	pub fn read_terminal_session_scrollback(
   232	    registry: &TerminalRegistry,
   233	    session_id: &str,
   234	) -> Result<Option<String>, String> {
   235	    let Some(session_id) = normalize_terminal_session_id(session_id) else {
   236	        return Ok(None);
   237	    };
   238	    let scrollback = {
   239	        let sessions = registry
   240	            .inner
   241	            .lock()
   242	            .map_err(|_| "Terminal session registry is unavailable".to_string())?;
   243	        let Some(session) = sessions.get(session_id) else {
   244	            return Ok(None);
   245	        };

