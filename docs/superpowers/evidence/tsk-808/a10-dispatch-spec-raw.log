  4510	fn group_playwright_processes(processes: Vec<PlaywrightProcessInfo>) -> Vec<PlaywrightSessionInfo> {
  4511	    let mut by_pgid: HashMap<u32, Vec<PlaywrightProcessInfo>> = HashMap::new();
  4512	    for process in processes {
  4513	        by_pgid.entry(process.pgid).or_default().push(process);
  4514	    }
  4515	
  4516	    let mut sessions = by_pgid
  4517	        .into_iter()
  4518	        .map(|(pgid, mut processes)| {
  4519	            processes.sort_by_key(|process| process.pid);
  4520	            let pids = processes
  4521	                .iter()
  4522	                .map(|process| process.pid)
  4523	                .collect::<Vec<_>>();
  4524	            let label = processes
  4525	                .iter()
  4526	                .find(|process| process.label != "Playwright browser")
  4527	                .or_else(|| processes.first())
  4528	                .map(|process| process.label.clone())
  4529	                .unwrap_or_else(|| "Playwright session".to_string());
  4530	            PlaywrightSessionInfo {
  4531	                pgid,
  4532	                label,
  4533	                pids,
  4534	                processes,
  4535	            }
  4536	        })
  4537	        .collect::<Vec<_>>();
  4538	
  4539	    sessions.sort_by(|left, right| left.pgid.cmp(&right.pgid));
  4540	    sessions
  4541	}
