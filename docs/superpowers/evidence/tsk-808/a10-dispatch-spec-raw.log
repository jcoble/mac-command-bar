   115	/// Writes the derived branch, task, pull request and source label onto every
   116	/// record, so the shell reads them off the row it already has instead of parsing
   117	/// titles again on the other side of the bridge.
   118	///
   119	/// Run once over the finished list rather than at each construction site: a
   120	/// session is described by several files, and only the merged record has the
   121	/// title, folder and resume command the hints are read from.
   122	pub fn with_derived_agent_session_metadata(
   123	    mut records: Vec<AgentSessionRecord>,
