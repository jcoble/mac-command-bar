   265	      ownedId: candidate.ownedId,
   266	      agent,
   267	      viaCmux: candidate.viaCmux === true,
   268	      source: candidate.source === 'fresh' ? 'fresh' : 'scanned',
   269	      title: isNonEmptyString(candidate.title) ? candidate.title : '',
   270	      projectPath: isNonEmptyString(candidate.projectPath) ? candidate.projectPath : null,
   271	      cwd: candidate.cwd,
   272	      resumeCommand: isNonEmptyString(candidate.resumeCommand) ? candidate.resumeCommand : null,
