   179	fn has_unmerged_commits(path: &str) -> bool {
   180	    let output = Command::new("git")
   181	        .args([
   182	            "-C",
   183	            path,
   184	            "log",
   185	            "--branches",
   186	            "--not",
   187	            "--remotes",
   188	            "--oneline",
   189	        ])
   190	        .output();
   191	    output
   192	        .ok()
   193	        .filter(|output| output.status.success())
   194	        .map(|output| !output.stdout.is_empty())
   195	        .unwrap_or(false)
   196	}
   197	
   198	fn disk_bytes(path: &str) -> Option<u64> {
   199	    let output = Command::new("du").args(["-sk", path]).output().ok()?;
   200	    if !output.status.success() {
   201	        return None;
   202	    }
   203	    let stdout = String::from_utf8_lossy(&output.stdout);
   204	    let kb = stdout.split_whitespace().next()?.parse::<u64>().ok()?;
   205	    Some(kb * 1024)
   206	}
   207	
   208	fn last_activity(path: &str) -> Option<String> {
   209	    let output = Command::new("git")
   210	        .args(["-C", path, "log", "-1", "--format=%cI"])
   211	        .output()
   212	        .ok()?;
   213	    if !output.status.success() {
   214	        return None;
   215	    }
   216	    let value = String::from_utf8_lossy(&output.stdout).trim().to_string();
   217	    (!value.is_empty()).then_some(value)
   218	}
