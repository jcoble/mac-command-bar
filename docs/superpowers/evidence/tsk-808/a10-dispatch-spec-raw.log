  4651	fn parse_lsof_tcp_port(name: &str) -> Option<u16> {
  4652	    let endpoint = name.split("->").next().unwrap_or(name).trim();
  4653	    let port_text = endpoint.rsplit(':').next()?.trim();
  4654	    let digits: String = port_text
  4655	        .chars()
  4656	        .take_while(|character| character.is_ascii_digit())
  4657	        .collect();
  4658	
  4659	    if digits.is_empty() {
  4660	        return None;
  4661	    }
  4662	
  4663	    digits.parse::<u16>().ok()
  4664	}
