  4615	fn parse_lsof_tcp_listeners(output: &str) -> Vec<ProcessListener> {
  4616	    let mut listeners = Vec::new();
  4617	    let mut current_pid: Option<u32> = None;
  4618	    let mut current_command = String::new();
  4619	
  4620	    for line in output.lines().filter(|line| !line.is_empty()) {
  4621	        let (field, value) = line.split_at(1);
  4622	        match field {
  4623	            "p" => {
  4624	                current_pid = value.parse::<u32>().ok();
  4625	                current_command.clear();
  4626	            }
  4627	            "c" => {
  4628	                current_command = value.to_string();
  4629	            }
  4630	            "n" => {
  4631	                let Some(pid) = current_pid else {
  4632	                    continue;
  4633	                };
  4634	                let Some(port) = parse_lsof_tcp_port(value) else {
  4635	                    continue;
  4636	                };
  4637	
  4638	                listeners.push(ProcessListener {
  4639	                    pid,
  4640	                    command: current_command.clone(),
  4641	                    port,
  4642	                });
  4643	            }
  4644	            _ => {}
  4645	        }
  4646	    }
  4647	
  4648	    listeners
  4649	}
