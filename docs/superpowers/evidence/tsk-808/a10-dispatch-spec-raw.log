   228	        DirtyState::UntrackedOnly => "blocked: untracked files".to_string(),
   229	        DirtyState::Clean if has_unmerged_commits => "blocked: unmerged commits".to_string(),
   230	        DirtyState::Clean if is_locked => "blocked: locked worktree".to_string(),
   231	        DirtyState::Clean if is_prunable => {
   232	            "review: prunable missing worktree metadata".to_string()
   233	        }
   234	        DirtyState::Clean => "requires-confirmation".to_string(),
   235	    }
   236	}
