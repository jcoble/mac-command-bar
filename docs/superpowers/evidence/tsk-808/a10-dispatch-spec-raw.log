     1	/**
     2	 * contextStore.svelte.ts — Svelte 5 runes state for the /next context cards.
     3	 *
     4	 * Holds the STATE of the five cards the context region shows — runs, runtime
     5	 * processes, agent sessions, worktrees and repository summaries — plus the
     6	 * input they are loaded for (the project list and the active project root).
     7	 *
     8	 * Two rules this module exists to enforce (same shape as
     9	 * `stores/sessionRailStore.svelte.ts`):
    10	 *
    11	 * 1. **No backend, ever.** Nothing here calls Tauri, fetches, or touches
    12	 *    localStorage. Every backend call lives in `contextService.ts` and lands
    13	 *    here as a plain mutation.
    14	 * 2. **No `$effect`.** `$effect` is illegal in a `.svelte.ts` module and against
    15	 *    the constitution. Loading is driven imperatively by the service.
    16	 *
    17	 * Each card carries a monotonic `requestId`. A loader takes a ticket from
    18	 * `beginCardLoad` and hands it back when it finishes; a result whose ticket is
    19	 * no longer the current one is dropped, so a slow first scan can never overwrite
    20	 * a fast second one (the superseded-request guard the old shell used at
    21	 * `src/routes/+page.svelte:3776-3801`).
    22	 *
    23	 * Imports are type-only on purpose: the module stays runnable on its own, which
    24	 * is what `scripts/contextStore.test.mjs` compiles and exercises.
    25	 */
    26	import type {
    27	  AgentSession,
    28	  GitRepositorySummary,
    29	  OrchestrationRun,
    30	  ProjectWorktree,
    31	  RuntimeContext,
    32	  RuntimeContextProject
    33	} from '../../tauriSource.ts';
    34	
    35	/** The five cards, by name. */
    36	export type ContextCardKey = 'runs' | 'runtime' | 'agents' | 'worktrees' | 'repositories';
    37	
    38	/** Every card key, in the order the panel renders them. */
    39	export const contextCardKeys: ContextCardKey[] = [
    40	  'runs',
    41	  'runtime',
    42	  'agents',
    43	  'worktrees',
    44	  'repositories'
    45	];
    46	
    47	/** One card's state. `rows` is whatever the backend last returned for it. */
    48	export interface ContextCard<Row> {
    49	  /** The rows to render. Replaced wholesale by each successful load. */
    50	  rows: Row[];
    51	  /** A load is in flight. */
    52	  loading: boolean;
    53	  /** Why the last load failed, in plain English. `null` when it did not. */
    54	  error: string | null;
    55	  /**
    56	   * Why there is nothing to show through no fault of anyone — for example the
    57	   * data only exists in the desktop app, or no project is selected yet.
    58	   * Non-null means "do not show an empty list, show this sentence".
    59	   */
    60	  unavailableReason: string | null;
    61	  /** Monotonic ticket of the most recent load request. */
    62	  requestId: number;
    63	  /** `Date.now()` of the last successful load, or `null`. */
    64	  loadedAt: number | null;
    65	}
    66	
    67	/** Any row any card can hold — used by the key-generic mutators below. */
    68	export type ContextRow =
    69	  | OrchestrationRun
    70	  | RuntimeContext
    71	  | AgentSession
    72	  | ProjectWorktree
    73	  | GitRepositorySummary;
    74	
    75	/**
    76	 * Whether the desktop app behind this window can do a named thing.
    77	 *
    78	 * `unknown` is the launch state — nobody has asked yet, so nothing may be
    79	 * offered on the strength of it. It is deliberately NOT the same as
    80	 * `unavailable`: a button greyed out because we have not asked yet and a button
    81	 * greyed out because this build genuinely cannot do it need different sentences.
    82	 */
    83	export type BackendSupport = 'unknown' | 'available' | 'unavailable';
    84	
    85	/** What the panel is loaded FOR: the projects to scan and the active project. */
    86	export interface ContextInput {
    87	  /** Projects handed in by the shell; the scans that take a list use this. */
    88	  projects: RuntimeContextProject[];
    89	  /** The active session's project root — worktrees are read for this one. */
    90	  activeRoot: string | null;
    91	  /** Human name of the active project, used in empty-state sentences. */
    92	  projectName?: string;
    93	}
    94	
    95	function emptyCard<Row>(): ContextCard<Row> {
    96	  return {
    97	    rows: [] as Row[],
    98	    loading: false,
    99	    error: null,
   100	    unavailableReason: null,
   101	    requestId: 0,
   102	    loadedAt: null
   103	  };
   104	}
   105	
   106	/**
   107	 * The single reactive context state. Read fields directly in components
   108	 * (`contextState.runs.rows`); mutate only through the functions below.
   109	 */
   110	export const contextState = $state<{
   111	  /** The panel has been shown at least once and its first load has started. */
   112	  activated: boolean;
   113	  projects: RuntimeContextProject[];
   114	  activeRoot: string | null;
   115	  projectName: string;
   116	  runs: ContextCard<OrchestrationRun>;
   117	  runtime: ContextCard<RuntimeContext>;
   118	  agents: ContextCard<AgentSession>;
   119	  worktrees: ContextCard<ProjectWorktree>;
   120	  repositories: ContextCard<GitRepositorySummary>;
   121	  /** Can this desktop build stop a running process? Asked once per launch. */
   122	  processKill: BackendSupport;
   123	  /** The process id currently being stopped, or `null` when none is. */
   124	  stoppingPid: number | null;
   125	  /** What the last stop did, in one sentence. `null` until one has been tried. */
   126	  lastProcessMessage: string | null;
   127	}>({
   128	  activated: false,
   129	  projects: [],
   130	  activeRoot: null,
   131	  projectName: '',
   132	  runs: emptyCard<OrchestrationRun>(),
   133	  runtime: emptyCard<RuntimeContext>(),
   134	  agents: emptyCard<AgentSession>(),
   135	  worktrees: emptyCard<ProjectWorktree>(),
   136	  repositories: emptyCard<GitRepositorySummary>(),
   137	  processKill: 'unknown',
   138	  stoppingPid: null,
   139	  lastProcessMessage: null
   140	});
   141	
   142	function cardFor(key: ContextCardKey): ContextCard<ContextRow> {
   143	  return contextState[key] as ContextCard<ContextRow>;
   144	}
   145	
   146	// ── Mutations ─────────────────────────────────────────────────────────────────
   147	
   148	/** Record that the panel has been shown and its first load has begun. */
   149	export function markContextActivated(): void {
   150	  contextState.activated = true;
   151	}
   152	
   153	/**
   154	 * Store what the cards are loaded for. Pure bookkeeping — it starts no load.
   155	 * `projectName` falls back to the last folder name of the active root so the
   156	 * empty states can still say which project they looked in.
   157	 */
   158	export function setContextInput(input: ContextInput): void {
   159	  contextState.projects = input.projects;
   160	  contextState.activeRoot = input.activeRoot;
   161	  contextState.projectName = input.projectName?.trim() || folderName(input.activeRoot);
   162	}
   163	
   164	/**
   165	 * A short, stable description of an input, so the service can tell whether the
   166	 * shell handed it something new (a different project was selected) or the same
   167	 * thing again (a repeated `activate` call, which must cost nothing).
   168	 */
   169	export function describeContextInput(input: ContextInput): string {
   170	  const projects = input.projects.map((project) => `${project.id}@${project.path}`).join(',');
   171	  return `${input.activeRoot ?? ''}|${projects}`;
   172	}
   173	
   174	/**
   175	 * Take a ticket for a new load of `key`: marks the card loading and clears the
   176	 * last error. Pass the ticket back to `applyCardRows` / `failCardLoad` /
   177	 * `markCardUnavailable` — a stale ticket is ignored.
   178	 */
   179	export function beginCardLoad(key: ContextCardKey): number {
   180	  const card = cardFor(key);
   181	  card.requestId += 1;
   182	  card.loading = true;
   183	  card.error = null;
   184	  card.unavailableReason = null;
   185	  return card.requestId;
   186	}
   187	
   188	/** `true` while `requestId` is still the newest ticket handed out for `key`. */
   189	export function isCurrentCardRequest(key: ContextCardKey, requestId: number): boolean {
   190	  return cardFor(key).requestId === requestId;
   191	}
   192	
   193	/** Land a successful load. Returns `false` when a newer load superseded it. */
   194	export function applyCardRows(
   195	  key: ContextCardKey,
   196	  requestId: number,
   197	  rows: ContextRow[]
   198	): boolean {
   199	  const card = cardFor(key);
   200	  if (card.requestId !== requestId) return false;
   201	  card.rows = rows;
   202	  card.loading = false;
   203	  card.error = null;
   204	  card.unavailableReason = null;
   205	  card.loadedAt = Date.now();
   206	  return true;
   207	}
   208	
   209	/** Land a failed load. Returns `false` when a newer load superseded it. */
   210	export function failCardLoad(key: ContextCardKey, requestId: number, message: string): boolean {
   211	  const card = cardFor(key);
   212	  if (card.requestId !== requestId) return false;
   213	  card.loading = false;
   214	  card.error = message;
   215	  return true;
   216	}
   217	
   218	/**
   219	 * Land a load that could not run at all — there is nothing wrong, the data just
   220	 * is not reachable here (desktop-app-only data, or no project selected yet).
   221	 * Returns `false` when a newer load superseded it.
   222	 */
   223	export function markCardUnavailable(
   224	  key: ContextCardKey,
   225	  requestId: number,
   226	  reason: string
   227	): boolean {
   228	  const card = cardFor(key);
   229	  if (card.requestId !== requestId) return false;
   230	  card.rows = [];
   231	  card.loading = false;
   232	  card.error = null;
   233	  card.unavailableReason = reason;
   234	  return true;
   235	}
