    56	/** List the worktrees of the repository `root` belongs to. */
    57	export function listWorktrees(root: string): Promise<ProjectWorktree[] | null> {
    58	  return listProjectWorktreesFromTauri(root);
    59	}
    60	
    61	/** Read each project's repository summary — the only source of ahead/behind. */
    62	export function listRepositorySummaries(
    63	  projects: RuntimeContextProject[]
    64	): Promise<GitRepositorySummary[] | null> {
    65	  return listGitRepositorySummariesFromTauri(projects);
    66	}
    67	
    68	/** Take a full, recoverable backup of a worktree before anything is removed. */
    69	export function archiveWorktree(
    70	  root: string,
