   235	  }
   236	  const result: OwnedSession[] = [];
   237	  for (const entry of data) {
   238	    if (typeof entry !== 'object' || entry === null) {
   239	      continue;
   240	    }
   241	    const candidate = entry as Record<string, unknown>;
   242	    if (!isNonEmptyString(candidate.ownedId) || !isNonEmptyString(candidate.cwd)) {
   243	      continue;
   244	    }
   245	    const agent = (KNOWN_AGENTS as string[]).includes(candidate.agent as string)
   246	      ? (candidate.agent as AgentKind)
   247	      : 'other';
   248	    const state = (KNOWN_STATES as string[]).includes(candidate.state as string)
   249	      ? (candidate.state as OwnedSessionState)
   250	      : 'exited';
   251	    const ptySessionId = isNonEmptyString(candidate.ptySessionId) ? candidate.ptySessionId : null;
   252	    const executionOwner = (KNOWN_EXECUTION_OWNERS as string[]).includes(
   253	      candidate.executionOwner as string
   254	    )
   255	      ? (candidate.executionOwner as AgentExecutionOwner)
