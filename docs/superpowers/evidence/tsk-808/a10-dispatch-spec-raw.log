    30	
    31	pub fn parse_lsof_listeners(output: &str) -> Vec<ProcessRecord> {
    32	    let mut by_pid: BTreeMap<u32, ProcessRecord> = BTreeMap::new();
    33	
    34	    for line in output
    35	        .lines()
    36	        .skip(1)
    37	        .filter(|line| !line.trim().is_empty())
    38	    {
    39	        let parts: Vec<&str> = line.split_whitespace().collect();
    40	        if parts.len() < 9 {
    41	            continue;
    42	        }
    43	
    44	        let Ok(pid) = parts[1].parse::<u32>() else {
    45	            continue;
    46	        };
    47	
    48	        let Some(port) = parts.iter().find_map(|part| parse_listener_port(part)) else {
    49	            continue;
    50	        };
    51	
    52	        let record = by_pid.entry(pid).or_insert_with(|| ProcessRecord {
    53	            name: parts[0].to_string(),
    54	            pid,
    55	            user: Some(parts[2].to_string()),
    56	            cwd: process_cwd(pid),
    57	            listening_ports: Vec::new(),
    58	            args: process_args(pid),
    59	        });
    60	
    61	        if !record.listening_ports.contains(&port) {
    62	            record.listening_ports.push(port);
    63	        }
    64	    }
    65	
    66	    by_pid
    67	        .into_values()
    68	        .map(|mut record| {
    69	            record.listening_ports.sort_unstable();
    70	            record
    71	        })
    72	        .collect()
    73	}
    74	
    75	fn parse_listener_port(part: &str) -> Option<u16> {
    76	    if !part.contains(':') {
    77	        return None;
    78	    }
    79	
    80	    let cleaned = part
    81	        .trim_matches('[')
    82	        .trim_matches(']')
    83	        .trim_end_matches("(LISTEN)");
    84	    let suffix = cleaned.rsplit(':').next()?;
    85	    suffix.parse::<u16>().ok()
    86	}
    87	
    88	fn process_cwd(pid: u32) -> Option<String> {
    89	    let output = Command::new("lsof")
    90	        .args(["-a", "-p", &pid.to_string(), "-d", "cwd", "-Fn"])
    91	        .output()
    92	        .ok()?;
    93	    if !output.status.success() {
    94	        return None;
    95	    }
    96	
    97	    String::from_utf8_lossy(&output.stdout)
    98	        .lines()
    99	        .find_map(|line| line.strip_prefix('n').map(ToOwned::to_owned))
   100	}
