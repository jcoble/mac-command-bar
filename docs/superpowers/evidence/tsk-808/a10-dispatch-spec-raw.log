   651	/// Read one UTF-8 source file for native C# Peek, confined to the canonical
   652	/// workspace root. This command is intentionally read-only.
   653	#[tauri::command]
   654	async fn read_native_csharp_file(root: String, path: String) -> Result<SourcePreview, String> {
   655	    tauri::async_runtime::spawn_blocking(move || {
   656	        let root = std::fs::canonicalize(root)
   657	            .map_err(|error| format!("Could not resolve C# workspace root: {error}"))?;
   658	        let path = std::fs::canonicalize(path)
   659	            .map_err(|error| format!("Could not resolve C# source path: {error}"))?;
   660	        if !path.starts_with(&root) {
   661	            return Err("C# source path is outside the workspace root".to_string());
   662	        }
   663	        read_source_file_sync(path)
   664	    })
   665	    .await
   666	    .map_err(|error| format!("Native C# source read task failed: {error}"))?
   667	}
