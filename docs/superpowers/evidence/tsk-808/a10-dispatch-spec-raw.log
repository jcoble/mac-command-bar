    16	pub fn scan_lsof_listeners() -> Vec<ProcessRecord> {
    17	    let Ok(output) = Command::new("lsof")
    18	        .args(["-nP", "-iTCP", "-sTCP:LISTEN"])
    19	        .output()
    20	    else {
    21	        return Vec::new();
    22	    };
    23	
    24	    if !output.status.success() {
