     1	/**
     2	 * processBackend.ts — the one desktop command that stops a running process, and
     3	 * the question that says whether this build of the app has it.
     4	 *
     5	 * Written the same way `worktreesBackend.ts` and `playwrightBackend.ts` are:
     6	 * `@tauri-apps/api/core` is imported only inside the call, and the answer is
     7	 * `null` when we are not running inside the desktop app. `null` means "nothing
     8	 * was invoked" — the card then says the plain truth instead of inventing an
     9	 * outcome.
    10	 *
    11	 * WHY THE APP IS ASKED WHAT IT CAN DO, RATHER THAN JUST TRYING.
    12	 * Stopping a process is not undoable, so the button must never be offered by a
    13	 * screen that cannot actually deliver it. A desktop build made before
    14	 * `kill_process` existed answers the call with an error, and an error arriving
    15	 * AFTER the user confirmed "yes, stop it" is a confirmation they should never
    16	 * have been asked for. So the app is asked outright, once:
    17	 * `read_backend_capabilities` lists what this build supports, and the stop
    18	 * button only becomes live when `processKill` is in that list. A build too old
    19	 * to even have that question answers with an error, which is caught here and
    20	 * read as "it cannot".
    21	 */
    22	import { isNativeTauriRuntime } from '../../tauriSource.ts';
    23	
    24	/** The name the desktop app uses for "this build can stop a process by id". */
    25	export const PROCESS_KILL_CAPABILITY = 'processKill';
    26	
    27	/** What the desktop app says happened, in a sentence meant to be shown as-is. */
    28	export interface ProcessKillResult {
    29	  /** Did the process actually get the signal? */
    30	  ok: boolean;
    31	  /** One plain sentence describing what happened. */
    32	  message: string;
    33	}
    34	
    35	/**
    36	 * Ask the desktop app to stop the process with this id.
    37	 *
    38	 * The desktop side refuses ids that would be dangerous (anything at or below 1,
    39	 * and the app's own process), so the honest answer for those comes back as
    40	 * `ok: false` with a sentence saying why, not as a thrown error.
    41	 *
    42	 * `expectedCommand` is the command the list showed for this id. Ids get handed
    43	 * out again after a process exits, so the app re-checks the id still belongs
    44	 * to that command before sending anything, and refuses if it moved on.
    45	 */
    46	export async function killProcess(
    47	  pid: number,
    48	  expectedCommand?: string
    49	): Promise<ProcessKillResult | null> {
    50	  if (!isNativeTauriRuntime()) return null;
    51	  const { invoke } = await import('@tauri-apps/api/core');
    52	  return invoke<ProcessKillResult>('kill_process', { pid, expectedCommand: expectedCommand ?? null });
    53	}
    54	
    55	/**
