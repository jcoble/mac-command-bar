    89	pub fn start_terminal_session<R: Runtime>(
    90	    app: tauri::AppHandle<R>,
    91	    registry: &TerminalRegistry,
    92	    request: TerminalStartRequest,
    93	) -> Result<TerminalSessionInfo, String> {
