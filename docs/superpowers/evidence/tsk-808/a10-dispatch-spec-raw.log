   169	  return language;
   170	}
   171	
   172	/**
   173	 * Does this pushed message describe the file currently on screen? Anything for
   174	 * another project or another language belongs to a different server and must
   175	 * not move this chip.
   176	 */
   177	export function statusMessageIsAboutThisFile(
   178	  message: unknown,
   179	  projectRoot: string | null,
   180	  language: string | null
