   830	/// Ensure the one native C# language-client endpoint for this canonical root.
   831	/// Both workspace warming and editor startup call this command; the registry
   832	/// coalesces them into the same bounded slot.
   833	#[tauri::command]
   834	async fn ensure_native_csharp_language_client(
   835	    registry: tauri::State<'_, lsp::SourceLspRegistry>,
   836	    root: String,
   837	) -> Result<Option<lsp::NativeCsharpEndpoint>, String> {
