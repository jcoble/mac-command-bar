  1524	impl SourceLspRegistry {
  1525	    /// Return the one authenticated native C# language-client endpoint for a
  1526	    /// canonical workspace root. The registry lock covers lookup and insertion,
  1527	    /// so concurrent frontend and Rust warm calls cannot create duplicate slots.
  1528	    pub(crate) fn ensure_native_csharp_endpoint(
  1529	        &self,
  1530	        root: &str,
  1531	    ) -> Result<NativeCsharpEndpoint, String> {
  1532	        if !csharp_language_server_enabled() {
  1533	            return Err("The C# language server is switched off in Settings.".to_string());
  1534	        }
  1535	        let root = normalized_lsp_root(root)
  1536	            .ok_or_else(|| "Project root is not a directory".to_string())?;
  1537	        let use_tick = self.next_use.fetch_add(1, Ordering::Relaxed) + 1;
  1538	
  1539	        let mut sessions = self
  1540	            .native_csharp_sessions
  1541	            .lock()
  1542	            .map_err(|_| "Native C# registry lock poisoned".to_string())?;
  1543	        if let Some(session) = sessions.get(&root) {
  1544	            session.last_used.store(use_tick, Ordering::Relaxed);
  1545	            return Ok(session.endpoint.clone());
  1546	        }
  1547	
  1548	        let server = resolve_server_for_language("csharp")
  1549	            .ok_or_else(|| "roslyn-language-server is not installed or not on PATH".to_string())?;
  1550	        let listener = std::net::TcpListener::bind(("127.0.0.1", 0))
  1551	            .map_err(|error| format!("Could not bind native C# bridge: {error}"))?;
  1552	        listener
  1553	            .set_nonblocking(true)
  1554	            .map_err(|error| format!("Could not configure native C# bridge: {error}"))?;
  1555	        let address = listener
  1556	            .local_addr()
  1557	            .map_err(|error| format!("Could not read native C# bridge address: {error}"))?;
  1558	        let token = uuid::Uuid::new_v4().simple().to_string();
  1559	        let endpoint = NativeCsharpEndpoint {
  1560	            ws_url: format!("ws://{address}/lsp?token={token}"),
  1561	            root: root.clone(),
  1562	        };
  1563	        let (shutdown_sender, shutdown_receiver) = oneshot::channel();
  1564	        let (stop_clients, _) = broadcast::channel(1);
  1565	        let state = NativeCsharpBridgeState {
  1566	            token: Arc::<str>::from(token),
  1567	            root: Arc::new(PathBuf::from(&root)),
  1568	            server,
  1569	            connected: Arc::new(AtomicBool::new(false)),
  1570	            stop_clients: stop_clients.clone(),
  1571	        };
  1572	        let listener = TcpListener::from_std(listener)
  1573	            .map_err(|error| format!("Could not start native C# bridge: {error}"))?;
  1574	        tauri::async_runtime::spawn(async move {
  1575	            let router = Router::new()
  1576	                .route("/lsp", get(upgrade_native_csharp_lsp))
  1577	                .with_state(state);
  1578	            let server = axum::serve(listener, router).with_graceful_shutdown(async move {
  1579	                let _ = shutdown_receiver.await;
  1580	            });
  1581	            if let Err(error) = server.await {
  1582	                eprintln!("[native-csharp-bridge] {error}");
  1583	            }
  1584	        });
  1585	
  1586	        let session = Arc::new(NativeCsharpSession {
  1587	            endpoint: endpoint.clone(),
  1588	            last_used: AtomicU64::new(use_tick),
  1589	            shutdown: Mutex::new(Some(shutdown_sender)),
  1590	            stop_clients,
  1591	        });
  1592	        let evicted = if sessions.len() >= MAX_LSP_WORKSPACES_PER_LANGUAGE {
  1593	            sessions
  1594	                .iter()
  1595	                .min_by_key(|(_, session)| session.last_used.load(Ordering::Relaxed))
  1596	                .map(|(root, _)| root.clone())
  1597	                .and_then(|root| sessions.remove(&root))
  1598	        } else {
  1599	            None
  1600	        };
  1601	        sessions.insert(root.clone(), session);
  1602	        drop(sessions);
  1603	        drop(evicted);
  1604	        record_language_server_state(
  1605	            "csharp",
  1606	            &root,
  1607	            LanguageServerState::Starting,
  1608	            Some("The native C# client endpoint is ready.".to_string()),
  1609	        );
  1610	        Ok(endpoint)
  1611	    }
  1612	
  1613	    pub(crate) fn mark_native_csharp_client_ready(&self, root: &str) -> Result<(), String> {
  1614	        let root = normalized_lsp_root(root)
  1615	            .ok_or_else(|| "Project root is not a directory".to_string())?;
  1616	        let sessions = self
  1617	            .native_csharp_sessions
  1618	            .lock()
  1619	            .map_err(|_| "Native C# registry lock poisoned".to_string())?;
  1620	        if !sessions.contains_key(&root) {
  1621	            return Err("The native C# language client is not running for this root.".to_string());
  1622	        }
  1623	        drop(sessions);
  1624	        record_language_server_state("csharp", &root, LanguageServerState::Ready, None);
  1625	        Ok(())
  1626	    }
