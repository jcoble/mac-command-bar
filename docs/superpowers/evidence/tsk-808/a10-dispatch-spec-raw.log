  1508	fn lsp_session_key_to_evict(
  1509	    entries: &[(SourceLspSessionKey, u64)],
  1510	    incoming: &SourceLspSessionKey,
  1511	) -> Option<SourceLspSessionKey> {
  1512	    if entries.iter().any(|(key, _)| key == incoming)
  1513	        || entries.len() < MAX_LSP_WORKSPACES_PER_LANGUAGE
  1514	    {
  1515	        return None;
  1516	    }
  1517	
  1518	    entries
  1519	        .iter()
  1520	        .min_by_key(|(_, last_used)| *last_used)
  1521	        .map(|(key, _)| key.clone())
  1522	}
