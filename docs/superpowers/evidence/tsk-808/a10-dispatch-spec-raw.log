  4481	fn playwright_process_name(args: &str) -> String {
  4482	    if args.contains("Google Chrome") {
  4483	        return "Google Chrome".to_string();
  4484	    }
  4485	    if args.contains("Chromium") {
  4486	        return "Chromium".to_string();
