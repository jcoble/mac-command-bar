    41	/** The name the desktop app uses for "this build can force-remove a worktree". */
    42	export const WORKTREE_FORCE_REMOVE_CAPABILITY = 'worktreeForceRemove';
    43	
    44	/**
    45	 * The name the desktop app uses for "this build clears ONE folder-gone row".
    46	 *
    47	 * A build without it answers a click on a folder-gone row by running git's
    48	 * repo-wide tidy-up, which clears every row whose folder is gone — not the one
    49	 * that was clicked. Both builds accept exactly the same call and both answer
    50	 * "done", so there is nothing in the outcome to tell them apart. The app is
    51	 * asked outright, and the confirmation dialog says which of the two will happen
    52	 * before anybody presses anything.
