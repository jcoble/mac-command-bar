  3996	fn git_dirty_status_fingerprint(files: &[GitFileStatus]) -> String {
  3997	    let mut rows: Vec<String> = files
  3998	        .iter()
  3999	        .map(|file| {
  4000	            [
  4001	                file.relative_path.as_str(),
  4002	                file.index_status.as_str(),
  4003	                file.worktree_status.as_str(),
  4004	                file.status.as_str(),
  4005	                file.badge.as_str(),
  4006	            ]
  4007	            .join("\x1f")
  4008	        })
  4009	        .collect();
  4010	    rows.sort();
  4011	
  4012	    let mut hash = 0xcbf2_9ce4_8422_2325u64;
  4013	    for row in rows {
  4014	        for byte in row.as_bytes().iter().copied().chain([0]) {
  4015	            hash ^= u64::from(byte);
  4016	            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
  4017	        }
  4018	    }
  4019	
  4020	    format!("{hash:016x}")
  4021	}
