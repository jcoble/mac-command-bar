   102	    historyLoadingMore: false,
   103	    historyComplete: false,
   104	    historyPaged: false,
   105	    historyCeiling: false,
   106	    selectedPath: '',
   107	    selectedDiff: null,
   108	    diffLoading: false,
   109	    diffError: '',
   110	    commitMessage: '',
   111	    actionBusy: '',
   112	    actionStatus: '',
   113	    actionError: ''
