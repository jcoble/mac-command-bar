  5256	fn localized_path_compare(left: &str, right: &str) -> std::cmp::Ordering {
  5257	    left.to_ascii_lowercase()
  5258	        .cmp(&right.to_ascii_lowercase())
  5259	        .then_with(|| left.cmp(right))
  5260	}
  5261	
  5262	fn skip_dir_reason(name: &str) -> Option<&'static str> {
  5263	    let normalized = name.to_ascii_lowercase();
  5264	    if normalized.ends_with("_files") {
  5265	        return Some("saved web page asset directory");
  5266	    }
  5267	
  5268	    match normalized.as_str() {
  5269	        ".git" | ".hg" | ".svn" => Some("version-control metadata directory"),
  5270	        ".agents" | ".claude" | ".codex" | ".dev" | ".history" | ".idea" | ".omx"
  5271	        | ".playwright" | ".playwright-cli" | ".run" | ".slots" | ".vscode" | ".zed" => {
  5272	            Some("agent/tool state directory")
  5273	        }
  5274	        "__pycache__" | ".cache" | ".build" | ".gradle" | ".next" | ".nuxt" | ".parcel-cache"
  5275	        | ".pytest_cache" | ".svelte-kit" | ".tmp" | ".turbo" | ".vite" | "bin" | "build"
  5276	        | "coverage" | "deriveddata" | "dist" | "obj" | "target" | "testresults" => {
  5277	            Some("build output/cache directory")
  5278	        }
  5279	        ".merge-backups" => Some("merge backup directory"),
  5280	        "node_modules" | "pods" | "vendor" => Some("dependency directory"),
  5281	        "worktrees" => Some("session worktree directory"),
  5282	        _ => None,
  5283	    }
  5284	}
  5285	
  5286	fn source_file_matches_query(relative_path: &str, file_name: &str, query: Option<&str>) -> bool {
  5287	    let Some(query) = query else {
  5288	        return true;
  5289	    };
  5290	    relative_path.to_lowercase().contains(query) || file_name.to_lowercase().contains(query)
  5291	}
