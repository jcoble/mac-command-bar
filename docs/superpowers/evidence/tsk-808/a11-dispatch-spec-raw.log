  4148	fn list_playwright_sessions_sync() -> Result<Vec<PlaywrightSessionInfo>, String> {
  4149	    let output = Command::new("ps")
  4150	        .args(["-axo", "pid=,pgid=,etime=,command="])
  4151	        .output()
  4152	        .map_err(|error| format!("Could not run ps: {error}"))?;
  4153	
  4154	    if !output.status.success() {
  4155	        return Err(format!(
  4156	            "Could not list processes: {}",
  4157	            String::from_utf8_lossy(&output.stderr).trim()
  4158	        ));
  4159	    }
  4160	
  4161	    Ok(group_playwright_processes(parse_playwright_processes(
  4162	        &String::from_utf8_lossy(&output.stdout),
  4163	    )))
  4164	}
