  2265	#[derive(Debug, PartialEq, Eq)]
  2266	struct ParsedSourceSymbol {
  2267	    name: String,
  2268	    kind: String,
  2269	    column: usize,
  2270	}
  2271	
  2272	fn parse_source_symbol_line(language: &str, line: &str) -> Option<ParsedSourceSymbol> {
  2273	    match language {
  2274	        "csharp" => parse_csharp_symbol_line(line),
  2275	        "typescript" | "tsx" | "javascript" | "jsx" => parse_typescript_symbol_line(line),
  2276	        _ => None,
  2277	    }
  2278	}
  2279	
  2280	fn parse_csharp_symbol_line(line: &str) -> Option<ParsedSourceSymbol> {
  2281	    let trimmed = line.trim();
  2282	    if trimmed.is_empty() || trimmed.starts_with("//") {
  2283	        return None;
  2284	    }
  2285	
  2286	    if let Some(namespace_name) = trimmed.strip_prefix("namespace ") {
  2287	        let name = trim_symbol_name(namespace_name, &[';', '{']);
  2288	        return source_symbol_from_name(line, name, "namespace");
  2289	    }
  2290	
  2291	    let tokens = source_line_tokens(trimmed);
  2292	    for (index, token) in tokens.iter().enumerate() {
  2293	        if !matches!(*token, "class" | "interface" | "record" | "enum" | "struct") {
  2294	            continue;
  2295	        }
  2296	
  2297	        let name = tokens.get(index + 1)?;
  2298	        return source_symbol_from_name(line, name, token);
  2299	    }
  2300	
  2301	    let before_params = trimmed.split_once('(')?.0.trim_end();
  2302	    let method_name = before_params.split_whitespace().last()?;
  2303	    if method_name.is_empty() || !starts_with_identifier(method_name) {
  2304	        return None;
  2305	    }
  2306	
  2307	    let first_token = tokens.first().copied().unwrap_or_default();
  2308	    if !matches!(
  2309	        first_token,
  2310	        "public"
  2311	            | "private"
  2312	            | "protected"
  2313	            | "internal"
  2314	            | "static"
  2315	            | "async"
  2316	            | "virtual"
  2317	            | "override"
  2318	    ) {
  2319	        return None;
  2320	    }
  2321	
  2322	    source_symbol_from_name(line, method_name, "method")
  2323	}
  2324	
  2325	fn parse_typescript_symbol_line(line: &str) -> Option<ParsedSourceSymbol> {
  2326	    let trimmed = line.trim();
  2327	    if trimmed.is_empty() || trimmed.starts_with("//") {
  2328	        return None;
  2329	    }
  2330	
  2331	    let tokens = source_line_tokens(trimmed);
  2332	    let mut index = 0;
  2333	    while matches!(
  2334	        tokens.get(index).copied(),
  2335	        Some("export" | "default" | "abstract" | "async" | "declare")
  2336	    ) {
  2337	        index += 1;
  2338	    }
  2339	
  2340	    match tokens.get(index).copied()? {
  2341	        "class" | "interface" | "type" | "enum" => {
  2342	            source_symbol_from_name(line, tokens.get(index + 1)?, tokens[index])
  2343	        }
  2344	        "function" => source_symbol_from_name(line, tokens.get(index + 1)?, "function"),
  2345	        "const" | "let" | "var" => {
  2346	            source_symbol_from_name(line, tokens.get(index + 1)?, "constant")
  2347	        }
  2348	        _ => None,
  2349	    }
  2350	}
  2351	
  2352	fn source_line_tokens(line: &str) -> Vec<&str> {
  2353	    line.split_whitespace()
  2354	        .map(|token| trim_symbol_name(token, &[';', '{', '(', ')', ':', ',', '=', '<']))
  2355	        .filter(|token| !token.is_empty())
  2356	        .collect()
  2357	}
  2358	
  2359	fn trim_symbol_name<'a>(value: &'a str, separators: &[char]) -> &'a str {
  2360	    value
  2361	        .trim()
  2362	        .trim_matches(|character: char| separators.contains(&character))
  2363	        .split(|character: char| separators.contains(&character))
  2364	        .next()
  2365	        .unwrap_or("")
  2366	}
  2367	
  2368	fn source_symbol_from_name(line: &str, name: &str, kind: &str) -> Option<ParsedSourceSymbol> {
  2369	    if name.is_empty() || !starts_with_identifier(name) {
  2370	        return None;
  2371	    }
  2372	
  2373	    Some(ParsedSourceSymbol {
  2374	        name: name.to_string(),
  2375	        kind: kind.to_string(),
  2376	        column: line.find(name).map(|index| index + 1).unwrap_or(1),
  2377	    })
  2378	}
  2379	
  2380	fn starts_with_identifier(value: &str) -> bool {
  2381	    value
  2382	        .chars()
  2383	        .next()
  2384	        .is_some_and(|character| character == '_' || character.is_ascii_alphabetic())
  2385	}
  2386	
  2387	fn compact_source_line_excerpt(line: &str) -> String {
  2388	    let trimmed = line.trim();
  2389	    if trimmed.chars().count() <= 180 {
  2390	        return trimmed.to_string();
  2391	    }
  2392	
  2393	    format!("{}...", trimmed.chars().take(177).collect::<String>())
  2394	}
