  5631	                pids: vec![201],
  5632	                processes: Vec::new(),
  5633	            },
  5634	        ];
  5635	        let mut signals = Vec::new();
  5636	
  5637	        let result = kill_playwright_session_with(
  5638	            sessions,
  5639	            200,
  5640	            |pid, signal| {
  5641	                signals.push((pid, signal.to_string()));
  5642	                Ok(())
  5643	            },
  5644	            || {},
  5645	            || Ok(Vec::new()),
  5646	        )
  5647	        .unwrap();
  5648	
  5649	        // Only the requested group is touched; the other session's pids are never signalled.
  5650	        assert_eq!(signals, vec![(201, "TERM".to_string())]);
