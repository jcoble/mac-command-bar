  3816	fn git_repository_paths_for_project(project: &RuntimeContextProject) -> Vec<(PathBuf, bool)> {
  3817	    let project_path = PathBuf::from(&project.path);
  3818	    let project_path_string = normalized_path_string(&project_path);
  3819	    let mut seen = HashSet::from([project_path_string]);
  3820	    let mut paths = vec![(project_path.clone(), false)];
  3821	
  3822	    if let Ok(worktrees) = list_project_worktree_paths(&project_path) {
  3823	        for worktree_path in worktrees {
  3824	            let normalized_path = normalized_path_string(&worktree_path);
  3825	            if seen.insert(normalized_path) {
  3826	                paths.push((worktree_path, true));
  3827	            }
  3828	        }
  3829	    }
  3830	
  3831	    paths
  3832	}
