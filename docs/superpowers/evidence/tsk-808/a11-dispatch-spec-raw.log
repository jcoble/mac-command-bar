   105	
   106	type WorkflowSnapshotPayload = WorkflowRunRecord | WorkflowRunRecord[];
   107	type WorkflowSnapshotListener = (snapshot: WorkflowSnapshotPayload) => void;
   108	
   109	let unlisten: UnlistenFn | null = null;
   110	const listeners = new Set<WorkflowSnapshotListener>();
   111	
   112	/**
   113	 * Listen for an optional controller push.  A6 currently returns snapshots from
   114	 * commands and does not require a push event, so browser builds and older
   115	 * controllers simply receive a no-op unsubscribe.  The subscription itself is
   116	 * kept here so components never import Tauri event APIs.
   117	 */
   118	export async function subscribeWorkflowSnapshots(
   119	  listener: WorkflowSnapshotListener
   120	): Promise<() => void> {
   121	  listeners.add(listener);
   122	  if (!isNativeTauriRuntime() || unlisten) {
   123	    return () => listeners.delete(listener);
   124	  }
   125	
   126	  try {
   127	    unlisten = await listen<WorkflowSnapshotPayload>(workflowSnapshotEvent, ({ payload }) => {
   128	      for (const current of listeners) current(payload);
   129	    });
   130	  } catch {
   131	    // An older controller has no event channel; commands remain authoritative.
   132	    unlisten = null;
   133	  }
   134	
   135	  return () => {
   136	    listeners.delete(listener);
   137	    if (listeners.size === 0) {
   138	      unlisten?.();
   139	      unlisten = null;
   140	    }
   141	  };
   142	}
   143	
   144	export function stopWorkflowSnapshotSubscription(): void {
   145	  unlisten?.();
   146	  unlisten = null;
   147	  listeners.clear();
   148	}
