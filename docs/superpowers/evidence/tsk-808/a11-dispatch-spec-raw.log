     1	/**
     2	 * gitBackendExtra.ts — the two git questions the shell could not ask before,
     3	 * plus the browser's way of asking any of them.
     4	 *
     5	 * WHAT IS NEW HERE
     6	 * The desktop app grew two commands this round:
     7	 *   - `read_git_commit_files(root, sha)` — which files one commit touched.
     8	 *   - `read_git_commit_file_diff(root, sha, relativePath)` — what changed
     9	 *     inside one of those files, in that commit.
    10	 * Everything else the source-control panel needs already had a wrapper in
    11	 * `tauriSource.ts`; this file adds only the missing two, in the same style, so
    12	 * the panel keeps one habit: a wrapper returns `null` when there is nothing to
    13	 * ask, and the caller says so plainly instead of inventing data.
    14	 *
    15	 * ⚠ THE PATH TRAP. `read_git_commit_file_diff` takes a path RELATIVE to the
    16	 * repository, while the older `read_source_git_diff` takes the whole path on
    17	 * disk. They look like the same argument and they are not. Passing the wrong
    18	 * one gets you "Git actions only accept relative repo paths" or "Source path is
    19	 * outside Git root" — so each wrapper below names its argument for what it is.
    20	 *
    21	 * WHAT ELSE IS HERE: THE BROWSER
    22	 * The Rust commands only exist inside the desktop app, so in a browser the
    23	 * whole panel could previously only say "desktop app only" — which made it
    24	 * impossible to look at while building it. The dev server now answers the same
    25	 * questions by running git itself (`src/lib/server/gitBridge.ts`), and the
    26	 * functions below try the desktop first and that bridge second. The bridge
    27	 * READS ONLY: staging, committing, fetching, pulling and pushing stay in the
    28	 * desktop app, and `bridgeGitBackend()` says exactly that if something asks.
    29	 *
    30	 * TOLERATING AN OLDER DESKTOP BUILD
    31	 * A desktop app built before the two new commands existed answers "command not
    32	 * found". That is not a failure worth a red error — it means "this build is
    33	 * older than this panel". `isMissingCommandError` spots it so the caller can
    34	 * say so in one plain sentence.
    35	 */
    36	
    37	import type { GitBackend } from './gitService.ts';
    38	import { validateProjectRootFromTauri } from '../../tauriSource.ts';
    39	import type {
    40	  GitActionResult,
    41	  GitCommitHistoryEntry,
    42	  ProjectGitStatus,
    43	  SourceGitDiff
