  5620	    fn kill_playwright_session_only_signals_the_group_that_was_asked_for() {
  5621	        let sessions = vec![
  5622	            PlaywrightSessionInfo {
  5623	                pgid: 100,
  5624	                label: "Playwright CLI server".to_string(),
  5625	                pids: vec![101, 102],
