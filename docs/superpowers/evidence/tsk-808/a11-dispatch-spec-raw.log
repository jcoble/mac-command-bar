  2951	fn format_git_path_action_message(action: &str, count: usize) -> String {
  2952	    let noun = if count == 1 { "path" } else { "paths" };
  2953	    format!("{action} {count} {noun}")
  2954	}
  2955	
  2956	fn read_source_git_diff_sync(root: PathBuf, path: PathBuf) -> Result<SourceGitDiff, String> {
  2957	    validate_git_root(&root)?;
  2958	
  2959	    let path_metadata = std::fs::metadata(&path)
  2960	        .map_err(|error| format!("Could not read source path metadata: {error}"))?;
  2961	    if !path_metadata.is_file() {
  2962	        return Err("Source path is not a file".to_string());
  2963	    }
  2964	
  2965	    let canonical_root = std::fs::canonicalize(&root)
  2966	        .map_err(|error| format!("Could not resolve Git root: {error}"))?;
  2967	    let canonical_path = std::fs::canonicalize(&path)
  2968	        .map_err(|error| format!("Could not resolve source path: {error}"))?;
  2969	    let root_string = normalized_path_string(&canonical_root);
  2970	    let path_string = normalized_path_string(&canonical_path);
  2971	    if !path_is_within(&path_string, &root_string) {
  2972	        return Err("Source path is outside Git root".to_string());
  2973	    }
  2974	
  2975	    let relative_path = canonical_path
  2976	        .strip_prefix(&canonical_root)
  2977	        .map_err(|error| format!("Could not derive source relative path: {error}"))?
  2978	        .to_string_lossy()
  2979	        .replace('\\', "/");
  2980	    let status = read_source_git_status(&canonical_root, &relative_path)?;
  2981	    let staged_diff = run_git_text(
  2982	        &canonical_root,
  2983	        &[
  2984	            "diff",
  2985	            "--no-ext-diff",
  2986	            "--cached",
  2987	            "--",
  2988	            relative_path.as_str(),
  2989	        ],
  2990	    )?;
  2991	    let working_diff = run_git_text(
  2992	        &canonical_root,
  2993	        &["diff", "--no-ext-diff", "--", relative_path.as_str()],
  2994	    )?;
  2995	    let diff = combine_source_git_diffs(&staged_diff, &working_diff);
  2996	    let is_binary = diff.contains("Binary files ") || diff.contains("GIT binary patch");
  2997	    let models = if is_binary {
  2998	        git_diff_models::GitDiffModels {
  2999	            original_content: None,
  3000	            modified_content: None,
  3001	        }
  3002	    } else {
  3003	        git_diff_models::working_tree_models(&canonical_root, &relative_path, &canonical_path)?
  3004	    };
  3005	    let status = if status.is_empty() && !diff.is_empty() {
  3006	        "modified".to_string()
  3007	    } else if status.is_empty() {
  3008	        "clean".to_string()
  3009	    } else {
  3010	        status
  3011	    };
  3012	
  3013	    Ok(SourceGitDiff {
  3014	        relative_path,
  3015	        status,
  3016	        diff,
  3017	        is_binary,
  3018	        original_content: models.original_content,
  3019	        modified_content: models.modified_content,
  3020	    })
  3021	}
  3022	
  3023	fn read_source_git_status(root: &Path, relative_path: &str) -> Result<String, String> {
  3024	    let output = run_git_text(
  3025	        root,
  3026	        &[
  3027	            "status",
  3028	            "--porcelain=v1",
  3029	            "--untracked-files=normal",
  3030	            "--",
  3031	            relative_path,
  3032	        ],
  3033	    )?;
  3034	    Ok(parse_project_git_status(&output)?
  3035	        .files
  3036	        .into_iter()
  3037	        .next()
  3038	        .map(|file| file.status)
  3039	        .unwrap_or_default())
  3040	}
  3041	
  3042	fn run_git_text(root: &Path, args: &[&str]) -> Result<String, String> {
  3043	    let root_arg = root.display().to_string();
  3044	    let output = Command::new("git")
  3045	        .arg("-C")
  3046	        .arg(root_arg)
  3047	        .args(args)
  3048	        .output()
  3049	        .map_err(|error| format!("Could not run git {}: {error}", args.join(" ")))?;
  3050	
  3051	    if !output.status.success() {
  3052	        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  3053	        return Err(if stderr.is_empty() {
  3054	            format!("git {} exited with {}", args.join(" "), output.status)
  3055	        } else {
  3056	            stderr
  3057	        });
  3058	    }
  3059	
  3060	    Ok(String::from_utf8_lossy(&output.stdout).to_string())
  3061	}
  3062	
  3063	fn combine_source_git_diffs(staged_diff: &str, working_diff: &str) -> String {
  3064	    let staged_diff = staged_diff.trim_end();
  3065	    let working_diff = working_diff.trim_end();
  3066	
  3067	    match (staged_diff.is_empty(), working_diff.is_empty()) {
  3068	        (true, true) => String::new(),
  3069	        (false, true) => staged_diff.to_string(),
  3070	        (true, false) => working_diff.to_string(),
  3071	        (false, false) => {
  3072	            format!("## Staged\n{staged_diff}\n\n## Working tree\n{working_diff}")
  3073	        }
  3074	    }
  3075	}
  3076	
  3077	fn list_project_worktrees_sync(root: PathBuf) -> Result<Vec<ProjectWorktree>, String> {
  3078	    let metadata = std::fs::metadata(&root)
  3079	        .map_err(|error| format!("Could not read worktree root metadata: {error}"))?;
  3080	    if !metadata.is_dir() {
  3081	        return Err("Worktree root is not a directory".to_string());
  3082	    }
  3083	
  3084	    let root_arg = root.display().to_string();
  3085	    let output = Command::new("git")
  3086	        .args(["-C", root_arg.as_str(), "worktree", "list", "--porcelain"])
  3087	        .output()
  3088	        .map_err(|error| format!("Could not run git worktree list: {error}"))?;
  3089	
  3090	    if !output.status.success() {
  3091	        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  3092	        return Err(if stderr.is_empty() {
  3093	            format!("git worktree list exited with {}", output.status)
  3094	        } else {
  3095	            stderr
  3096	        });
  3097	    }
  3098	
  3099	    let repo = path_last_segment(&root).unwrap_or_else(|| "repo".to_string());
  3100	    Ok(
  3101	        parse_project_worktree_porcelain(&String::from_utf8_lossy(&output.stdout))
  3102	            .into_iter()
  3103	            .map(|mut record| {
  3104	                record.repo = repo.clone();
  3105	                if !record.is_prunable {
  3106	                    record.is_dirty = project_worktree_is_dirty(&record.path);
  3107	                    record.has_unmerged_commits =
  3108	                        project_worktree_has_unmerged_commits(&record.path);
  3109	                    record.last_activity = project_worktree_last_activity(&record.path);
  3110	                }
  3111	                record.delete_eligibility = project_worktree_delete_eligibility(
  3112	                    record.is_dirty,
  3113	                    record.has_unmerged_commits,
  3114	                    record.is_prunable,
  3115	                    record.is_locked,
  3116	                );
  3117	                record
  3118	            })
  3119	            .collect(),
  3120	    )
  3121	}
