  3790	fn list_git_repository_summaries_sync(
  3791	    projects: Vec<RuntimeContextProject>,
  3792	) -> Result<Vec<GitRepositorySummary>, String> {
  3793	    let mut seen_paths = HashSet::new();
  3794	    let mut summaries = Vec::new();
  3795	
  3796	    for project in projects {
  3797	        for (path, is_worktree) in git_repository_paths_for_project(&project) {
  3798	            let normalized_path = normalized_path_string(&path);
  3799	            if !seen_paths.insert(normalized_path) {
  3800	                continue;
  3801	            }
  3802	
  3803	            summaries.push(git_repository_summary_for_path(&project, path, is_worktree));
  3804	        }
  3805	    }
  3806	
  3807	    summaries.sort_by(|left, right| {
  3808	        left.project_name
  3809	            .cmp(&right.project_name)
  3810	            .then(left.root_label.cmp(&right.root_label))
  3811	            .then(left.branch.cmp(&right.branch))
  3812	    });
  3813	    Ok(summaries)
  3814	}
