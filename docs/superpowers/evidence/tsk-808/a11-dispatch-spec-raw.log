  2726	fn read_git_commit_history_sync(
  2727	    root: PathBuf,
  2728	    limit: Option<usize>,
  2729	) -> Result<Vec<GitCommitHistoryEntry>, String> {
  2730	    validate_git_root(&root)?;
  2731	
