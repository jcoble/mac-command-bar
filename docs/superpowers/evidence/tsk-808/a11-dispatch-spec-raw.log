   131	// ── Storage ───────────────────────────────────────────────────────────────────
   132	
   133	/** Where the saved stacks live. */
   134	export const STACK_DEFINITIONS_STORAGE_KEY = 'mac-command-bar.next.stacks.definitions';
   135	
   136	/** Where "this session is that stack" lives, so the tag survives a reload. */
   137	export const STACK_RUNS_STORAGE_KEY = 'mac-command-bar.next.stacks.runs';
   138	
   139	/** What the user is told when a saved configuration could not be written down. */
