   170	export function pendingMarkupFromInput(
   171	  tab: BrowserTabState,
   172	  input: BrowserMarkupInput
   173	): BrowserPendingMarkup {
   174	  if (!input.capture || !Array.isArray(input.capture.bytes)) {
   175	    throw new Error('A bounded viewport capture is required');
   176	  }
   177	  return {
   178	    workspaceId: tab.workspaceId,
   179	    tabId: tab.id,
   180	    generation: tab.generation,
   181	    capture: {
   182	      mimeType: text(input.capture.mimeType) || 'image/png',
   183	      bytes: Object.freeze([...input.capture.bytes]),
   184	      width: Math.max(0, Math.floor(input.capture.width)),
   185	      height: Math.max(0, Math.floor(input.capture.height)),
   186	      sourceHash: text(input.capture.sourceHash) || browserSourceHash([tab.id, tab.generation, input.capture.width, input.capture.height])
   187	    },
   188	    note: text(input.note) || null,
   189	    intent: intentFor('markup', input.intent)
   190	  };
   191	}
