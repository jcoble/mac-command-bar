  3696	fn write_git_command_output(root: &Path, args: &[&str], destination: &Path) -> Result<(), String> {
  3697	    let output = Command::new("git")
  3698	        .arg("-C")
  3699	        .arg(root)
  3700	        .args(args)
  3701	        .output()
  3702	        .map_err(|error| format!("Could not run git {}: {error}", args.join(" ")))?;
  3703	
  3704	    if !output.status.success() {
  3705	        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  3706	        return Err(if stderr.is_empty() {
  3707	            format!("git {} exited with {}", args.join(" "), output.status)
  3708	        } else {
  3709	            stderr
  3710	        });
  3711	    }
  3712	
  3713	    std::fs::write(destination, output.stdout)
  3714	        .map_err(|error| format!("Could not write {}: {error}", destination.display()))
  3715	}
