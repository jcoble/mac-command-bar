  4997	fn compare_source_walk_entries(
  4998	    root: &Path,
  4999	    left: &std::fs::DirEntry,
  5000	    right: &std::fs::DirEntry,
  5001	) -> std::cmp::Ordering {
  5002	    let left_path = left.path();
  5003	    let right_path = right.path();
  5004	    let left_file_type = left.file_type().ok();
  5005	    let right_file_type = right.file_type().ok();
  5006	    let left_is_directory = left_file_type
  5007	        .as_ref()
  5008	        .map(|file_type| file_type.is_dir())
  5009	        .unwrap_or(false);
  5010	    let right_is_directory = right_file_type
  5011	        .as_ref()
  5012	        .map(|file_type| file_type.is_dir())
  5013	        .unwrap_or(false);
  5014	    let left_language = if left_file_type
  5015	        .as_ref()
  5016	        .map(|file_type| file_type.is_file())
  5017	        .unwrap_or(false)
  5018	    {
  5019	        detect_language(&left_path)
  5020	    } else {
  5021	        String::new()
  5022	    };
  5023	    let right_language = if right_file_type
  5024	        .as_ref()
  5025	        .map(|file_type| file_type.is_file())
  5026	        .unwrap_or(false)
  5027	    {
  5028	        detect_language(&right_path)
  5029	    } else {
  5030	        String::new()
  5031	    };
  5032	    let left_relative_path = normalized_relative_source_path(root, &left_path);
  5033	    let right_relative_path = normalized_relative_source_path(root, &right_path);
  5034	
  5035	    source_path_priority(&left_relative_path, &left_language, left_is_directory, root)
  5036	        .cmp(&source_path_priority(
  5037	            &right_relative_path,
  5038	            &right_language,
  5039	            right_is_directory,
  5040	            root,
  5041	        ))
  5042	        .then_with(|| localized_path_compare(&left_relative_path, &right_relative_path))
  5043	}
  5044	
  5045	fn compare_source_records(left: &SourceRecord, right: &SourceRecord) -> std::cmp::Ordering {
  5046	    source_path_priority(&left.relative_path, &left.language, false, Path::new(""))
  5047	        .cmp(&source_path_priority(
  5048	            &right.relative_path,
  5049	            &right.language,
  5050	            false,
  5051	            Path::new(""),
  5052	        ))
  5053	        .then_with(|| localized_path_compare(&left.relative_path, &right.relative_path))
  5054	}
