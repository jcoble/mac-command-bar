   130	 */
   131	export async function readGitCommitFileDiffFromTauri(
   132	  root: string,
   133	  sha: string,
   134	  relativePath: string
   135	): Promise<SourceGitDiff | null> {
   136	  if (!isTauriRuntime()) return null;
   137	  const { invoke } = await import('@tauri-apps/api/core');
   138	  return invoke<SourceGitDiff>('read_git_commit_file_diff', { root, sha, relativePath });
