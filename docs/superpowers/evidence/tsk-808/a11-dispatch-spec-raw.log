  4441	fn parse_playwright_processes(output: &str) -> Vec<PlaywrightProcessInfo> {
  4442	    output
  4443	        .lines()
  4444	        .filter_map(parse_playwright_process_line)
  4445	        .filter_map(|process| {
  4446	            playwright_process_label(&process.command, &process.args)
  4447	                .map(|label| PlaywrightProcessInfo { label, ..process })
  4448	        })
  4449	        .collect()
  4450	}
  4451	
  4452	fn parse_playwright_process_line(line: &str) -> Option<PlaywrightProcessInfo> {
  4453	    let (pid_text, rest) = next_ps_field(line)?;
  4454	    let (pgid_text, rest) = next_ps_field(rest)?;
  4455	    let (elapsed, args) = next_ps_field(rest)?;
  4456	    let pid = pid_text.parse::<u32>().ok()?;
  4457	    let pgid = pgid_text.parse::<u32>().ok()?;
  4458	    let elapsed = elapsed.to_string();
  4459	    let args = args.trim().to_string();
  4460	    let command = args.clone();
  4461	    let name = playwright_process_name(&args);
  4462	
  4463	    Some(PlaywrightProcessInfo {
  4464	        pid,
  4465	        pgid,
  4466	        command,
  4467	        name,
  4468	        label: String::new(),
  4469	        elapsed,
  4470	        args,
  4471	    })
  4472	}
  4473	
  4474	fn next_ps_field(line: &str) -> Option<(&str, &str)> {
  4475	    let trimmed = line.trim_start();
  4476	    let split_index = trimmed.find(char::is_whitespace)?;
  4477	    let (field, rest) = trimmed.split_at(split_index);
  4478	    (!field.is_empty()).then_some((field, rest.trim_start()))
  4479	}
  4480	
  4481	fn playwright_process_name(args: &str) -> String {
  4482	    if args.contains("Google Chrome") {
  4483	        return "Google Chrome".to_string();
  4484	    }
  4485	    if args.contains("Chromium") {
  4486	        return "Chromium".to_string();
  4487	    }
  4488	    if has_playwright_mcp_command(args) {
  4489	        return "playwright-mcp".to_string();
  4490	    }
  4491	    if has_playwright_cli_daemon(args) {
  4492	        return "cliDaemon.js".to_string();
  4493	    }
  4494	    if has_playwright_cli_server(args) {
  4495	        return "playwright/cli.js".to_string();
  4496	    }
  4497	
  4498	    args.split_whitespace()
  4499	        .next()
  4500	        .map(|command| {
  4501	            Path::new(command)
  4502	                .file_name()
  4503	                .and_then(|value| value.to_str())
  4504	                .unwrap_or(command)
  4505	                .to_string()
  4506	        })
  4507	        .unwrap_or_else(|| "process".to_string())
  4508	}
  4509	
  4510	fn group_playwright_processes(processes: Vec<PlaywrightProcessInfo>) -> Vec<PlaywrightSessionInfo> {
  4511	    let mut by_pgid: HashMap<u32, Vec<PlaywrightProcessInfo>> = HashMap::new();
  4512	    for process in processes {
  4513	        by_pgid.entry(process.pgid).or_default().push(process);
  4514	    }
  4515	
  4516	    let mut sessions = by_pgid
  4517	        .into_iter()
  4518	        .map(|(pgid, mut processes)| {
  4519	            processes.sort_by_key(|process| process.pid);
  4520	            let pids = processes
  4521	                .iter()
  4522	                .map(|process| process.pid)
  4523	                .collect::<Vec<_>>();
  4524	            let label = processes
  4525	                .iter()
  4526	                .find(|process| process.label != "Playwright browser")
  4527	                .or_else(|| processes.first())
  4528	                .map(|process| process.label.clone())
  4529	                .unwrap_or_else(|| "Playwright session".to_string());
  4530	            PlaywrightSessionInfo {
  4531	                pgid,
  4532	                label,
  4533	                pids,
  4534	                processes,
  4535	            }
  4536	        })
  4537	        .collect::<Vec<_>>();
  4538	
  4539	    sessions.sort_by(|left, right| left.pgid.cmp(&right.pgid));
  4540	    sessions
  4541	}
  4542	
  4543	fn playwright_process_label(command: &str, args: &str) -> Option<String> {
  4544	    let combined = format!("{command} {args}");
  4545	    if has_playwright_cli_daemon(&combined) {
  4546	        return Some("Playwright CLI daemon".to_string());
  4547	    }
  4548	    if has_playwright_cli_server(&combined) {
  4549	        return Some("Playwright CLI server".to_string());
  4550	    }
  4551	    if has_playwright_mcp_command(&combined) {
  4552	        return Some("Playwright MCP".to_string());
  4553	    }
  4554	    if looks_like_chrome_command(command, args) && has_playwright_profile_arg(&combined) {
  4555	        return Some("Playwright browser".to_string());
  4556	    }
  4557	
  4558	    None
  4559	}
  4560	
  4561	fn has_playwright_cli_daemon(command_line: &str) -> bool {
  4562	    command_line.split_whitespace().any(|arg| {
  4563	        let normalized = arg.replace('\\', "/");
  4564	        normalized.ends_with("/cliDaemon.js")
  4565	            && (normalized.contains("/node_modules/playwright-core/")
  4566	                || normalized.contains("/node_modules/playwright/")
  4567	                || normalized.contains("/node_modules/@playwright/"))
  4568	    })
  4569	}
  4570	
  4571	fn has_playwright_cli_server(command_line: &str) -> bool {
  4572	    command_line
  4573	        .split_whitespace()
  4574	        .any(|arg| path_ends_with(arg, "/node_modules/playwright/cli.js"))
  4575	        && command_line
  4576	            .split_whitespace()
  4577	            .any(|arg| arg == "run-cli-server")
  4578	}
  4579	
  4580	fn has_playwright_mcp_command(command_line: &str) -> bool {
  4581	    command_line.split_whitespace().any(|arg| {
  4582	        let name = Path::new(arg)
  4583	            .file_name()
  4584	            .and_then(|value| value.to_str())
  4585	            .unwrap_or(arg);
  4586	        matches!(name, "playwright-mcp" | "playwright-mcp.js")
  4587	    })
  4588	}
  4589	
  4590	fn has_playwright_profile_arg(command_line: &str) -> bool {
  4591	    command_line.split_whitespace().any(|arg| {
  4592	        let Some(profile_path) = arg.strip_prefix("--user-data-dir=") else {
  4593	            return false;
  4594	        };
  4595	        Path::new(profile_path)
  4596	            .file_name()
  4597	            .and_then(|value| value.to_str())
  4598	            .is_some_and(|name| name.starts_with("playwright_chromiumdev_profile-"))
  4599	    })
  4600	}
  4601	
  4602	fn path_ends_with(value: &str, suffix: &str) -> bool {
  4603	    value.replace('\\', "/").ends_with(suffix)
  4604	}
  4605	
  4606	fn looks_like_chrome_command(command: &str, args: &str) -> bool {
  4607	    let lower_command = command.to_ascii_lowercase();
  4608	    let lower_args = args.to_ascii_lowercase();
  4609	    lower_command.contains("chrome")
  4610	        || lower_command.contains("chromium")
  4611	        || lower_args.contains("google chrome")
  4612	        || lower_args.contains("chromium")
  4613	}
  4614	
  4615	fn parse_lsof_tcp_listeners(output: &str) -> Vec<ProcessListener> {
  4616	    let mut listeners = Vec::new();
  4617	    let mut current_pid: Option<u32> = None;
  4618	    let mut current_command = String::new();
  4619	
  4620	    for line in output.lines().filter(|line| !line.is_empty()) {
  4621	        let (field, value) = line.split_at(1);
  4622	        match field {
  4623	            "p" => {
  4624	                current_pid = value.parse::<u32>().ok();
  4625	                current_command.clear();
  4626	            }
  4627	            "c" => {
  4628	                current_command = value.to_string();
  4629	            }
  4630	            "n" => {
  4631	                let Some(pid) = current_pid else {
  4632	                    continue;
  4633	                };
  4634	                let Some(port) = parse_lsof_tcp_port(value) else {
  4635	                    continue;
  4636	                };
  4637	
  4638	                listeners.push(ProcessListener {
  4639	                    pid,
  4640	                    command: current_command.clone(),
  4641	                    port,
  4642	                });
  4643	            }
  4644	            _ => {}
  4645	        }
  4646	    }
  4647	
  4648	    listeners
  4649	}
