--- context service ---
     1	/**
     2	 * contextService.ts — the ONLY place the context cards talk to the backend.
     3	 *
     4	 * Five independent loaders (runs, runtime processes, agent sessions, worktrees,
     5	 * repository summaries), each imperative: nothing here runs from an `$effect`,
     6	 * nothing runs at import, and nothing polls. Loads happen exactly twice:
     7	 *
     8	 *  - the shell calls `activate(input)` when the context region is first shown
     9	 *    (and again whenever the selected project changes — only the cards that
    10	 *    depend on what changed reload);
    11	 *  - the user presses Refresh in the panel, which calls `refreshAll()` or
    12	 *    `refreshCard(key)`.
    13	 *
    14	 * `refreshAll` reaches the Playwright card too, even though that card keeps its
    15	 * own state next door in `playwrightService` — one Refresh button in the panel
    16	 * has to mean every card in the panel, or the one it skips looks freshly read
    17	 * when it is not.
    18	 *
    19	 * Every backend call is counted with `countInvoke('<command name>')`
    20	 * immediately before it, so the dev invoke counter stays honest.
    21	 *
    22	 * A `null` result from a `…FromTauri` wrapper means "not running in the desktop
    23	 * app" — nothing was invoked. Those cards say so; they never show made-up data.
    24	 */
    25	import { countInvoke } from '../devInvokeCounter.svelte.ts';
    26	import {
    27	  listAgentSessionsFromLocalBridge,
    28	  listAgentSessionsFromTauri,
    29	  listGitRepositorySummariesFromTauri,
    30	  listOrchestrationRunsFromTauri,
    31	  listProjectWorktreesFromTauri,
    32	  listRuntimeContextsFromTauri,
    33	  type AgentSession
    34	} from '../../tauriSource.ts';
    35	import {
    36	  killProcess,
    37	  PROCESS_KILL_CAPABILITY,
    38	  readBackendCapabilities
    39	} from '../processes/processBackend.ts';
    40	import { refresh as refreshPlaywrightCard } from '../processes/playwrightService.ts';
    41	import {
    42	  applyCardRows,
    43	  beginCardLoad,
    44	  beginProcessStop,
    45	  contextState,
    46	  describeContextInput,
    47	  failCardLoad,
    48	  finishProcessStop,
    49	  markCardUnavailable,
    50	  markContextActivated,
    51	  setContextInput,
    52	  setProcessKillSupport,
    53	  type ContextCardKey,
    54	  type ContextInput
    55	} from './contextStore.svelte.ts';
    56	
    57	export type { ContextInput } from './contextStore.svelte.ts';
    58	
    59	/** Shown when a card's data only exists inside the desktop app. */
    60	const DESKTOP_ONLY = 'This runs in the desktop app only.';
    61	
    62	/** What the last `activate` was given, so a repeat call costs nothing. */
    63	let loadedInputKey: string | null = null;
    64	
    65	function describeError(error: unknown): string {
    66	  return error instanceof Error ? error.message : String(error);
    67	}
    68	
    69	/**
    70	 * Show the context cards and load them.
    71	 *
    72	 * Idempotent: calling it again with the same projects and active project does
    73	 * no work at all. Calling it with a different selection reloads only the cards
    74	 * that read the part which changed — the worktree card follows the active
    75	 * project, the other four follow the project list.
    76	 */
    77	export function activate(input: ContextInput): void {
    78	  const key = describeContextInput(input);
    79	  const firstTime = !contextState.activated;
    80	  const previousRoot = contextState.activeRoot;
    81	  const previousProjects = contextState.projects
    82	    .map((project) => `${project.id}@${project.path}`)
    83	    .join(',');
    84	  const nextProjects = input.projects.map((project) => `${project.id}@${project.path}`).join(',');
    85	
    86	  setContextInput(input);
    87	  markContextActivated();
    88	  if (!firstTime && key === loadedInputKey) return;
    89	  loadedInputKey = key;
    90	
    91	  if (firstTime) {
    92	    // Deliberately NOT `refreshAll()`: the shell activates the Playwright card
    93	    // in the same breath as this one, and `refreshAll` reads it too, so calling
    94	    // it here would read that card twice on the very first show.
    95	    void loadRuns();
    96	    void loadRuntime();
    97	    void loadAgents();
    98	    void loadWorktrees();
    99	    void loadRepositories();
   100	    void askWhatTheAppCanDo();
   101	    return;
   102	  }
   103	  if (nextProjects !== previousProjects) {
   104	    void loadRuns();
   105	    void loadRuntime();
   106	    void loadAgents();
   107	    void loadRepositories();
   108	  }
   109	  if (input.activeRoot !== previousRoot) {
   110	    void loadWorktrees();
   111	  }
   112	}
   113	
   114	/**
   115	 * Reload EVERY card in the panel. The panel's Refresh button.
   116	 *
   117	 * "Every" includes the Playwright card, which keeps its own state in
   118	 * `playwrightService` and used to sit there unreloaded while the five cards
   119	 * around it went and read fresh data. A refresh button that skips a card is
   120	 * worse than no refresh button: the stale card looks as freshly read as its
   121	 * neighbours.
   122	 *
   123	 * The same pass is also where the panel finds out whether this build of the
   124	 * desktop app can stop a process, so the stop buttons can never be left greyed
   125	 * out by a question nobody got round to asking.
   126	 */
   127	export async function refreshAll(): Promise<void> {
   128	  await Promise.all([
   129	    loadRuns(),
   130	    loadRuntime(),
   131	    loadAgents(),
   132	    loadWorktrees(),
   133	    loadRepositories(),
   134	    refreshPlaywrightCard(),
   135	    askWhatTheAppCanDo()
   136	  ]);
   137	}
   138	
   139	/** Reload one card. */
   140	export async function refreshCard(key: ContextCardKey): Promise<void> {
   141	  if (key === 'runs') return loadRuns();
   142	  if (key === 'runtime') return loadRuntime();
   143	  if (key === 'agents') return loadAgents();
   144	  if (key === 'worktrees') return loadWorktrees();
   145	  return loadRepositories();
   146	}
   147	
   148	/** Forget which input was last loaded — used when the shell tears the panel down. */
   149	export function resetContextActivation(): void {
   150	  loadedInputKey = null;
   151	}
   152	
   153	// ── Stopping one running process ──────────────────────────────────────────────
   154	
   155	/**
   156	 * Ask the desktop app whether it can stop a process by id.
   157	 *
   158	 * Asked rather than tried: see the long note in `processBackend.ts`. Asking
   159	 * again is cheap and keeps the answer right after the user updates and restarts
   160	 * the app, so this runs on every full refresh rather than once per launch.
   161	 */
   162	export async function askWhatTheAppCanDo(): Promise<void> {
   163	  countInvoke('read_backend_capabilities');
   164	  const capabilities = await readBackendCapabilities();
   165	  if (capabilities === null) {
   166	    // Not the desktop app at all; nothing here can stop anything.
   167	    setProcessKillSupport('unavailable');
   168	    return;
   169	  }
   170	  setProcessKillSupport(
   171	    capabilities.includes(PROCESS_KILL_CAPABILITY) ? 'available' : 'unavailable'
   172	  );
   173	}
   174	
   175	/**
   176	 * Stop the process with this id, then read the running processes again.
   177	 *
   178	 * The list is re-read rather than edited in place, because the desktop app's
   179	 * answer says what it ASKED the process to do, not whether the process has
   180	 * actually gone. Reading again is the only honest way to show what survived.
   181	 *
   182	 * Refuses outright when the app has not said it can do this, so a wired-up
   183	 * keyboard shortcut or a stale screen can never send a request that would be
   184	 * silently ignored.
   185	 */
   186	export async function stopProcess(pid: number, expectedCommand?: string): Promise<void> {
   187	  if (contextState.processKill !== 'available') return;
   188	  beginProcessStop(pid);
   189	  try {
   190	    countInvoke('kill_process');
   191	    const result = await killProcess(pid, expectedCommand);
   192	    if (result === null) {
   193	      finishProcessStop(DESKTOP_ONLY);
   194	      return;
   195	    }
   196	    finishProcessStop(result.message);
   197	  } catch (error) {
   198	    finishProcessStop(`Process ${pid} was not stopped: ${describeError(error)}`);
   199	  }
   200	  await loadRuntime();
   201	}
   202	
   203	// ── The five loaders ──────────────────────────────────────────────────────────
   204	
   205	async function loadRuns(): Promise<void> {
   206	  const ticket = beginCardLoad('runs');
   207	  const projects = snapshotProjects();
   208	  try {
   209	    countInvoke('list_orchestration_runs');
   210	    const runs = await listOrchestrationRunsFromTauri(projects);
   211	    if (runs === null) {
   212	      markCardUnavailable('runs', ticket, DESKTOP_ONLY);
   213	      return;
   214	    }
   215	    applyCardRows('runs', ticket, runs);
   216	  } catch (error) {
   217	    failCardLoad('runs', ticket, `Could not read runs: ${describeError(error)}`);
   218	  }
   219	}
   220	
   221	async function loadRuntime(): Promise<void> {
   222	  const ticket = beginCardLoad('runtime');
   223	  const projects = snapshotProjects();
   224	  try {
   225	    countInvoke('list_runtime_contexts');
   226	    const contexts = await listRuntimeContextsFromTauri(projects);
   227	    if (contexts === null) {
   228	      markCardUnavailable('runtime', ticket, DESKTOP_ONLY);
   229	      return;
   230	    }
   231	    applyCardRows('runtime', ticket, contexts);
   232	  } catch (error) {
   233	    failCardLoad('runtime', ticket, `Could not read running processes: ${describeError(error)}`);
   234	  }
   235	}
   236	
   237	/**
   238	 * Agent sessions have two transports: the desktop app first, the local dev
   239	 * bridge second. The counted name says which one actually ran — the same rule
   240	 * the session rail's scan uses, so the counter never claims a Tauri command was
   241	 * invoked when the browser bridge answered.
   242	 */
   243	async function loadAgents(): Promise<void> {
   244	  const ticket = beginCardLoad('agents');
   245	  let nativeError: string | null = null;
   246	  try {
   247	    let sessions: AgentSession[] | null = null;
   248	    try {
   249	      sessions = await listAgentSessionsFromTauri();
   250	    } catch (error) {
   251	      nativeError = describeError(error);
   252	    }
   253	    // A `null` native result with no error = not in the desktop app: nothing invoked.
   254	    countInvoke((sessions ?? nativeError) ? 'list_agent_sessions' : 'bridge:agent-sessions');
   255	    sessions ??= await listAgentSessionsFromLocalBridge();
   256	    if (sessions === null) {
   257	      if (nativeError) {
   258	        failCardLoad('agents', ticket, `Could not read agent sessions: ${nativeError}`);
   259	        return;
   260	      }
   261	      markCardUnavailable('agents', ticket, DESKTOP_ONLY);
   262	      return;
   263	    }
   264	    applyCardRows('agents', ticket, sessions);
   265	  } catch (error) {
   266	    failCardLoad(
   267	      'agents',
   268	      ticket,
   269	      `Could not read agent sessions: ${nativeError ?? describeError(error)}`
   270	    );
   271	  }
   272	}
   273	
   274	async function loadWorktrees(): Promise<void> {
   275	  const ticket = beginCardLoad('worktrees');
   276	  const root = contextState.activeRoot;
   277	  if (!root) {
   278	    markCardUnavailable('worktrees', ticket, 'Pick a session to see its worktrees.');
   279	    return;
   280	  }
   281	  try {
   282	    countInvoke('list_project_worktrees');
   283	    const worktrees = await listProjectWorktreesFromTauri(root);
   284	    if (worktrees === null) {
   285	      markCardUnavailable('worktrees', ticket, DESKTOP_ONLY);
   286	      return;
   287	    }
   288	    applyCardRows('worktrees', ticket, worktrees);
   289	  } catch (error) {
   290	    failCardLoad('worktrees', ticket, `Could not read worktrees: ${describeError(error)}`);
   291	  }
   292	}
   293	
   294	async function loadRepositories(): Promise<void> {
   295	  const ticket = beginCardLoad('repositories');
   296	  const projects = snapshotProjects();
   297	  try {
   298	    countInvoke('list_git_repository_summaries');
   299	    const repos = await listGitRepositorySummariesFromTauri(projects);
   300	    if (repos === null) {
   301	      markCardUnavailable('repositories', ticket, DESKTOP_ONLY);
   302	      return;
   303	    }
   304	    applyCardRows('repositories', ticket, repos);
   305	  } catch (error) {
   306	    failCardLoad('repositories', ticket, `Could not read repositories: ${describeError(error)}`);
   307	  }
   308	}
   309	
   310	/**
   311	 * Plain copies of the project rows for the backend call. A runes proxy cannot
   312	 * cross the Tauri boundary, so the array is flattened before it is sent.
   313	 */
   314	function snapshotProjects(): { id: string; name: string; path: string }[] {
   315	  return contextState.projects.map((project) => ({
   316	    id: project.id,
   317	    name: project.name,
   318	    path: project.path
   319	  }));
   320	}

