  2497	fn terminal_path_action_command(
  2498	    path: &Path,
  2499	    terminal: Option<String>,
  2500	) -> Result<SourceFileActionCommand, String> {
  2501	    let metadata = std::fs::metadata(path)
  2502	        .map_err(|error| format!("Could not read terminal path metadata: {error}"))?;
  2503	    if !metadata.is_dir() {
  2504	        return Err("Terminal path is not a directory".to_string());
  2505	    }
  2506	
  2507	    let terminal_app = normalize_terminal_app(terminal.as_deref())?;
  2508	    if terminal_app == "Warp" {
  2509	        return Ok(SourceFileActionCommand {
  2510	            program: "open".to_string(),
  2511	            args: vec![format!(
  2512	                "warp://action/new_tab?path={}",
  2513	                uri_query_encode(&path.display().to_string())
  2514	            )],
  2515	        });
  2516	    }
  2517	
  2518	    Ok(SourceFileActionCommand {
  2519	        program: "open".to_string(),
  2520	        args: vec!["-a".to_string(), terminal_app, path.display().to_string()],
  2521	    })
  2522	}
  2523	
  2524	fn terminal_command_action_command(
  2525	    path: &Path,
  2526	    command: &str,
  2527	    terminal: Option<String>,
  2528	) -> Result<SourceFileActionCommand, String> {
  2529	    let metadata = std::fs::metadata(path)
  2530	        .map_err(|error| format!("Could not read terminal path metadata: {error}"))?;
  2531	    if !metadata.is_dir() {
  2532	        return Err("Terminal path is not a directory".to_string());
  2533	    }
  2534	
  2535	    let command = normalize_terminal_command(command)?;
  2536	    let terminal_app = normalize_terminal_app(terminal.as_deref())?;
  2537	    let shell_command = format!(
  2538	        "cd {} && {}",
  2539	        shell_quote(&path.display().to_string()),
  2540	        command
  2541	    );
  2542	    let escaped_shell_command = applescript_string_escape(&shell_command);
  2543	    let script = match terminal_app.as_str() {
  2544	        "Terminal" => format!(
  2545	            "tell application \"Terminal\"\nactivate\ndo script \"{}\"\nend tell",
  2546	            escaped_shell_command
  2547	        ),
  2548	        "iTerm" | "iTerm2" => format!(
  2549	            "tell application \"{}\"\nactivate\ncreate window with default profile\ntell current session of current window\nwrite text \"{}\"\nend tell\nend tell",
  2550	            terminal_app,
  2551	            escaped_shell_command
  2552	        ),
  2553	        _ => {
  2554	            return Err(format!(
  2555	                "Terminal command execution is not supported for {terminal_app}"
  2556	            ))
  2557	        }
  2558	    };
  2559	
  2560	    Ok(SourceFileActionCommand {
  2561	        program: "osascript".to_string(),
  2562	        args: vec!["-e".to_string(), script],
  2563	    })
  2564	}
  2565	
  2566	fn normalize_terminal_app(terminal: Option<&str>) -> Result<String, String> {
  2567	    let requested = terminal
  2568	        .map(str::trim)
  2569	        .filter(|value| !value.is_empty())
  2570	        .unwrap_or("Terminal");
  2571	    let allowlisted = [
  2572	        ("terminal", "Terminal"),
  2573	        ("terminal.app", "Terminal"),
  2574	        ("warp", "Warp"),
  2575	        ("warp.app", "Warp"),
  2576	        ("iterm", "iTerm"),
  2577	        ("iterm.app", "iTerm"),
  2578	        ("iterm2", "iTerm2"),
  2579	        ("iterm2.app", "iTerm2"),
  2580	        ("wezterm", "WezTerm"),
  2581	        ("wezterm.app", "WezTerm"),
  2582	        ("ghostty", "Ghostty"),
  2583	        ("ghostty.app", "Ghostty"),
  2584	        ("alacritty", "Alacritty"),
  2585	        ("alacritty.app", "Alacritty"),
  2586	    ];
  2587	
  2588	    allowlisted
  2589	        .iter()
  2590	        .find(|(alias, _)| alias.eq_ignore_ascii_case(requested))
  2591	        .map(|(_, app)| (*app).to_string())
  2592	        .ok_or_else(|| format!("Unsupported terminal app: {requested}"))
  2593	}
  2594	
  2595	fn normalize_terminal_command(command: &str) -> Result<String, String> {
  2596	    let command = command.trim();
  2597	    if command.is_empty() {
  2598	        return Err("Terminal command is empty".to_string());
  2599	    }
  2600	    if command.contains('\0') || command.contains('\n') || command.contains('\r') {
  2601	        return Err("Terminal command must be a single line".to_string());
  2602	    }
  2603	
  2604	    Ok(command.to_string())
  2605	}
  2606	
  2607	fn shell_quote(value: &str) -> String {
  2608	    if value.is_empty() {
  2609	        return "''".to_string();
  2610	    }
  2611	    format!("'{}'", value.replace('\'', "'\\''"))
  2612	}
  2613	
  2614	fn uri_query_encode(value: &str) -> String {
  2615	    let mut encoded = String::new();
  2616	    for byte in value.bytes() {
  2617	        match byte {
  2618	            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' | b'/' => {
  2619	                encoded.push(byte as char)
  2620	            }
  2621	            _ => encoded.push_str(&format!("%{byte:02X}")),
  2622	        }
  2623	    }
  2624	    encoded
  2625	}
  2626	
  2627	fn applescript_string_escape(value: &str) -> String {
  2628	    value.replace('\\', "\\\\").replace('"', "\\\"")
  2629	}
