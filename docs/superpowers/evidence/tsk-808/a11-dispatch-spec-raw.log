   654	pub(crate) struct WorktreeLeaseRequest {
   655	    pub run_id: String,
   656	    pub node_run_id: String,
   657	    pub workspace: WorkflowWorkspacePolicy,
   658	    pub cwd: String,
   659	    pub file_paths: Vec<String>,
   660	}
   661	
   662	#[derive(Debug, Clone)]
   663	pub(crate) struct WorktreeLeaseReceipt {
   664	    pub lease_id: String,
   665	    pub cwd: String,
   666	}
   667	
   668	pub(crate) trait WorktreeLeasePort: Send + Sync {
   669	    fn acquire(&self, request: WorktreeLeaseRequest)
   670	        -> Result<WorktreeLeaseReceipt, WorkflowError>;
   671	    fn release(&self, lease_id: &str) -> Result<(), WorkflowError>;
   672	    fn rebuild(&self, active: Vec<WorktreeLeaseRequest>) -> Result<(), WorkflowError>;
   673	}
   674	
   675	#[derive(Default)]
   676	pub(crate) struct InMemoryWorktreeLeasePort {
   677	    leases: Mutex<HashMap<String, WorktreeLeaseRequest>>,
   678	}
   679	
   680	impl WorktreeLeasePort for InMemoryWorktreeLeasePort {
   681	    fn acquire(
   682	        &self,
   683	        request: WorktreeLeaseRequest,
   684	    ) -> Result<WorktreeLeaseReceipt, WorkflowError> {
   685	        let mut leases = self
   686	            .leases
   687	            .lock()
   688	            .map_err(|_| WorkflowError::LeaseConflict("Lease authority unavailable".into()))?;
   689	        if matches!(
   690	            request.workspace,
   691	            WorkflowWorkspacePolicy::DedicatedNew { .. }
   692	        ) {
   693	            return Err(WorkflowError::PolicyDenied("Dedicated-new must be allocated by the existing worktree authority before dispatch".into()));
   694	        }
   695	        let writes = !matches!(
   696	            request.workspace,
   697	            WorkflowWorkspacePolicy::ReadOnlyCurrent | WorkflowWorkspacePolicy::None
   698	        );
   699	        if writes
   700	            && leases.values().any(|held| {
   701	                held.cwd == request.cwd && paths_overlap(&held.file_paths, &request.file_paths)
   702	            })
   703	        {
   704	            return Err(WorkflowError::LeaseConflict(format!(
   705	                "Overlapping file lease in {}",
   706	                request.cwd
   707	            )));
   708	        }
   709	        let lease_id = format!(
   710	            "lease-{}",
   711	            stable_hash(&format!(
   712	                "{}:{}:{}",
   713	                request.run_id, request.node_run_id, request.cwd
   714	            ))
   715	        );
   716	        leases.entry(lease_id.clone()).or_insert(request.clone());
   717	        Ok(WorktreeLeaseReceipt {
   718	            lease_id,
   719	            cwd: request.cwd,
   720	        })
   721	    }
   722	
   723	    fn release(&self, lease_id: &str) -> Result<(), WorkflowError> {
   724	        self.leases
   725	            .lock()
   726	            .map_err(|_| WorkflowError::LeaseConflict("Lease authority unavailable".into()))?
   727	            .remove(lease_id);
   728	        Ok(())
   729	    }
   730	
   731	    fn rebuild(&self, active: Vec<WorktreeLeaseRequest>) -> Result<(), WorkflowError> {
   732	        let mut leases = self
   733	            .leases
   734	            .lock()
   735	            .map_err(|_| WorkflowError::LeaseConflict("Lease authority unavailable".into()))?;
   736	        for request in active {
   737	            let writes = !matches!(
   738	                request.workspace,
   739	                WorkflowWorkspacePolicy::ReadOnlyCurrent | WorkflowWorkspacePolicy::None
   740	            );
   741	            let lease_id = format!(
   742	                "lease-{}",
   743	                stable_hash(&format!(
   744	                    "{}:{}:{}",
   745	                    request.run_id, request.node_run_id, request.cwd
   746	                ))
   747	            );
   748	            if leases.contains_key(&lease_id) {
   749	                continue;
   750	            }
   751	            if writes
   752	                && leases.values().any(|held| {
   753	                    held.cwd == request.cwd && paths_overlap(&held.file_paths, &request.file_paths)
   754	                })
   755	            {
   756	                return Err(WorkflowError::LeaseConflict(format!(
   757	                    "Persisted overlapping file lease in {}",
   758	                    request.cwd
   759	                )));
   760	            }
   761	            leases.insert(lease_id, request);
   762	        }
   763	        Ok(())
   764	    }
   765	}
   766	
   767	fn paths_overlap(left: &[String], right: &[String]) -> bool {
   768	    left.is_empty()
   769	        || right.is_empty()
   770	        || left.iter().any(|a| {
   771	            right.iter().any(|b| {
   772	                a == b || a.starts_with(&format!("{b}/")) || b.starts_with(&format!("{a}/"))
   773	            })
   774	        })
   775	}
