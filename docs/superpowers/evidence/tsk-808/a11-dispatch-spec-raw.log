    48	  relativePath: string;
    49	  status: string;
    50	  badge: string;
    51	}
    52	
    53	/** Said whenever a write is attempted anywhere but the desktop app. */
    54	export const READ_ONLY_IN_BROWSER_MESSAGE =
    55	  'Changing the repository runs in the desktop app only. This page can read it, not commit to it.';
    56	
    57	/** Said when the desktop app is older than this panel. */
    58	export const MISSING_COMMAND_MESSAGE =
    59	  'This desktop app was built before per-commit file lists existed. Restart it after the next update.';
    60	
    61	function isTauriRuntime(): boolean {
    62	  return typeof window !== 'undefined' && '__TAURI_INTERNALS__' in window;
    63	}
    64	
    65	/** True while the page can also reach the dev server's read-only git bridge. */
    66	export function hasGitBridge(): boolean {
    67	  return typeof window !== 'undefined' && typeof fetch === 'function';
    68	}
    69	
    70	/** Where this page's git answers come from, in words fit for the screen. */
    71	export function gitDataSourceLabel(): string {
    72	  if (isTauriRuntime()) return 'desktop app';
    73	  if (hasGitBridge()) return 'dev server (reads only)';
    74	  return 'nowhere';
