  3661	fn project_worktree_archive_root(path: &Path) -> PathBuf {
  3662	    let normalized_path = normalized_path_string(path);
  3663	    let marker = "/worktrees/";
  3664	    if let Some(index) = normalized_path.find(marker) {
  3665	        return PathBuf::from(format!("{}/worktree-archives", &normalized_path[..index]));
  3666	    }
  3667	
  3668	    path.parent()
  3669	        .map(|parent| parent.join("worktree-archives"))
