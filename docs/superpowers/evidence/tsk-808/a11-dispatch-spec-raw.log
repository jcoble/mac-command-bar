  3852	fn git_repository_summary_for_path_result(
  3853	    project: &RuntimeContextProject,
  3854	    path: &Path,
  3855	    is_worktree: bool,
  3856	) -> Result<GitRepositorySummary, String> {
  3857	    let metadata = std::fs::metadata(path)
  3858	        .map_err(|error| format!("Could not read repository metadata: {error}"))?;
  3859	    if !metadata.is_dir() {
  3860	        return Err("Repository path is not a directory".to_string());
  3861	    }
  3862	
  3863	    let status = project_git_status_sync(path.to_path_buf())?;
  3864	    let counts = git_repository_status_counts(&status.files);
  3865	    let (last_commit_sha, last_commit_subject, last_commit_at) = git_last_commit(path);
  3866	    let branch = status.branch.unwrap_or_else(|| "unknown".to_string());
  3867	    let task_id = branch_task_id(&branch)
  3868	        .or_else(|| last_commit_subject.as_deref().and_then(task_id_from_text));
  3869	    let dirty_count = counts.staged_count + counts.unstaged_count + counts.untracked_count;
  3870	
  3871	    Ok(GitRepositorySummary {
  3872	        project_id: project.id.clone(),
  3873	        project_name: project.name.clone(),
  3874	        repo: path_last_segment(Path::new(&project.path)).unwrap_or_else(|| project.name.clone()),
  3875	        path: path.display().to_string(),
  3876	        root_label: runtime_context_root_label(path),
  3877	        branch: branch.clone(),
  3878	        task_id,
  3879	        is_worktree,
  3880	        is_dirty: dirty_count > 0,
  3881	        staged_count: counts.staged_count,
  3882	        unstaged_count: counts.unstaged_count,
  3883	        untracked_count: counts.untracked_count,
  3884	        dirty_count,
  3885	        ahead: status.ahead,
  3886	        behind: status.behind,
  3887	        has_upstream: status.has_upstream,
  3888	        last_commit_sha,
  3889	        last_commit_subject,
  3890	        last_commit_at,
  3891	        dirty_since_epoch_ms: git_dirty_since_epoch_ms(path, &status.files),
  3892	        dirty_status_fingerprint: git_dirty_status_fingerprint(&status.files),
  3893	        error: None,
  3894	    })
  3895	}
