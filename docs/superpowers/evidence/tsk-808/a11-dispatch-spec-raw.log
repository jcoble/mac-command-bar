  2136	fn find_source_reference_column(line: &str, normalized_symbol_name: &str) -> Option<usize> {
  2137	    let normalized_line = line.to_lowercase();
  2138	    let mut search_start = 0;
  2139	
  2140	    while search_start < normalized_line.len() {
  2141	        let relative_index = normalized_line[search_start..].find(normalized_symbol_name)?;
  2142	        let index = search_start + relative_index;
  2143	        let end_index = index + normalized_symbol_name.len();
  2144	        if is_source_token_boundary(line, index, end_index) {
  2145	            return Some(index);
  2146	        }
  2147	        search_start = end_index;
  2148	    }
  2149	
  2150	    None
  2151	}
