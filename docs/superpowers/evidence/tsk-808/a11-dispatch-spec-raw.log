   134	/** Restore attachment metadata supplied by the existing owner-scoped vault. */
   135	export async function restoreConversationAttachments(
   136	  ownedId: string,
   137	  saved: readonly (Omit<ConversationAttachment, 'previewUrl'> & { previewUrl?: string })[] = []
   138	): Promise<ConversationAttachment[]> {
   139	  if (saved.length > 0) {
   140	    const restored = saved.map(restoreConversationAttachmentPreview);
   141	    setConversationAttachments(ownedId, restored);
   142	    return restored;
   143	  }
   144	  if (!isTauri()) return [];
   145	  try {
   146	    const records = await invoke<(Omit<ConversationAttachment, 'previewUrl'> & { previewUrl?: string })[]>(
   147	      'read_agent_conversation_attachments',
   148	      { ownedId }
   149	    );
   150	    const restored = Array.isArray(records) ? records.map(restoreConversationAttachmentPreview) : [];
   151	    setConversationAttachments(ownedId, restored);
   152	    return restored;
   153	  } catch {
   154	    // Older controller builds have no listing command. The draft and saved ids
   155	    // remain intact so a later controller can hydrate them without data loss.
   156	    return [];
   157	  }
   158	}
