  2765	fn read_git_commit_file_diff_sync(
  2766	    root: PathBuf,
  2767	    sha: String,
  2768	    relative_path: String,
  2769	) -> Result<SourceGitDiff, String> {
  2770	    validate_git_root(&root)?;
  2771	    let relative_path = validate_git_relative_paths(&[relative_path])?
  2772	        .into_iter()
  2773	        .next()
  2774	        .expect("one validated path");
  2775	    let sha = validate_git_commit_id(&sha)?;
  2776	
  2777	    let name_status = run_git_text(
  2778	        &root,
  2779	        &[
  2780	            "show",
  2781	            "--name-status",
  2782	            "--format=",
  2783	            sha.as_str(),
  2784	            "--",
  2785	            relative_path.as_str(),
  2786	        ],
  2787	    )?;
  2788	    let status = parse_git_commit_file_changes(&name_status)
  2789	        .into_iter()
  2790	        .next()
  2791	        .map(|change| change.status)
  2792	        .unwrap_or_default();
  2793	
  2794	    // `--format=` drops the commit header, so what comes back is only the patch —
  2795	    // the same text shape the working-copy diff returns, readable by the same parser.
  2796	    let diff = run_git_text(
  2797	        &root,
  2798	        &[
  2799	            "show",
  2800	            "--no-ext-diff",
  2801	            "--format=",
  2802	            sha.as_str(),
  2803	            "--",
  2804	            relative_path.as_str(),
  2805	        ],
  2806	    )?;
  2807	    let is_binary = diff.contains("Binary files ") || diff.contains("GIT binary patch");
  2808	    let models = if is_binary {
  2809	        git_diff_models::GitDiffModels {
  2810	            original_content: None,
  2811	            modified_content: None,
  2812	        }
  2813	    } else {
  2814	        git_diff_models::commit_models(&root, &sha, &relative_path)?
  2815	    };
  2816	    let status = if status.is_empty() && !diff.is_empty() {
  2817	        "modified".to_string()
  2818	    } else if status.is_empty() {
  2819	        "clean".to_string()
  2820	    } else {
  2821	        status
  2822	    };
  2823	
  2824	    Ok(SourceGitDiff {
  2825	        relative_path,
  2826	        status,
  2827	        diff,
  2828	        is_binary,
  2829	        original_content: models.original_content,
  2830	        modified_content: models.modified_content,
  2831	    })
  2832	}
  2833	
  2834	/// `git show --name-status --format=` prints one tab-separated line per file:
  2835	/// a status letter (renames and copies add a similarity number, and a second path)
  2836	/// then the path. A merge commit prints nothing here, which reads as an empty list.
  2837	fn parse_git_commit_file_changes(output: &str) -> Vec<GitCommitFileChange> {
  2838	    output
  2839	        .lines()
  2840	        .filter(|line| !line.trim().is_empty())
  2841	        .filter_map(|line| {
  2842	            let mut fields = line.split('\t');
  2843	            let status_field = fields.next()?.trim();
  2844	            let status_code = status_field.chars().next()?;
  2845	            // For a rename or a copy git prints the old path then the new one; the
  2846	            // file lives at the last path, so that is the one we report.
  2847	            let relative_path = fields.last().map(str::trim).unwrap_or_default();
  2848	            if relative_path.is_empty() {
  2849	                return None;
  2850	            }
  2851	
  2852	            Some(GitCommitFileChange {
  2853	                relative_path: normalize_git_status_path(relative_path),
  2854	                status: git_status_name(status_code).to_string(),
  2855	                badge: git_status_badge(status_code, ' ').to_string(),
  2856	            })
  2857	        })
  2858	        .collect()
  2859	}
  2860	
  2861	/// Commit ids reach git as a bare argument, so anything that could be read as an
  2862	/// option (or as a shell-ish path) is refused instead of forwarded.
  2863	fn validate_git_commit_id(sha: &str) -> Result<String, String> {
  2864	    let trimmed = sha.trim();
  2865	    let is_safe = !trimmed.is_empty()
  2866	        && !trimmed.starts_with('-')
  2867	        && trimmed.len() <= 200
  2868	        && trimmed.chars().all(|character| {
  2869	            character.is_ascii_alphanumeric()
  2870	                || matches!(character, '_' | '-' | '.' | '/' | '^' | '~')
  2871	        });
  2872	
  2873	    if is_safe {
  2874	        Ok(trimmed.to_string())
  2875	    } else {
  2876	        Err("Git commit id must be a plain commit id or ref name".to_string())
  2877	    }
  2878	}
  2879	
  2880	fn validate_git_root(root: &Path) -> Result<(), String> {
  2881	    let metadata = std::fs::metadata(root)
  2882	        .map_err(|error| format!("Could not read Git root metadata: {error}"))?;
  2883	    if metadata.is_dir() {
  2884	        Ok(())
  2885	    } else {
  2886	        Err("Git root is not a directory".to_string())
  2887	    }
  2888	}
  2889	
  2890	fn validate_git_relative_paths(paths: &[String]) -> Result<Vec<String>, String> {
  2891	    if paths.is_empty() {
  2892	        return Err("At least one relative repo path is required".to_string());
  2893	    }
  2894	
  2895	    let mut validated_paths = Vec::with_capacity(paths.len());
  2896	    for path in paths {
  2897	        let trimmed = path.trim();
  2898	        let relative_path = Path::new(trimmed);
  2899	        let is_safe_relative_path = !trimmed.is_empty()
  2900	            && !trimmed.contains('\0')
  2901	            && !relative_path.is_absolute()
  2902	            && relative_path
  2903	                .components()
  2904	                .all(|component| matches!(component, std::path::Component::Normal(_)));
  2905	
  2906	        if !is_safe_relative_path {
  2907	            return Err("Git actions only accept relative repo paths".to_string());
  2908	        }
  2909	
  2910	        validated_paths.push(trimmed.to_string());
  2911	    }
  2912	
  2913	    Ok(validated_paths)
  2914	}
  2915	
  2916	fn run_git_with_paths(root: &Path, args: &[&str], paths: &[String]) -> Result<String, String> {
  2917	    let mut git_args = args.to_vec();
  2918	    git_args.push("--");
  2919	    for path in paths {
  2920	        git_args.push(path.as_str());
  2921	    }
  2922	
  2923	    run_git_text(root, &git_args)
  2924	}
