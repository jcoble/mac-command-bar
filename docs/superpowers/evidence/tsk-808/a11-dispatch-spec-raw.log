   104	function modelContext(): BrowserModelContext {
   105	  return { workspace: browser.workspace, backend: browser.backend };
   106	}
   107	
   108	function syncLegacy(nextUrl?: string, bumpFrame = false): void {
   109	  const active = browser.workspace.activeTabId
   110	    ? browser.workspace.tabs[browser.workspace.activeTabId] ?? null
   111	    : null;
   112	  const url = nextUrl ?? active?.url ?? '';
   113	  if (bumpFrame && browser.url === url && url) browser.frameKey += 1;
   114	  else if (bumpFrame && browser.url !== url) browser.frameKey += 1;
   115	  browser.url = url;
   116	  browser.inputUrl = active?.inputUrl ?? url;
   117	  browser.activated = browser.workspace.activated;
   118	  browser.error = browser.workspace.error ?? '';
   119	}
   120	
   121	function persist(url: string): boolean {
   122	  if (typeof localStorage === 'undefined') return false;
   123	  try {
   124	    if (url) localStorage.setItem(BROWSER_URL_STORAGE_KEY, url);
   125	    else localStorage.removeItem(BROWSER_URL_STORAGE_KEY);
   126	    return true;
   127	  } catch {
   128	    browser.error = STORAGE_WRITE_FAILED_MESSAGE;
   129	    return false;
   130	  }
   131	}
   132	
   133	export function loadStoredBrowserUrl(): string {
   134	  if (typeof localStorage === 'undefined') return '';
   135	  try {
   136	    return normalizeBrowserUrl(localStorage.getItem(BROWSER_URL_STORAGE_KEY) ?? '');
   137	  } catch {
   138	    return '';
   139	  }
   140	}
   141	
   142	export function captureBrowserState(): SessionBrowserWorkspace {
   143	  return {
   144	    url: browser.url,
   145	    inputUrl: browser.inputUrl,
   146	    activated: browser.activated
   147	  };
   148	}
   149	
   150	export function restoreBrowserState(snapshot: SessionBrowserWorkspace | null | undefined): void {
   151	  const nextUrl = normalizeBrowserUrl(snapshot?.url ?? '');
   152	  browser.workspace.activated = snapshot?.activated === true && nextUrl.length > 0;
   153	  browser.workspace.error = null;
   154	  const current = browser.workspace.activeTabId
   155	    ? browser.workspace.tabs[browser.workspace.activeTabId] ?? null
   156	    : null;
   157	  try {
   158	    if (nextUrl && !current) {
   159	      createBrowserTab(modelContext(), { url: nextUrl });
   160	    } else if (nextUrl && current && current.url !== nextUrl) {
   161	      navigateActiveBrowserTab(modelContext(), nextUrl);
   162	    }
   163	    if (!nextUrl && current) {
   164	      closeBrowserTab(modelContext(), current.id);
   165	    }
   166	  } catch (error) {
   167	    browser.workspace.error = error instanceof Error ? error.message : String(error);
   168	  }
   169	  if (snapshot?.inputUrl && browser.workspace.activeTabId) {
   170	    const active = browser.workspace.tabs[browser.workspace.activeTabId];
   171	    if (active) active.inputUrl = snapshot.inputUrl;
   172	  }
   173	  if (snapshot?.activated !== true) browser.workspace.activated = false;
   174	  syncLegacy(nextUrl);
   175	}
