   852	/// Turn the C# language server off or on, and stop it now if it is running.
   853	///
   854	/// The reader's setting drives this. Call it with what the setting says when
   855	/// the app starts as well as when the switch is flipped: the flag lives in this
   856	/// process and starts out on, so a reader who turned it off last week would
   857	/// otherwise get the server back on the next launch.
   858	#[tauri::command]
   859	async fn set_csharp_language_server_enabled(
   860	    registry: tauri::State<'_, lsp::SourceLspRegistry>,
   861	    enabled: bool,
   862	) -> Result<CsharpLanguageServerToggleResult, String> {
   863	    let registry = registry.inner().clone();
   864	    tauri::async_runtime::spawn_blocking(move || {
   865	        let changed = lsp::set_csharp_language_server_enabled(enabled);
   866	        let stopped_servers = if enabled {
   867	            0
   868	        } else {
   869	            registry.stop_servers_for_language("csharp")?
   870	        };
   871	
   872	        Ok(CsharpLanguageServerToggleResult {
   873	            enabled,
   874	            stopped_servers,
   875	            message: describe_csharp_language_server_toggle(enabled, changed, stopped_servers),
   876	        })
   877	    })
   878	    .await
   879	    .map_err(|error| format!("C# language server switch task failed: {error}"))?
   880	}
   881	
   882	fn describe_csharp_language_server_toggle(
   883	    enabled: bool,
   884	    changed: bool,
   885	    stopped_servers: usize,
   886	) -> String {
   887	    if enabled {
   888	        return if changed {
   889	            "The C# language server is back on. It starts the next time you open a C# file, and takes a minute to read the solution."
   890	                .to_string()
   891	        } else {
   892	            "The C# language server was already on.".to_string()
   893	        };
   894	    }
   895	
   896	    if stopped_servers > 0 {
   897	        "The C# language server is off and the running one has been stopped, freeing its memory. Reference counts and project search still work; mistake squiggles and precise go-to-definition do not."
   898	            .to_string()
   899	    } else {
   900	        "The C# language server is off. It was not running, so nothing had to be stopped. Reference counts and project search still work; mistake squiggles and precise go-to-definition do not."
