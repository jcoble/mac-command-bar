  4720	fn runtime_context_root_label(path: &Path) -> String {
  4721	    if let Some((_, slug)) = worktree_repo_and_slug(path) {
  4722	        return format!("worktree:{slug}");
  4723	    }
  4724	
  4725	    let segments = path_segments(path);
  4726	    if segments
  4727	        .len()
  4728	        .checked_sub(2)
  4729	        .and_then(|index| segments.get(index))
  4730	        .is_some_and(|segment| segment == "work")
  4731	    {
  4732	        return "main checkout".to_string();
  4733	    }
  4734	
  4735	    path_last_segment(path).unwrap_or_else(|| "unknown".to_string())
  4736	}
  4737	
  4738	fn worktree_repo_and_slug(path: &Path) -> Option<(String, String)> {
  4739	    let segments = path_segments(path);
  4740	    let worktrees_index = segments.iter().position(|segment| segment == "worktrees")?;
  4741	    let repo = segments.get(worktrees_index + 1)?.clone();
  4742	    let slug = segments.get(worktrees_index + 2)?.clone();
  4743	    Some((repo, slug))
  4744	}
