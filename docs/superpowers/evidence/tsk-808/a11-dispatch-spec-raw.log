  1033	    pub fn authorize_delegation(
  1034	        run: &WorkflowRunRecord,
  1035	        request: &AgentDelegationRequest,
  1036	    ) -> Result<(), WorkflowError> {
  1037	        let parent = run
  1038	            .nodes
  1039	            .iter()
  1040	            .find(|node| {
  1041	                node.id == request.parent_node_run_id
  1042	                    && node.owned_id == request.parent_owned_id
  1043	                    && node.state == WorkflowNodeState::Running
  1044	            })
  1045	            .ok_or_else(|| {
  1046	                WorkflowError::PolicyDenied(
  1047	                    "Delegation parent is not an active workflow agent".into(),
  1048	                )
  1049	            })?;
  1050	        if request.depth != parent.depth.saturating_add(1)
  1051	            || request.depth > run.definition.budgets.maximum_child_depth
  1052	        {
  1053	            return Err(WorkflowError::BudgetExhausted(budget_failure(
  1054	                "depth",
  1055	                "Delegation depth budget exhausted",
  1056	            )));
  1057	        }
  1058	        let role = run
  1059	            .definition
  1060	            .roles
  1061	            .iter()
  1062	            .find(|role| role.id == request.role_id)
  1063	            .ok_or_else(|| {
  1064	                WorkflowError::PolicyDenied("Delegation requested an unknown role".into())
  1065	            })?;
  1066	        if let Some(provider) = request.provider_override.as_deref() {
  1067	            if !role
  1068	                .provider_policy
  1069	                .allowed_providers
  1070	                .iter()
  1071	                .any(|allowed| allowed.eq_ignore_ascii_case(provider))
  1072	            {
  1073	                return Err(WorkflowError::PolicyDenied(
  1074	                    "Delegation provider override is not allow-listed".into(),
  1075	                ));
  1076	            }
  1077	        }
  1078	        Ok(())
  1079	    }
  1080	}
