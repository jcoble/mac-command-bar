  3981	fn git_dirty_since_epoch_ms(root: &Path, files: &[GitFileStatus]) -> Option<u64> {
  3982	    files
  3983	        .iter()
  3984	        .filter_map(|file| {
  3985	            std::fs::metadata(root.join(&file.relative_path))
  3986	                .ok()?
  3987	                .modified()
  3988	                .ok()?
  3989	                .duration_since(std::time::UNIX_EPOCH)
  3990	                .ok()
  3991	                .and_then(|duration| u64::try_from(duration.as_millis()).ok())
  3992	        })
  3993	        .min()
  3994	}
  3995	
  3996	fn git_dirty_status_fingerprint(files: &[GitFileStatus]) -> String {
  3997	    let mut rows: Vec<String> = files
  3998	        .iter()
  3999	        .map(|file| {
  4000	            [
  4001	                file.relative_path.as_str(),
  4002	                file.index_status.as_str(),
  4003	                file.worktree_status.as_str(),
  4004	                file.status.as_str(),
  4005	                file.badge.as_str(),
  4006	            ]
  4007	            .join("\x1f")
  4008	        })
  4009	        .collect();
  4010	    rows.sort();
  4011	
  4012	    let mut hash = 0xcbf2_9ce4_8422_2325u64;
  4013	    for row in rows {
  4014	        for byte in row.as_bytes().iter().copied().chain([0]) {
  4015	            hash ^= u64::from(byte);
  4016	            hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
  4017	        }
  4018	    }
  4019	
  4020	    format!("{hash:016x}")
  4021	}
  4022	
  4023	fn parse_git_commit_history(output: &str) -> Result<Vec<GitCommitHistoryEntry>, String> {
  4024	    let mut entries = Vec::new();
  4025	
  4026	    for line in output.lines().filter(|line| !line.trim().is_empty()) {
  4027	        let mut parts = line.split('\x1f');
  4028	        let short_sha = parts.next().unwrap_or_default().trim().to_string();
  4029	        let sha = parts.next().unwrap_or_default().trim().to_string();
  4030	        let subject = parts.next().unwrap_or_default().trim().to_string();
  4031	        let author = parts.next().unwrap_or_default().trim().to_string();
  4032	        let committed_at = parts.next().unwrap_or_default().trim().to_string();
  4033	        let refs = parts.next().unwrap_or_default().trim().to_string();
  4034	        let parent_shas = parts
  4035	            .next()
  4036	            .unwrap_or_default()
  4037	            .split_whitespace()
  4038	            .map(str::trim)
  4039	            .filter(|parent| !parent.is_empty())
  4040	            .map(ToOwned::to_owned)
  4041	            .collect::<Vec<_>>();
  4042	        let parent_count = parent_shas.len();
  4043	
  4044	        if short_sha.is_empty() || sha.is_empty() {
  4045	            return Err("Could not parse Git history entry".to_string());
  4046	        }
  4047	
  4048	        let (task_id, task_source) = match task_id_from_text(&refs) {
  4049	            Some(task_id) => (Some(task_id), Some("refs".to_string())),
  4050	            None => match task_id_from_text(&subject) {
  4051	                Some(task_id) => (Some(task_id), Some("subject".to_string())),
  4052	                None => (None, None),
  4053	            },
  4054	        };
  4055	        entries.push(GitCommitHistoryEntry {
  4056	            short_sha,
  4057	            sha,
  4058	            subject,
  4059	            author,
  4060	            committed_at,
  4061	            refs,
  4062	            parent_shas,
  4063	            parent_count,
  4064	            task_id,
  4065	            task_source,
  4066	        });
  4067	    }
  4068	
  4069	    Ok(entries)
  4070	}
