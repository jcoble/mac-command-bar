   427	#[derive(Default)]
   428	struct SourceScanRegistry {
   429	    scans: Mutex<HashMap<String, Arc<AtomicBool>>>,
   430	}
   431	
   432	impl SourceScanRegistry {
   433	    fn register(&self, scan_id: &str) -> Arc<AtomicBool> {
   434	        let cancelled = Arc::new(AtomicBool::new(false));
   435	        self.scans
   436	            .lock()
   437	            .expect("source scan registry lock poisoned")
   438	            .insert(scan_id.to_string(), Arc::clone(&cancelled));
   439	        cancelled
   440	    }
   441	
   442	    fn cancel(&self, scan_id: &str) -> bool {
   443	        let Some(cancelled) = self
   444	            .scans
   445	            .lock()
   446	            .expect("source scan registry lock poisoned")
   447	            .get(scan_id)
   448	            .cloned()
   449	        else {
   450	            return false;
   451	        };
   452	        cancelled.store(true, Ordering::Relaxed);
   453	        true
   454	    }
   455	
   456	    fn unregister(&self, scan_id: &str) {
   457	        self.scans
   458	            .lock()
   459	            .expect("source scan registry lock poisoned")
   460	            .remove(scan_id);
   461	    }
   462	}
   463	
   464	struct SourceScanCancellation {
   465	    cancelled: Arc<AtomicBool>,
   466	    progress: Option<Arc<dyn Fn(SourceScanStats) + Send + Sync>>,
   467	    /// When set, the walk stops itself at this moment even if nobody cancelled
   468	    /// it. Only the batched margin-count walk uses this; the file-list scan the
   469	    /// user watches runs to completion.
   470	    deadline: Option<Instant>,
   471	}
   472	
   473	impl SourceScanCancellation {
   474	    fn new(
   475	        cancelled: Arc<AtomicBool>,
   476	        progress: Option<Arc<dyn Fn(SourceScanStats) + Send + Sync>>,
   477	    ) -> Self {
   478	        Self {
   479	            cancelled,
   480	            progress,
   481	            deadline: None,
   482	        }
   483	    }
   484	
   485	    fn none() -> Self {
   486	        Self::new(Arc::new(AtomicBool::new(false)), None)
   487	    }
   488	
   489	    fn until(deadline: Instant) -> Self {
   490	        Self {
   491	            cancelled: Arc::new(AtomicBool::new(false)),
   492	            progress: None,
   493	            deadline: Some(deadline),
   494	        }
   495	    }
   496	
   497	    #[cfg(test)]
   498	    fn cancelled_for_test() -> Self {
   499	        Self::new(Arc::new(AtomicBool::new(true)), None)
   500	    }
   501	
   502	    #[cfg(test)]
   503	    fn active_for_test(progress: impl Fn(SourceScanStats) + Send + Sync + 'static) -> Self {
   504	        Self::new(Arc::new(AtomicBool::new(false)), Some(Arc::new(progress)))
   505	    }
   506	
   507	    fn ensure_active(&self) -> Result<(), String> {
   508	        if self.cancelled.load(Ordering::Relaxed) {
   509	            return Err("Source scan cancelled".to_string());
   510	        }
   511	        if self
   512	            .deadline
   513	            .is_some_and(|deadline| Instant::now() >= deadline)
   514	        {
   515	            return Err("Source scan ran out of time".to_string());
   516	        }
   517	        Ok(())
   518	    }
   519	
   520	    fn report_progress(&self, progress: SourceScanStats) {
   521	        if let Some(callback) = &self.progress {
   522	            callback(progress);
   523	        }
   524	    }
   525	}
   526	
   527	#[derive(Default)]
   528	struct SourceScanWalkProgress {
   529	    stats: SourceScanStats,
   530	    next_report_at: usize,
   531	}
   532	
   533	impl SourceScanWalkProgress {
   534	    fn visit_entry(&mut self, cancellation: &SourceScanCancellation) {
   535	        self.stats.visited_entries += 1;
   536	        if self.stats.visited_entries == 1 || self.stats.visited_entries >= self.next_report_at {
   537	            self.next_report_at = self.stats.visited_entries + SOURCE_SCAN_PROGRESS_INTERVAL;
   538	            self.report(cancellation);
   539	        }
   540	    }
   541	
   542	    fn match_file(&mut self, cancellation: &SourceScanCancellation) {
   543	        self.stats.matched_files += 1;
   544	        self.report(cancellation);
   545	    }
   546	
   547	    fn skip_directory(&mut self, root: &Path, path: &Path, name: &str, reason: &str) {
   548	        self.stats.skipped_directories += 1;
   549	        if self.stats.skipped_directory_samples.len() < MAX_SOURCE_SCAN_SKIPPED_DIRECTORY_SAMPLES {
   550	            self.stats
   551	                .skipped_directory_samples
   552	                .push(SourceSkippedDirectory {
   553	                    path: normalized_relative_source_path(root, path),
   554	                    name: name.to_string(),
   555	                    reason: reason.to_string(),
   556	                });
   557	        }
   558	    }
   559	
   560	    fn skip_unsupported_file(&mut self) {
   561	        self.stats.unsupported_files += 1;
   562	    }
   563	
   564	    fn skip_unreadable_entry(&mut self) {
   565	        self.stats.unreadable_entries += 1;
   566	    }
   567	
   568	    fn report(&self, cancellation: &SourceScanCancellation) {
   569	        cancellation.report_progress(self.stats.clone());
   570	    }
   571	}
