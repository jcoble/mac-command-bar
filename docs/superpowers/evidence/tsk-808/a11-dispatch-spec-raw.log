   863	pub(crate) struct WorkflowPolicy;
   864	impl WorkflowPolicy {
   865	    pub fn validate_definition(definition: &WorkflowDefinitionV1) -> Result<(), WorkflowError> {
   866	        if definition.version != WORKFLOW_DEFINITION_VERSION {
   867	            return Err(WorkflowError::InvalidDefinition(
   868	                "Only workflow definition version 1 is supported".into(),
   869	            ));
   870	        }
   871	        if definition.id.trim().is_empty() || definition.nodes.is_empty() {
   872	            return Err(WorkflowError::InvalidDefinition(
   873	                "Workflow id and at least one node are required".into(),
   874	            ));
   875	        }
   876	        let roles: HashSet<_> = definition
   877	            .roles
   878	            .iter()
   879	            .map(|role| role.id.as_str())
   880	            .collect();
   881	        if roles.len() != definition.roles.len() {
   882	            return Err(WorkflowError::InvalidDefinition(
   883	                "Role ids must be unique".into(),
   884	            ));
   885	        }
   886	        let nodes: HashSet<_> = definition
   887	            .nodes
   888	            .iter()
   889	            .map(|node| node.id.as_str())
   890	            .collect();
   891	        if nodes.len() != definition.nodes.len() {
   892	            return Err(WorkflowError::InvalidDefinition(
   893	                "Node ids must be unique".into(),
   894	            ));
   895	        }
   896	        for node in &definition.nodes {
   897	            if !roles.contains(node.role_id.as_str()) {
   898	                return Err(WorkflowError::InvalidDefinition(format!(
   899	                    "Node {} references unknown role {}",
   900	                    node.id, node.role_id
   901	                )));
   902	            }
   903	            if node
   904	                .depends_on
   905	                .iter()
   906	                .any(|dependency| !nodes.contains(dependency.as_str()))
   907	            {
   908	                return Err(WorkflowError::InvalidDefinition(format!(
   909	                    "Node {} has an unknown dependency",
   910	                    node.id
   911	                )));
   912	            }
   913	            if node
   914	                .depends_on
   915	                .iter()
   916	                .any(|dependency| dependency == &node.id)
   917	            {
   918	                return Err(WorkflowError::InvalidDefinition(format!(
   919	                    "Node {} depends on itself",
   920	                    node.id
   921	                )));
   922	            }
   923	        }
   924	        for edge in &definition.edges {
   925	            if !nodes.contains(edge.from.as_str()) || !nodes.contains(edge.to.as_str()) {
   926	                return Err(WorkflowError::InvalidDefinition(
   927	                    "Edge references an unknown node".into(),
   928	                ));
   929	            }
   930	        }
   931	        let mut incoming: HashMap<&str, usize> = definition
   932	            .nodes
   933	            .iter()
   934	            .map(|node| (node.id.as_str(), 0))
   935	            .collect();
   936	        let mut children: HashMap<&str, BTreeSet<&str>> = HashMap::new();
   937	        for node in &definition.nodes {
   938	            for dependency in &node.depends_on {
   939	                if children.entry(dependency).or_default().insert(&node.id) {
   940	                    *incoming.get_mut(node.id.as_str()).unwrap() += 1;
   941	                }
   942	            }
   943	        }
   944	        for edge in &definition.edges {
   945	            if children.entry(&edge.from).or_default().insert(&edge.to) {
   946	                *incoming.get_mut(edge.to.as_str()).unwrap() += 1;
   947	            }
   948	        }
   949	        let mut queue: BTreeSet<&str> = incoming
   950	            .iter()
   951	            .filter(|(_, count)| **count == 0)
   952	            .map(|(id, _)| *id)
   953	            .collect();
   954	        let mut visited = 0;
   955	        while let Some(id) = queue.pop_first() {
   956	            visited += 1;
   957	            if let Some(next) = children.get(id) {
   958	                for child in next {
   959	                    let count = incoming.get_mut(child).unwrap();
   960	                    *count -= 1;
   961	                    if *count == 0 {
   962	                        queue.insert(child);
   963	                    }
   964	                }
   965	            }
   966	        }
   967	        if visited != definition.nodes.len() {
   968	            return Err(WorkflowError::InvalidDefinition(
   969	                "Workflow graph contains a cycle".into(),
   970	            ));
   971	        }
   972	        Ok(())
   973	    }
   974	
   975	    pub fn validate_output(
   976	        contract: WorkflowOutputContract,
   977	        value: &Value,
   978	    ) -> Result<(), WorkflowError> {
   979	        value.as_object().ok_or_else(|| {
   980	            WorkflowError::OutputContract(format!(
   981	                "{} must be a structured object; prose is never control input",
   982	                contract.name()
   983	            ))
   984	        })?;
   985	        let parsed = match contract {
   986	            WorkflowOutputContract::ImplementationReceipt => {
   987	                serde_json::from_value::<ImplementationReceipt>(value.clone()).map(|_| ())
   988	            }
   989	            WorkflowOutputContract::ReviewReceipt => {
   990	                serde_json::from_value::<ReviewReceipt>(value.clone()).map(|_| ())
   991	            }
   992	            WorkflowOutputContract::SpecComplianceReceipt => {
   993	                serde_json::from_value::<SpecComplianceReceipt>(value.clone()).map(|_| ())
   994	            }
   995	            WorkflowOutputContract::VerificationReceipt => {
   996	                serde_json::from_value::<VerificationReceipt>(value.clone()).map(|_| ())
   997	            }
   998	            WorkflowOutputContract::PlanReceipt => {
   999	                serde_json::from_value::<PlanReceipt>(value.clone()).map(|_| ())
  1000	            }
  1001	        };
  1002	        parsed.map_err(|error| {
  1003	            WorkflowError::OutputContract(format!(
  1004	                "{} is invalid structured data: {error}",
  1005	                contract.name()
  1006	            ))
  1007	        })
  1008	    }
  1009	
  1010	    fn provider_for(role: &AgentRoleDefinition) -> Result<String, WorkflowError> {
  1011	        let provider = role.provider_policy.provider.trim().to_ascii_lowercase();
  1012	        if provider.is_empty() {
  1013	            return Err(WorkflowError::PolicyDenied(format!(
  1014	                "Role {} has no provider",
  1015	                role.id
  1016	            )));
  1017	        }
  1018	        if !role.provider_policy.allowed_providers.is_empty()
  1019	            && !role
  1020	                .provider_policy
  1021	                .allowed_providers
  1022	                .iter()
  1023	                .any(|allowed| allowed.eq_ignore_ascii_case(&provider))
  1024	        {
  1025	            return Err(WorkflowError::PolicyDenied(format!(
  1026	                "Provider {provider} is not allowed for role {}",
  1027	                role.id
  1028	            )));
  1029	        }
  1030	        Ok(provider)
  1031	    }
