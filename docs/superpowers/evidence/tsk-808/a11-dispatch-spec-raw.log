    29	export interface SidePaneValidationResult {
    30	  valid: boolean;
    31	  errors: string[];
    32	}
    33	
    34	const REGIONS: readonly SidePaneRegion[] = ['left', 'right', 'bottom'];
    35	
    36	function isRegion(value: unknown): value is SidePaneRegion {
    37	  return typeof value === 'string' && (REGIONS as readonly string[]).includes(value);
    38	}
