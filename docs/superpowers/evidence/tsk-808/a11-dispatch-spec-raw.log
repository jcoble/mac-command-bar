   203	export async function setConversationConfigOption(
   204	  ownedId: string,
   205	  optionId: string,
   206	  value: AgentConfigValue
   207	): Promise<AgentCapabilities | null> {
   208	  const state = getConversationSession(ownedId);
   209	  const option = state?.capabilities?.configOptions.find((candidate) => candidate.id === optionId);
   210	  if (!state || !option || (option.choices && !option.choices.some((choice) => JSON.stringify(choice.value) === JSON.stringify(value)))) {
   211	    throw new Error('This configuration value is not advertised for the session');
   212	  }
   213	  if (!beginConversationConfigChange(ownedId, optionId, value)) throw new Error('Configuration change is not available');
   214	  try {
   215	    if (!isTauri()) throw new Error('The structured conversation runtime is unavailable');
   216	    const response = await invoke<{ capabilities?: AgentCapabilities; configOptions?: AgentConfigOption[] }>(
   217	      'set_agent_conversation_config_option',
   218	      { request: { ownedId, generation: state.generation, optionId, value } }
   219	    );
   220	    const latest = getConversationSession(ownedId);
   221	    if (!latest || latest.generation !== state.generation) {
   222	      throw new Error('Configuration response belongs to a stale conversation generation');
   223	    }
   224	    const capabilities = response?.capabilities
   225	      ?? (response?.configOptions ? { ...state.capabilities, configOptions: response.configOptions } as AgentCapabilities : state.capabilities);
   226	    if (!capabilities || capabilities.provider !== state.provider) {
   227	      throw new Error('Configuration response provider does not match this session');
   228	    }
   229	    confirmConversationConfigChange(ownedId, optionId, value, capabilities);
   230	    return capabilities;
   231	  } catch (error) {
   232	    if (getConversationSession(ownedId)?.generation === state.generation) {
   233	      failConversationConfigChange(ownedId, optionId, error instanceof Error ? error.message : String(error));
   234	    }
   235	    throw error;
   236	  }
   237	}
