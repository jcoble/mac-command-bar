    61	export function createImmutableBrowserFeedbackAttachment(input: {
    62	  id: string;
    63	  kind: BrowserFeedbackKind;
    64	  workspaceId: string;
    65	  tabId: string;
    66	  generation: number;
    67	  url: string;
    68	  title: string;
    69	  selector?: string | null;
    70	  accessibleName?: string | null;
    71	  textSnippet?: string | null;
    72	  note?: string | null;
    73	  intent?: BrowserFeedbackIntent;
    74	  imageAttachmentId?: string | null;
    75	  createdAt: string;
    76	  sourceHash?: string;
    77	}): BrowserFeedbackAttachment {
    78	  const kind = input.kind;
    79	  const note = text(input.note) || null;
    80	  if (kind === 'annotation' && !note) throw new Error('An annotation note is required');
    81	  if (kind === 'annotation' && input.intent !== 'change' && input.intent !== 'question') {
    82	    throw new Error('An annotation intent must be Change or Question');
    83	  }
    84	  return immutable({
    85	    id: text(input.id),
    86	    kind,
    87	    workspaceId: text(input.workspaceId),
    88	    tabId: text(input.tabId),
    89	    generation: Number.isFinite(input.generation) ? Math.max(0, Math.floor(input.generation)) : 0,
    90	    url: text(input.url),
    91	    title: text(input.title),
    92	    selector: boundSelector(input.selector),
    93	    accessibleName: text(input.accessibleName) || null,
    94	    textSnippet: boundTextSnippet(input.textSnippet),
    95	    note,
    96	    intent: intentFor(kind, input.intent),
    97	    imageAttachmentId: text(input.imageAttachmentId) || null,
    98	    createdAt: text(input.createdAt),
    99	    sourceHash:
   100	      text(input.sourceHash) ||
   101	      browserSourceHash([
   102	        input.workspaceId,
   103	        input.tabId,
   104	        input.generation,
   105	        input.url,
   106	        input.selector,
   107	        input.textSnippet,
   108	        input.imageAttachmentId
   109	      ])
   110	  });
   111	}
