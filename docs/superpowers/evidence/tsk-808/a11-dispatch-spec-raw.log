  5062	
  5063	fn source_path_priority(
  5064	    relative_path: &str,
  5065	    language: &str,
  5066	    is_directory: bool,
  5067	    root: &Path,
  5068	) -> i32 {
  5069	    let normalized_path = relative_path.replace('\\', "/").to_ascii_lowercase();
  5070	    let segments = normalized_path
  5071	        .split('/')
  5072	        .filter(|segment| !segment.is_empty())
  5073	        .collect::<Vec<_>>();
  5074	    let first_segment = segments.first().copied().unwrap_or_default();
  5075	    let project_name = root
  5076	        .file_name()
  5077	        .and_then(|value| value.to_str())
  5078	        .unwrap_or_default()
  5079	        .to_ascii_lowercase();
  5080	    let mut score = if is_directory { -6 } else { 0 };
  5081	
  5082	    score += source_root_priority(first_segment, &project_name);
  5083	    score += source_language_priority(language);
  5084	    score += source_path_segment_adjustment(&segments);
  5085	
  5086	    if first_segment.starts_with('.') {
  5087	        score += 80;
  5088	    }
  5089	
  5090	    score
  5091	}
  5092	
  5093	fn source_root_priority(first_segment: &str, project_name: &str) -> i32 {
  5094	    if first_segment.is_empty() {
  5095	        return 100;
  5096	    }
  5097	
  5098	    let project_prefix = if project_name.is_empty() {
  5099	        String::new()
  5100	    } else {
  5101	        format!("{project_name}.")
  5102	    };
  5103	    if !project_name.is_empty()
  5104	        && (first_segment == project_name || first_segment.starts_with(&project_prefix))
  5105	    {
  5106	        return project_root_segment_adjustment(first_segment);
  5107	    }
  5108	
  5109	    if matches!(
  5110	        first_segment,
  5111	        "src" | "source" | "sources" | "lib" | "app" | "apps" | "packages"
  5112	    ) {
  5113	        return 0;
  5114	    }
  5115	
  5116	    if looks_like_source_project_segment(first_segment) {
  5117	        return 8 + project_root_segment_adjustment(first_segment);
  5118	    }
  5119	    if first_segment.contains("test") || first_segment.contains("spec") {
  5120	        return 26;
  5121	    }
  5122	    if matches!(first_segment, "scripts" | "tools") {
  5123	        return 34;
  5124	    }
  5125	    if matches!(
  5126	        first_segment,
  5127	        "config" | "deploy" | "infra" | "infrastructure" | ".config" | ".github"
  5128	    ) {
  5129	        return 60;
  5130	    }
  5131	    if matches!(first_segment, "docs" | "doc" | "documentation") {
  5132	        return 75;
  5133	    }
  5134	
  5135	    45
  5136	}
  5137	
  5138	fn looks_like_source_project_segment(segment: &str) -> bool {
  5139	    segment.contains('.')
  5140	        || segment.ends_with("-web")
  5141	        || segment.ends_with("-api")
  5142	        || segment.ends_with("-core")
  5143	        || segment.ends_with("-engine")
  5144	        || segment.ends_with("-data")
  5145	        || matches!(segment, "web" | "client" | "server")
  5146	}
  5147	
  5148	fn project_root_segment_adjustment(segment: &str) -> i32 {
  5149	    if segment.ends_with(".core") || segment.ends_with("-core") {
  5150	        return -8;
  5151	    }
  5152	    if segment.ends_with(".api") || segment.ends_with("-api") {
  5153	        return -6;
  5154	    }
  5155	    if segment.ends_with(".engine") || segment.ends_with("-engine") {
  5156	        return -5;
  5157	    }
  5158	    if segment.ends_with(".data") || segment.ends_with("-data") {
  5159	        return -4;
  5160	    }
  5161	    if segment.ends_with("-web") || segment == "web" || segment == "client" {
  5162	        return -3;
  5163	    }
  5164	    if segment.contains("test") || segment.contains("spec") {
  5165	        return 18;
  5166	    }
  5167	
  5168	    0
  5169	}
  5170	
  5171	fn source_language_priority(language: &str) -> i32 {
  5172	    if matches!(
  5173	        language,
  5174	        "csharp"
  5175	            | "typescript"
  5176	            | "tsx"
  5177	            | "svelte"
  5178	            | "javascript"
  5179	            | "jsx"
  5180	            | "rust"
  5181	            | "swift"
  5182	            | "go"
  5183	            | "python"
  5184	            | "java"
  5185	            | "kotlin"
  5186	            | "cpp"
  5187	            | "dart"
  5188	            | "fsharp"
  5189	            | "razor"
  5190	    ) {
  5191	        return 0;
  5192	    }
  5193	
  5194	    if matches!(
  5195	        language,
  5196	        "json"
  5197	            | "yaml"
  5198	            | "toml"
  5199	            | "xml"
  5200	            | "shell"
  5201	            | "powershell"
  5202	            | "sql"
  5203	            | "graphql"
  5204	            | "protobuf"
  5205	            | "hcl"
  5206	            | "dockerfile"
  5207	            | "makefile"
  5208	    ) {
  5209	        return 28;
  5210	    }
  5211	
  5212	    if language == "markdown" || language == "mdx" {
  5213	        return 55;
  5214	    }
  5215	
  5216	    80
  5217	}
  5218	
  5219	fn source_path_segment_adjustment(segments: &[&str]) -> i32 {
  5220	    let mut score = 0;
  5221	
  5222	    if [
  5223	        "services",
  5224	        "controllers",
  5225	        "routes",
  5226	        "components",
  5227	        "pages",
  5228	        "models",
  5229	        "entities",
  5230	        "features",
  5231	    ]
  5232	    .iter()
  5233	    .any(|segment| segments.contains(segment))
  5234	    {
  5235	        score -= 7;
  5236	    }
  5237	
  5238	    if [
  5239	        "migrations",
  5240	        "generated",
