    77	/**
    78	 * Does this error mean "the desktop app does not have that command"? Tauri
    79	 * phrases it a few ways depending on version, so match the stable words.
    80	 */
    81	export function isMissingCommandError(error: unknown): boolean {
    82	  const message = (error instanceof Error ? error.message : String(error ?? '')).toLowerCase();
    83	  return (
    84	    message.includes('not found') &&
    85	    (message.includes('command') || message.includes('invoke')) &&
