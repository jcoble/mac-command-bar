    72	
    73	/** Reload. The panel's Refresh button, and nothing else. */
    74	export async function refresh(): Promise<void> {
    75	  markProblemsActivated();
    76	  loadedRoot = problemsState.root;
    77	  await load();
    78	}
    79	
    80	/** Forget which project was last loaded — used when the shell tears down. */
