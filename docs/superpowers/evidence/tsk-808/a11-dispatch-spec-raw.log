   221	/**
   222	 * The panel's usual backend, answered by the dev server instead of the desktop
   223	 * app, so the whole surface can be looked at in a browser.
   224	 *
   225	 * Reads work. Writes do not, and say so in one sentence rather than failing
   226	 * with something only a programmer could read — the panel also disables those
   227	 * buttons, so reaching this message means something got past the button.
   228	 */
   229	export function bridgeGitBackend(): GitBackend {
   230	  const refuse = async (): Promise<GitActionResult | null> => {
   231	    throw new Error(READ_ONLY_IN_BROWSER_MESSAGE);
   232	  };
   233	
   234	  return {
   235	    readStatus: (root) => postGitBridge<ProjectGitStatus>('status', { root }),
   236	    readDiff: (root, absolutePath) =>
   237	      postGitBridge<SourceGitDiff>('file-diff', { root, path: absolutePath }),
   238	    readHistory: (root, limit) =>
   239	      postGitBridge<GitCommitHistoryEntry[]>('history', { root, limit }),
   240	    stage: refuse,
   241	    unstage: refuse,
   242	    commit: refuse,
   243	    fetch: refuse,
   244	    pull: refuse,
   245	    push: refuse
   246	  };
   247	}
   248	
   249	/** True when this page can change the repository (i.e. it is the desktop app). */
   250	export function canChangeRepository(): boolean {
   251	  return isTauriRuntime();
   252	}
