    56	/**
    57	 * Show the Problems panel and load it.
    58	 *
    59	 * Idempotent: opening the panel again on the same project does no work at all.
    60	 * A different project reloads. Pass a root of `null` (no session picked) and
    61	 * the panel is pointed at nothing and stays quiet.
    62	 */
    63	export function activate(root: string | null): void {
    64	  const next = (root ?? '').trim() || null;
    65	  const firstTime = !problemsState.activated;
    66	  setProblemsRoot(next);
    67	  markProblemsActivated();
    68	  if (!firstTime && next === loadedRoot) return;
    69	  loadedRoot = next;
    70	  void load();
