  3743	fn copy_untracked_worktree_files(
  3744	    root: &Path,
  3745	    destination_root: &Path,
  3746	    relative_paths: &[String],
  3747	) -> Result<(), String> {
  3748	    for relative_path in relative_paths {
  3749	        if !is_safe_git_relative_path(relative_path) {
  3750	            continue;
  3751	        }
  3752	
  3753	        let source = root.join(relative_path);
  3754	        let Ok(metadata) = std::fs::metadata(&source) else {
  3755	            continue;
  3756	        };
  3757	        if !metadata.is_file() {
  3758	            continue;
  3759	        }
  3760	
  3761	        let destination = destination_root.join(relative_path);
  3762	        if let Some(parent) = destination.parent() {
  3763	            std::fs::create_dir_all(parent).map_err(|error| {
  3764	                format!("Could not create untracked archive directory: {error}")
  3765	            })?;
  3766	        }
  3767	        std::fs::copy(&source, &destination).map_err(|error| {
  3768	            format!(
  3769	                "Could not copy untracked file {} to {}: {error}",
  3770	                source.display(),
  3771	                destination.display()
  3772	            )
  3773	        })?;
  3774	    }
  3775	
  3776	    Ok(())
  3777	}
