  1365	    pub fn skip_node(
  1366	        &self,
  1367	        run_id: &str,
  1368	        node_id: &str,
  1369	        idempotency_key: &str,
  1370	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1371	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1372	            return Ok(existing);
  1373	        }
  1374	        let mut run = self.require_run(run_id)?;
  1375	        let node = run
  1376	            .nodes
  1377	            .iter_mut()
  1378	            .find(|node| node.node_id == node_id)
  1379	            .ok_or_else(|| WorkflowError::NotFound(node_id.into()))?;
  1380	        if matches!(
  1381	            node.state,
  1382	            WorkflowNodeState::Completed | WorkflowNodeState::Running | WorkflowNodeState::Starting
  1383	        ) {
  1384	            return Err(WorkflowError::InvalidTransition(
  1385	                "Active or completed nodes cannot be skipped".into(),
  1386	            ));
  1387	        }
  1388	        node.state = WorkflowNodeState::Skipped;
  1389	        node.finished_at_ms = Some(self.clock.now_ms());
  1390	        refresh_ready_and_phase(&mut run);
  1391	        self.append(
  1392	            &mut run,
  1393	            "workflow.node.skipped",
  1394	            idempotency_key,
  1395	            Some(node_id),
  1396	        )?;
  1397	        Ok(run)
  1398	    }
  1399	
  1400	    pub fn approve_gate(
  1401	        &self,
  1402	        run_id: &str,
  1403	        node_id: &str,
  1404	        approval: Value,
  1405	        idempotency_key: &str,
  1406	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1407	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1408	            return Ok(existing);
  1409	        }
  1410	        let approved = approval
  1411	            .get("approved")
  1412	            .and_then(Value::as_bool)
  1413	            .ok_or_else(|| {
  1414	                WorkflowError::OutputContract(
  1415	                    "Gate input must be structured data containing approved: boolean".into(),
  1416	                )
  1417	            })?;
  1418	        let mut run = self.require_run(run_id)?;
  1419	        let node = run
  1420	            .nodes
  1421	            .iter_mut()
  1422	            .find(|node| node.node_id == node_id)
  1423	            .ok_or_else(|| WorkflowError::NotFound(node_id.into()))?;
  1424	        if node.state != WorkflowNodeState::WaitingApproval {
  1425	            return Err(WorkflowError::InvalidTransition(
  1426	                "Node is not waiting for approval".into(),
  1427	            ));
  1428	        }
  1429	        let gate = node
  1430	            .gate
  1431	            .as_mut()
  1432	            .ok_or_else(|| WorkflowError::InvalidTransition("Node has no gate".into()))?;
  1433	        gate.approved = Some(approved);
  1434	        gate.structured_input = Some(approval);
  1435	        node.state = if approved {
  1436	            WorkflowNodeState::Completed
  1437	        } else {
  1438	            WorkflowNodeState::Failed
  1439	        };
  1440	        node.finished_at_ms = Some(self.clock.now_ms());
  1441	        if !approved && run.definition.completion.cancel_descendants_on_failure {
  1442	            cancel_descendants(&mut run, node_id);
  1443	        }
  1444	        refresh_ready_and_phase(&mut run);
  1445	        self.append(
  1446	            &mut run,
  1447	            "workflow.gate.decided",
  1448	            idempotency_key,
  1449	            Some(node_id),
  1450	        )?;
  1451	        Ok(run)
  1452	    }
  1453	
  1454	    pub async fn submit_result(
  1455	        &self,
  1456	        run_id: &str,
  1457	        node_id: &str,
  1458	        result: Value,
  1459	        idempotency_key: &str,
  1460	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1461	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1462	            return Ok(existing);
  1463	        }
  1464	        let mut run = self.require_run(run_id)?;
  1465	        let index = run
  1466	            .nodes
  1467	            .iter()
  1468	            .position(|node| node.node_id == node_id)
  1469	            .ok_or_else(|| WorkflowError::NotFound(node_id.into()))?;
  1470	        if run.nodes[index].state == WorkflowNodeState::Completed {
  1471	            return Ok(run);
  1472	        }
  1473	        if run.nodes[index].state != WorkflowNodeState::Running {
  1474	            return Err(WorkflowError::InvalidTransition(
  1475	                "Only a running node accepts a result".into(),
  1476	            ));
  1477	        }
  1478	        enforce_node_timeout(&run, index, self.clock.now_ms())?;
  1479	        WorkflowPolicy::validate_output(run.nodes[index].output_contract, &result)?;
  1480	        run.tokens_used = run.tokens_used.saturating_add(
  1481	            result
  1482	                .get("tokensUsed")
  1483	                .and_then(Value::as_u64)
  1484	                .unwrap_or_default(),
  1485	        );
  1486	        run.tool_terminals_used = run.tool_terminals_used.saturating_add(
  1487	            result
  1488	                .get("toolTerminalsUsed")
  1489	                .and_then(Value::as_u64)
  1490	                .unwrap_or_default() as u32,
  1491	        );
  1492	        if let Err(error) = enforce_budgets(&run, self.clock.now_ms()) {
  1493	            if let WorkflowError::BudgetExhausted(failure) = &error {
  1494	                run.nodes[index].state = WorkflowNodeState::Failed;
  1495	                run.nodes[index].failure = Some(failure.clone());
  1496	                run.nodes[index].finished_at_ms = Some(self.clock.now_ms());
  1497	                if run.definition.completion.cancel_descendants_on_failure {
  1498	                    cancel_descendants(&mut run, node_id);
  1499	                }
  1500	                run.state = WorkflowRunState::Failed;
  1501	                run.phase = WorkflowLoopPhase::Failed;
  1502	                let budget_key = format!(
  1503	                    "budget:{}:{}",
  1504	                    run.nodes[index].id,
  1505	                    failure.budget.as_deref().unwrap_or("unknown")
  1506	                );
  1507	                self.append(
  1508	                    &mut run,
  1509	                    "workflow.node.budget-exhausted",
  1510	                    &budget_key,
  1511	                    Some(node_id),
  1512	                )?;
  1513	            }
  1514	            return Err(error);
  1515	        }
  1516	        let artifacts = result
  1517	            .get("artifacts")
  1518	            .or_else(|| result.get("evidenceArtifacts"))
  1519	            .cloned()
  1520	            .unwrap_or_else(|| json!([]));
  1521	        run.nodes[index].artifacts = serde_json::from_value(artifacts).unwrap_or_default();
  1522	        run.nodes[index].structured_output = Some(result);
  1523	        if let Some(gate_definition) = run
  1524	            .definition
  1525	            .nodes
  1526	            .iter()
  1527	            .find(|node| node.id == node_id)
  1528	            .and_then(|node| node.approval_gate.clone())
  1529	        {
  1530	            run.nodes[index].state = WorkflowNodeState::WaitingApproval;
  1531	            run.nodes[index].gate = Some(WorkflowGateRecord {
  1532	                id: gate_definition.id,
  1533	                node_run_id: run.nodes[index].id.clone(),
  1534	                approved: None,
  1535	                structured_input: None,
  1536	            });
  1537	            run.state = WorkflowRunState::WaitingApproval;
  1538	        } else {
  1539	            run.nodes[index].state = WorkflowNodeState::Completed;
  1540	            run.nodes[index].finished_at_ms = Some(self.clock.now_ms());
  1541	            if let Some(lease_id) = run.nodes[index].lease_id.take() {
  1542	                self.leases.release(&lease_id)?;
  1543	            }
  1544	        }
  1545	        refresh_ready_and_phase(&mut run);
  1546	        self.append(
  1547	            &mut run,
  1548	            "workflow.node.result-submitted",
  1549	            idempotency_key,
  1550	            Some(node_id),
  1551	        )?;
  1552	        self.dispatch_ready(run_id).await
  1553	    }
  1554	
  1555	    pub async fn dispatch_ready(&self, run_id: &str) -> Result<WorkflowRunRecord, WorkflowError> {
  1556	        loop {
  1557	            let mut run = self.require_run(run_id)?;
  1558	            if run.state != WorkflowRunState::Running {
  1559	                return Ok(run);
  1560	            }
  1561	            if let Err(error) = enforce_budgets(&run, self.clock.now_ms()) {
  1562	                if let WorkflowError::BudgetExhausted(failure) = &error {
  1563	                    run.state = WorkflowRunState::Failed;
  1564	                    run.phase = WorkflowLoopPhase::Failed;
  1565	                    let budget_key = format!(
  1566	                        "budget:{}:{}",
  1567	                        run.id,
  1568	                        failure.budget.as_deref().unwrap_or("unknown")
  1569	                    );
  1570	                    self.append(&mut run, "workflow.run.budget-exhausted", &budget_key, None)?;
  1571	                }
  1572	                return Err(error);
  1573	            }
  1574	            if let Some(index) = run.nodes.iter().enumerate().find_map(|(index, node)| {
  1575	                (node.state == WorkflowNodeState::Running
  1576	                    && enforce_node_timeout(&run, index, self.clock.now_ms()).is_err())
  1577	                .then_some(index)
  1578	            }) {
  1579	                let failure = budget_failure("node-timeout", "Workflow node timeout exhausted");
  1580	                run.nodes[index].state = WorkflowNodeState::Failed;
  1581	                run.nodes[index].failure = Some(failure.clone());
  1582	                run.nodes[index].finished_at_ms = Some(self.clock.now_ms());
  1583	                if let Some(lease_id) = run.nodes[index].lease_id.take() {
  1584	                    self.leases.release(&lease_id)?;
  1585	                }
  1586	                let node_id = run.nodes[index].node_id.clone();
  1587	                if run.definition.completion.cancel_descendants_on_failure {
  1588	                    cancel_descendants(&mut run, &node_id);
  1589	                }
  1590	                refresh_ready_and_phase(&mut run);
  1591	                let timeout_key = format!(
  1592	                    "timeout:{}:{}",
  1593	                    run.nodes[index].id, run.nodes[index].attempt
  1594	                );
  1595	                self.append(
  1596	                    &mut run,
  1597	                    "workflow.node.timed-out",
  1598	                    &timeout_key,
  1599	                    Some(&node_id),
  1600	                )?;
  1601	                return Err(WorkflowError::BudgetExhausted(failure));
  1602	            }
  1603	            refresh_ready_and_phase(&mut run);
  1604	            let Some(node_id) = run
  1605	                .nodes
  1606	                .iter()
  1607	                .filter(|node| node.state == WorkflowNodeState::Ready)
  1608	                .map(|node| node.node_id.clone())
  1609	                .min()
  1610	            else {
  1611	                let settled_key = format!("settled:{}:{}", run_id, run.last_sequence);
  1612	                self.append(&mut run, "workflow.scheduler.settled", &settled_key, None)?;
  1613	                return Ok(run);
  1614	            };
  1615	            let all_runs = self.list_runs()?;
  1616	            self.rebuild_active_leases(&all_runs)?;
  1617	            let global_active = all_runs
  1618	                .iter()
  1619	                .flat_map(|candidate| &candidate.nodes)
  1620	                .filter(|node| {
  1621	                    matches!(
  1622	                        node.state,
  1623	                        WorkflowNodeState::Starting | WorkflowNodeState::Running
  1624	                    )
  1625	                })
  1626	                .count();
  1627	            let workflow_active = run
  1628	                .nodes
  1629	                .iter()
  1630	                .filter(|node| {
  1631	                    matches!(
  1632	                        node.state,
  1633	                        WorkflowNodeState::Starting | WorkflowNodeState::Running
  1634	                    )
  1635	                })
  1636	                .count();
  1637	            let index = run
  1638	                .nodes
  1639	                .iter()
  1640	                .position(|node| node.node_id == node_id)
  1641	                .unwrap();
  1642	            let role = run
  1643	                .definition
  1644	                .roles
  1645	                .iter()
  1646	                .find(|role| role.id == run.nodes[index].role_id)
  1647	                .unwrap()
  1648	                .clone();
  1649	            let provider = WorkflowPolicy::provider_for(&role)?;
  1650	            let provider_active = all_runs
  1651	                .iter()
  1652	                .flat_map(|candidate| &candidate.nodes)
  1653	                .filter(|node| {
  1654	                    matches!(
  1655	                        node.state,
  1656	                        WorkflowNodeState::Starting | WorkflowNodeState::Running
  1657	                    ) && node.provider == provider
  1658	                })
  1659	                .count();
  1660	            let provider_limit = run
  1661	                .definition
  1662	                .concurrency
  1663	                .providers
  1664	                .get(&provider)
  1665	                .copied()
  1666	                .unwrap_or(usize::MAX);
  1667	            let global_limit = run
  1668	                .definition
  1669	                .concurrency
  1670	                .global
  1671	                .min(run.definition.budgets.maximum_active_agents);
  1672	            if global_active >= global_limit
  1673	                || workflow_active >= run.definition.concurrency.workflow
  1674	                || provider_active >= provider_limit
  1675	            {
  1676	                return Ok(run);
  1677	            }
  1678	            if run.nodes[index].depth > run.definition.budgets.maximum_child_depth {
  1679	                return Err(WorkflowError::BudgetExhausted(budget_failure(
  1680	                    "depth",
  1681	                    "Child depth budget exhausted",
  1682	                )));
  1683	            }
  1684	            let cwd = run
  1685	                .input_snapshot
  1686	                .get("cwd")
  1687	                .and_then(Value::as_str)
  1688	                .unwrap_or_default()
  1689	                .to_string();
  1690	            let files = match &role.workspace_policy {
  1691	                WorkflowWorkspacePolicy::SharedCurrent { file_allow_list } => {
  1692	                    file_allow_list.clone()
  1693	                }
  1694	                _ => Vec::new(),
  1695	            };
  1696	            let allocates_worktree = matches!(
  1697	                role.workspace_policy,
  1698	                WorkflowWorkspacePolicy::DedicatedExisting { .. }
  1699	                    | WorkflowWorkspacePolicy::DedicatedNew { .. }
  1700	            );
  1701	            if allocates_worktree
  1702	                && run.worktrees_allocated >= run.definition.budgets.maximum_worktrees
  1703	            {
  1704	                return Err(WorkflowError::BudgetExhausted(budget_failure(
  1705	                    "worktrees",
  1706	                    "Workflow worktree budget exhausted",
  1707	                )));
  1708	            }
  1709	            let lease = self.leases.acquire(WorktreeLeaseRequest {
  1710	                run_id: run.id.clone(),
  1711	                node_run_id: run.nodes[index].id.clone(),
  1712	                workspace: role.workspace_policy.clone(),
  1713	                cwd: cwd.clone(),
  1714	                file_paths: files,
  1715	            })?;
  1716	            if allocates_worktree {
  1717	                run.worktrees_allocated = run.worktrees_allocated.saturating_add(1);
  1718	            }
  1719	            run.nodes[index].lease_id = Some(lease.lease_id.clone());
  1720	            run.nodes[index].state = WorkflowNodeState::Starting;
  1721	            run.nodes[index].started_at_ms = Some(self.clock.now_ms());
  1722	            run.nodes[index].provider = provider.clone();
  1723	            let starting_key = format!(
  1724	                "starting:{}:{}",
  1725	                run.nodes[index].id, run.nodes[index].attempt
  1726	            );
  1727	            self.append(
  1728	                &mut run,
  1729	                "workflow.node.starting",
  1730	                &starting_key,
  1731	                Some(&node_id),
  1732	            )?;
  1733	            let prompt = json!({ "workflowRunId": run.id, "nodeId": node_id, "inputHash": run.input_hash, "input": run.input_snapshot }).to_string();
  1734	            let dispatch = self
  1735	                .runtime
  1736	                .dispatch(AgentDispatchRequest {
  1737	                    owned_id: run.nodes[index].owned_id.clone(),
  1738	                    provider,
  1739	                    cwd: lease.cwd,
  1740	                    prompt,
  1741	                    role_id: role.id,
  1742	                    model: role.model_policy.value,
  1743	                    effort: role.effort_policy.value,
  1744	                    permission: role.permission_policy.value,
  1745	                    output_contract: role.output_contract,
  1746	                })
  1747	                .await;
  1748	            let mut run = self.require_run(run_id)?;
  1749	            let index = run
  1750	                .nodes
  1751	                .iter()
  1752	                .position(|node| node.node_id == node_id)
  1753	                .unwrap();
  1754	            match dispatch {
  1755	                Ok(receipt) => {
  1756	                    run.nodes[index].provider_instance_id = Some(receipt.provider_instance_id);
  1757	                    run.nodes[index].state = WorkflowNodeState::Running;
  1758	                    let running_key = format!(
  1759	                        "running:{}:{}",
  1760	                        run.nodes[index].id, run.nodes[index].attempt
  1761	                    );
  1762	                    self.append(
  1763	                        &mut run,
  1764	                        "workflow.node.running",
  1765	                        &running_key,
  1766	                        Some(&node_id),
  1767	                    )?;
  1768	                }
  1769	                Err(error) => {
  1770	                    if let Some(lease_id) = run.nodes[index].lease_id.take() {
  1771	                        self.leases.release(&lease_id)?;
  1772	                    }
  1773	                    run.nodes[index].state = WorkflowNodeState::Failed;
  1774	                    run.nodes[index].failure = Some(WorkflowFailure {
  1775	                        code: "runtime".into(),
  1776	                        message: error.to_string(),
  1777	                        budget: None,
  1778	                    });
  1779	                    if run.definition.completion.cancel_descendants_on_failure {
  1780	                        cancel_descendants(&mut run, &node_id);
  1781	                    }
  1782	                    refresh_ready_and_phase(&mut run);
  1783	                    let failed_key = format!(
  1784	                        "failed:{}:{}",
  1785	                        run.nodes[index].id, run.nodes[index].attempt
  1786	                    );
  1787	                    self.append(
  1788	                        &mut run,
  1789	                        "workflow.node.failed",
  1790	                        &failed_key,
  1791	                        Some(&node_id),
  1792	                    )?;
  1793	                    return Err(error);
  1794	                }
  1795	            }
  1796	        }
  1797	    }
  1798	
  1799	    pub fn rebuild_from_events(&self) -> Result<Vec<WorkflowRunRecord>, WorkflowError> {
  1800	        self.list_runs()
  1801	    }
  1802	    pub fn list_runs(&self) -> Result<Vec<WorkflowRunRecord>, WorkflowError> {
  1803	        WorkflowReducer::reduce(read_workflow_event_values().map_err(WorkflowError::Ledger)?)
  1804	    }
  1805	
  1806	    fn require_run(&self, run_id: &str) -> Result<WorkflowRunRecord, WorkflowError> {
  1807	        self.list_runs()?
  1808	            .into_iter()
  1809	            .find(|run| run.id == run_id)
  1810	            .ok_or_else(|| WorkflowError::NotFound(run_id.into()))
  1811	    }
  1812	
  1813	    fn rebuild_active_leases(&self, runs: &[WorkflowRunRecord]) -> Result<(), WorkflowError> {
  1814	        let active = runs
  1815	            .iter()
  1816	            .flat_map(|run| {
  1817	                run.nodes.iter().filter_map(move |node| {
  1818	                    if node.lease_id.is_none()
  1819	                        || !matches!(
  1820	                            node.state,
  1821	                            WorkflowNodeState::Starting
  1822	                                | WorkflowNodeState::Running
  1823	                                | WorkflowNodeState::WaitingApproval
  1824	                                | WorkflowNodeState::WaitingInput
  1825	                        )
  1826	                    {
  1827	                        return None;
  1828	                    }
  1829	                    let role = run
  1830	                        .definition
  1831	                        .roles
  1832	                        .iter()
  1833	                        .find(|role| role.id == node.role_id)?;
  1834	                    let file_paths = match &role.workspace_policy {
  1835	                        WorkflowWorkspacePolicy::SharedCurrent { file_allow_list } => {
  1836	                            file_allow_list.clone()
  1837	                        }
  1838	                        _ => Vec::new(),
  1839	                    };
  1840	                    Some(WorktreeLeaseRequest {
  1841	                        run_id: run.id.clone(),
  1842	                        node_run_id: node.id.clone(),
  1843	                        workspace: role.workspace_policy.clone(),
  1844	                        cwd: run
  1845	                            .input_snapshot
  1846	                            .get("cwd")
  1847	                            .and_then(Value::as_str)
  1848	                            .unwrap_or_default()
  1849	                            .to_string(),
  1850	                        file_paths,
  1851	                    })
  1852	                })
  1853	            })
  1854	            .collect();
  1855	        self.leases.rebuild(active)
  1856	    }
  1857	
  1858	    fn idempotent_run(
  1859	        &self,
  1860	        run_id: &str,
  1861	        key: &str,
  1862	    ) -> Result<Option<WorkflowRunRecord>, WorkflowError> {
  1863	        if key.trim().is_empty() {
  1864	            return Ok(None);
  1865	        }
  1866	        let events = read_workflow_event_values().map_err(WorkflowError::Ledger)?;
  1867	        let duplicate = events.iter().any(|event| {
  1868	            event.get("runId").and_then(Value::as_str) == Some(run_id)
  1869	                && event.get("idempotencyKey").and_then(Value::as_str) == Some(key)
  1870	        });
  1871	        if duplicate {
  1872	            Ok(Some(self.require_run(run_id)?))
  1873	        } else {
  1874	            Ok(None)
  1875	        }
  1876	    }
  1877	
  1878	    fn idempotent_workflow_run(
  1879	        &self,
  1880	        workflow_id: &str,
  1881	        key: &str,
  1882	    ) -> Result<Option<WorkflowRunRecord>, WorkflowError> {
  1883	        if key.trim().is_empty() {
  1884	            return Ok(None);
  1885	        }
  1886	        let events = read_workflow_event_values().map_err(WorkflowError::Ledger)?;
  1887	        Ok(events.into_iter().find_map(|event| {
  1888	            if event.get("workflowId").and_then(Value::as_str) == Some(workflow_id)
  1889	                && event.get("idempotencyKey").and_then(Value::as_str) == Some(key)
  1890	            {
  1891	                event
  1892	                    .get("workflowPayload")
  1893	                    .and_then(|payload| payload.get("run"))
  1894	                    .cloned()
  1895	                    .and_then(|value| serde_json::from_value(value).ok())
  1896	            } else {
  1897	                None
  1898	            }
  1899	        }))
  1900	    }
  1901	    fn append(
  1902	        &self,
  1903	        run: &mut WorkflowRunRecord,
  1904	        kind: &str,
  1905	        idempotency_key: &str,
  1906	        node_id: Option<&str>,
  1907	    ) -> Result<(), WorkflowError> {
  1908	        run.updated_at_ms = self.clock.now_ms();
  1909	        run.phase = derive_phase(run);
  1910	        let node = node_id.and_then(|id| run.nodes.iter().find(|node| node.node_id == id));
  1911	        let event = json!({
  1912	            "schemaVersion": 1, "runId": run.id, "timestamp": run.updated_at_ms.to_string(), "kind": kind,
  1913	            "status": format!("{:?}", run.state).to_ascii_lowercase(), "workflowId": run.workflow_id,
  1914	            "workflowVersion": run.definition.version, "nodeId": node_id,
  1915	            "nodeRunId": node.map(|value| value.id.clone()),
  1916	            "ownedId": node.map(|value| value.owned_id.clone()),
  1917	            "attempt": node.map(|value| value.attempt), "depth": node.map(|value| value.depth),
  1918	            "inputHash": run.input_hash,
  1919	            "outputContract": node.map(|value| value.output_contract.name()),
  1920	            "workflowArtifacts": node.map(|value| value.artifacts.clone()),
  1921	            "gateId": node.and_then(|value| value.gate.as_ref().map(|gate| gate.id.clone())),
  1922	            "leaseId": node.and_then(|value| value.lease_id.clone()),
  1923	            "providerInstanceId": node.and_then(|value| value.provider_instance_id.clone()),
  1924	            "idempotencyKey": idempotency_key, "provenance": "workflow-agent", "workflowPayload": { "run": run }
  1925	        });
  1926	        let stored = append_workflow_event_value(event).map_err(WorkflowError::Ledger)?;
  1927	        run.last_sequence = stored
  1928	            .get("sequence")
  1929	            .and_then(Value::as_u64)
  1930	            .unwrap_or(run.last_sequence);
  1931	        Ok(())
  1932	    }
  1933	}
  1934	
  1935	fn enforce_budgets(run: &WorkflowRunRecord, now_ms: u64) -> Result<(), WorkflowError> {
  1936	    if now_ms.saturating_sub(run.created_at_ms)
  1937	        > run
  1938	            .definition
  1939	            .budgets
  1940	            .maximum_wall_time_seconds
  1941	            .saturating_mul(1000)
  1942	    {
  1943	        return Err(WorkflowError::BudgetExhausted(budget_failure(
  1944	            "wall-time",
  1945	            "Workflow wall-time budget exhausted",
  1946	        )));
  1947	    }
  1948	    if run
  1949	        .definition
  1950	        .budgets
  1951	        .maximum_tokens
  1952	        .is_some_and(|limit| run.tokens_used > limit)
  1953	    {
  1954	        return Err(WorkflowError::BudgetExhausted(budget_failure(
  1955	            "tokens",
  1956	            "Workflow token budget exhausted",
  1957	        )));
  1958	    }
  1959	    if run.tool_terminals_used > run.definition.budgets.maximum_tool_terminals {
  1960	        return Err(WorkflowError::BudgetExhausted(budget_failure(
  1961	            "tool-terminals",
  1962	            "Workflow tool-terminal budget exhausted",
  1963	        )));
  1964	    }
  1965	    if run.worktrees_allocated > run.definition.budgets.maximum_worktrees {
  1966	        return Err(WorkflowError::BudgetExhausted(budget_failure(
  1967	            "worktrees",
  1968	            "Workflow worktree budget exhausted",
  1969	        )));
  1970	    }
  1971	    Ok(())
  1972	}
  1973	
  1974	fn enforce_node_timeout(
  1975	    run: &WorkflowRunRecord,
  1976	    node_index: usize,
  1977	    now_ms: u64,
  1978	) -> Result<(), WorkflowError> {
  1979	    let node = &run.nodes[node_index];
  1980	    let definition = run
  1981	        .definition
  1982	        .nodes
  1983	        .iter()
  1984	        .find(|candidate| candidate.id == node.node_id)
  1985	        .ok_or_else(|| WorkflowError::NotFound(node.node_id.clone()))?;
  1986	    if node.started_at_ms.is_some_and(|started| {
  1987	        now_ms.saturating_sub(started) > definition.timeout_seconds.saturating_mul(1000)
  1988	    }) {
  1989	        return Err(WorkflowError::BudgetExhausted(budget_failure(
  1990	            "node-timeout",
  1991	            "Workflow node timeout exhausted",
  1992	        )));
  1993	    }
  1994	    Ok(())
  1995	}
  1996	
  1997	fn budget_failure(budget: &str, message: &str) -> WorkflowFailure {
  1998	    WorkflowFailure {
  1999	        code: "budget-exhausted".into(),
  2000	        message: message.into(),
  2001	        budget: Some(budget.into()),
  2002	    }
  2003	}
  2004	
  2005	fn refresh_ready_and_phase(run: &mut WorkflowRunRecord) {
  2006	    for node_id in WorkflowScheduler::ready_nodes(run) {
  2007	        if let Some(node) = run.nodes.iter_mut().find(|node| node.node_id == node_id) {
  2008	            node.state = WorkflowNodeState::Ready;
  2009	        }
  2010	    }
  2011	    if run.nodes.iter().all(|node| {
  2012	        matches!(
  2013	            node.state,
  2014	            WorkflowNodeState::Completed | WorkflowNodeState::Skipped
  2015	        )
  2016	    }) {
  2017	        run.state = WorkflowRunState::Completed;
  2018	    } else if run
  2019	        .nodes
  2020	        .iter()
  2021	        .any(|node| node.state == WorkflowNodeState::WaitingApproval)
  2022	    {
  2023	        run.state = WorkflowRunState::WaitingApproval;
  2024	    } else if run
  2025	        .nodes
  2026	        .iter()
  2027	        .any(|node| node.state == WorkflowNodeState::WaitingInput)
  2028	    {
  2029	        run.state = WorkflowRunState::WaitingInput;
  2030	    } else if run
  2031	        .nodes
  2032	        .iter()
  2033	        .any(|node| node.state == WorkflowNodeState::Failed)
  2034	        && !run.nodes.iter().any(|node| {
  2035	            matches!(
  2036	                node.state,
  2037	                WorkflowNodeState::Running | WorkflowNodeState::Ready | WorkflowNodeState::Starting
  2038	            )
  2039	        })
  2040	    {
  2041	        run.state = WorkflowRunState::Failed;
  2042	    }
  2043	    run.phase = derive_phase(run);
  2044	}
  2045	
  2046	fn cancel_descendants(run: &mut WorkflowRunRecord, failed_node_id: &str) {
  2047	    let mut cancelled = BTreeSet::from([failed_node_id.to_string()]);
  2048	    loop {
  2049	        let next: Vec<_> =
  2050	            run.definition
  2051	                .nodes
  2052	                .iter()
  2053	                .filter(|definition| {
  2054	                    !cancelled.contains(&definition.id)
  2055	                        && (definition
  2056	                            .depends_on
  2057	                            .iter()
  2058	                            .any(|dependency| cancelled.contains(dependency))
  2059	                            || run.definition.edges.iter().any(|edge| {
  2060	                                edge.to == definition.id && cancelled.contains(&edge.from)
  2061	                            }))
  2062	                })
  2063	                .map(|definition| definition.id.clone())
  2064	                .collect();
  2065	        if next.is_empty() {
  2066	            break;
  2067	        }
  2068	        cancelled.extend(next);
  2069	    }
  2070	    for node in &mut run.nodes {
  2071	        if node.node_id != failed_node_id
  2072	            && cancelled.contains(&node.node_id)
  2073	            && !matches!(
  2074	                node.state,
  2075	                WorkflowNodeState::Completed | WorkflowNodeState::Skipped
  2076	            )
  2077	        {
  2078	            node.state = WorkflowNodeState::Cancelled;
  2079	        }
  2080	    }
  2081	}
  2082	
  2083	fn derive_phase(run: &WorkflowRunRecord) -> WorkflowLoopPhase {
  2084	    match run.state {
  2085	        WorkflowRunState::Draft | WorkflowRunState::Queued => WorkflowLoopPhase::Draft,
  2086	        WorkflowRunState::Completed => WorkflowLoopPhase::Completed,
  2087	        WorkflowRunState::Failed => WorkflowLoopPhase::Failed,
  2088	        WorkflowRunState::Cancelled => WorkflowLoopPhase::Cancelled,
  2089	        WorkflowRunState::WaitingApproval => WorkflowLoopPhase::Approval,
  2090	        _ => {
  2091	            let active_roles: Vec<_> = run
  2092	                .nodes
  2093	                .iter()
  2094	                .filter(|node| {
  2095	                    matches!(
  2096	                        node.state,
  2097	                        WorkflowNodeState::Ready
  2098	                            | WorkflowNodeState::Queued
  2099	                            | WorkflowNodeState::Starting
  2100	                            | WorkflowNodeState::Running
  2101	                            | WorkflowNodeState::WaitingInput
  2102	                    )
  2103	                })
  2104	                .map(|node| node.role_id.to_ascii_lowercase())
  2105	                .collect();
  2106	            if active_roles.iter().any(|role| role.contains("review")) {
  2107	                WorkflowLoopPhase::Reviewing
  2108	            } else if active_roles
  2109	                .iter()
  2110	                .any(|role| role.contains("verif") || role.contains("test"))
  2111	            {
  2112	                WorkflowLoopPhase::Verifying
  2113	            } else if active_roles.is_empty() {
  2114	                WorkflowLoopPhase::Scheduling
  2115	            } else {
  2116	                WorkflowLoopPhase::Implementing
  2117	            }
  2118	        }
  2119	    }
  2120	}
  2121	
  2122	fn canonical_json(value: &Value) -> String {
  2123	    match value {
  2124	        Value::Object(map) => {
  2125	            let ordered: BTreeMap<_, _> = map.iter().collect();
  2126	            format!(
  2127	                "{{{}}}",
  2128	                ordered
  2129	                    .into_iter()
  2130	                    .map(|(key, value)| format!(
  2131	                        "{}:{}",
  2132	                        serde_json::to_string(key).unwrap(),
  2133	                        canonical_json(value)
  2134	                    ))
  2135	                    .collect::<Vec<_>>()
  2136	                    .join(",")
  2137	            )
  2138	        }
  2139	        Value::Array(values) => format!(
  2140	            "[{}]",
  2141	            values
  2142	                .iter()
  2143	                .map(canonical_json)
  2144	                .collect::<Vec<_>>()
  2145	                .join(",")
  2146	        ),
  2147	        _ => serde_json::to_string(value).unwrap_or_default(),
  2148	    }
  2149	}
  2150	
  2151	fn stable_hash(value: &str) -> String {
  2152	    let mut hash = 0xcbf2_9ce4_8422_2325u64;
  2153	    for byte in value.bytes() {
  2154	        hash ^= u64::from(byte);
  2155	        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
  2156	    }
  2157	    format!("fnv1a64:{hash:016x}")
  2158	}
