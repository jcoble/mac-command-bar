  2631	fn project_git_status_sync(root: PathBuf) -> Result<ProjectGitStatus, String> {
  2632	    validate_git_root(&root)?;
  2633	
  2634	    let root_arg = root.display().to_string();
  2635	    let output = Command::new("git")
  2636	        .args([
  2637	            "-C",
  2638	            root_arg.as_str(),
  2639	            "status",
  2640	            "--porcelain=v1",
  2641	            "--branch",
  2642	            "--untracked-files=normal",
  2643	        ])
  2644	        .output()
  2645	        .map_err(|error| format!("Could not run git status: {error}"))?;
  2646	
  2647	    if !output.status.success() {
  2648	        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  2649	        return Err(if stderr.is_empty() {
  2650	            format!("git status exited with {}", output.status)
  2651	        } else {
  2652	            stderr
  2653	        });
  2654	    }
  2655	
  2656	    parse_project_git_status(&String::from_utf8_lossy(&output.stdout))
  2657	}
