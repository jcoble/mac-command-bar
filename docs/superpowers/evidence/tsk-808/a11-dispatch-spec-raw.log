   170	/**
   171	 * Split the changed files into the three groups the panel shows. A file with
   172	 * both staged and unstaged work appears in two groups — that is the truth, and
   173	 * it is how the old shell showed it.
   174	 */
   175	export function buildGitStatusFileGroups(files: ProjectGitFileStatus[]): GitStatusFileGroup[] {
   176	  const staged = files.filter(isGitFileStaged);
   177	  const unstaged = files.filter(
   178	    (file) => hasGitFileUnstagedChanges(file) && !isGitFileUntracked(file)
   179	  );
   180	  const untracked = files.filter(isGitFileUntracked);
   181	
   182	  const groups: GitStatusFileGroup[] = [
   183	    { id: 'staged', label: 'Staged', files: staged, action: 'unstage' },
   184	    { id: 'unstaged', label: 'Changed', files: unstaged, action: 'stage' },
   185	    { id: 'untracked', label: 'New files', files: untracked, action: 'stage' }
   186	  ];
   187	  return groups.filter((group) => group.files.length > 0);
   188	}
   189	
   190	/** "Staged 2 · Changed 5", or a plain sentence when there is nothing. */
   191	export function describeGitStatusGroups(groups: GitStatusFileGroup[]): string {
   192	  if (groups.length === 0) return 'No changed files';
   193	  return groups.map((group) => `${group.label} ${group.files.length}`).join(' · ');
   194	}
   195	
   196	export function gitStatusGroupActionLabel(group: GitStatusFileGroup): string {
   197	  return group.action === 'unstage' ? 'Unstage all' : 'Stage all';
   198	}
