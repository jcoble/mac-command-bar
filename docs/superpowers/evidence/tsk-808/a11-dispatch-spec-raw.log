   756	/**
   757	 * Build a confirmation preview, then commit only when the same owner,
   758	 * generation and draft snapshot still exist.  Queue removal is the final
   759	 * mutation, so every rejected path keeps feedback available to retry.
   760	 */
   761	export function stageBrowserFeedbackPreview(
   762	  first?: BrowserWorkspaceState | BrowserModelContext | BrowserFeedbackStageOptions,
   763	  second?: BrowserFeedbackStageOptions | BrowserModelContext
   764	): BrowserFeedbackPreview {
   765	  const context = isWorkspace(first) || isContext(first) ? contextFor(first, second) : contextFor();
   766	  const options = (isWorkspace(first) || isContext(first) ? second : first) as BrowserFeedbackStageOptions | undefined;
   767	  const bridge = options?.bridge ?? options?.conversation ?? context.conversation;
   768	  const attachment = context.workspace.queue.find((item) => !options?.attachmentId || item.id === options.attachmentId) ?? null;
   769	  const ownedId = options?.ownedId ?? context.workspace.ownedId;
   770	  const generation = options?.generation ?? context.workspace.activeGeneration;
   771	  const conversation = ownedId ? readConversation(bridge, ownedId) : null;
   772	  const currentDraft = conversation?.draft ?? '';
   773	  const currentAttachments = conversation?.attachments ? [...conversation.attachments] : [];
   774	  const expectedDraft = options?.draftSnapshot ?? options?.draft;
   775	  const stale =
   776	    !attachment ||
   777	    !ownedId ||
   778	    !bridge ||
   779	    !conversation ||
   780	    ownedId !== context.workspace.ownedId ||
   781	    generation !== context.workspace.activeGeneration ||
   782	    conversation.generation !== generation;
   783	  const conflict = !stale && expectedDraft !== undefined && expectedDraft !== currentDraft;
   784	  const status: BrowserFeedbackPreview['status'] = !attachment
   785	    ? 'empty'
   786	    : stale
   787	      ? 'stale-target'
   788	      : conflict
   789	        ? 'draft-conflict'
   790	        : 'ready';
   791	  const preview: BrowserFeedbackPreview = {
   792	    status,
   793	    queueRetained: true,
   794	    attachment,
   795	    currentDraft,
   796	    mergedDraft: attachment && status === 'ready' ? mergedDraft(currentDraft, attachment) : currentDraft,
   797	    currentAttachments,
   798	    commit: async () => {
   799	      if (!attachment || status !== 'ready') {
   800	        return stageResult(status === 'ready' ? 'empty' : status, true, attachment);
   801	      }
   802	      if (!bridge) return stageResult('attachment-error', true, attachment);
   803	      const latestConversation = ownedId ? readConversation(bridge, ownedId) : null;
   804	      if (!ownedId || !latestConversation || ownedId !== context.workspace.ownedId || generation !== context.workspace.activeGeneration || latestConversation.generation !== generation) {
   805	        return stageResult('stale-target', true, attachment);
   806	      }
   807	      if (expectedDraft !== undefined && latestConversation?.draft !== expectedDraft) {
   808	        return stageResult('draft-conflict', true, attachment);
   809	      }
   810	      try {
   811	        let nextAttachments = [...(latestConversation?.attachments ?? currentAttachments)];
   812	        const bytes = attachmentBytesFor(context, attachment);
   813	        if (bytes && bridge?.saveAttachment && attachment.imageAttachmentId) {
   814	          const saved = await bridge.saveAttachment({
   815	            ownedId,
   816	            name: `${attachment.id}.png`,
   817	            mimeType: 'image/png',
   818	            bytes
   819	          });
   820	          nextAttachments = [...nextAttachments, saved];
   821	        }
   822	        if (bridge?.setDraft) await bridge.setDraft(ownedId, mergedDraft(latestConversation?.draft ?? currentDraft, attachment));
   823	        if (bridge?.setAttachments) await bridge.setAttachments(ownedId, nextAttachments);
   824	        context.workspace.queue = context.workspace.queue.filter((item) => item.id !== attachment.id);
   825	        const tab = context.workspace.tabs[attachment.tabId];
   826	        if (tab) tab.annotations = tab.annotations.filter((item) => item.id !== attachment.id);
   827	        if (attachment.imageAttachmentId && context.workspace.markupCaptures) {
   828	          delete context.workspace.markupCaptures[attachment.imageAttachmentId];
   829	        }
   830	        return stageResult('staged', false, attachment);
   831	      } catch (error) {
   832	        context.workspace.error = describeError(error);
   833	        return stageResult('attachment-error', true, attachment);
   834	      }
   835	    }
   836	  };
   837	  if (options?.confirm) void preview.commit();
   838	  return preview;
   839	}
