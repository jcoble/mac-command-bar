   276	fn orchestration_writer_lock() -> &'static Mutex<()> {
   277	    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();
   278	    LOCK.get_or_init(|| Mutex::new(()))
   279	}
   280	
   281	/// Append a WorkflowEngine transition to the one orchestration ledger. Sequence allocation and
   282	/// idempotency are guarded by the same writer lock so a single app process has one total order.
   283	pub(crate) fn append_workflow_event_value(
   284	    value: serde_json::Value,
   285	) -> Result<serde_json::Value, String> {
   286	    let _writer = orchestration_writer_lock()
   287	        .lock()
   288	        .map_err(|_| "Orchestration event writer is unavailable".to_string())?;
   289	    let mut event = serde_json::from_value::<OrchestrationEvent>(value)
   290	        .map_err(|error| format!("Invalid workflow event: {error}"))?;
   291	    if event
   292	        .workflow_id
   293	        .as_deref()
   294	        .unwrap_or_default()
   295	        .trim()
   296	        .is_empty()
   297	        || !event.kind.starts_with("workflow.")
   298	    {
   299	        return Err("Workflow event requires workflowId and a workflow.* kind".to_string());
   300	    }
   301	    normalize_orchestration_event(&mut event)?;
   302	    let existing = read_orchestration_events()?;
   303	    if let Some(key) = event.idempotency_key.as_deref() {
   304	        if let Some(prior) = existing.iter().find(|candidate| {
   305	            candidate.run_id == event.run_id && candidate.idempotency_key.as_deref() == Some(key)
   306	        }) {
   307	            return serde_json::to_value(prior)
   308	                .map_err(|error| format!("Could not serialize workflow event: {error}"));
   309	        }
   310	    }
   311	    let current_sequence = existing
   312	        .iter()
   313	        .filter(|candidate| candidate.run_id == event.run_id)
   314	        .filter_map(|candidate| candidate.sequence)
   315	        .max()
   316	        .unwrap_or_default();
   317	    let expected_sequence = event
   318	        .workflow_payload
   319	        .as_ref()
   320	        .and_then(|payload| payload.get("run"))
   321	        .and_then(|run| run.get("lastSequence"))
   322	        .and_then(serde_json::Value::as_u64)
   323	        .unwrap_or_default();
   324	    if expected_sequence != current_sequence {
   325	        return Err(format!(
   326	            "Stale workflow transition: expected sequence {expected_sequence}, current sequence {current_sequence}"
   327	        ));
   328	    }
   329	    event.sequence = Some(current_sequence.saturating_add(1));
   330	    append_orchestration_event(&event)?;
   331	    serde_json::to_value(event)
   332	        .map_err(|error| format!("Could not serialize workflow event: {error}"))
   333	}
   334	
   335	pub(crate) fn read_workflow_event_values() -> Result<Vec<serde_json::Value>, String> {
   336	    read_orchestration_events()?
   337	        .into_iter()
   338	        .filter(|event| event.workflow_id.is_some() && event.kind.starts_with("workflow."))
   339	        .map(|event| {
   340	            serde_json::to_value(event)
   341	                .map_err(|error| format!("Could not serialize workflow event: {error}"))
   342	        })
   343	        .collect()
   344	}
   345	
   346	fn normalize_orchestration_event(event: &mut OrchestrationEvent) -> Result<(), String> {
   347	    event.run_id = event.run_id.trim().to_string();
   348	    if event.run_id.is_empty() {
   349	        return Err("Orchestration event runId is required".to_string());
   350	    }
