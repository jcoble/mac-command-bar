    37	  let {
    38	    onResetLayout,
    39	    onRescanSessions,
    40	    onStartNewSession,
    41	    newSessionRoots,
    42	    message,
    43	    onProblemsLocationChange
    44	  }: Props = $props();
    45	
    46	  let settingsHost: { open: () => void; close: () => void } | null = null;
    47	  let newSessionHost: { open: (input?: { sessionRoots?: string[] }) => void } | null = null;
    48	
    49	  /** Open the settings dialog from outside — the gear on the activity bar is
    50	   * over in the left column, and the dialog lives here. Same shape as
