    91	/** Merge provider commands/skills with Assembly actions, preserving source order and ids. */
    92	export function mergeConversationCommandCatalog(
    93	  providerCommands: readonly AgentCommandDescriptor[] = [],
    94	  providerSkills: readonly AgentCommandDescriptor[] = [],
    95	  assemblyCommands: readonly AssemblyConversationCommand[] = DEFAULT_ASSEMBLY_CONVERSATION_COMMANDS
    96	): ConversationCommand[] {
    97	  const merged: ConversationCommand[] = [];
    98	  const seen = new Set<string>();
    99	  const add = (command: ConversationCommand | null): void => {
   100	    if (!command || seen.has(command.name)) return;
   101	    seen.add(command.name);
   102	    merged.push(command);
   103	  };
   104	  providerCommands.forEach((command) => add(providerCommand(command, 'provider')));
   105	  providerSkills.forEach((command) => add(providerCommand(command, 'skill')));
   106	  assemblyCommands.forEach((command) => add(assemblyCommand(command)));
   107	  return merged;
   108	}
   109	
   110	export function filterConversationCommandCatalog(
   111	  catalog: readonly ConversationCommand[],
   112	  query: string
   113	): ConversationCommand[] {
   114	  const normalized = query.trim().replace(/^\/+/, '').toLowerCase();
   115	  if (!normalized) return [...catalog];
   116	  return catalog.filter((command) => {
   117	    const haystack = `${command.name} ${command.label} ${command.description ?? ''}`.toLowerCase();
   118	    return haystack.includes(normalized);
   119	  });
   120	}
   121	
   122	export function slashName(command: ConversationCommand): string {
   123	  return `/${command.name}`;
   124	}
