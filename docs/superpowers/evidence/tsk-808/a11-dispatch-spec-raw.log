  8328	    fn unique_temp_root() -> PathBuf {
  8329	        static TEMP_ROOT_COUNTER: std::sync::atomic::AtomicUsize =
  8330	            std::sync::atomic::AtomicUsize::new(0);
  8331	
  8332	        let unique = SystemTime::now()
  8333	            .duration_since(UNIX_EPOCH)
  8334	            .unwrap()
  8335	            .as_nanos();
  8336	        let counter = TEMP_ROOT_COUNTER.fetch_add(1, Ordering::Relaxed);
  8337	        std::env::temp_dir().join(format!(
  8338	            "mac-command-bar-tauri-source-test-{}-{unique}-{counter}",
  8339	            std::process::id()
  8340	        ))
  8341	    }
  8342	
  8343	    fn run_git_for_test(root: &Path, args: &[&str]) {
  8344	        let output = Command::new("git")
  8345	            .args(["-C", root.to_str().unwrap()])
  8346	            .args(args)
  8347	            .output()
  8348	            .unwrap_or_else(|error| panic!("could not run git {args:?}: {error}"));
  8349	        assert!(
  8350	            output.status.success(),
  8351	            "git {args:?} failed: {}",
  8352	            String::from_utf8_lossy(&output.stderr)
  8353	        );
  8354	    }
  8355	}

