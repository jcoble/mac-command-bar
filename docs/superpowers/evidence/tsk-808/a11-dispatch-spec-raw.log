   141	// ── the dev server's read-only bridge ───────────────────────────────────────
   142	
   143	/**
   144	 * Ask the dev server one git question. `null` means the bridge is not there —
   145	 * a built page with no dev server behind it, for instance — which is a reason
   146	 * to say "desktop app only", not an error to show.
   147	 */
   148	export async function postGitBridge<T>(
   149	  route: string,
   150	  payload: Record<string, unknown>
   151	): Promise<T | null> {
   152	  if (!hasGitBridge()) return null;
   153	
   154	  let response: Response;
   155	  try {
   156	    response = await fetch(`/__mcb/git/${route}`, {
   157	      method: 'POST',
   158	      headers: { 'content-type': 'application/json' },
   159	      body: JSON.stringify(payload)
   160	    });
   161	  } catch {
   162	    return null;
   163	  }
   164	
   165	  if (!(response.headers.get('content-type') ?? '').includes('application/json')) return null;
   166	  const text = await response.text();
   167	  const body = text ? JSON.parse(text) : null;
   168	
   169	  if (!response.ok) {
   170	    const message =
   171	      body && typeof body === 'object' && 'error' in body
   172	        ? String((body as { error: unknown }).error)
   173	        : `The git bridge answered with HTTP ${response.status}`;
   174	    throw new Error(message);
   175	  }
   176	
   177	  return body as T;
   178	}
   179	
   180	// ── desktop first, bridge second ────────────────────────────────────────────
   181	
   182	/**
   183	 * Which files one commit touched. An empty list is a real answer: a merge
   184	 * commit brings no changes of its own, so git lists nothing for it.
   185	 */
   186	export async function readCommitFiles(
   187	  root: string,
   188	  sha: string
   189	): Promise<GitCommitFileChange[] | null> {
   190	  const fromDesktop = await askDesktop(() => readGitCommitFilesFromTauri(root, sha));
   191	  if (fromDesktop) return fromDesktop;
   192	  return postGitBridge<GitCommitFileChange[]>('commit-files', { root, sha });
   193	}
   194	
   195	/**
   196	 * Run a desktop call, turning "that command does not exist" into one plain
   197	 * sentence. Every other failure keeps git's own words.
   198	 */
   199	async function askDesktop<T>(run: () => Promise<T | null>): Promise<T | null> {
   200	  try {
   201	    return await run();
   202	  } catch (error) {
   203	    if (isMissingCommandError(error)) throw new Error(MISSING_COMMAND_MESSAGE);
   204	    throw error;
   205	  }
   206	}
   207	
   208	/** What changed inside one file of one commit. `relativePath` is repository-relative. */
   209	export async function readCommitFileDiff(
   210	  root: string,
   211	  sha: string,
   212	  relativePath: string
   213	): Promise<SourceGitDiff | null> {
   214	  const fromDesktop = await askDesktop(() =>
   215	    readGitCommitFileDiffFromTauri(root, sha, relativePath)
   216	  );
   217	  if (fromDesktop) return fromDesktop;
   218	  return postGitBridge<SourceGitDiff>('commit-file-diff', { root, sha, relativePath });
   219	}
