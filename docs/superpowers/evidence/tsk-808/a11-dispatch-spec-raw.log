   117	export function selectionFromElementInput(
   118	  tab: BrowserTabState,
   119	  input: {
   120	    selector?: string | null;
   121	    accessibleName?: string | null;
   122	    textSnippet?: string | null;
   123	    imageAttachmentId?: string | null;
   124	    rect?: { x: number; y: number; width: number; height: number } | null;
   125	    classCount?: number;
   126	    classes?: readonly string[];
   127	    sourceHash?: string;
   128	    url?: string;
   129	    title?: string;
   130	    generation?: number;
   131	  }
   132	): BrowserElementSelection {
   133	  const selector = boundSelector(input.selector);
   134	  const textSnippet = boundTextSnippet(input.textSnippet);
   135	  const classes = Array.isArray(input.classes)
   136	    ? input.classes
   137	        .filter((value): value is string => typeof value === 'string' && value.trim().length > 0)
   138	        .slice(0, 32)
   139	        .map((value) => value.trim())
   140	    : [];
   141	  const classCount = boundClassCount(input.classCount ?? classes.length);
   142	  const rect = input.rect
   143	    ? {
   144	        x: Number.isFinite(input.rect.x) ? input.rect.x : 0,
   145	        y: Number.isFinite(input.rect.y) ? input.rect.y : 0,
   146	        width: Math.max(0, Number.isFinite(input.rect.width) ? input.rect.width : 0),
   147	        height: Math.max(0, Number.isFinite(input.rect.height) ? input.rect.height : 0)
   148	      }
   149	    : null;
   150	  const generation = Number.isFinite(input.generation) ? Math.floor(input.generation as number) : tab.generation;
   151	  return {
   152	    workspaceId: tab.workspaceId,
   153	    tabId: tab.id,
   154	    generation,
   155	    url: text(input.url) || tab.url,
   156	    title: text(input.title) || tab.title,
   157	    selector,
   158	    accessibleName: text(input.accessibleName) || null,
   159	    textSnippet,
   160	    imageAttachmentId: text(input.imageAttachmentId) || null,
   161	    rect,
   162	    classes,
   163	    classCount,
   164	    sourceHash:
   165	      text(input.sourceHash) ||
   166	      browserSourceHash([tab.workspaceId, tab.id, generation, tab.url, selector, textSnippet, classes.join('.')])
   167	  };
   168	}
