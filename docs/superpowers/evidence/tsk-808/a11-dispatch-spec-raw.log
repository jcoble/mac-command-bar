   762	  /** EXPLICIT IO: scan for resumable agent sessions (Tauri first, bridge second).
   763	   * ONE counted call per rescan, named for the transport that actually ran. */
   764	  async function scanRail(): Promise<void> {
   765	    if (rail.scanning) return;
   766	    rail.scanning = true;
   767	    rail.error = null;
   768	    let nativeError: string | null = null;
   769	    try {
   770	      let sessions: AgentSession[] | null = null;
   771	      try {
   772	        sessions = await listAgentSessionsFromTauri();
   773	      } catch (error) {
   774	        nativeError = describeError(error);
   775	      }
   776	      // A `null` native result with no error = not under Tauri: nothing invoked.
   777	      countInvoke((sessions ?? nativeError) ? 'list_agent_sessions' : 'bridge:agent-sessions');
   778	      sessions ??= await listAgentSessionsFromLocalBridge();
   779	      if (disposed) return;
   780	      setAvailable(sessions ?? []);
   781	      // Surface the native failure only if the bridge produced nothing either.
   782	      if (sessions === null && nativeError) rail.error = `session scan failed: ${nativeError}`;
   783	    } catch (error) {
   784	      if (!disposed) rail.error = `session scan failed: ${nativeError ?? describeError(error)}`;
   785	    } finally {
   786	      rail.scanning = false;
   787	    }
   788	  }
