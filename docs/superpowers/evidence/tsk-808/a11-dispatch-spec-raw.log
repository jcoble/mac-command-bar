   109	/** Revoke only URLs owned by this surface; the managed path never goes through the DOM. */
   110	export function cleanupConversationAttachmentPreview(attachment: ConversationAttachment): void {
   111	  if (attachment.previewUrl.startsWith('blob:')) URL.revokeObjectURL(attachment.previewUrl);
