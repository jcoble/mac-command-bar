     1	<script lang="ts">
     2	  /**
     3	   * ShellFrame.svelte — mounts the Gridview root + center Dockview and
     4	   * teleports Svelte-owned content into them. All content is authored in the
     5	   * hidden parking stage below, so dockview NEVER owns app DOM; if the frame
     6	   * fails to mount, content simply stays parked (invisible) and the page's
     7	   * error rail reports it. No backend IO anywhere in this component.
     8	   */
     9	  import 'dockview-core/dist/styles/dockview.css';
    10	  import { onMount, type Snippet } from 'svelte';
    11	
    12	  import {
    13	    createCenterDock,
    14	    type CenterDock,
    15	    type CenterDockSnapshot
    16	  } from '$lib/shell/layout/centerDock';
    17	  import {
    18	    createShellFrame,
    19	    type RegionHeightLimits,
    20	    type RegionWidthLimits,
    21	    type ShellFrame as Frame,
    22	    type ShellRegionId
    23	  } from '$lib/shell/layout/frame';
    24	
    25	  interface Props {
    26	    /** The left column: the sessions list, and nothing else. */
    27	    sessions: Snippet;
    28	    center: {
    29	      session: Snippet;
    30	      editor: Snippet;
    31	      browser: Snippet;
    32	      diff: Snippet;
    33	      sessionLibrary: Snippet;
    34	      agents: Snippet;
    35	    };
    36	    /** The right column: whichever tool view the icon strip has open. */
    37	    tools: Snippet;
    38	    /** The icon strip on the far right edge, which picks that view. */
    39	    activity: Snippet;
    40	    dock: Snippet;
    41	    onSessionPanelLayout?: () => void;
    42	    /** A center tab came to the front. Fires for the dock's own start-up
    43	     * announcements too — see the note in `centerDock.ts`. */
    44	    onCenterPanelShown?: (id: string) => void;
    45	    onReady?: (controls: {
    46	      resetLayout: () => void;
    47	      showCenterPanel: (id: string) => void;
    48	      captureCenterLayout: () => CenterDockSnapshot | null;
    49	      restoreCenterLayout: (snapshot: CenterDockSnapshot | null | undefined) => void;
    50	      /** Give one region a width — how a column asks to be folded up or
    51	       * opened out. See `setRegionWidth` in `frame.ts`. */
    52	      setRegionWidth: (id: ShellRegionId, width: number, limits?: RegionWidthLimits) => void;
    53	      /** Give one region a height — how the bottom strip is closed when the
    54	       * Problems list has been moved elsewhere or hidden. See
    55	       * `setRegionHeight` in `frame.ts`. */
    56	      setRegionHeight: (id: ShellRegionId, height: number, limits?: RegionHeightLimits) => void;
    57	      /** Say what a region may be dragged to without moving it. See
    58	       * `setRegionLimits` in `frame.ts`. */
    59	      setRegionLimits: (id: ShellRegionId, limits: RegionWidthLimits) => void;
    60	      /** How wide a region is right now, or null if the frame is gone. */
    61	      regionWidth: (id: ShellRegionId) => number | null;
    62	    }) => void;
    63	    onError?: (message: string) => void;
    64	  }
    65	  let {
    66	    sessions,
    67	    center,
    68	    tools,
    69	    activity,
    70	    dock,
    71	    onSessionPanelLayout,
    72	    onCenterPanelShown,
    73	    onReady,
    74	    onError
    75	  }: Props = $props();
    76	
    77	  let gridHost: HTMLElement;
    78	  let sessionsSlot: HTMLElement;
    79	  let centerSlot: HTMLElement; // holds the center Dockview's own container
    80	  let toolsSlot: HTMLElement;
    81	  let activitySlot: HTMLElement;
    82	  let dockSlot: HTMLElement;
    83	  let sessionSlot: HTMLElement;
    84	  let editorSlot: HTMLElement;
    85	  let browserSlot: HTMLElement;
    86	  let diffSlot: HTMLElement;
    87	  let sessionLibrarySlot: HTMLElement;
    88	  let agentsSlot: HTMLElement;
    89	
    90	  let frame: Frame | null = null;
    91	  let centerDock: CenterDock | null = null;
    92	  let ready = $state(false);
    93	
    94	  onMount(() => {
    95	    let observer: ResizeObserver | null = null;
    96	    try {
    97	      frame = createShellFrame(gridHost, {
    98	        storage: window.localStorage,
    99	        regions: {
   100	          sessions: sessionsSlot,
   101	          center: centerSlot,
   102	          tools: toolsSlot,
   103	          activity: activitySlot,
   104	          dock: dockSlot
   105	        }
   106	      });
   107	      centerDock = createCenterDock(centerSlot, {
   108	        storage: window.localStorage,
   109	        // The session is what you talk to, so it opens on its own on the left;
   110	        // the editor, the browser and the diff are where you look at the
   111	        // result, so they open stacked together on the right. Source control
   112	        // itself is not here at all — it is a view of the tool column — but the
   113	        // changes it shows are, because a diff wants the width of the middle.
   114	        panels: [
   115	          { id: 'session', title: 'Session', element: sessionSlot },
   116	          { id: 'editor', title: 'Editor', element: editorSlot, group: 'display' },
   117	          { id: 'browser', title: 'Browser', element: browserSlot, group: 'display' },
   118	          { id: 'diff', title: 'Diff', element: diffSlot, group: 'display' },
   119	          {
   120	            id: 'session-library',
   121	            title: 'Session Library',
   122	            element: sessionLibrarySlot,
   123	            group: 'display'
   124	          },
   125	          { id: 'agents', title: 'Agents', element: agentsSlot, group: 'display' }
   126	        ],
   127	        onPanelLayout: (id) => {
   128	          if (id === 'session') onSessionPanelLayout?.();
   129	        },
   130	        onPanelActivated: (id) => onCenterPanelShown?.(id)
   131	      });
   132	      frame.layout(gridHost.clientWidth, gridHost.clientHeight);
   133	      observer = new ResizeObserver(() => {
   134	        frame?.layout(gridHost.clientWidth, gridHost.clientHeight);
   135	      });
   136	      observer.observe(gridHost);
   137	      ready = true;
   138	      onReady?.({
   139	        resetLayout: () => {
   140	          frame?.resetLayout();
   141	          centerDock?.resetLayout();
   142	        },
   143	        showCenterPanel: (id: string) => centerDock?.activatePanel(id),
   144	        captureCenterLayout: () => centerDock?.captureLayout() ?? null,
   145	        restoreCenterLayout: (snapshot) => centerDock?.restoreLayout(snapshot),
   146	        setRegionWidth: (id, width, limits) => frame?.setRegionWidth(id, width, limits),
   147	        setRegionHeight: (id, height, limits) => frame?.setRegionHeight(id, height, limits),
   148	        setRegionLimits: (id, limits) => frame?.setRegionLimits(id, limits),
   149	        regionWidth: (id) => frame?.regionWidth(id) ?? null
   150	      });
   151	    } catch (error) {
   152	      onError?.(error instanceof Error ? error.message : String(error));
   153	    }
   154	
   155	    return () => {
   156	      observer?.disconnect();
   157	      centerDock?.dispose();
   158	      centerDock = null;
   159	      frame?.dispose();
   160	      frame = null;
   161	    };
   162	  });
   163	</script>
   164	
   165	<div class="shell-frame" class:ready bind:this={gridHost}></div>
   166	
   167	<!-- Parking stage: content lives here until (and unless) dockview claims it, and
   168	     whenever a panel hands it back. Not rendered at all, so nothing parked here
   169	     can be measured — see the note on `.parking-stage` in the styles below. -->
   170	<div class="parking-stage" aria-hidden="true">
   171	  <div class="slot" bind:this={sessionsSlot}>{@render sessions()}</div>
   172	  <div class="slot slot-center-dock" bind:this={centerSlot}></div>
   173	  <div class="slot" bind:this={toolsSlot}>{@render tools()}</div>
   174	  <div class="slot" bind:this={activitySlot}>{@render activity()}</div>
   175	  <div class="slot" bind:this={dockSlot}>{@render dock()}</div>
   176	  <div class="slot" bind:this={sessionSlot}>{@render center.session()}</div>
   177	  <div class="slot" bind:this={editorSlot}>{@render center.editor()}</div>
   178	  <div class="slot" bind:this={browserSlot}>{@render center.browser()}</div>
   179	  <div class="slot" bind:this={diffSlot}>{@render center.diff()}</div>
   180	  <div class="slot" bind:this={sessionLibrarySlot}>{@render center.sessionLibrary()}</div>
   181	  <div class="slot" bind:this={agentsSlot}>{@render center.agents()}</div>
   182	</div>
   183	
   184	<style>
   185	  .shell-frame {
   186	    height: 100%;
   187	    width: 100%;
   188	    overflow: hidden;
   189	    visibility: hidden; /* anti-flash: revealed when ready */
   190	  }
   191	  .shell-frame.ready {
   192	    visibility: visible;
   193	  }
   194	
   195	  /* `display: none`, NOT a 1px hidden box: parked content must be UNMEASURABLE.
   196	     A 1px stage still has a size, and a terminal parked in one measures its host
   197	     at zero — xterm's fit addon clamps that to 2 columns by 1 row and resizes the
   198	     real PTY to it, reflowing the agent's screen. With `display: none` the
   199	     computed height is `auto`, the fit addon proposes NaN and returns without
   200	     touching the grid. Content renders normally the moment it is moved out. */
   201	  .parking-stage {
   202	    display: none;
   203	  }
   204	
   205	  /* Teleported slots and hosts must fill whatever cell they land in. */
   206	  .slot,
   207	  :global(.shell-region-host),
   208	  :global(.center-panel-host) {
   209	    height: 100%;
   210	    width: 100%;
   211	    min-width: 0;
   212	    min-height: 0;
   213	    overflow: hidden;
   214	  }
   215	
   216	  /* ---- dockview overrides (ported from the old shell's audited CSS) ----
   217	     BOTH theme classes must be targeted where dracula reasserts values.   */
   218	  .shell-frame :global(.shell-grid),
   219	  .shell-frame :global(.shell-center-dock) {
   220	    /* token map: translate dockview vars onto the /next palette */
   221	    --dv-group-view-background-color: var(--color-bg);
   222	    --dv-tabs-and-actions-container-background-color: var(--color-bg);
   223	    --dv-activegroup-visiblepanel-tab-background-color: var(--color-surface);
   224	    --dv-activegroup-hiddenpanel-tab-background-color: var(--color-bg);
   225	    --dv-inactivegroup-visiblepanel-tab-background-color: var(--color-tab-unfocused-surface);
   226	    --dv-inactivegroup-hiddenpanel-tab-background-color: var(--color-bg);
   227	    --dv-tab-divider-color: transparent;
   228	    --dv-tabs-and-actions-container-height: 35px;
   229	    --dv-activegroup-visiblepanel-tab-color: var(--color-text);
   230	    --dv-activegroup-hiddenpanel-tab-color: var(--color-text-2);
   231	    --dv-inactivegroup-visiblepanel-tab-color: var(--color-tab-unfocused-text);
   232	    --dv-inactivegroup-hiddenpanel-tab-color: var(--color-text-2);
   233	    --dv-separator-border: var(--color-border);
   234	    --dv-paneview-active-outline-color: transparent;
   235	    /* NEUTRAL wash only — the teal accent here caused the green drag-flash. */
   236	    --dv-drag-over-background-color: rgba(255, 255, 255, 0.05);
   237	    --dv-drag-over-border-color: transparent;
   238	    /* VS Code-style resize feedback: the divider lights up teal on hover/drag.
   239	       Safe to color, unlike the drag-over wash above — this paints only the
   240	       sash line itself, never the panel content. Delay 0 so it appears the
   241	       moment you grab it, not half a second in. */
   242	    --dv-active-sash-color: var(--color-accent);
   243	    --dv-active-sash-transition-delay: 0.1s;
   244	    --dv-active-sash-transition-duration: 0.05s;
   245	  }
   246	
   247	  /* seam flattening */
   248	  .shell-frame :global(.dv-groupview),
   249	  .shell-frame :global(.dv-tabs-and-actions-container),
   250	  .shell-frame :global(.dv-content-container),
   251	  .shell-frame :global(.dv-tabs-container),
   252	  .shell-frame :global(.dv-tab) {
   253	    border-color: transparent;
   254	    box-shadow: none;
   255	  }
   256	
   257	  /* The six center tabs are permanent navigation. A restored Dockview layout
