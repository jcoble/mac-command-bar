  1199	    pub fn pause(
  1200	        &self,
  1201	        run_id: &str,
  1202	        idempotency_key: &str,
  1203	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1204	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1205	            return Ok(existing);
  1206	        }
  1207	        let mut run = self.require_run(run_id)?;
  1208	        if run.state == WorkflowRunState::Paused {
  1209	            return Ok(run);
  1210	        }
  1211	        if run.state != WorkflowRunState::Running {
  1212	            return Err(WorkflowError::InvalidTransition(
  1213	                "Only a running workflow can be paused".into(),
  1214	            ));
  1215	        }
  1216	        run.state = WorkflowRunState::Paused;
  1217	        self.append(&mut run, "workflow.run.paused", idempotency_key, None)?;
  1218	        Ok(run)
  1219	    }
  1220	
  1221	    pub async fn resume(
  1222	        &self,
  1223	        run_id: &str,
  1224	        idempotency_key: &str,
  1225	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1226	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1227	            return Ok(existing);
  1228	        }
  1229	        let mut run = self.require_run(run_id)?;
  1230	        if run.state == WorkflowRunState::Running {
  1231	            return Ok(run);
  1232	        }
  1233	        if run.state != WorkflowRunState::Paused {
  1234	            return Err(WorkflowError::InvalidTransition(
  1235	                "Only a paused workflow can be resumed".into(),
  1236	            ));
  1237	        }
  1238	        run.state = WorkflowRunState::Running;
  1239	        refresh_ready_and_phase(&mut run);
  1240	        self.append(&mut run, "workflow.run.resumed", idempotency_key, None)?;
  1241	        self.dispatch_ready(run_id).await
  1242	    }
  1243	
  1244	    pub async fn cancel(
  1245	        &self,
  1246	        run_id: &str,
  1247	        idempotency_key: &str,
  1248	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1249	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1250	            return Ok(existing);
  1251	        }
  1252	        let mut run = self.require_run(run_id)?;
  1253	        if run.state == WorkflowRunState::Cancelled {
  1254	            return Ok(run);
  1255	        }
  1256	        for node in &mut run.nodes {
  1257	            if matches!(
  1258	                node.state,
  1259	                WorkflowNodeState::Running
  1260	                    | WorkflowNodeState::Starting
  1261	                    | WorkflowNodeState::Queued
  1262	            ) {
  1263	                self.runtime.cancel(&node.owned_id).await?;
  1264	            }
  1265	            if !matches!(
  1266	                node.state,
  1267	                WorkflowNodeState::Completed | WorkflowNodeState::Skipped
  1268	            ) {
  1269	                node.state = WorkflowNodeState::Cancelled;
  1270	                node.finished_at_ms = Some(self.clock.now_ms());
  1271	            }
  1272	            if let Some(lease_id) = node.lease_id.take() {
  1273	                self.leases.release(&lease_id)?;
  1274	            }
  1275	        }
  1276	        run.state = WorkflowRunState::Cancelled;
  1277	        run.phase = WorkflowLoopPhase::Cancelled;
  1278	        self.append(&mut run, "workflow.run.cancelled", idempotency_key, None)?;
  1279	        Ok(run)
  1280	    }
  1281	
  1282	    pub fn retry_node(
  1283	        &self,
  1284	        run_id: &str,
  1285	        node_id: &str,
  1286	        idempotency_key: &str,
  1287	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1288	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1289	            return Ok(existing);
  1290	        }
  1291	        let mut run = self.require_run(run_id)?;
  1292	        let definition = run
  1293	            .definition
  1294	            .nodes
  1295	            .iter()
  1296	            .find(|node| node.id == node_id)
  1297	            .ok_or_else(|| WorkflowError::NotFound(node_id.into()))?
  1298	            .clone();
  1299	        let role = run
  1300	            .definition
  1301	            .roles
  1302	            .iter()
  1303	            .find(|role| {
  1304	                role.id
  1305	                    == run
  1306	                        .nodes
  1307	                        .iter()
  1308	                        .find(|node| node.node_id == node_id)
  1309	                        .unwrap()
  1310	                        .role_id
  1311	            })
  1312	            .unwrap()
  1313	            .clone();
  1314	        let max = definition
  1315	            .max_attempts
  1316	            .min(run.definition.budgets.maximum_attempts_per_node)
  1317	            .min(role.retry_policy.max_attempts)
  1318	            .max(1);
  1319	        let node = run
  1320	            .nodes
  1321	            .iter_mut()
  1322	            .find(|node| node.node_id == node_id)
  1323	            .unwrap();
  1324	        if node.state != WorkflowNodeState::Failed {
  1325	            return Err(WorkflowError::InvalidTransition(
  1326	                "Only a failed node can be retried".into(),
  1327	            ));
  1328	        }
  1329	        if !role.retry_policy.retryable_codes.is_empty()
  1330	            && !node.failure.as_ref().is_some_and(|failure| {
  1331	                role.retry_policy
  1332	                    .retryable_codes
  1333	                    .iter()
  1334	                    .any(|code| code == &failure.code)
  1335	            })
  1336	        {
  1337	            return Err(WorkflowError::PolicyDenied(
  1338	                "Node failure is not retryable by role policy".into(),
  1339	            ));
  1340	        }
  1341	        if node.attempt >= max {
  1342	            return Err(WorkflowError::BudgetExhausted(budget_failure(
  1343	                "attempts",
  1344	                "Node attempt budget exhausted",
  1345	            )));
  1346	        }
  1347	        node.attempt += 1;
  1348	        node.id = format!("{}:{}:{}", run.id, node.node_id, node.attempt);
  1349	        node.owned_id = self.ids.next_id("workflow-agent");
  1350	        node.state = WorkflowNodeState::Ready;
  1351	        node.failure = None;
  1352	        node.structured_output = None;
  1353	        node.finished_at_ms = None;
  1354	        run.state = WorkflowRunState::Running;
  1355	        refresh_ready_and_phase(&mut run);
  1356	        self.append(
  1357	            &mut run,
  1358	            "workflow.node.retried",
  1359	            idempotency_key,
  1360	            Some(node_id),
  1361	        )?;
  1362	        Ok(run)
  1363	    }
