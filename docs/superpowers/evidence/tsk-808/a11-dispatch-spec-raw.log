   803	pub(crate) struct WorkflowReducer;
   804	
   805	impl WorkflowReducer {
   806	    pub fn reduce(events: Vec<Value>) -> Result<Vec<WorkflowRunRecord>, WorkflowError> {
   807	        let mut ordered: Vec<(u64, String, WorkflowRunRecord)> = events
   808	            .into_iter()
   809	            .filter_map(|event| {
   810	                let sequence = event.get("sequence")?.as_u64()?;
   811	                let run_id = event.get("runId")?.as_str()?.to_string();
   812	                let run = serde_json::from_value(event.get("workflowPayload")?.get("run")?.clone())
   813	                    .ok()?;
   814	                Some((sequence, run_id, run))
   815	            })
   816	            .collect();
   817	        ordered.sort_by(|a, b| a.1.cmp(&b.1).then(a.0.cmp(&b.0)));
   818	        let mut runs = BTreeMap::new();
   819	        for (sequence, run_id, mut run) in ordered {
   820	            run.last_sequence = sequence;
   821	            runs.insert(run_id, run);
   822	        }
   823	        Ok(runs.into_values().collect())
   824	    }
   825	}
