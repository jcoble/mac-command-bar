  1113	    pub fn create_run(
  1114	        &self,
  1115	        definition: WorkflowDefinitionV1,
  1116	        input: Value,
  1117	        idempotency_key: String,
  1118	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1119	        WorkflowPolicy::validate_definition(&definition)?;
  1120	        if let Some(existing) = self.idempotent_workflow_run(&definition.id, &idempotency_key)? {
  1121	            return Ok(existing);
  1122	        }
  1123	        let canonical = canonical_json(&input);
  1124	        let input_hash = stable_hash(&canonical);
  1125	        let now = self.clock.now_ms();
  1126	        let run_id = self.ids.next_id("workflow-run");
  1127	        let mut nodes: Vec<_> = definition
  1128	            .nodes
  1129	            .iter()
  1130	            .map(|node| {
  1131	                let role = definition
  1132	                    .roles
  1133	                    .iter()
  1134	                    .find(|role| role.id == node.role_id)
  1135	                    .expect("validated role");
  1136	                WorkflowNodeRunRecord {
  1137	                    id: format!("{}:{}:1", run_id, node.id),
  1138	                    node_id: node.id.clone(),
  1139	                    role_id: node.role_id.clone(),
  1140	                    state: WorkflowNodeState::Blocked,
  1141	                    attempt: 1,
  1142	                    depth: 0,
  1143	                    owned_id: self.ids.next_id("workflow-agent"),
  1144	                    provider: role.provider_policy.provider.to_ascii_lowercase(),
  1145	                    provider_instance_id: None,
  1146	                    started_at_ms: None,
  1147	                    finished_at_ms: None,
  1148	                    output_contract: role.output_contract,
  1149	                    structured_output: None,
  1150	                    artifacts: Vec::new(),
  1151	                    gate: None,
  1152	                    lease_id: None,
  1153	                    failure: None,
  1154	                }
  1155	            })
  1156	            .collect();
  1157	        nodes.sort_by(|a, b| a.node_id.cmp(&b.node_id));
  1158	        let mut run = WorkflowRunRecord {
  1159	            id: run_id,
  1160	            workflow_id: definition.id.clone(),
  1161	            definition,
  1162	            state: WorkflowRunState::Draft,
  1163	            phase: WorkflowLoopPhase::Draft,
  1164	            input_snapshot: input,
  1165	            input_hash,
  1166	            created_at_ms: now,
  1167	            updated_at_ms: now,
  1168	            nodes,
  1169	            tokens_used: 0,
  1170	            tool_terminals_used: 0,
  1171	            worktrees_allocated: 0,
  1172	            last_sequence: 0,
  1173	        };
  1174	        self.append(&mut run, "workflow.run.created", &idempotency_key, None)?;
  1175	        Ok(run)
  1176	    }
  1177	
  1178	    pub async fn start(
  1179	        &self,
  1180	        run_id: &str,
  1181	        idempotency_key: &str,
  1182	    ) -> Result<WorkflowRunRecord, WorkflowError> {
  1183	        if let Some(existing) = self.idempotent_run(run_id, idempotency_key)? {
  1184	            return Ok(existing);
  1185	        }
  1186	        let mut run = self.require_run(run_id)?;
  1187	        if !matches!(
  1188	            run.state,
  1189	            WorkflowRunState::Draft | WorkflowRunState::Queued
  1190	        ) {
  1191	            return Ok(run);
  1192	        }
  1193	        run.state = WorkflowRunState::Running;
  1194	        refresh_ready_and_phase(&mut run);
  1195	        self.append(&mut run, "workflow.run.started", idempotency_key, None)?;
  1196	        self.dispatch_ready(run_id).await
  1197	    }
