  8276	    #[test]
  8277	    fn git_commit_files_and_diff_read_one_commit() {
  8278	        let root = unique_temp_root();
  8279	        std::fs::create_dir_all(root.join("src")).unwrap();
  8280	        std::fs::write(root.join("src/App.ts"), "export const value = 1;\n").unwrap();
  8281	        std::fs::write(root.join("README.md"), "initial\n").unwrap();
  8282	
  8283	        run_git_for_test(&root, &["init"]);
  8284	        run_git_for_test(&root, &["config", "user.name", "MacCommandBar Test"]);
  8285	        run_git_for_test(&root, &["config", "user.email", "test@example.invalid"]);
  8286	        run_git_for_test(&root, &["add", "."]);
  8287	        run_git_for_test(&root, &["commit", "-m", "initial"]);
  8288	
  8289	        std::fs::write(root.join("src/App.ts"), "export const value = 2;\n").unwrap();
  8290	        std::fs::write(root.join("src/Added.ts"), "export const added = true;\n").unwrap();
  8291	        std::fs::remove_file(root.join("README.md")).unwrap();
  8292	        run_git_for_test(&root, &["add", "-A"]);
  8293	        run_git_for_test(&root, &["commit", "-m", "second"]);
  8294	
  8295	        let history = read_git_commit_history_sync(root.clone(), Some(1)).unwrap();
  8296	        let sha = history[0].sha.clone();
  8297	
  8298	        let mut files = read_git_commit_files_sync(root.clone(), sha.clone()).unwrap();
  8299	        files.sort_by(|left, right| left.relative_path.cmp(&right.relative_path));
  8300	
  8301	        assert_eq!(files.len(), 3);
  8302	        assert_eq!(files[0].relative_path, "README.md");
  8303	        assert_eq!(files[0].status, "deleted");
  8304	        assert_eq!(files[0].badge, "D");
  8305	        assert_eq!(files[1].relative_path, "src/Added.ts");
  8306	        assert_eq!(files[1].status, "added");
  8307	        assert_eq!(files[1].badge, "A");
  8308	        assert_eq!(files[2].relative_path, "src/App.ts");
  8309	        assert_eq!(files[2].status, "modified");
  8310	        assert_eq!(files[2].badge, "M");
  8311	
  8312	        let diff =
  8313	            read_git_commit_file_diff_sync(root.clone(), sha, "src/App.ts".to_string()).unwrap();
  8314	
  8315	        assert_eq!(diff.relative_path, "src/App.ts");
  8316	        assert_eq!(diff.status, "modified");
  8317	        assert!(!diff.is_binary);
  8318	        assert!(diff.diff.contains("--- a/src/App.ts"));
  8319	        assert!(diff.diff.contains("+export const value = 2;"));
  8320	        assert!(diff.diff.contains("-export const value = 1;"));
  8321	        // The commit subject line never leaks into the patch text, so the same unified
  8322	        // diff parser the working-copy diff uses can read this one.
  8323	        assert!(!diff.diff.contains("second"));
  8324	
  8325	        std::fs::remove_dir_all(root).unwrap();
  8326	    }
