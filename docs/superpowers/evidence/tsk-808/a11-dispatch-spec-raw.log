  4772	fn parse_project_git_status(output: &str) -> Result<ProjectGitStatus, String> {
  4773	    let mut git_status = ProjectGitStatus {
  4774	        branch: None,
  4775	        ahead: 0,
  4776	        behind: 0,
  4777	        has_upstream: false,
  4778	        files: Vec::new(),
  4779	    };
  4780	
  4781	    for line in output.lines().filter(|line| !line.trim().is_empty()) {
  4782	        if let Some(header) = line.strip_prefix("## ") {
  4783	            let branch_header = parse_git_branch_header(header);
  4784	            git_status.branch = branch_header.branch;
  4785	            git_status.ahead = branch_header.ahead;
  4786	            git_status.behind = branch_header.behind;
  4787	            git_status.has_upstream = branch_header.has_upstream;
  4788	            continue;
  4789	        }
  4790	
  4791	        if line.len() < 4 {
  4792	            continue;
  4793	        }
  4794	
  4795	        let index_code = line.chars().next().unwrap_or(' ');
  4796	        let worktree_code = line.chars().nth(1).unwrap_or(' ');
  4797	        let relative_path = normalize_git_status_path(&line[3..]);
  4798	        if relative_path.is_empty() {
  4799	            continue;
  4800	        }
  4801	
  4802	        let index_status = git_status_name(index_code).to_string();
  4803	        let worktree_status = git_status_name(worktree_code).to_string();
  4804	        let status = if !worktree_status.is_empty() {
  4805	            worktree_status.clone()
  4806	        } else {
  4807	            index_status.clone()
  4808	        };
  4809	        let badge = git_status_badge(index_code, worktree_code).to_string();
  4810	
  4811	        git_status.files.push(GitFileStatus {
  4812	            relative_path,
  4813	            index_status,
  4814	            worktree_status,
  4815	            status,
  4816	            badge,
  4817	        });
  4818	    }
  4819	
  4820	    Ok(git_status)
  4821	}
