   224	/**
   225	 * A read that came back with fewer commits than it asked for has nothing more to
   226	 * give: asking again the same way returns the same list. That is true whether
   227	 * the repository ran out of commits or the app build stopped early, which is why
   228	 * the sentences below never claim to know which.
   229	 */
   230	export function isGitHistoryComplete(requested: number, received: number): boolean {
   231	  return received < requested;
   232	}
   233	
   234	/** Should the "Load more" button be offered right now? */
   235	export function canLoadMoreGitHistory(state: GitPanelState): boolean {
   236	  return (
   237	    state.activated &&
   238	    !state.desktopOnly &&
   239	    state.history.length > 0 &&
   240	    !state.historyComplete &&
   241	    !state.historyCeiling &&
   242	    !state.historyLoading &&
   243	    !state.historyLoadingMore
   244	  );
   245	}
   246	
   247	/**
   248	 * The short count beside the "Commits" heading. "so far" is the whole point:
   249	 * a bare number next to a list of 24 out of thousands reads as the total.
   250	 */
   251	export function describeGitHistoryCount(state: GitPanelState): string {
   252	  const shown = state.history.length;
   253	  if (shown === 0) return '';
   254	  if (state.historyComplete || state.historyCeiling) return String(shown);
   255	  return `${shown} so far`;
   256	}
   257	
   258	/**
   259	 * The sentence under the list, and the hover text on the count. It says what
   260	 * actually came back rather than what was asked for, so an older app build that
   261	 * returns fewer commits than this panel requests cannot look like a repository
   262	 * that has run out of history.
   263	 */
   264	export function describeGitHistoryFooter(state: GitPanelState): string {
   265	  const shown = state.history.length;
   266	  if (shown === 0) return '';
   267	  if (state.historyCeiling) {
   268	    return `Showing ${shown} commits — the most this app reads at one time. Older commits are not in this list.`;
   269	  }
   270	  if (!state.historyComplete) return `Showing ${shown} so far.`;
   271	  if (!state.historyPaged) return `Showing all ${shown} commits.`;
   272	  return (
   273	    `Showing ${shown} commits. We asked for ${state.historyRequested} and this is all that came ` +
   274	    `back, so it is everything this app will show for this repository.`
   275	  );
   276	}
