    88	    tabId: text(input.tabId),
    89	    generation: Number.isFinite(input.generation) ? Math.max(0, Math.floor(input.generation)) : 0,
    90	    url: text(input.url),
    91	    title: text(input.title),
    92	    selector: boundSelector(input.selector),
