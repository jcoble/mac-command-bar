  3956	fn git_last_commit(root: &Path) -> (Option<String>, Option<String>, Option<String>) {
  3957	    let Ok(output) = run_git_text(root, &["log", "-1", "--format=%h%x1f%s%x1f%cI"]) else {
  3958	        return (None, None, None);
  3959	    };
  3960	
  3961	    let mut parts = output.trim().split('\x1f');
  3962	    let sha = parts
  3963	        .next()
  3964	        .map(str::trim)
  3965	        .filter(|value| !value.is_empty())
  3966	        .map(ToString::to_string);
  3967	    let subject = parts
  3968	        .next()
  3969	        .map(str::trim)
  3970	        .filter(|value| !value.is_empty())
  3971	        .map(ToString::to_string);
  3972	    let committed_at = parts
  3973	        .next()
  3974	        .map(str::trim)
  3975	        .filter(|value| !value.is_empty())
  3976	        .map(ToString::to_string);
  3977	
  3978	    (sha, subject, committed_at)
  3979	}
