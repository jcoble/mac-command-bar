    57	function commandName(value: string): string {
    58	  const trimmed = value.trim().replace(/^\/+/, '');
    59	  return trimmed.split(/\s+/, 1)[0].toLowerCase();
    60	}
    61	
    62	export function isExcludedConversationCommand(value: string): boolean {
    63	  const name = commandName(value);
    64	  return !name || TUI_ONLY_COMMAND_NAMES.has(name);
    65	}
    66	
    67	function providerCommand(command: AgentCommandDescriptor, source: 'provider' | 'skill'): ConversationCommand | null {
    68	  const name = commandName(command.id || command.label);
    69	  if (isExcludedConversationCommand(name)) return null;
    70	  return {
    71	    ...command,
    72	    name,
    73	    source,
    74	    action: 'insert'
    75	  };
    76	}
    77	
    78	function assemblyCommand(command: AssemblyConversationCommand): ConversationCommand | null {
    79	  const name = commandName(command.name ?? command.id);
    80	  if (isExcludedConversationCommand(name)) return null;
    81	  return {
    82	    id: command.id,
    83	    label: command.label,
    84	    description: command.description,
    85	    name,
    86	    source: 'assembly',
    87	    action: command.action ?? 'invoke'
    88	  };
    89	}
