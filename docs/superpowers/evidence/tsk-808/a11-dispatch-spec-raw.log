  3717	fn git_untracked_paths(root: &Path) -> Result<Vec<String>, String> {
  3718	    let output = Command::new("git")
  3719	        .arg("-C")
  3720	        .arg(root)
  3721	        .args(["ls-files", "--others", "--exclude-standard", "-z"])
  3722	        .output()
  3723	        .map_err(|error| format!("Could not list untracked files: {error}"))?;
  3724	
  3725	    if !output.status.success() {
  3726	        let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  3727	        return Err(if stderr.is_empty() {
  3728	            format!("git ls-files exited with {}", output.status)
  3729	        } else {
  3730	            stderr
  3731	        });
  3732	    }
  3733	
  3734	    Ok(output
  3735	        .stdout
  3736	        .split(|byte| *byte == 0)
  3737	        .filter(|chunk| !chunk.is_empty())
  3738	        .map(|chunk| String::from_utf8_lossy(chunk).to_string())
  3739	        .filter(|path| is_safe_git_relative_path(path))
  3740	        .collect())
  3741	}
