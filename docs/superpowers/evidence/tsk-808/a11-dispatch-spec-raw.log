    21	
    22	  let {
    23	    items,
    24	    assistantLabel = 'Assistant',
    25	    savedScrollTop = 0,
    26	    emptyText = 'Start the conversation below.',
    27	    onScroll,
    28	    onApprovalDecision,
    29	    onInputSubmit,
    30	    onFileLink
    31	  }: Props = $props();
    32	
    33	  let host = $state<HTMLDivElement | null>(null);
    34	  let viewportHeight = $state(480);
    35	  let currentScrollTop = $state(0);
    36	  let follow = $state(true);
    37	  let lastItemId = '';
    38	  const rowEstimate = 96;
    39	  const range = $derived(visibleConversationRange(items.length, currentScrollTop, viewportHeight, rowEstimate));
    40	  const visibleItems = $derived(items.slice(range.start, range.end));
    41	
    42	  function measure(): void {
    43	    if (host) viewportHeight = Math.max(1, host.clientHeight);
    44	  }
    45	
    46	  function handleScroll(): void {
    47	    if (!host) return;
    48	    currentScrollTop = host.scrollTop;
    49	    follow = conversationScrollShouldFollow(host.scrollTop, host.clientHeight, host.scrollHeight);
    50	    onScroll?.(host.scrollTop);
    51	  }
    52	
    53	  function jumpToLatest(): void {
    54	    if (!host) return;
    55	    host.scrollTop = host.scrollHeight;
    56	    currentScrollTop = host.scrollTop;
    57	    follow = true;
    58	  }
    59	
    60	  $effect(() => {
    61	    const latest = items[items.length - 1];
    62	    const latestId = latest?.itemId ?? '';
    63	    if (!latestId || latestId === lastItemId) return;
    64	    lastItemId = latestId;
    65	    if (!follow) return;
    66	    void tick().then(() => jumpToLatest());
    67	  });
    68	
    69	  $effect(() => {
