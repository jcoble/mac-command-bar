    31	/** The working-tree action currently running, or '' when nothing is running. */
    32	export type GitActionKind = 'stage' | 'unstage' | 'commit' | 'fetch' | 'pull' | 'push';
    33	
    34	export interface GitPanelState {
    35	  // ── which repository the panel is pointed at ─────────────────────────────
    36	  /** Absolute path of the project the panel is showing, or null before it is
    37	   *  pointed at one. Set only by `gitService.activate(root)`. */
    38	  root: string | null;
    39	  /** True once `activate()` has run for the current root. Before that the panel
    40	   *  renders an inert empty state and issues no backend calls. */
    41	  activated: boolean;
    42	  /** True when the backend said "not running in the desktop app". The panel then
    43	   *  says so plainly and shows nothing — it never invents stand-in data. */
    44	  desktopOnly: boolean;
    45	
    46	  // ── working-tree status ───────────────────────────────────────────────────
