    73	/** Build ordered ACP content blocks without turning typed images into Markdown. */
    74	export function buildConversationPrompt(
    75	  text: string,
    76	  attachments: readonly AttachmentWithBytes[],
    77	  supportsImages: boolean
    78	): { text: string; content: AgentPromptContent[] } {
    79	  if (attachments.length > 0 && !supportsImages) {
    80	    throw new Error('This conversation provider does not advertise image prompts');
    81	  }
    82	  const content: AgentPromptContent[] = [];
    83	  if (text.length > 0) content.push({ type: 'text', text });
    84	  for (const attachment of attachments) {
    85	    if (!attachment.bytes?.length) throw new Error(`Attachment ${attachment.name} is not available for image upload`);
    86	    content.push({
    87	      type: 'image',
    88	      mimeType: attachment.mimeType,
    89	      data: attachment.bytes,
    90	      name: attachment.name
    91	    });
    92	  }
    93	  return { text, content };
    94	}
