   117	/**
   118	 * The fallback route: ask about each open file, one call per file.
   119	 *
   120	 * Only files with a language server behind them are asked about — asking about
   121	 * a plain text file spawns nothing and returns nothing, but it does cost a
   122	 * round trip per file, and the count on screen has to mean "files we actually
   123	 * looked at" for the sentence under the header to be true.
   124	 */
   125	async function loadFromOpenFiles(ticket: number, root: string): Promise<void> {
   126	  const files = editorState.openFiles.filter(
   127	    (file) => file.preview !== null && sourceSupportsLanguageIntelligence(file.language)
   128	  );
   129	
   130	  if (files.length === 0) {
   131	    applyProblems(ticket, [], 'open-files', 0);
   132	    return;
   133	  }
   134	
   135	  const rows: ProblemRow[] = [];
   136	  let filesRead = 0;
   137	  let lastError: string | null = null;
   138	
   139	  for (const file of files) {
   140	    const preview = file.preview;
   141	    if (!preview) continue;
   142	    try {
   143	      countInvoke('read_source_lsp_diagnostics');
   144	      const diagnostics = await readProblemsForFile(preview, root);
   145	      if (diagnostics === null) {
   146	        markProblemsUnavailable(ticket, DESKTOP_ONLY);
   147	        return;
   148	      }
   149	      filesRead += 1;
   150	      for (const diagnostic of diagnostics) {
   151	        const row = problemRowFromDiagnostic(diagnostic, root, file.path);
   152	        if (row) rows.push(row);
   153	      }
   154	    } catch (error) {
   155	      // One file failing is not a reason to show nothing for the others; the
   156	      // failure is only reported if it is the only thing that happened.
   157	      lastError = describeError(error);
   158	    }
   159	  }
