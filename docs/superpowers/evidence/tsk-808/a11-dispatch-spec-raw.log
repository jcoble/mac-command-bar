  3673	fn safe_archive_path_segment(value: &str) -> String {
  3674	    let mut segment = value
  3675	        .trim()
  3676	        .chars()
  3677	        .map(|character| {
  3678	            if character.is_ascii_alphanumeric() || matches!(character, '.' | '_' | '-') {
  3679	                character
  3680	            } else {
  3681	                '-'
  3682	            }
  3683	        })
  3684	        .collect::<String>();
  3685	    while segment.contains("--") {
  3686	        segment = segment.replace("--", "-");
  3687	    }
  3688	    let segment = segment.trim_matches('-').to_string();
  3689	    if segment.is_empty() {
  3690	        "worktree".to_string()
  3691	    } else {
  3692	        segment
  3693	    }
  3694	}
