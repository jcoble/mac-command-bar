  3123	/// `force = false` is the everyday remove: it refuses anything that would lose work.
  3124	/// `force = true` is the "I know, delete it anyway" remove: it unlocks the worktree if
  3125	/// it is locked, deletes it even when files are uncommitted or commits are unmerged, and
  3126	/// reports in the returned message exactly what went away. Neither mode will ever touch
  3127	/// the primary checkout.
  3128	fn remove_project_worktree_sync(
  3129	    root: PathBuf,
  3130	    path: PathBuf,
  3131	    force: bool,
  3132	) -> Result<ProjectWorktreeActionResult, String> {
  3133	    validate_git_root(&root)?;
  3134	
  3135	    let root_metadata = std::fs::metadata(&root)
  3136	        .map_err(|error| format!("Could not read worktree root metadata: {error}"))?;
  3137	    if !root_metadata.is_dir() {
  3138	        return Err("Worktree root is not a directory".to_string());
  3139	    }
  3140	
  3141	    let canonical_root = std::fs::canonicalize(&root)
  3142	        .map_err(|error| format!("Could not resolve Git root: {error}"))?;
  3143	    let canonical_path = std::fs::canonicalize(&path).ok();
  3144	    if canonical_path
  3145	        .as_ref()
  3146	        .map(|path| normalized_path_string(&canonical_root) == normalized_path_string(path))
  3147	        .unwrap_or(false)
  3148	    {
  3149	        return Err("Refusing to remove the primary checkout".to_string());
  3150	    }
  3151	
  3152	    let worktrees = list_project_worktrees_sync(root.clone())?;
  3153	    let worktree = worktrees
  3154	        .iter()
  3155	        .find(|worktree| {
  3156	            project_worktree_path_matches(&worktree.path, &path, canonical_path.as_deref())
  3157	        })
  3158	        .ok_or_else(|| "Worktree path is not registered for this repository".to_string())?;
  3159	
  3160	    // Comparing the path against the root that was passed only catches "remove the repo you
  3161	    // asked through". Ask through a linked worktree FOR the primary checkout and those two
  3162	    // paths differ, so that check waves it through. `git worktree list --porcelain` always
  3163	    // prints the main working tree first, so that is the answer that actually holds.
  3164	    if worktrees
  3165	        .first()
  3166	        .is_some_and(|main_working_tree| main_working_tree.path == worktree.path)
  3167	    {
  3168	        return Err("Refusing to remove the primary checkout".to_string());
  3169	    }
  3170	
  3171	    if !force {
  3172	        if worktree.is_locked {
  3173	            return Err("Refusing to remove locked worktree".to_string());
  3174	        }
  3175	        if worktree.is_dirty {
  3176	            return Err("Refusing to remove dirty worktree".to_string());
  3177	        }
  3178	        if worktree.has_unmerged_commits {
  3179	            return Err("Refusing to remove worktree with unmerged commits".to_string());
  3180	        }
  3181	    }
  3182	    if worktree.is_prunable {
  3183	        // Only this row. `git worktree prune` would clear the records of EVERY
  3184	        // worktree whose folder is gone, and it did: a reader who clicked one
  3185	        // stale row watched two of them disappear. Git documents removing a
  3186	        // single `.git/worktrees/<name>` folder by hand as the supported way to
  3187	        // forget one worktree, which is exactly the promise the button makes.
  3188	        let branch = worktree.branch.clone();
  3189	        let cleared = clear_one_worktree_record(&root, &worktree.path)?;
  3190	        return Ok(ProjectWorktreeActionResult {
  3191	            message: if cleared {
  3192	                format!(
  3193	                    "Cleared git's records for {branch}. Its folder was already gone, and nothing on disk was touched."
  3194	                )
  3195	            } else {
  3196	                format!("Git had no records left for {branch}, so there was nothing to clear.")
  3197	            },
  3198	            worktrees: list_project_worktrees_sync(root)?,
  3199	        });
  3200	    }
  3201	
  3202	    let path_metadata = std::fs::metadata(&path)
  3203	        .map_err(|error| format!("Could not read worktree path metadata: {error}"))?;
  3204	    if !path_metadata.is_dir() {
  3205	        return Err("Worktree path is not a directory".to_string());
  3206	    }
  3207	
  3208	    let worktree_path = worktree.path.clone();
  3209	
  3210	    if force {
  3211	        // Count what is about to be destroyed BEFORE destroying it, so the message can
  3212	        // name it. After the remove there is nothing left to look at.
  3213	        let dirty_file_count = project_worktree_dirty_file_count(&worktree_path);
  3214	        let was_dirty = worktree.is_dirty;
  3215	        let had_unmerged_commits = worktree.has_unmerged_commits;
  3216	        let unlocked_reason = worktree.is_locked.then(|| {
  3217	            worktree
  3218	                .locked_reason
  3219	                .clone()
  3220	                .unwrap_or_default()
  3221	                .trim()
  3222	                .to_string()
  3223	        });
  3224	
  3225	        if unlocked_reason.is_some() {
  3226	            run_git_text(&root, &["worktree", "unlock", worktree_path.as_str()])?;
  3227	        }
  3228	        run_git_text(
  3229	            &root,
  3230	            &["worktree", "remove", "--force", worktree_path.as_str()],
  3231	        )?;
  3232	        run_git_text(&root, &["worktree", "prune"])?;
  3233	
  3234	        return Ok(ProjectWorktreeActionResult {
  3235	            message: describe_forced_worktree_removal(
  3236	                &worktree.branch,
  3237	                dirty_file_count,
  3238	                was_dirty,
  3239	                had_unmerged_commits,
  3240	                unlocked_reason.as_deref(),
  3241	            ),
  3242	            worktrees: list_project_worktrees_sync(root)?,
  3243	        });
  3244	    }
  3245	
  3246	    run_git_text(&root, &["worktree", "remove", worktree_path.as_str()])?;
  3247	    run_git_text(&root, &["worktree", "prune"])?;
  3248	
  3249	    Ok(ProjectWorktreeActionResult {
  3250	        message: format!("Removed worktree {}", worktree.branch),
  3251	        worktrees: list_project_worktrees_sync(root)?,
  3252	    })
  3253	}
  3254	
  3255	/// Forget ONE worktree, leaving every other worktree's records alone.
  3256	///
  3257	/// Git keeps a small folder of records per linked worktree under the
  3258	/// repository's `worktrees` directory. The folder is named after the worktree
  3259	/// but not reliably so — two worktrees whose folders share a name get suffixed
  3260	/// names — so this does not guess from the name. Each record folder holds a
  3261	/// `gitdir` file naming the worktree it belongs to, and that is what is matched.
  3262	///
  3263	/// Returns whether a record folder was actually found and removed.
  3264	fn clear_one_worktree_record(root: &Path, worktree_path: &str) -> Result<bool, String> {
  3265	    let records_directory = git_worktree_records_directory(root)?;
  3266	    let Ok(entries) = std::fs::read_dir(&records_directory) else {
  3267	        return Ok(false);
  3268	    };
  3269	
  3270	    for entry in entries.flatten() {
  3271	        let record_directory = entry.path();
  3272	        if !record_directory.is_dir() {
  3273	            continue;
  3274	        }
  3275	        let Ok(gitdir) = std::fs::read_to_string(record_directory.join("gitdir")) else {
  3276	            continue;
  3277	        };
  3278	        if worktree_record_gitdir_names(gitdir.trim()) != Some(worktree_path.to_string()) {
  3279	            continue;
  3280	        }
  3281	
  3282	        std::fs::remove_dir_all(&record_directory).map_err(|error| {
  3283	            format!(
  3284	                "Could not clear git's records for this worktree: {error} ({})",
  3285	                record_directory.display()
  3286	            )
  3287	        })?;
  3288	        return Ok(true);
  3289	    }
  3290	
  3291	    Ok(false)
  3292	}
  3293	
  3294	/// Where this repository keeps its per-worktree record folders.
  3295	///
  3296	/// Asked of git rather than assumed to be `<root>/.git/worktrees`: the answer
  3297	/// may be relative to the root, and in a repository that is itself a linked
  3298	/// worktree the records live in the primary checkout, not next door.
  3299	fn git_worktree_records_directory(root: &Path) -> Result<PathBuf, String> {
  3300	    let common_directory = run_git_text(root, &["rev-parse", "--git-common-dir"])?
  3301	        .trim()
  3302	        .to_string();
  3303	    if common_directory.is_empty() {
  3304	        return Err("Could not find where this repository keeps its records".to_string());
  3305	    }
  3306	
  3307	    let common_directory = PathBuf::from(&common_directory);
  3308	    let common_directory = if common_directory.is_absolute() {
  3309	        common_directory
  3310	    } else {
  3311	        root.join(common_directory)
  3312	    };
  3313	
  3314	    Ok(common_directory.join("worktrees"))
  3315	}
  3316	
  3317	/// Which worktree a record folder's `gitdir` file points at.
  3318	///
  3319	/// The file names the worktree's own `.git` file — `/path/to/worktree/.git` —
  3320	/// so the worktree is its parent folder. The folder is normally gone by the
  3321	/// time this is asked, which is why this is pure text and never touches disk.
  3322	fn worktree_record_gitdir_names(gitdir: &str) -> Option<String> {
  3323	    let gitdir = gitdir.trim();
  3324	    if gitdir.is_empty() {
  3325	        return None;
  3326	    }
  3327	    Path::new(gitdir).parent().map(normalized_path_string)
  3328	}
  3329	
  3330	fn archive_project_worktree_sync(
  3331	    root: PathBuf,
  3332	    path: PathBuf,
  3333	) -> Result<ProjectWorktreeArchiveResult, String> {
  3334	    validate_git_root(&root)?;
  3335	
  3336	    let root_metadata = std::fs::metadata(&root)
  3337	        .map_err(|error| format!("Could not read worktree root metadata: {error}"))?;
  3338	    if !root_metadata.is_dir() {
  3339	        return Err("Worktree root is not a directory".to_string());
  3340	    }
  3341	
  3342	    let path_metadata = std::fs::metadata(&path)
  3343	        .map_err(|error| format!("Could not read worktree path metadata: {error}"))?;
  3344	    if !path_metadata.is_dir() {
  3345	        return Err("Worktree path is not a directory".to_string());
  3346	    }
  3347	
  3348	    let canonical_root = std::fs::canonicalize(&root)
  3349	        .map_err(|error| format!("Could not resolve Git root: {error}"))?;
  3350	    let canonical_path = std::fs::canonicalize(&path)
  3351	        .map_err(|error| format!("Could not resolve worktree path: {error}"))?;
  3352	    if normalized_path_string(&canonical_root) == normalized_path_string(&canonical_path) {
  3353	        return Err("Refusing to archive the primary checkout as a removable worktree".to_string());
  3354	    }
  3355	
  3356	    let worktrees = list_project_worktrees_sync(root.clone())?;
  3357	    let worktree = worktrees
  3358	        .iter()
  3359	        .find(|worktree| {
  3360	            project_worktree_path_matches(&worktree.path, &path, Some(&canonical_path))
  3361	        })
  3362	        .ok_or_else(|| "Worktree path is not registered for this repository".to_string())?;
  3363	    let archive_path = project_worktree_archive_path(worktree)?;
  3364	    std::fs::create_dir_all(&archive_path)
  3365	        .map_err(|error| format!("Could not create worktree archive directory: {error}"))?;
  3366	
  3367	    write_git_command_output(
  3368	        &canonical_path,
  3369	        &["status", "--short", "--branch"],
  3370	        &archive_path.join("status.txt"),
  3371	    )?;
  3372	    write_git_command_output(
  3373	        &canonical_path,
  3374	        &["log", "--oneline", "--decorate", "--max-count=40"],
  3375	        &archive_path.join("commits.txt"),
  3376	    )?;
  3377	    write_git_command_output(
  3378	        &canonical_path,
  3379	        &["diff", "--binary"],
  3380	        &archive_path.join("unstaged.patch"),
  3381	    )?;
  3382	    write_git_command_output(
  3383	        &canonical_path,
  3384	        &["diff", "--cached", "--binary"],
  3385	        &archive_path.join("staged.patch"),
  3386	    )?;
  3387	
  3388	    let untracked_paths = git_untracked_paths(&canonical_path)?;
  3389	    std::fs::write(
  3390	        archive_path.join("untracked.txt"),
  3391	        format!("{}\n", untracked_paths.join("\n")),
  3392	    )
  3393	    .map_err(|error| format!("Could not write untracked file list: {error}"))?;
  3394	    copy_untracked_worktree_files(
  3395	        &canonical_path,
  3396	        &archive_path.join("untracked"),
  3397	        &untracked_paths,
  3398	    )?;
  3399	
  3400	    let bundle_path = archive_path.join("head.bundle");
  3401	    run_git_text(
  3402	        &canonical_path,
  3403	        &[
  3404	            "bundle",
  3405	            "create",
  3406	            bundle_path.to_str().unwrap_or_default(),
  3407	            "HEAD",
  3408	        ],
  3409	    )?;
  3410	
  3411	    Ok(ProjectWorktreeArchiveResult {
  3412	        message: format!("Archived worktree {}", worktree.branch),
  3413	        archive_path: normalized_path_string(&archive_path),
  3414	        worktrees: list_project_worktrees_sync(root)?,
  3415	    })
  3416	}
  3417	
  3418	fn project_worktree_path_matches(
  3419	    record_path: &str,
  3420	    target_path: &Path,
  3421	    canonical_target: Option<&Path>,
  3422	) -> bool {
  3423	    let normalized_target = normalized_path_string(target_path);
  3424	    let normalized_record = normalized_path_string(Path::new(record_path));
  3425	    if normalized_record == normalized_target {
  3426	        return true;
  3427	    }
  3428	
  3429	    let Some(canonical_target) = canonical_target else {
  3430	        return false;
  3431	    };
  3432	    let normalized_canonical_target = normalized_path_string(canonical_target);
  3433	    if normalized_record == normalized_canonical_target {
  3434	        return true;
  3435	    }
  3436	
  3437	    std::fs::canonicalize(record_path)
  3438	        .ok()
  3439	        .map(|canonical_record| {
  3440	            normalized_path_string(&canonical_record) == normalized_canonical_target
  3441	        })
  3442	        .unwrap_or(false)
  3443	}
  3444	
  3445	fn parse_project_worktree_porcelain(output: &str) -> Vec<ProjectWorktree> {
  3446	    output
  3447	        .split("\n\n")
  3448	        .filter_map(|block| {
  3449	            let mut path = None;
  3450	            let mut branch = None;
  3451	            let mut is_prunable = false;
  3452	            let mut prunable_reason = None;
  3453	            let mut is_locked = false;
  3454	            let mut locked_reason = None;
  3455	
  3456	            for line in block.lines() {
  3457	                if let Some(value) = line.strip_prefix("worktree ") {
  3458	                    path = Some(value.to_string());
  3459	                } else if let Some(value) = line.strip_prefix("branch ") {
  3460	                    branch = Some(value.trim_start_matches("refs/heads/").to_string());
  3461	                } else if line == "detached" {
  3462	                    branch = Some("detached".to_string());
  3463	                } else if line == "prunable" {
  3464	                    is_prunable = true;
  3465	                } else if let Some(value) = line.strip_prefix("prunable ") {
  3466	                    is_prunable = true;
  3467	                    prunable_reason = Some(value.to_string());
  3468	                } else if line == "locked" {
  3469	                    is_locked = true;
  3470	                } else if let Some(value) = line.strip_prefix("locked ") {
  3471	                    is_locked = true;
  3472	                    locked_reason = Some(value.to_string());
  3473	                }
  3474	            }
  3475	
  3476	            path.map(|path| {
  3477	                let branch = branch.unwrap_or_else(|| "unknown".to_string());
  3478	                let task_id = branch_task_id(&branch);
  3479	                ProjectWorktree {
  3480	                    repo: String::new(),
  3481	                    path,
  3482	                    branch,
  3483	                    task_id,
  3484	                    is_dirty: false,
  3485	                    has_unmerged_commits: false,
  3486	                    is_prunable,
  3487	                    prunable_reason,
  3488	                    is_locked,
  3489	                    locked_reason,
  3490	                    last_activity: None,
  3491	                    delete_eligibility: "unknown".to_string(),
  3492	                }
  3493	            })
  3494	        })
  3495	        .collect()
  3496	}
  3497	
  3498	fn project_worktree_delete_eligibility(
  3499	    is_dirty: bool,
  3500	    has_unmerged_commits: bool,
  3501	    is_prunable: bool,
  3502	    is_locked: bool,
  3503	) -> String {
  3504	    if is_dirty {
  3505	        "blocked: dirty worktree".to_string()
  3506	    } else if has_unmerged_commits {
  3507	        "blocked: unmerged commits".to_string()
  3508	    } else if is_locked {
  3509	        "blocked: locked worktree".to_string()
  3510	    } else if is_prunable {
  3511	        "review: prunable missing worktree metadata".to_string()
  3512	    } else {
  3513	        "requires-confirmation".to_string()
  3514	    }
  3515	}
  3516	
  3517	/// Plain sentences describing what a forced removal actually threw away, so the person
  3518	/// who clicked the button can read the consequence rather than decode a status code.
  3519	/// `dirty_file_count` is `None` when git could not be asked how much was there. That is NOT
  3520	/// the same as zero, and it must never be reported as "nothing was lost" — the removal has
  3521	/// already happened by the time this runs. `was_dirty` is what the worktree listing said a
  3522	/// moment earlier, and it is believed over a count of zero when the two disagree.
  3523	fn describe_forced_worktree_removal(
  3524	    branch: &str,
  3525	    dirty_file_count: Option<usize>,
  3526	    was_dirty: bool,
  3527	    had_unpushed_commits: bool,
  3528	    unlocked_reason: Option<&str>,
  3529	) -> String {
  3530	    let mut message = format!("Force removed worktree {branch}.");
  3531	
  3532	    match dirty_file_count {
  3533	        Some(count) if count > 0 => {
  3534	            let noun = if count == 1 { "file" } else { "files" };
  3535	            message.push_str(&format!(
  3536	                " Deleted {count} {noun} with changes that were never committed."
  3537	            ));
  3538	        }
  3539	        // Counted zero, but the listing had already seen changes — the count is the one
  3540	        // that is wrong, so say what is known and admit the number is not.
  3541	        _ if was_dirty => {
  3542	            message.push_str(
  3543	                " Deleted files with changes that were never committed; they could not be counted before the removal.",
  3544	            );
  3545	        }
  3546	        Some(_) => {
  3547	            message.push_str(" It had no uncommitted changes.");
  3548	        }
  3549	        // Nothing could be read at all, so promising a clean worktree would be a guess.
  3550	        None => {
  3551	            message.push_str(
  3552	                " Could not check for uncommitted changes before the removal, so anything not committed is gone.",
  3553	            );
  3554	        }
  3555	    }
  3556	
