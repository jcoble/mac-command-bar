  6963	
  6964	        let pushed = push_git_repository_sync(local.clone()).unwrap();
  6965	        assert_eq!(pushed.message, "Pushed current branch");
  6966	        assert_eq!(pushed.status.ahead, 0);
  6967	        let remote_subject = run_git_text(&remote, &["log", "-1", "--format=%s", "main"]).unwrap();
  6968	        assert_eq!(remote_subject.trim(), "local update");
  6969	
  6970	        std::fs::remove_dir_all(remote).unwrap();
  6971	        std::fs::remove_dir_all(local).unwrap();
  6972	        std::fs::remove_dir_all(peer).unwrap();
