   152	/** The file has something in the index that is not just "untracked". */
   153	export function isGitFileStaged(file: ProjectGitFileStatus | null | undefined): boolean {
   154	  return Boolean(file?.indexStatus && file.badge !== '?');
   155	}
   156	
   157	export function isGitFileUntracked(file: ProjectGitFileStatus): boolean {
   158	  return file.badge === '?' || file.indexStatus === '?' || file.worktreeStatus === '?';
   159	}
   160	
   161	export function hasGitFileUnstagedChanges(file: ProjectGitFileStatus): boolean {
   162	  return isGitFileUntracked(file) || Boolean(file.worktreeStatus);
   163	}
   164	
   165	/** True when the file is gone from disk, so there is no diff to read for it. */
   166	export function isGitFileDeleted(file: ProjectGitFileStatus): boolean {
   167	  return file.badge === 'D' || file.worktreeStatus === 'deleted';
   168	}
