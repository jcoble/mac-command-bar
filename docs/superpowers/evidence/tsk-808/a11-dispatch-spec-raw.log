   278	/** "main · 2 ahead · 1 behind", or why there is no branch line to show. */
   279	export function describeGitBranch(status: ProjectGitStatus | null): string {
   280	  if (!status) return 'No repository loaded';
   281	  const parts: string[] = [status.branch ?? 'no branch checked out'];
   282	  if (!status.hasUpstream) {
   283	    parts.push('no upstream branch');
   284	  } else {
   285	    if (status.ahead > 0) parts.push(`${status.ahead} to push`);
   286	    if (status.behind > 0) parts.push(`${status.behind} to pull`);
   287	    if (status.ahead === 0 && status.behind === 0) parts.push('up to date');
   288	  }
   289	  return parts.join(' · ');
   290	}
   291	
   292	/**
   293	 * The hover text for the branch line. A branch name like
   294	 * `codex/outbound-rule-generation` does not fit a narrow panel, and a name cut
   295	 * off at `outbound-rule-generat…` is worse than no name at all — you cannot tell
   296	 * two long branches apart. So the full name always exists somewhere you can
   297	 * read it, with the ahead/behind counts spelled out as sentences rather than
   298	 * arrows.
   299	 */
   300	export function describeGitBranchTitle(status: ProjectGitStatus | null): string {
   301	  if (!status) return 'No repository loaded';
   302	  const branch = status.branch ?? '';
   303	  const lines: string[] = [branch === '' ? 'No branch is checked out.' : `Branch: ${branch}`];
   304	
   305	  if (!status.hasUpstream) {
   306	    lines.push('This branch has no matching branch on the remote yet.');
   307	  } else if (status.ahead === 0 && status.behind === 0) {
   308	    lines.push('Up to date with the remote.');
   309	  } else {
   310	    if (status.ahead > 0) {
   311	      lines.push(
   312	        `${status.ahead} commit${status.ahead === 1 ? '' : 's'} here that the remote does not have.`
   313	      );
   314	    }
   315	    if (status.behind > 0) {
   316	      lines.push(
   317	        `${status.behind} commit${status.behind === 1 ? '' : 's'} on the remote that you do not have.`
   318	      );
   319	    }
   320	  }
   321	  return lines.join('\n');
   322	}
   323	
   324	/** The last path segment of an absolute path, for the panel's title line. */
   325	export function repositoryLabel(root: string | null): string {
   326	  if (!root) return '';
   327	  const trimmed = root.replace(/\/+$/, '');
   328	  const index = trimmed.lastIndexOf('/');
   329	  return index >= 0 ? trimmed.slice(index + 1) : trimmed;
   330	}
   331	
   332	/** True when there is at least one staged file, so a commit could succeed. */
   333	export function hasStagedChanges(status: ProjectGitStatus | null): boolean {
   334	  return (status?.files ?? []).some(isGitFileStaged);
   335	}
   336	
   337	/**
   338	 * Is this failure just "there is no repository in this folder"?
   339	 *
   340	 * That is an ordinary thing for a folder to be, not a fault, and git reports it
   341	 * the same way it reports real breakage — on stderr, starting with `fatal:`. So
   342	 * the panel has to tell the two apart to avoid showing a plain folder a red
   343	 * error it can do nothing about. Everything this does NOT match stays an error
   344	 * and keeps its own message, which is what a genuine failure needs.
   345	 */
   346	export function isNotARepositoryError(message: string): boolean {
   347	  // Deliberately narrow. A phrase matched too eagerly here would HIDE a real
   348	  // failure behind a calm empty state, which is worse than showing a message
   349	  // that is hard to read — so only git's own wording for this counts.
   350	  return /not a git repository/i.test(message);
   351	}
