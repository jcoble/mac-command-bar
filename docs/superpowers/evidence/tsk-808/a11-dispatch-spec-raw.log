  4688	fn runtime_context_project_for_cwd(
  4689	    cwd: &Path,
  4690	    projects: &[RuntimeContextProject],
  4691	) -> Option<RuntimeContextProjectMatch> {
  4692	    let cwd_path = normalized_path_string(cwd);
  4693	
  4694	    for project in projects {
  4695	        let project_path = normalized_path_string(Path::new(&project.path));
  4696	        if path_is_within(&cwd_path, &project_path) {
  4697	            return Some(RuntimeContextProjectMatch {
  4698	                project_id: Some(project.id.clone()),
  4699	                project_name: project.name.clone(),
  4700	                root_label: runtime_context_root_label(Path::new(&project.path)),
  4701	            });
  4702	        }
  4703	    }
  4704	
  4705	    let (worktree_repo, _) = worktree_repo_and_slug(cwd)?;
  4706	    projects
  4707	        .iter()
  4708	        .find(|project| {
  4709	            project.name.eq_ignore_ascii_case(&worktree_repo)
  4710	                || path_last_segment(Path::new(&project.path))
  4711	                    .is_some_and(|segment| segment.eq_ignore_ascii_case(&worktree_repo))
  4712	        })
  4713	        .map(|project| RuntimeContextProjectMatch {
  4714	            project_id: Some(project.id.clone()),
  4715	            project_name: project.name.clone(),
  4716	            root_label: runtime_context_root_label(cwd),
  4717	        })
  4718	}
