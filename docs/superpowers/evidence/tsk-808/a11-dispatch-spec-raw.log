   544	pub(crate) trait AgentRuntimePort: Send + Sync {
   545	    fn dispatch<'a>(
   546	        &'a self,
   547	        request: AgentDispatchRequest,
   548	    ) -> PortFuture<'a, AgentDispatchReceipt>;
   549	    fn cancel<'a>(&'a self, owned_id: &'a str) -> PortFuture<'a, ()>;
   550	}
   551	
   552	impl AgentRuntimePort for AgentRuntimeManager {
   553	    fn dispatch<'a>(
   554	        &'a self,
   555	        request: AgentDispatchRequest,
   556	    ) -> PortFuture<'a, AgentDispatchReceipt> {
   557	        Box::pin(async move {
   558	            let provider = match request.provider.to_ascii_lowercase().as_str() {
   559	                "codex" => AgentConversationProvider::Codex,
   560	                "claude" => AgentConversationProvider::Claude,
   561	                other => {
   562	                    return Err(WorkflowError::PolicyDenied(format!(
   563	                        "Unsupported provider {other}"
   564	                    )))
   565	                }
   566	            };
   567	            let connection = self
   568	                .ensure(EnsureAgentConversationRequest {
   569	                    owned_id: request.owned_id.clone(),
   570	                    provider,
   571	                    cwd: request.cwd.clone(),
   572	                    native_session_id: None,
   573	                })
   574	                .map_err(WorkflowError::Runtime)?;
   575	            if self.providers().manifest(provider).is_err() {
   576	                return Err(WorkflowError::Runtime(format!(
   577	                    "Provider {} is not installed",
   578	                    request.provider
   579	                )));
   580	            }
   581	            self.activate(&connection.owned_id, connection.generation)
   582	                .await
   583	                .map_err(WorkflowError::Runtime)?;
   584	            let capabilities = self
   585	                .capabilities(&connection.owned_id, connection.generation)
   586	                .map_err(WorkflowError::Runtime)?;
   587	            for (categories, selected) in [
   588	                (&["model"][..], request.model.as_deref()),
   589	                (&["thought_level", "effort"][..], request.effort.as_deref()),
   590	                (
   591	                    &["mode", "permission", "permissions"][..],
   592	                    request.permission.as_deref(),
   593	                ),
   594	            ] {
   595	                if let Some(value) = selected {
   596	                    let option = capabilities
   597	                        .config_options
   598	                        .iter()
   599	                        .find(|option| {
   600	                            categories
   601	                                .iter()
   602	                                .any(|category| option.category.eq_ignore_ascii_case(category))
   603	                        })
   604	                        .ok_or_else(|| {
   605	                            WorkflowError::PolicyDenied(format!(
   606	                                "Provider {} did not advertise the requested {} capability",
   607	                                request.provider, categories[0]
   608	                            ))
   609	                        })?;
   610	                    self.set_config(
   611	                        &connection.owned_id,
   612	                        connection.generation,
   613	                        &option.id,
   614	                        json!(value),
   615	                    )
   616	                    .await
   617	                    .map_err(WorkflowError::Runtime)?;
   618	                }
   619	            }
   620	            let envelope = json!({
   621	                "roleId": request.role_id, "model": request.model, "effort": request.effort,
   622	                "permission": request.permission, "outputContract": request.output_contract.name(),
   623	                "task": request.prompt
   624	            });
   625	            self.prompt(
   626	                &connection.owned_id,
   627	                connection.generation,
   628	                AgentPrompt {
   629	                    text: envelope.to_string(),
   630	                    images: Vec::new(),
   631	                },
   632	            )
   633	            .await
   634	            .map_err(WorkflowError::Runtime)?;
   635	            Ok(AgentDispatchReceipt {
   636	                provider_instance_id: format!("{}-{}", request.provider, connection.generation),
   637	            })
   638	        })
   639	    }
   640	
   641	    fn cancel<'a>(&'a self, owned_id: &'a str) -> PortFuture<'a, ()> {
   642	        Box::pin(async move {
   643	            let Some(snapshot) = self.snapshot(owned_id).map_err(WorkflowError::Runtime)? else {
   644	                return Ok(());
   645	            };
   646	            self.cancel_turn(owned_id, snapshot.connection.generation)
   647	                .await
   648	                .map_err(WorkflowError::Runtime)
   649	        })
   650	    }
   651	}
