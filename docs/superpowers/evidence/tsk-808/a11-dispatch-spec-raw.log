   561	export function setConversationConnection(connection: AgentConversationConnection): void {
   562	  const current = ensureConversationSession(connection.ownedId, connection.provider);
   563	  current.generation = connection.generation;
   564	  current.writerLease.generation = connection.generation;
   565	  current.connectionState = connection.state;
   566	  if (connection.nativeSessionId) current.nativeSessionId = connection.nativeSessionId;
   567	}
   568	
   569	export function captureConversationWorkspace(
   570	  ownedId: string
   571	): SessionConversationWorkspace | undefined {
   572	  const current = conversationSessions[ownedId];
   573	  if (!current) return undefined;
   574	  return {
   575	    version: SESSION_CONVERSATION_WORKSPACE_VERSION,
   576	    mode: current.mode,
   577	    draft: current.draft,
   578	    generation: current.generation,
   579	    owner: current.executionOwner,
   580	    attachmentIds: current.attachmentIds,
   581	    config: current.config,
   582	    parentScrollTop: current.scrollTop,
   583	    childScrollTopById: current.childScrollTopById,
   584	    sequence: current.lastSequence,
   585	    telemetry: current.telemetry,
   586	    writerLease: current.writerLease,
   587	    writerLeaseTransition: current.writerLeaseTransition,
   588	    selectedChildId: current.selectedChildId,
   589	    scrollTop: current.scrollTop,
   590	    providerGeneration: current.generation,
   591	    lastSequence: current.lastSequence
   592	  };
   593	}
   594	
   595	export function restoreConversationWorkspace(
   596	  ownedId: string,
   597	  provider: AgentConversationProvider,
   598	  snapshot: SessionConversationWorkspace | null | undefined
   599	): ConversationWorkspaceState {
   600	  const current = ensureConversationSession(ownedId, provider);
   601	  current.mode = snapshot?.mode === 'raw' ? 'raw' : 'structured';
   602	  current.draft = snapshot?.draft ?? '';
   603	  current.selectedChildId = snapshot?.selectedChildId ?? null;
   604	  current.scrollTop = snapshot?.parentScrollTop ?? snapshot?.scrollTop ?? 0;
   605	  current.childScrollTopById = snapshot?.childScrollTopById ?? {};
   606	  current.executionOwner = snapshot?.owner ?? current.executionOwner;
   607	  current.attachmentIds = snapshot?.attachmentIds ?? current.attachmentIds;
   608	  current.config = snapshot?.config ?? current.config;
   609	  current.telemetry = snapshot?.telemetry ?? current.telemetry;
   610	  if (snapshot?.writerLease?.ownedId === ownedId) current.writerLease = snapshot.writerLease;
   611	  if (snapshot?.writerLeaseTransition?.ownedId === ownedId) {
   612	    current.writerLeaseTransition = snapshot.writerLeaseTransition;
   613	  }
   614	  return current;
   615	}
   616	
   617	export function removeConversationSession(ownedId: string): void {
   618	  delete conversationSessions[ownedId];
