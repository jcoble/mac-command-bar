   209	/** The small grey line under a changed-file row. */
   210	export function describeGitFileChange(file: ProjectGitFileStatus): string {
   211	  if (file.indexStatus && file.worktreeStatus) {
   212	    return `${file.indexStatus} + ${file.worktreeStatus}`;
   213	  }
   214	  return file.status || 'changed';
   215	}
