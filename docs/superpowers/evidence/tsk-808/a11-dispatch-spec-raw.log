  8134	    /// Not part of the normal suite: it reads a real, large checkout. Run it by
  8135	    /// hand when the margin-count budget is in question:
  8136	    ///
  8137	    /// ```text
  8138	    /// cargo test --release --manifest-path tauri-svelte-preview/src-tauri/Cargo.toml \
  8139	    ///   reference_count_pass_over_a_large_project -- --ignored --nocapture
  8140	    /// ```
  8141	    #[test]
  8142	    #[ignore]
  8143	    fn reference_count_pass_over_a_large_project() {
  8144	        let root = PathBuf::from(
  8145	            std::env::var("MCB_REFERENCE_COUNT_BENCH_ROOT")
  8146	                .unwrap_or_else(|_| "/Users/blackcolours/dev/work/EdiPlatform".to_string()),
  8147	        );
  8148	        if !root.is_dir() {
  8149	            eprintln!("skipping: {} is not a directory", root.display());
  8150	            return;
  8151	        }
  8152	
  8153	        let symbol_names = (0..120)
  8154	            .map(|index| format!("BenchmarkSymbol{index}"))
  8155	            .collect::<Vec<_>>();
  8156	
  8157	        {
  8158	            let started = Instant::now();
  8159	            let mut records = Vec::new();
  8160	            let _ = collect_source_files(
  8161	                &root,
  8162	                &root,
  8163	                source_collection_limit(DEFAULT_SOURCE_LIST_LIMIT),
  8164	                None,
  8165	                &mut records,
  8166	                &SourceScanCancellation::none(),
  8167	                &mut SourceScanWalkProgress::default(),
  8168	            );
  8169	            eprintln!(
  8170	                "walk only: {} files in {} ms",
  8171	                records.len(),
  8172	                started.elapsed().as_millis()
  8173	            );
  8174	
  8175	            let started = Instant::now();
  8176	            let mut bytes_read = 0usize;
  8177	            for record in &records {
  8178	                if record.byte_count > MAX_PREVIEW_BYTES {
  8179	                    continue;
  8180	                }
  8181	                if let Ok(bytes) = std::fs::read(&record.path) {
  8182	                    bytes_read += bytes.len();
  8183	                }
  8184	            }
  8185	            eprintln!(
  8186	                "read only: {} MB in {} ms",
  8187	                bytes_read / 1_000_000,
  8188	                started.elapsed().as_millis()
  8189	            );
  8190	        }
  8191	
  8192	        // First pass warms the file cache; the second is the number that matters.
  8193	        for attempt in 1..=2 {
  8194	            let started = Instant::now();
  8195	            let result =
  8196	                count_source_references_sync(root.clone(), symbol_names.clone(), Some(600_000))
  8197	                    .unwrap();
  8198	            eprintln!(
  8199	                "pass {attempt}: {} files in {} ms (approximate: {})",
  8200	                result.scanned_files,
  8201	                started.elapsed().as_millis(),
  8202	                result.approximate
  8203	            );
  8204	        }
  8205	    }
