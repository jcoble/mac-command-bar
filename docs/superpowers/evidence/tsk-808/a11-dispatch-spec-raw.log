  1586	#[cfg(test)]
  1587	fn list_source_files_sync(
  1588	    root: PathBuf,
  1589	    limit: usize,
  1590	    query: Option<String>,
  1591	) -> Result<SourceScanResult, String> {
  1592	    list_source_files_sync_with_cancellation(root, limit, query, SourceScanCancellation::none())
  1593	}
  1594	
  1595	fn list_source_files_sync_with_cancellation(
  1596	    root: PathBuf,
  1597	    limit: usize,
  1598	    query: Option<String>,
  1599	    cancellation: SourceScanCancellation,
  1600	) -> Result<SourceScanResult, String> {
  1601	    cancellation.ensure_active()?;
  1602	    let metadata = std::fs::metadata(&root)
  1603	        .map_err(|error| format!("Could not read source root metadata: {error}"))?;
  1604	    if !metadata.is_dir() {
  1605	        return Err("Source root is not a directory".to_string());
  1606	    }
  1607	
  1608	    let limit = if limit == 0 {
  1609	        DEFAULT_SOURCE_LIST_LIMIT
  1610	    } else {
  1611	        limit.min(MAX_SOURCE_LIST_LIMIT)
  1612	    };
  1613	    let normalized_query = query
  1614	        .map(|value| value.trim().to_lowercase())
  1615	        .filter(|value| !value.is_empty());
  1616	    let collect_limit = source_collection_limit(limit);
  1617	    let mut records = Vec::new();
  1618	    let mut progress = SourceScanWalkProgress::default();
  1619	    collect_source_files(
  1620	        &root,
  1621	        &root,
  1622	        collect_limit,
  1623	        normalized_query.as_deref(),
  1624	        &mut records,
  1625	        &cancellation,
  1626	        &mut progress,
  1627	    )?;
  1628	    progress.report(&cancellation);
  1629	    cancellation.ensure_active()?;
  1630	    let collected_file_count = records.len();
  1631	    records.sort_by(compare_source_records);
  1632	    let truncated = collected_file_count > limit;
  1633	    records.truncate(limit);
  1634	    let mut stats = progress.stats;
  1635	    stats.requested_limit = limit;
  1636	    stats.returned_files = records.len();
  1637	    stats.collection_limit = collect_limit;
  1638	    stats.collection_limit_reached = collected_file_count >= collect_limit;
  1639	    #[cfg(debug_assertions)]
  1640	    eprintln!(
  1641	        "mcb tauri source.list root={} count={} truncated={}",
  1642	        root.display(),
  1643	        records.len(),
  1644	        truncated
  1645	    );
  1646	    Ok(SourceScanResult {
  1647	        records,
  1648	        limit,
  1649	        truncated,
  1650	        stats,
  1651	    })
  1652	}
  1653	
  1654	fn validate_project_root_sync(path: PathBuf) -> ProjectRootValidationResult {
  1655	    let path_label = path.display().to_string();
  1656	    let metadata = std::fs::metadata(&path);
  1657	    let Ok(metadata) = metadata else {
  1658	        return ProjectRootValidationResult {
  1659	            path: path_label,
  1660	            exists: false,
  1661	            is_directory: false,
  1662	            is_git_repository: false,
  1663	            git_root: None,
  1664	            message: "Project path not found".to_string(),
  1665	        };
  1666	    };
  1667	
  1668	    if !metadata.is_dir() {
  1669	        return ProjectRootValidationResult {
  1670	            path: path_label,
  1671	            exists: true,
  1672	            is_directory: false,
  1673	            is_git_repository: false,
  1674	            git_root: None,
  1675	            message: "Project path points to a file. Choose the repository folder instead."
  1676	                .to_string(),
  1677	        };
  1678	    }
  1679	
  1680	    let git_root_path = git_repository_root(&path);
  1681	    let is_git_repository = git_root_path
  1682	        .as_ref()
  1683	        .is_some_and(|git_root| paths_refer_to_same_location(git_root, &path));
  1684	    let git_root = git_root_path
  1685	        .as_ref()
  1686	        .map(|root| normalized_path_string(root));
  1687	    ProjectRootValidationResult {
  1688	        path: path_label,
  1689	        exists: true,
  1690	        is_directory: true,
  1691	        is_git_repository,
  1692	        git_root: git_root.clone(),
  1693	        message: if is_git_repository {
  1694	            "Project root ready".to_string()
  1695	        } else if let Some(git_root) = git_root {
  1696	            format!("Folder is inside a Git repository. Add {git_root} for full project context.")
  1697	        } else {
  1698	            "Folder is not a Git repository. Source browsing will work, but Git/worktree panels may be unavailable."
  1699	                .to_string()
  1700	        },
  1701	    }
  1702	}
  1703	
  1704	fn git_repository_root(path: &Path) -> Option<PathBuf> {
  1705	    let mut current = Some(path);
  1706	    while let Some(candidate) = current {
  1707	        if candidate.join(".git").exists() {
  1708	            return Some(candidate.to_path_buf());
  1709	        }
  1710	        current = candidate.parent();
  1711	    }
  1712	
  1713	    let output = Command::new("git")
  1714	        .args([
  1715	            "-C",
  1716	            path.to_str().unwrap_or_default(),
  1717	            "rev-parse",
  1718	            "--show-toplevel",
  1719	        ])
  1720	        .output()
  1721	        .ok()?;
  1722	
  1723	    if !output.status.success() {
  1724	        return None;
  1725	    }
  1726	
  1727	    let root = String::from_utf8_lossy(&output.stdout).trim().to_string();
  1728	    if root.is_empty() {
  1729	        None
  1730	    } else {
  1731	        Some(PathBuf::from(root))
  1732	    }
  1733	}
  1734	
  1735	fn paths_refer_to_same_location(left: &Path, right: &Path) -> bool {
  1736	    let normalized_left = std::fs::canonicalize(left)
  1737	        .map(|path| normalized_path_string(&path))
  1738	        .unwrap_or_else(|_| normalized_path_string(left));
  1739	    let normalized_right = std::fs::canonicalize(right)
  1740	        .map(|path| normalized_path_string(&path))
  1741	        .unwrap_or_else(|_| normalized_path_string(right));
  1742	    normalized_left == normalized_right
  1743	}
  1744	
  1745	fn collect_source_files(
  1746	    root: &Path,
  1747	    current: &Path,
  1748	    limit: usize,
  1749	    query: Option<&str>,
  1750	    records: &mut Vec<SourceRecord>,
  1751	    cancellation: &SourceScanCancellation,
  1752	    progress: &mut SourceScanWalkProgress,
  1753	) -> Result<(), String> {
  1754	    cancellation.ensure_active()?;
  1755	    if records.len() >= limit {
  1756	        return Ok(());
  1757	    }
  1758	
  1759	    let mut entries = std::fs::read_dir(current)
  1760	        .map_err(|error| format!("Could not read source directory: {error}"))?
  1761	        .filter_map(Result::ok)
  1762	        .collect::<Vec<_>>();
  1763	    entries.sort_by(|left, right| compare_source_walk_entries(root, left, right));
  1764	
  1765	    for entry in entries {
  1766	        cancellation.ensure_active()?;
  1767	        progress.visit_entry(cancellation);
  1768	
  1769	        if records.len() >= limit {
  1770	            break;
  1771	        }
  1772	
  1773	        let path = entry.path();
  1774	        let file_name = entry.file_name().to_string_lossy().to_string();
  1775	        let Ok(metadata) = entry.metadata() else {
  1776	            progress.skip_unreadable_entry();
  1777	            continue;
  1778	        };
  1779	
  1780	        if metadata.is_dir() {
  1781	            if let Some(reason) = skip_dir_reason(&file_name) {
  1782	                progress.skip_directory(root, &path, &file_name, reason);
  1783	                continue;
  1784	            }
  1785	            collect_source_files(root, &path, limit, query, records, cancellation, progress)?;
  1786	            continue;
  1787	        }
  1788	
  1789	        if !metadata.is_file() {
  1790	            progress.skip_unsupported_file();
  1791	            continue;
  1792	        }
  1793	
  1794	        if !is_source_file(&path) {
  1795	            progress.skip_unsupported_file();
  1796	            continue;
  1797	        }
  1798	
  1799	        let relative_path = normalized_relative_source_path(root, &path);
  1800	        if !source_file_matches_query(&relative_path, &file_name, query) {
  1801	            continue;
  1802	        }
  1803	
  1804	        records.push(SourceRecord {
  1805	            path: path.display().to_string(),
  1806	            relative_path,
  1807	            file_name,
  1808	            language: detect_language(&path),
  1809	            byte_count: metadata.len(),
  1810	        });
  1811	        progress.match_file(cancellation);
  1812	    }
  1813	
  1814	    Ok(())
  1815	}
  1816	
  1817	fn read_source_file_sync(path: PathBuf) -> Result<SourcePreview, String> {
  1818	    let path_ref = path.as_path();
  1819	    let metadata = std::fs::metadata(path_ref)
  1820	        .map_err(|error| format!("Could not read source metadata: {error}"))?;
  1821	    if !metadata.is_file() {
  1822	        return Err("Source path is not a file".to_string());
  1823	    }
  1824	    if metadata.len() > MAX_PREVIEW_BYTES {
  1825	        return Err(format!(
  1826	            "Source file is too large: {} bytes",
  1827	            metadata.len()
  1828	        ));
  1829	    }
  1830	
  1831	    let content = std::fs::read_to_string(path_ref)
  1832	        .map_err(|error| format!("Could not read source file as UTF-8: {error}"))?;
  1833	    let file_name = path_ref
  1834	        .file_name()
  1835	        .and_then(|value| value.to_str())
  1836	        .unwrap_or("source")
  1837	        .to_string();
  1838	
  1839	    let preview = SourcePreview {
  1840	        path: path_ref.display().to_string(),
  1841	        relative_path: file_name.clone(),
  1842	        file_name,
  1843	        language: detect_language(path_ref),
  1844	        byte_count: metadata.len(),
  1845	        line_count: content.lines().count(),
  1846	        content,
  1847	    };
  1848	    #[cfg(debug_assertions)]
  1849	    eprintln!(
  1850	        "mcb tauri source.preview path={} language={} lines={}",
  1851	        preview.path, preview.language, preview.line_count
  1852	    );
  1853	    Ok(preview)
  1854	}
  1855	
  1856	fn write_source_file_sync(path: PathBuf, content: String) -> Result<SourcePreview, String> {
  1857	    let path_ref = path.as_path();
  1858	    let metadata = std::fs::metadata(path_ref)
  1859	        .map_err(|error| format!("Could not read source metadata: {error}"))?;
  1860	    if !metadata.is_file() {
  1861	        return Err("Source path is not a file".to_string());
  1862	    }
  1863	    if !is_source_file(path_ref) {
  1864	        return Err("Source path is not a supported source file".to_string());
  1865	    }
  1866	
  1867	    let byte_count = content.as_bytes().len() as u64;
  1868	    if byte_count > MAX_PREVIEW_BYTES {
  1869	        return Err(format!("Source content is too large: {byte_count} bytes"));
  1870	    }
  1871	
  1872	    let parent = path_ref
  1873	        .parent()
  1874	        .ok_or_else(|| "Source path has no parent directory".to_string())?;
  1875	    let file_name = path_ref
  1876	        .file_name()
  1877	        .and_then(|value| value.to_str())
  1878	        .unwrap_or("source");
  1879	    let unique = std::time::SystemTime::now()
  1880	        .duration_since(std::time::UNIX_EPOCH)
  1881	        .map(|duration| duration.as_nanos())
  1882	        .unwrap_or_default();
  1883	    let temp_path = parent.join(format!(
  1884	        ".{file_name}.mcb-write-{}-{unique}",
  1885	        std::process::id()
  1886	    ));
  1887	
  1888	    std::fs::write(&temp_path, content.as_bytes())
  1889	        .map_err(|error| format!("Could not write source temp file: {error}"))?;
  1890	    if let Err(error) = std::fs::rename(&temp_path, path_ref) {
  1891	        let _ = std::fs::remove_file(&temp_path);
  1892	        return Err(format!("Could not replace source file: {error}"));
  1893	    }
  1894	
  1895	    read_source_file_sync(path)
  1896	}
  1897	
  1898	fn search_source_files_sync(
  1899	    records: Vec<SourceRecord>,
  1900	    query: String,
  1901	    limit: Option<usize>,
  1902	) -> Result<Vec<SourceSearchMatch>, String> {
  1903	    let normalized_query = query.trim().to_lowercase();
  1904	    if normalized_query.is_empty() {
  1905	        return Ok(Vec::new());
  1906	    }
  1907	
  1908	    let capped_limit = limit
  1909	        .unwrap_or(DEFAULT_SOURCE_SEARCH_LIMIT)
  1910	        .min(MAX_SOURCE_SEARCH_LIMIT);
  1911	    if capped_limit == 0 {
  1912	        return Ok(Vec::new());
  1913	    }
  1914	
  1915	    let mut matches = Vec::new();
  1916	    for record in records {
  1917	        if matches.len() >= capped_limit {
  1918	            break;
  1919	        }
  1920	
  1921	        let path = PathBuf::from(&record.path);
  1922	        let Ok(metadata) = std::fs::metadata(&path) else {
  1923	            continue;
  1924	        };
  1925	        if !metadata.is_file() || metadata.len() > MAX_PREVIEW_BYTES {
  1926	            continue;
