    27	export interface ShellCommandHooks {
    28	  /** Bring a center tab to the front (its id in the tab roster). */
    29	  showPanel(id: string): void;
    30	  /** Unfold the Source control section of the tool column on the right. */
    31	  expandSourceControl(): void;
    32	  /** Open one view of the tool column on the right. Opening a view is what
    33	   * lets that view read anything, so this is the entry point for somebody who
    34	   * has not got the column open at all. */
    35	  showView(id: SidebarViewId): void;
    36	  /** Open the new-session dialog. */
    37	  openNewSession(): void;
    38	  /** Put the Problems list back in the strip along the bottom. Hiding the list
    39	   * removes the buttons that would put it back, so this is a way in from the
    40	   * keyboard that cannot be taken away. */
    41	  showProblemsAtBottom(): void;
    42	}
