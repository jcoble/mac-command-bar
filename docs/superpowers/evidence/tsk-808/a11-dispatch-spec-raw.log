  7375	    /// The incident this replaced: a reader clicked one row whose folder was
  7376	    /// gone and watched every other gone-folder row disappear with it, because
  7377	    /// the removal ran a repo-wide prune.
  7378	    #[test]
  7379	    fn remove_project_worktree_clears_only_the_asked_for_missing_sibling() {
  7380	        let root = unique_temp_root();
  7381	        let first_sibling = unique_temp_root();
  7382	        let second_sibling = unique_temp_root();
  7383	        std::fs::create_dir_all(root.join("src")).unwrap();
  7384	        std::fs::write(root.join("src/App.ts"), "export const value = 1;\n").unwrap();
  7385	
  7386	        run_git_for_test(&root, &["init"]);
  7387	        run_git_for_test(&root, &["config", "user.name", "MacCommandBar Test"]);
  7388	        run_git_for_test(&root, &["config", "user.email", "test@example.invalid"]);
  7389	        run_git_for_test(&root, &["add", "src/App.ts"]);
  7390	        run_git_for_test(&root, &["commit", "-m", "initial"]);
  7391	        for (branch, sibling) in [
  7392	            ("cdx/tsk-500-first", &first_sibling),
  7393	            ("cdx/tsk-500-second", &second_sibling),
  7394	        ] {
  7395	            run_git_for_test(
  7396	                &root,
  7397	                &["worktree", "add", "-b", branch, sibling.to_str().unwrap()],
  7398	            );
  7399	            std::fs::remove_dir_all(sibling).unwrap();
  7400	        }
  7401	
  7402	        let before = list_project_worktrees_sync(root.clone()).unwrap();
  7403	        let first = before
  7404	            .iter()
  7405	            .find(|worktree| worktree.branch == "cdx/tsk-500-first")
  7406	            .expect("both deleted siblings should still be registered");
  7407	        assert!(first.is_prunable);
  7408	        let first_path = PathBuf::from(&first.path);
  7409	
  7410	        let result = remove_project_worktree_sync(root.clone(), first_path, false).unwrap();
  7411	
  7412	        assert!(!result
  7413	            .worktrees
  7414	            .iter()
  7415	            .any(|worktree| worktree.branch == "cdx/tsk-500-first"));
  7416	        assert!(
  7417	            result
  7418	                .worktrees
  7419	                .iter()
  7420	                .any(|worktree| worktree.branch == "cdx/tsk-500-second"),
  7421	            "clearing one gone-folder row must leave the other one alone"
  7422	        );
  7423	
  7424	        std::fs::remove_dir_all(root).unwrap();
  7425	    }
