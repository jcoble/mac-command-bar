    26	    /** Start the session the new-session dialog described. */
    27	    onStartNewSession: (request: NewSessionRequest) => void | Promise<void>;
    28	    /** The folders the sessions on the rail are running in, so the project
    29	     * picker knows about projects nobody added by hand. */
    30	    newSessionRoots: string[];
