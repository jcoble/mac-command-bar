   325	export async function sendStructuredMessage(
   326	  ownedId: string,
   327	  text: string,
   328	  ptySessionId?: string | null
   329	): Promise<void> {
   330	  const state = getConversationSession(ownedId);
   331	  if (!state) return;
   332	  if (!text.trim() && state.attachments.length === 0) return;
   333	  setConversationSending(ownedId, true);
   334	  try {
   335	    if (ptySessionId) {
   336	      if (state.writerLease.ownedId !== ownedId
   337	        || state.writerLease.generation !== state.generation
   338	        || state.writerLease.owner !== 'terminal') {
   339	        throw new Error('The terminal writer lease is not confirmed for this session');
   340	      }
   341	      const attachmentText = state.attachments.length
   342	        ? `\n\nAttached screenshots:\n${state.attachments.map((item) => `- ${item.path}`).join('\n')}`
   343	        : '';
   344	      const outgoingText = `${text}${attachmentText}`;
   345	      // Match a real terminal paste followed by a separate Enter key. Sending
   346	      // both in one PTY write makes Claude's TUI treat Enter as part of its
   347	      // multiline paste buffer, leaving the prompt staged but never submitted.
   348	      const pasted = await writeTerminalSessionFromTauri(
   349	        ptySessionId,
   350	        `\u001b[200~${outgoingText}\u001b[201~`
   351	      );
   352	      if (!pasted) throw new Error('The terminal session is no longer running');
   353	      const submitted = await writeTerminalSessionFromTauri(ptySessionId, '\r');
   354	      if (!submitted) throw new Error('The terminal session is no longer running');
   355	      setConversationSending(ownedId, false);
   356	      state.attachments.forEach(cleanupConversationAttachmentPreview);
   357	      setConversationAttachments(ownedId, []);
   358	      return;
   359	    }
   360	    if (state.generation < 1) throw new Error('The structured conversation is not connected');
   361	    const hydratedAttachments = state.capabilities?.prompt.image === true
   362	      ? await Promise.all(state.attachments.map((attachment) => hydrateAttachmentBytes(attachment as AttachmentWithBytes)))
   363	      : state.attachments as AttachmentWithBytes[];
   364	    const prompt = buildConversationPrompt(
   365	      text,
   366	      hydratedAttachments,
   367	      state.capabilities?.prompt.image === true
   368	    );
   369	    await invoke('send_agent_conversation_message', {
   370	      request: { ownedId, generation: state.generation, text: prompt.text, content: prompt.content }
   371	    });
   372	    state.attachments.forEach(cleanupConversationAttachmentPreview);
   373	    setConversationAttachments(ownedId, []);
   374	  } catch (error) {
   375	    setConversationSending(ownedId, false);
   376	    throw error;
   377	  }
   378	}
