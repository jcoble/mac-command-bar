  4212	fn select_playwright_session(
  4213	    sessions: Vec<PlaywrightSessionInfo>,
  4214	    pgid: i32,
  4215	) -> Result<PlaywrightSessionInfo, String> {
  4216	    let matched = u32::try_from(pgid).ok().and_then(|pgid| {
  4217	        sessions
  4218	            .into_iter()
  4219	            .find(|session| session.pgid == pgid && !session.pids.is_empty())
  4220	    });
  4221	
  4222	    matched.ok_or_else(|| {
  4223	        format!("No Playwright session is running in process group {pgid}, so nothing was stopped")
  4224	    })
  4225	}
  4226	
  4227	fn kill_playwright_sessions_with<SignalProcess, SleepAfterTerm, ListSessions>(
  4228	    sessions: Vec<PlaywrightSessionInfo>,
  4229	    mut signal_process: SignalProcess,
  4230	    sleep_after_term: SleepAfterTerm,
  4231	    mut list_sessions: ListSessions,
  4232	) -> Result<PlaywrightCleanupResult, String>
  4233	where
  4234	    SignalProcess: FnMut(u32, &str) -> Result<(), String>,
  4235	    SleepAfterTerm: FnOnce(),
  4236	    ListSessions: FnMut() -> Result<Vec<PlaywrightSessionInfo>, String>,
  4237	{
  4238	    let mut terminated_pgids = Vec::new();
  4239	    let mut terminated_pids = Vec::new();
  4240	    let mut failed_pgids = Vec::new();
  4241	
  4242	    for session in &sessions {
  4243	        let mut session_had_signal = false;
  4244	        for pid in &session.pids {
  4245	            if let Err(message) = signal_process(*pid, "TERM") {
  4246	                failed_pgids.push(PlaywrightCleanupFailure {
  4247	                    pgid: session.pgid,
  4248	                    pid: Some(*pid),
  4249	                    message,
  4250	                });
  4251	                continue;
  4252	            }
  4253	            session_had_signal = true;
  4254	            terminated_pids.push(*pid);
  4255	        }
  4256	        if session_had_signal {
  4257	            terminated_pgids.push(session.pgid);
  4258	        }
  4259	    }
  4260	
  4261	    sleep_after_term();
  4262	
  4263	    let remaining_pids = match list_sessions() {
  4264	        Ok(remaining_sessions) => remaining_sessions
  4265	            .into_iter()
  4266	            .flat_map(|session| session.pids)
  4267	            .collect::<HashSet<_>>(),
  4268	        Err(error) => {
  4269	            for pgid in &terminated_pgids {
  4270	                failed_pgids.push(PlaywrightCleanupFailure {
  4271	                    pgid: *pgid,
  4272	                    pid: None,
  4273	                    message: format!("Could not verify Playwright cleanup after TERM: {error}"),
  4274	                });
  4275	            }
  4276	            return Ok(PlaywrightCleanupResult {
  4277	                sessions,
  4278	                terminated_pgids,
  4279	                terminated_pids,
  4280	                failed_pgids,
  4281	            });
  4282	        }
  4283	    };
  4284	    let terminated_pid_set = terminated_pids.iter().copied().collect::<HashSet<_>>();
  4285	    for session in &sessions {
  4286	        for pid in session
  4287	            .pids
  4288	            .iter()
  4289	            .copied()
  4290	            .filter(|pid| terminated_pid_set.contains(pid) && remaining_pids.contains(pid))
  4291	        {
  4292	            if let Err(message) = signal_process(pid, "KILL") {
  4293	                failed_pgids.push(PlaywrightCleanupFailure {
  4294	                    pgid: session.pgid,
  4295	                    pid: Some(pid),
  4296	                    message,
  4297	                });
  4298	            }
  4299	        }
  4300	    }
  4301	
  4302	    Ok(PlaywrightCleanupResult {
  4303	        sessions,
  4304	        terminated_pgids,
  4305	        terminated_pids,
  4306	        failed_pgids,
  4307	    })
  4308	}
  4309	
  4310	fn kill_process_sync(pid: u32, expected_command: Option<String>) -> ProcessKillResult {
  4311	    // Process numbers get handed out again after a process exits. The panel the
  4312	    // reader clicked in may be minutes old, so before anything is signalled,
  4313	    // check the number still belongs to the command the panel showed them.
  4314	    if let Some(expected) = expected_command.as_deref().map(str::trim) {
  4315	        if !expected.is_empty() && pid > 1 {
  4316	            match process_command_name(pid) {
  4317	                None => {
  4318	                    return ProcessKillResult {
  4319	                        ok: false,
  4320	                        message: format!(
  4321	                            "Process {pid} has already exited, so there was nothing to stop."
  4322	                        ),
  4323	                    };
  4324	                }
  4325	                Some(actual) => {
  4326	                    if !process_commands_match(&actual, expected) {
  4327	                        return ProcessKillResult {
  4328	                            ok: false,
  4329	                            message: format!(
  4330	                                "Process {pid} now belongs to \"{actual}\", not \"{expected}\" — the number was reused by something else, so nothing was stopped. Refresh the list and try again."
  4331	                            ),
  4332	                        };
  4333	                    }
  4334	                }
  4335	            }
  4336	        }
  4337	    }
  4338	    kill_process_with(pid, std::process::id(), signal_process)
  4339	}
  4340	
  4341	/// The executable a process number belongs to right now, or None when no such
  4342	/// process exists.
  4343	fn process_command_name(pid: u32) -> Option<String> {
  4344	    let output = std::process::Command::new("ps")
  4345	        .args(["-p", &pid.to_string(), "-o", "comm="])
  4346	        .output()
  4347	        .ok()?;
  4348	    if !output.status.success() {
  4349	        return None;
  4350	    }
  4351	    let text = String::from_utf8_lossy(&output.stdout).trim().to_string();
  4352	    if text.is_empty() {
  4353	        None
  4354	    } else {
  4355	        Some(text)
  4356	    }
  4357	}
  4358	
  4359	/// The panel shows short names ("node") while `ps` answers with full paths
  4360	/// ("/usr/local/bin/node"), so the comparison is between file names, either
  4361	/// containing the other to survive versioned names like "node22".
  4362	fn process_commands_match(actual: &str, expected: &str) -> bool {
  4363	    fn file_name(command: &str) -> &str {
  4364	        command.trim().rsplit('/').next().unwrap_or(command)
  4365	    }
  4366	    let actual_name = file_name(actual);
  4367	    let expected_name = file_name(expected);
  4368	    if actual_name.is_empty() || expected_name.is_empty() {
  4369	        return false;
  4370	    }
  4371	    actual_name == expected_name
  4372	        || actual_name.contains(expected_name)
  4373	        || expected_name.contains(actual_name)
  4374	}
  4375	
  4376	/// Stop one process, with the refusals spelled out.
  4377	///
  4378	/// Numbers 0 and 1 are not ordinary processes — 0 means "every process in my
  4379	/// group" to the kill signal and 1 is the system's own first process, so both
  4380	/// are refused before anything is sent. So is this app's own number, which
  4381	/// would otherwise close the window the reader clicked in.
  4382	fn kill_process_with<SignalProcess>(
  4383	    pid: u32,
  4384	    own_pid: u32,
  4385	    mut signal_process: SignalProcess,
  4386	) -> ProcessKillResult
  4387	where
  4388	    SignalProcess: FnMut(u32, &str) -> Result<(), String>,
  4389	{
  4390	    if pid <= 1 {
  4391	        return ProcessKillResult {
  4392	            ok: false,
  4393	            message: format!(
  4394	                "{pid} is not a process this app will stop — it is the system's own, and stopping it would take the machine down."
  4395	            ),
  4396	        };
  4397	    }
  4398	    if pid == own_pid {
  4399	        return ProcessKillResult {
  4400	            ok: false,
  4401	            message: "That number belongs to this app itself, so nothing was stopped.".to_string(),
  4402	        };
  4403	    }
  4404	
  4405	    match signal_process(pid, "TERM") {
  4406	        Ok(()) => ProcessKillResult {
  4407	            ok: true,
  4408	            message: format!(
  4409	                "Asked process {pid} to stop. It may take a moment to finish shutting down."
  4410	            ),
  4411	        },
  4412	        Err(reason) => ProcessKillResult {
  4413	            ok: false,
  4414	            message: format!(
  4415	                "Could not stop process {pid}. It may have already exited, or it may belong to another user. ({reason})"
  4416	            ),
  4417	        },
  4418	    }
  4419	}
  4420	
  4421	fn signal_process(pid: u32, signal: &str) -> Result<(), String> {
  4422	    if pid == 0 || pid == std::process::id() {
  4423	        return Err(format!("Refusing to signal unsafe process {pid}"));
  4424	    }
  4425	
  4426	    let output = Command::new("kill")
  4427	        .args([format!("-{signal}"), pid.to_string()])
  4428	        .output()
  4429	        .map_err(|error| format!("Could not run kill -{signal} for pid {pid}: {error}"))?;
  4430	
  4431	    if output.status.success() {
  4432	        Ok(())
  4433	    } else {
  4434	        Err(format!(
  4435	            "kill -{signal} {pid} failed: {}",
  4436	            String::from_utf8_lossy(&output.stderr).trim()
  4437	        ))
  4438	    }
  4439	}
