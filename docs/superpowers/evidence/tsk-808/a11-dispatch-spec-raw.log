     1	/**
     2	 * sidebarViews.ts — which views the tool column offers, and which one it opens.
     3	 *
     4	 * PURE: no DOM, no dockview, no backend call. The activity bar and the column
     5	 * itself both read the roster from here so an id can never mean two different
     6	 * things in the two places.
     7	 *
     8	 * Each view holds its own stack of collapsible panes and remembers it under its
     9	 * own key, so opening Explorer cannot disturb how Worktrees was arranged.
    10	 *
    11	 * Two keys here are deliberately never read again, both left where they are,
    12	 * harmless and unread — the same treatment the center dock's pre-v2 layout key
    13	 * got:
    14	 *
    15	 *  - `mac-command-bar.next.left-panes`, from the single shared stack these
    16	 *    replaced. It describes one stack of four sections, a shape the column no
    17	 *    longer builds.
    18	 *  - `mac-command-bar.next.view-sessions-panes`, from back when the sessions
    19	 *    list was one of this column's views. Sessions now has a whole column of
    20	 *    its own down the left of the shell, so there is no view here to restore it
    21	 *    into. A stored "open on the sessions view" answer is handled the same way
    22	 *    by `readActiveView`: it names a view that no longer exists, so the column
    23	 *    opens on the default instead.
    24	 */
    25	import { clearLayout, loadLayout, saveLayout, type LayoutStorage } from './layoutStorage.ts';
    26	
    27	export type SidebarViewId =
    28	  | 'explorer'
    29	  | 'source-control'
    30	  | 'worktrees'
    31	  | 'stacks'
    32	  | 'context'
    33	  | 'agents'
    34	  | 'problems';
    35	
    36	export interface SidebarView {
    37	  id: SidebarViewId;
    38	  /** What the icon's tooltip says. */
    39	  title: string;
