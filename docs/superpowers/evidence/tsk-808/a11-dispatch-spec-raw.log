    25	import {
    26	  readCommitFileDiff,
    27	  readCommitFiles,
    28	  resolveRepositoryTop,
    29	  type GitCommitFileChange
    30	} from './gitBackendExtra.ts';
    31	import {
    32	  COMMIT_FILES_DESKTOP_ONLY_MESSAGE,
    33	  UNREADABLE_PATH_MESSAGE,
    34	  commitFilesEntry,
    35	  createGitCommitFilesEntry,
    36	  gitCommitFiles,
    37	  isCommitExpanded,
    38	  isUnreadableGitPath,
