   142	
   143	function trimmedString(value: unknown): string {
   144	  return typeof value === 'string' ? value.trim() : '';
   145	}
   146	
   147	function finiteNumber(value: unknown): number {
   148	  return typeof value === 'number' && Number.isFinite(value) ? value : 0;
   149	}
   150	
   151	/** Anything that is not a plain, readable array comes back as one that is empty. */
   152	function parseArray(raw: string | null | undefined): unknown[] {
   153	  if (typeof raw !== 'string' || raw.trim() === '') return [];
   154	  try {
   155	    const parsed: unknown = JSON.parse(raw);
   156	    return Array.isArray(parsed) ? parsed : [];
   157	  } catch {
   158	    return [];
   159	  }
   160	}
   161	
   162	/**
   163	 * Read a saved `env` list back. Anything that is not a list of `{key, value}`
   164	 * pairs with a usable name comes back empty, and a list with nothing usable in
   165	 * it comes back as `[]` — which the caller then leaves off the record entirely.
   166	 */
   167	function parseEnvList(value: unknown): StackEnvVar[] {
   168	  if (!Array.isArray(value)) return [];
   169	  const seen = new Set<string>();
   170	  const variables: StackEnvVar[] = [];
   171	  for (const entry of value) {
   172	    if (typeof entry !== 'object' || entry === null) continue;
   173	    const row = entry as Record<string, unknown>;
   174	    const key = trimmedString(row.key);
   175	    if (!key || !isEnvName(key) || seen.has(key)) continue;
   176	    seen.add(key);
   177	    variables.push({ key, value: typeof row.value === 'string' ? row.value : '' });
   178	  }
   179	  return variables;
   180	}
   181	
   182	/**
   183	 * Read saved run configurations back. Tolerant on purpose: an unreadable value,
   184	 * a value that is not a list, a row that is not an object, a row missing any of
   185	 * its four required fields, and a second row re-using an id are all simply
   186	 * dropped — a bad saved value must never be able to stop the panel opening.
   187	 *
   188	 * MIGRATION. Environment variables arrived after this shape shipped, so a
   189	 * configuration saved by an older build has no `env` key at all. That is not an
   190	 * error and needs no conversion step: the field is optional, a missing or
   191	 * unusable one reads as "no environment variables", and the record is left
   192	 * WITHOUT the key rather than being given an empty list. An old saved value
   193	 * therefore reads back byte-identical to what was written, and a user who never
   194	 * sets a variable can move between builds in either direction.
   195	 */
   196	export function parseStackDefinitions(raw: string | null | undefined): StackDefinition[] {
   197	  const seen = new Set<string>();
   198	  const definitions: StackDefinition[] = [];
   199	  for (const entry of parseArray(raw)) {
   200	    if (typeof entry !== 'object' || entry === null) continue;
   201	    const row = entry as Record<string, unknown>;
   202	    const id = trimmedString(row.id);
   203	    const name = trimmedString(row.name);
   204	    const script = trimmedString(row.script);
   205	    const cwd = trimmedString(row.cwd);
   206	    if (!id || !name || !script || !cwd) continue;
   207	    if (seen.has(id)) continue;
   208	    seen.add(id);
   209	    const env = parseEnvList(row.env);
   210	    definitions.push(env.length > 0 ? { id, name, script, cwd, env } : { id, name, script, cwd });
   211	  }
   212	  return definitions;
   213	}
   214	
   215	export function serializeStackDefinitions(definitions: StackDefinition[]): string {
   216	  return JSON.stringify(
   217	    definitions.map((definition) => {
   218	      const env = definition.env ?? [];
   219	      const row: Record<string, unknown> = {
   220	        id: definition.id,
   221	        name: definition.name,
   222	        script: definition.script,
   223	        cwd: definition.cwd
   224	      };
   225	      // Only written when there is something to write — see the migration note
   226	      // on `parseStackDefinitions`.
   227	      if (env.length > 0) row.env = env.map((entry) => ({ key: entry.key, value: entry.value }));
   228	      return row;
   229	    })
   230	  );
   231	}
