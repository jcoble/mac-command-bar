    87	async function load(): Promise<void> {
    88	  const ticket = beginProblemsLoad();
    89	  const root = problemsState.root;
    90	  if (!root) {
    91	    markProblemsUnavailable(ticket, 'Pick a session to see its problems.');
    92	    return;
    93	  }
    94	
    95	  try {
    96	    countInvoke('list_source_lsp_diagnostics_for_root');
    97	    const answer = await listProblemsForRoot(root);
    98	    if (answer === null) {
    99	      markProblemsUnavailable(ticket, DESKTOP_ONLY);
