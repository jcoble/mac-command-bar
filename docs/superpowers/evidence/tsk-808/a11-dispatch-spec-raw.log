   165	/**
   166	 * Join a repository root and a repository-relative path. The diff command wants
   167	 * an absolute path on disk; git status hands us a relative one.
   168	 */
   169	export function absolutePathWithin(root: string, relativePath: string): string {
   170	  const base = root.replace(/\/+$/, '');
   171	  const tail = relativePath.replace(/^\/+/, '');
   172	  return tail === '' ? base : `${base}/${tail}`;
   173	}
