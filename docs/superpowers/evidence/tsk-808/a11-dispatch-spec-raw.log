     9	
    10	import type { PaneSpec } from './paneStack.ts';
    11	
    12	export type SidePaneRegion = 'left' | 'right' | 'bottom';
    13	
    14	export const LEFT_SIDE_PANE_IDS = ['working', 'done', 'settled'] as const;
    15	
    16	export interface SidePaneRegistration {
    17	  id: string;
    18	  title: string;
    19	  region: SidePaneRegion;
    20	  component: Component;
    21	  minimumSize: number;
    22	  preferredSize: number;
    23	  maximumSize: number | null;
    24	  defaultExpanded: boolean;
    25	  persistent: boolean;
    26	  order: number;
    27	}
