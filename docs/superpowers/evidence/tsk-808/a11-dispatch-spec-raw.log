   111	/** The strip, trimmed to the cap: the most recent tabs, which are the ones at
   112	 * the end. The tab that was showing is always kept, even when it is older than
   113	 * all of them — coming back to a session and not finding the file you left on
   114	 * screen is the one thing nobody would forgive. It keeps its place in the
   115	 * strip; the oldest of the recent tabs makes room for it. */
   116	function cappedPaths(paths: string[], activePath: string | null): string[] {
   117	  const unique: string[] = [];
   118	  for (const path of paths) {
   119	    if (typeof path === 'string' && path && !unique.includes(path)) unique.push(path);
   120	  }
   121	  if (unique.length <= OPEN_PATHS_CAP) return unique;
   122	
   123	  const recent = unique.slice(unique.length - OPEN_PATHS_CAP);
   124	  if (!activePath || recent.includes(activePath) || !unique.includes(activePath)) return recent;
   125	  return [activePath, ...recent.slice(1)];
   126	}
