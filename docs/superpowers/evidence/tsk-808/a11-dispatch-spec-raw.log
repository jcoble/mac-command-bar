   198	    setConversationCapabilityError(ownedId, message);
   199	    throw error;
   200	  }
   201	}
   202	
   203	export async function setConversationConfigOption(
   204	  ownedId: string,
   205	  optionId: string,
   206	  value: AgentConfigValue
   207	): Promise<AgentCapabilities | null> {
   208	  const state = getConversationSession(ownedId);
   209	  const option = state?.capabilities?.configOptions.find((candidate) => candidate.id === optionId);
   210	  if (!state || !option || (option.choices && !option.choices.some((choice) => JSON.stringify(choice.value) === JSON.stringify(value)))) {
   211	    throw new Error('This configuration value is not advertised for the session');
   212	  }
   213	  if (!beginConversationConfigChange(ownedId, optionId, value)) throw new Error('Configuration change is not available');
   214	  try {
   215	    if (!isTauri()) throw new Error('The structured conversation runtime is unavailable');
   216	    const response = await invoke<{ capabilities?: AgentCapabilities; configOptions?: AgentConfigOption[] }>(
   217	      'set_agent_conversation_config_option',
   218	      { request: { ownedId, generation: state.generation, optionId, value } }
   219	    );
   220	    const latest = getConversationSession(ownedId);
   221	    if (!latest || latest.generation !== state.generation) {
   222	      throw new Error('Configuration response belongs to a stale conversation generation');
   223	    }
   224	    const capabilities = response?.capabilities
   225	      ?? (response?.configOptions ? { ...state.capabilities, configOptions: response.configOptions } as AgentCapabilities : state.capabilities);
   226	    if (!capabilities || capabilities.provider !== state.provider) {
   227	      throw new Error('Configuration response provider does not match this session');
   228	    }
   229	    confirmConversationConfigChange(ownedId, optionId, value, capabilities);
   230	    return capabilities;
   231	  } catch (error) {
   232	    if (getConversationSession(ownedId)?.generation === state.generation) {
   233	      failConversationConfigChange(ownedId, optionId, error instanceof Error ? error.message : String(error));
   234	    }
   235	    throw error;
   236	  }
   237	}
   238	
   239	export function startConversationTerminalProjection(input: {
   240	  ownedId: string;
   241	  provider: AgentConversationProvider;
   242	  nativeSessionId: string;
   243	}): void {
   244	  if (!isTauri()) return;
   245	  const signature = `${input.provider}:${input.nativeSessionId}`;
   246	  if (terminalProjections.get(input.ownedId) === signature) return;
   247	  terminalProjections.set(input.ownedId, signature);
   248	  const generation = getConversationSession(input.ownedId)?.generation ?? 0;
   249	  void invoke<TerminalProjectionRegistration>('start_agent_conversation_terminal_projection', {
   250	    request: { ...input, generation }
   251	  }).then((registration) => {
   252	    for (const event of registration.events) applyAgentConversationEvent(event);
   253	  }).catch(() => {
   254	    // The transcript may not exist until the agent accepts its first prompt.
   255	    // Dropping the signature lets the next activation register again.
   256	    if (terminalProjections.get(input.ownedId) === signature) terminalProjections.delete(input.ownedId);
   257	  });
   258	}
   259	
   260	export function stopConversationTerminalProjection(ownedId: string): void {
   261	  if (!terminalProjections.delete(ownedId) || !isTauri()) return;
   262	  void invoke<boolean>('stop_agent_conversation_terminal_projection', { ownedId });
   263	}
   264	
   265	async function resyncConversation(ownedId: string): Promise<void> {
   266	  const existing = resyncing.get(ownedId);
   267	  if (existing) return existing;
   268	  const work = (async () => {
   269	    for (let attempt = 0; attempt < 3; attempt += 1) {
   270	      const snapshot = await invoke<AgentConversationSnapshot | null>(
   271	        'read_agent_conversation_snapshot',
   272	        { ownedId }
   273	      );
   274	      if (!snapshot) return;
   275	      const sequenceBeforeApply = getConversationSession(ownedId)?.lastSequence ?? 0;
   276	      applyAgentConversationSnapshot(snapshot);
   277	      if (sequenceBeforeApply <= snapshot.lastSequence) return;
   278	    }
   279	  })().finally(() => resyncing.delete(ownedId));
   280	  resyncing.set(ownedId, work);
   281	  return work;
   282	}
   283	
   284	export async function startConversationEvents(): Promise<void> {
   285	  if (!isTauri() || unlisten) return;
   286	  unlisten = await listen<AgentConversationEvent | AgentEvent>('agent-conversation-event', ({ payload }) => {
   287	    applyAgentConversationEvent(payload);
   288	    if (getConversationSession(payload.ownedId)?.desynchronized) {
   289	      void resyncConversation(payload.ownedId);
   290	    }
   291	    if (('kind' in payload.payload && (payload.payload.kind === 'turn' || payload.payload.kind === 'error'))
   292	      || ('type' in payload && ['turn.completed', 'turn.interrupted', 'runtime.error'].includes(payload.type))) {
   293	      setConversationSending(payload.ownedId, false);
   294	    }
   295	  });
   296	}
   297	
   298	export function stopConversationEvents(): void {
   299	  unlisten?.();
   300	  unlisten = null;
   301	  for (const ownedId of [...terminalProjections.keys()]) stopConversationTerminalProjection(ownedId);
   302	}
   303	
   304	export async function closeStructuredConversation(ownedId: string): Promise<void> {
   305	  if (!isTauri()) return;
   306	  await invoke<boolean>('close_agent_conversation', { ownedId });
   307	}
   308	
   309	export async function ensureStructuredConversation(input: {
   310	  ownedId: string;
   311	  provider: AgentConversationProvider;
   312	  cwd: string;
   313	  nativeSessionId?: string | null;
   314	}): Promise<AgentConversationConnection | null> {
   315	  ensureConversationSession(input.ownedId, input.provider);
   316	  if (!isTauri() || !input.cwd.trim()) return null;
   317	  const connection = await invoke<AgentConversationConnection>('ensure_agent_conversation', {
   318	    request: input
   319	  });
   320	  setConversationConnection(connection);
   321	  await resyncConversation(input.ownedId);
   322	  return connection;
   323	}
   324	
   325	export async function sendStructuredMessage(
   326	  ownedId: string,
   327	  text: string,
   328	  ptySessionId?: string | null
   329	): Promise<void> {
   330	  const state = getConversationSession(ownedId);
   331	  if (!state) return;
   332	  if (!text.trim() && state.attachments.length === 0) return;
   333	  setConversationSending(ownedId, true);
   334	  try {
   335	    if (ptySessionId) {
   336	      if (state.writerLease.ownedId !== ownedId
   337	        || state.writerLease.generation !== state.generation
   338	        || state.writerLease.owner !== 'terminal') {
   339	        throw new Error('The terminal writer lease is not confirmed for this session');
   340	      }
   341	      const attachmentText = state.attachments.length
   342	        ? `\n\nAttached screenshots:\n${state.attachments.map((item) => `- ${item.path}`).join('\n')}`
   343	        : '';
   344	      const outgoingText = `${text}${attachmentText}`;
   345	      // Match a real terminal paste followed by a separate Enter key. Sending
   346	      // both in one PTY write makes Claude's TUI treat Enter as part of its
   347	      // multiline paste buffer, leaving the prompt staged but never submitted.
   348	      const pasted = await writeTerminalSessionFromTauri(
   349	        ptySessionId,
   350	        `\u001b[200~${outgoingText}\u001b[201~`
   351	      );
   352	      if (!pasted) throw new Error('The terminal session is no longer running');
   353	      const submitted = await writeTerminalSessionFromTauri(ptySessionId, '\r');
   354	      if (!submitted) throw new Error('The terminal session is no longer running');
   355	      setConversationSending(ownedId, false);
   356	      state.attachments.forEach(cleanupConversationAttachmentPreview);
   357	      setConversationAttachments(ownedId, []);
   358	      return;
   359	    }
   360	    if (state.generation < 1) throw new Error('The structured conversation is not connected');
   361	    const hydratedAttachments = state.capabilities?.prompt.image === true
   362	      ? await Promise.all(state.attachments.map((attachment) => hydrateAttachmentBytes(attachment as AttachmentWithBytes)))
   363	      : state.attachments as AttachmentWithBytes[];
   364	    const prompt = buildConversationPrompt(
   365	      text,
   366	      hydratedAttachments,
   367	      state.capabilities?.prompt.image === true
   368	    );
   369	    await invoke('send_agent_conversation_message', {
   370	      request: { ownedId, generation: state.generation, text: prompt.text, content: prompt.content }
   371	    });
   372	    state.attachments.forEach(cleanupConversationAttachmentPreview);
   373	    setConversationAttachments(ownedId, []);
   374	  } catch (error) {
   375	    setConversationSending(ownedId, false);
   376	    throw error;
   377	  }
   378	}
   379	
   380	export async function respondToStructuredApproval(
   381	  ownedId: string,
   382	  requestId: string,
   383	  decision: 'accept' | 'decline' | 'cancel'
   384	): Promise<void> {
   385	  const state = getConversationSession(ownedId);
   386	  if (!state) return;
   387	  await invoke('respond_agent_conversation_approval', {
   388	    request: { ownedId, generation: state.generation, requestId, decision }
   389	  });
   390	}
   391	
   392	export async function respondToStructuredInput(
   393	  ownedId: string,
   394	  response: Omit<AgentUserInputResponse, 'ownedId' | 'generation'>
   395	): Promise<void> {
