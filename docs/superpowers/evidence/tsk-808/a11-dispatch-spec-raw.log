  6662	    #[test]
  6663	    fn git_repository_summary_counts_dirty_files_and_task_branch() {
  6664	        let root = unique_temp_root();
  6665	        std::fs::create_dir_all(&root).unwrap();
  6666	        let readme_path = root.join("README.md");
  6667	        std::fs::write(&readme_path, "initial\n").unwrap();
  6668	
  6669	        run_git_for_test(&root, &["init"]);
  6670	        run_git_for_test(&root, &["add", "README.md"]);
  6671	        run_git_for_test(
  6672	            &root,
  6673	            &[
  6674	                "-c",
  6675	                "user.name=MacCommandBar Test",
  6676	                "-c",
  6677	                "user.email=test@example.invalid",
  6678	                "commit",
  6679	                "-m",
  6680	                "initial",
  6681	            ],
  6682	        );
  6683	        run_git_for_test(&root, &["checkout", "-b", "tsk-127-repo-dashboard"]);
  6684	
  6685	        std::fs::write(root.join("staged.txt"), "staged\n").unwrap();
  6686	        run_git_for_test(&root, &["add", "staged.txt"]);
  6687	        std::fs::write(&readme_path, "changed\n").unwrap();
  6688	        std::fs::write(root.join("untracked.txt"), "untracked\n").unwrap();
  6689	
  6690	        let project = RuntimeContextProject {
  6691	            id: "mac-command-bar".to_string(),
  6692	            name: "MacCommandBar".to_string(),
  6693	            path: root.display().to_string(),
  6694	        };
  6695	        let summaries = list_git_repository_summaries_sync(vec![project]).unwrap();
  6696	        let summary = summaries
  6697	            .iter()
  6698	            .find(|summary| summary.path == root.display().to_string())
  6699	            .unwrap();
  6700	
  6701	        assert_eq!(summary.project_id, "mac-command-bar");
  6702	        assert_eq!(summary.project_name, "MacCommandBar");
  6703	        assert_eq!(summary.branch, "tsk-127-repo-dashboard");
  6704	        assert_eq!(summary.task_id.as_deref(), Some("TSK-127"));
  6705	        assert_eq!(summary.staged_count, 1);
  6706	        assert_eq!(summary.unstaged_count, 1);
  6707	        assert_eq!(summary.untracked_count, 1);
  6708	        assert_eq!(summary.dirty_count, 3);
  6709	        assert!(!summary.has_upstream);
  6710	        assert!(summary.is_dirty);
  6711	        assert_eq!(summary.last_commit_subject.as_deref(), Some("initial"));
  6712	        assert!(summary
  6713	            .last_commit_sha
  6714	            .as_ref()
  6715	            .is_some_and(|sha| !sha.is_empty()));
  6716	        assert!(summary.dirty_since_epoch_ms.is_some());
  6717	        assert_ne!(
  6718	            summary.dirty_status_fingerprint,
  6719	            git_dirty_status_fingerprint(&[]),
  6720	            "dirty repositories should include a dirty status fingerprint"
