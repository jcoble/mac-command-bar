   114	async function hydrateAttachmentBytes(attachment: AttachmentWithBytes): Promise<AttachmentWithBytes> {
   115	  if (attachment.bytes?.length) return attachment;
   116	  if (!attachment.path) throw new Error(`Attachment ${attachment.name} has no managed path`);
   117	  const response = await fetch(isTauri() ? convertFileSrc(attachment.path) : attachment.path);
   118	  if (!response.ok) throw new Error(`Could not read attachment ${attachment.name}`);
   119	  return {
   120	    ...attachment,
   121	    bytes: Array.from(new Uint8Array(await response.arrayBuffer()))
   122	  };
   123	}
