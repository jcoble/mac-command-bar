  3929	#[derive(Default)]
  3930	struct GitRepositoryStatusCounts {
  3931	    staged_count: usize,
  3932	    unstaged_count: usize,
  3933	    untracked_count: usize,
  3934	}
  3935	
  3936	fn git_repository_status_counts(files: &[GitFileStatus]) -> GitRepositoryStatusCounts {
  3937	    let mut counts = GitRepositoryStatusCounts::default();
  3938	
  3939	    for file in files {
  3940	        if file.status == "untracked" {
  3941	            counts.untracked_count += 1;
  3942	            continue;
  3943	        }
  3944	
  3945	        if !file.index_status.is_empty() {
  3946	            counts.staged_count += 1;
  3947	        }
  3948	        if !file.worktree_status.is_empty() {
  3949	            counts.unstaged_count += 1;
  3950	        }
  3951	    }
  3952	
  3953	    counts
  3954	}
