    36	/** A small stable digest for metadata-only captures. */
    37	export function browserSourceHash(parts: readonly (string | number | null | undefined)[]): string {
    38	  let hash = 2166136261;
    39	  for (const part of parts) {
    40	    const value = String(part ?? '');
    41	    for (let index = 0; index < value.length; index += 1) {
    42	      hash ^= value.charCodeAt(index);
    43	      hash = Math.imul(hash, 16777619);
    44	    }
    45	    hash ^= 31;
    46	    hash = Math.imul(hash, 16777619);
    47	  }
    48	  return `browser-${(hash >>> 0).toString(16).padStart(8, '0')}`;
