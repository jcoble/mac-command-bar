  4187	/// Stops ONE Playwright process group, the same polite-then-forceful way the
  4188	/// stop-everything command does. The group has to be one this app just listed as a
  4189	/// Playwright session; anything else is refused, so this can never be used to stop an
  4190	/// arbitrary process by number.
  4191	fn kill_playwright_session_with<SignalProcess, SleepAfterTerm, ListSessions>(
  4192	    sessions: Vec<PlaywrightSessionInfo>,
  4193	    pgid: i32,
  4194	    signal_process: SignalProcess,
  4195	    sleep_after_term: SleepAfterTerm,
  4196	    list_sessions: ListSessions,
  4197	) -> Result<PlaywrightCleanupResult, String>
  4198	where
  4199	    SignalProcess: FnMut(u32, &str) -> Result<(), String>,
  4200	    SleepAfterTerm: FnOnce(),
  4201	    ListSessions: FnMut() -> Result<Vec<PlaywrightSessionInfo>, String>,
  4202	{
  4203	    let session = select_playwright_session(sessions, pgid)?;
  4204	    kill_playwright_sessions_with(
  4205	        vec![session],
  4206	        signal_process,
  4207	        sleep_after_term,
  4208	        list_sessions,
  4209	    )
  4210	}
