  2153	fn count_source_references_sync(
  2154	    root: PathBuf,
  2155	    symbol_names: Vec<String>,
  2156	    deadline_ms: Option<u64>,
  2157	) -> Result<SourceReferenceCountResult, String> {
  2158	    let started = Instant::now();
  2159	    let metadata = std::fs::metadata(&root)
  2160	        .map_err(|error| format!("Could not read source root metadata: {error}"))?;
  2161	    if !metadata.is_dir() {
  2162	        return Err("Source root is not a directory".to_string());
  2163	    }
  2164	
  2165	    let names = normalized_reference_count_symbols(symbol_names);
  2166	    if names.is_empty() {
  2167	        return Ok(SourceReferenceCountResult {
  2168	            counts: HashMap::new(),
  2169	            approximate: false,
  2170	            scanned_files: 0,
  2171	            elapsed_ms: elapsed_millis(started),
  2172	        });
  2173	    }
  2174	
  2175	    let budget = Duration::from_millis(
  2176	        deadline_ms
  2177	            .unwrap_or(DEFAULT_REFERENCE_COUNT_DEADLINE_MS)
  2178	            .clamp(1, MAX_REFERENCE_COUNT_DEADLINE_MS),
  2179	    );
  2180	    let deadline = started + budget;
  2181	
  2182	    // Walking the project here rather than accepting a file list from the
  2183	    // caller is the point: the list is thousands of entries and used to be
  2184	    // serialized across the bridge once per symbol.
  2185	    let collection_limit = source_collection_limit(DEFAULT_SOURCE_LIST_LIMIT);
  2186	    let mut records = Vec::new();
  2187	    let mut walk_progress = SourceScanWalkProgress::default();
  2188	    let walk = collect_source_files(
  2189	        &root,
  2190	        &root,
  2191	        collection_limit,
  2192	        None,
  2193	        &mut records,
  2194	        &SourceScanCancellation::until(deadline),
  2195	        &mut walk_progress,
  2196	    );
  2197	    let mut approximate = walk.is_err() || records.len() >= collection_limit;
  2198	
  2199	    // The counting pass takes only a path and a size per file; the rest of a
  2200	    // record (language, display names) means nothing to it.
  2201	    let files = records
  2202	        .iter()
  2203	        .map(|record| ReferenceCountFile {
  2204	            path: Path::new(&record.path),
  2205	            byte_count: record.byte_count,
  2206	        })
  2207	        .collect::<Vec<_>>();
  2208	
  2209	    let plan = ReferenceCountPlan::new(&names);
  2210	    // Not `MAX_PREVIEW_BYTES`: that ceiling decides how much text is worth putting on
  2211	    // screen, which has nothing to do with how much text this pass can walk through.
  2212	    // Reusing it meant one 660KB source file made every count in the project a floor.
  2213	    let pass =
  2214	        count_reference_lines_across_files(&files, &plan, deadline, MAX_REFERENCE_SCAN_BYTES);
  2215	    log_reference_count_timing(&pass, names.len(), started);
  2216	    // Both mean the same thing to the reader: not every file was counted, so
  2217	    // the totals are floors and the margin must say "at least", never an exact
  2218	    // number nobody actually took.
  2219	    approximate = approximate || pass.ran_out_of_time || pass.skipped_files;
  2220	
  2221	    let counts = names
  2222	        .iter()
  2223	        .cloned()
  2224	        .zip(pass.counts)
  2225	        .collect::<HashMap<String, u32>>();
  2226	
  2227	    Ok(SourceReferenceCountResult {
  2228	        counts,
  2229	        approximate,
  2230	        scanned_files: pass.scanned_files,
  2231	        elapsed_ms: elapsed_millis(started),
  2232	    })
  2233	}
  2234	
  2235	fn elapsed_millis(started: Instant) -> u64 {
  2236	    u64::try_from(started.elapsed().as_millis()).unwrap_or(u64::MAX)
  2237	}
  2238	
  2239	/// Say, on the terminal the app was started from, how long one pass of counting
  2240	/// mentions across the project took — but only when the reader asked for timings
  2241	/// by starting the app with `MCB_TIMING=1`. Silence otherwise.
  2242	fn log_reference_count_timing(
  2243	    pass: &mcb_core::reference_counts::ReferenceCountPass,
  2244	    symbol_count: usize,
  2245	    started: Instant,
  2246	) {
  2247	    if !lsp::timing_enabled() {
  2248	        return;
  2249	    }
  2250	
  2251	    let outcome = if pass.ran_out_of_time {
  2252	        "it ran out of time, so the totals are floors"
  2253	    } else if pass.skipped_files {
  2254	        "some files were too big or could not be read, so the totals are floors"
  2255	    } else {
  2256	        "every file on the list was read, so the totals are exact"
  2257	    };
  2258	    eprintln!(
  2259	        "Timing: counting {symbol_count} names across {} files took {} ms; {outcome}.",
  2260	        pass.scanned_files,
  2261	        elapsed_millis(started)
  2262	    );
  2263	}
