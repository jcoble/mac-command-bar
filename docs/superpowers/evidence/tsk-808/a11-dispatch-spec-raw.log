   125	/** Rebuild a preview URL from a backend-owned attachment after a workspace restore. */
   126	export function restoreConversationAttachmentPreview(
   127	  attachment: Omit<ConversationAttachment, 'previewUrl'> & { previewUrl?: string }
   128	): ConversationAttachment {
   129	  const previewUrl = attachment.previewUrl
   130	    ?? (isTauri() ? convertFileSrc(attachment.path) : attachment.path);
   131	  return { ...attachment, previewUrl };
