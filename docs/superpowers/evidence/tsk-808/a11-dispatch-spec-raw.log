    86	      for (const child of data) walk(child);
    87	      return;
    88	    }
    89	    if (type === 'leaf' && data && typeof data === 'object') {
    90	      const id = (data as { id?: unknown }).id;
    91	      if (typeof id === 'string') ids.add(id);
    92	    }
    93	  };
    94	  walk(root);
    95	  return ids;
    96	}
