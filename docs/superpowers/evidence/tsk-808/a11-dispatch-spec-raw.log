   233	// ── Environment variables (pure) ──────────────────────────────────────────────
   234	
   235	/** The names a shell will accept: a letter or underscore, then word characters. */
   236	const ENV_NAME = /^[A-Za-z_][A-Za-z0-9_]*$/;
   237	
   238	function isEnvName(value: string): boolean {
   239	  return ENV_NAME.test(value);
   240	}
   241	
   242	/** Drop one matching pair of surrounding quotes, if the value has them. */
   243	function unquote(value: string): string {
   244	  if (value.length < 2) return value;
   245	  const first = value[0];
   246	  const last = value[value.length - 1];
   247	  if ((first === '"' || first === "'") && first === last) return value.slice(1, -1);
   248	  return value;
   249	}
   250	
   251	/**
   252	 * Read the environment box: one `KEY=value` per line.
   253	 *
   254	 * Blank lines and lines starting with `#` are skipped, a leading `export ` is
   255	 * allowed and ignored, and a value wrapped in quotes has them removed (the
   256	 * quoting is put back when the command line is built, so typing them is neither
   257	 * required nor harmful). Anything else comes back in `unreadable` so the editor
   258	 * can say which lines it did not understand instead of dropping them silently.
   259	 * The last line wins when a name is given twice.
   260	 */
   261	export function readEnvLines(text: string | null | undefined): {
   262	  variables: StackEnvVar[];
   263	  unreadable: string[];
   264	} {
   265	  const variables: StackEnvVar[] = [];
   266	  const unreadable: string[] = [];
   267	  const positionOf = new Map<string, number>();
   268	  for (const rawLine of String(text ?? '').split('\n')) {
   269	    const line = rawLine.trim();
   270	    if (line === '' || line.startsWith('#')) continue;
   271	    const body = line.startsWith('export ') ? line.slice('export '.length).trim() : line;
   272	    const split = body.indexOf('=');
   273	    if (split <= 0) {
   274	      unreadable.push(line);
   275	      continue;
   276	    }
   277	    const key = body.slice(0, split).trim();
   278	    if (!isEnvName(key)) {
   279	      unreadable.push(line);
   280	      continue;
   281	    }
   282	    const value = unquote(body.slice(split + 1).trim());
   283	    const existing = positionOf.get(key);
   284	    if (existing === undefined) {
   285	      positionOf.set(key, variables.length);
   286	      variables.push({ key, value });
   287	    } else {
   288	      variables[existing] = { key, value };
   289	    }
   290	  }
   291	  return { variables, unreadable };
   292	}
   293	
   294	/** The saved variables as the editor's box shows them, one per line. */
   295	export function formatEnvLines(env: StackEnvVar[] | null | undefined): string {
   296	  return (env ?? []).map((entry) => `${entry.key}=${entry.value}`).join('\n');
   297	}
   298	
   299	/** Wrap a value in single quotes so a shell takes it literally, spaces and all. */
   300	function shellQuote(value: string): string {
   301	  return `'${value.split("'").join("'\\''")}'`;
   302	}
   303	
   304	/**
   305	 * The command line a run configuration actually runs: its script with its
   306	 * environment variables in front of it.
   307	 *
   308	 * Put in FRONT rather than handed to the backend because the desktop app's
   309	 * terminal spawn takes a command and a folder and nothing else. `KEY=value cmd`
   310	 * is what a person would type, it works in every shell the app opens, and it is
   311	 * visible in the terminal afterwards — so what ran is on screen rather than
   312	 * hidden in a settings file.
   313	 */
   314	export function commandWithEnv(script: string, env: StackEnvVar[] | null | undefined): string {
   315	  const command = script.trim();
   316	  const prefix = (env ?? [])
   317	    .filter((entry) => isEnvName(entry.key))
   318	    .map((entry) => `${entry.key}=${shellQuote(entry.value)}`)
   319	    .join(' ');
   320	  return prefix ? `${prefix} ${command}` : command;
   321	}
   322	
   323	/**
   324	 * Read the saved "which session is which stack" list back. Same tolerance as
   325	 * above; a row keeping only its two ids is repaired rather than dropped, since
   326	 * the ids are the part that matters.
   327	 */
   328	export function parseStackRuns(raw: string | null | undefined): StackRunRecord[] {
   329	  const seen = new Set<string>();
   330	  const runs: StackRunRecord[] = [];
   331	  for (const entry of parseArray(raw)) {
   332	    if (typeof entry !== 'object' || entry === null) continue;
   333	    const row = entry as Record<string, unknown>;
   334	    const ownedId = trimmedString(row.ownedId);
   335	    const stackId = trimmedString(row.stackId);
   336	    if (!ownedId || !stackId || seen.has(ownedId)) continue;
   337	    seen.add(ownedId);
   338	    runs.push({
   339	      ownedId,
   340	      stackId,
   341	      startedAt: finiteNumber(row.startedAt),
   342	      exited: row.exited === true,
   343	      exitCode: typeof row.exitCode === 'number' && Number.isFinite(row.exitCode) ? row.exitCode : null,
   344	      signal: trimmedString(row.signal) || null
   345	    });
   346	  }
   347	  return runs;
   348	}
   349	
   350	export function serializeStackRuns(runs: StackRunRecord[]): string {
   351	  return JSON.stringify(
   352	    runs.map((run) => ({
   353	      ownedId: run.ownedId,
   354	      stackId: run.stackId,
   355	      startedAt: run.startedAt,
   356	      exited: run.exited,
   357	      exitCode: run.exitCode,
   358	      signal: run.signal
   359	    }))
   360	  );
   361	}
   362	
   363	// ── Derivation (pure) ─────────────────────────────────────────────────────────
   364	
   365	/**
   366	 * The listening processes that belong to a stack's folder — the folder itself
   367	 * or anything underneath it. A folder whose name merely STARTS the same way
   368	 * (`/a/ap` against `/a/app`) is a different folder, hence the separator check.
   369	 */
   370	export function stackProcessesFor(
   371	  definition: { cwd: string },
   372	  processes: StackProcess[]
   373	): StackProcess[] {
   374	  const root = definition.cwd.replace(/\/+$/, '');
   375	  if (!root) return [];
   376	  return processes.filter((process) => {
   377	    const cwd = (process.cwd ?? '').replace(/\/+$/, '');
   378	    return cwd === root || cwd.startsWith(`${root}/`);
   379	  });
   380	}
