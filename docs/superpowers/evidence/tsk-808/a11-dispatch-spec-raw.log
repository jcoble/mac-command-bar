     1	/**
     2	 * Ephemeral UI state for the Agent Control Center.
     3	 *
     4	 * The store caches complete engine snapshots and remembers only selection and
     5	 * list filters.  It never calls Tauri, reads a ledger, reduces event history,
     6	 * or invents a workflow phase.
     7	 */
     8	import type { WorkflowFilter, WorkflowRunRecord } from './workflowTypes';
     9	
    10	export interface WorkflowStoreState {
    11	  runs: WorkflowRunRecord[];
    12	  selectedWorkflowRunId: string | null;
    13	  selectedNodeId: string | null;
    14	  query: string;
    15	  filter: WorkflowFilter;
    16	  loading: boolean;
    17	  error: string | null;
    18	  unavailableReason: string | null;
    19	  activated: boolean;
    20	}
    21	
    22	export const workflowState = $state<WorkflowStoreState>({
    23	  runs: [],
    24	  selectedWorkflowRunId: null,
    25	  selectedNodeId: null,
    26	  query: '',
    27	  filter: 'all',
    28	  loading: false,
    29	  error: null,
    30	  unavailableReason: null,
    31	  activated: false
    32	});
    33	
    34	export function resetWorkflowStore(): void {
    35	  workflowState.runs = [];
    36	  workflowState.selectedWorkflowRunId = null;
    37	  workflowState.selectedNodeId = null;
    38	  workflowState.query = '';
    39	  workflowState.filter = 'all';
    40	  workflowState.loading = false;
    41	  workflowState.error = null;
    42	  workflowState.unavailableReason = null;
    43	  workflowState.activated = false;
    44	}
    45	
    46	export function beginWorkflowLoad(): void {
    47	  workflowState.loading = true;
    48	  workflowState.error = null;
    49	  workflowState.unavailableReason = null;
    50	  workflowState.activated = true;
    51	}
    52	
    53	export function applyWorkflowSnapshots(runs: WorkflowRunRecord[] | null): void {
    54	  workflowState.runs = runs ? [...runs] : [];
    55	  workflowState.loading = false;
    56	  workflowState.error = null;
    57	  workflowState.unavailableReason = runs === null ? 'Workflow runs are available in the desktop app.' : null;
    58	  workflowState.activated = true;
    59	  if (
    60	    workflowState.selectedWorkflowRunId &&
    61	    !workflowState.runs.some((run) => run.id === workflowState.selectedWorkflowRunId)
    62	  ) {
    63	    workflowState.selectedWorkflowRunId = workflowState.runs[0]?.id ?? null;
    64	    workflowState.selectedNodeId = null;
    65	  }
    66	}
    67	
    68	export function failWorkflowLoad(message: string): void {
    69	  workflowState.loading = false;
    70	  workflowState.error = message;
    71	  workflowState.unavailableReason = null;
    72	  workflowState.activated = true;
    73	}
    74	
    75	export function upsertWorkflowSnapshot(run: WorkflowRunRecord): void {
    76	  const index = workflowState.runs.findIndex((candidate) => candidate.id === run.id);
    77	  if (index < 0) workflowState.runs = [...workflowState.runs, run];
    78	  else workflowState.runs[index] = run;
    79	  workflowState.loading = false;
    80	  workflowState.error = null;
    81	  workflowState.unavailableReason = null;
    82	  workflowState.activated = true;
    83	  if (!workflowState.selectedWorkflowRunId) workflowState.selectedWorkflowRunId = run.id;
    84	}
    85	
    86	export function selectWorkflowRun(workflowRunId: string | null): void {
    87	  workflowState.selectedWorkflowRunId = workflowRunId;
    88	  workflowState.selectedNodeId = null;
    89	}
    90	
    91	export function selectWorkflowNode(nodeId: string | null): void {
    92	  workflowState.selectedNodeId = nodeId;
    93	}
    94	
    95	export function setWorkflowQuery(query: string): void {
    96	  workflowState.query = query;
    97	}
    98	
    99	export function setWorkflowFilter(filter: WorkflowFilter): void {
   100	  workflowState.filter = filter;
   101	}
   102	
   103	export function selectedWorkflowRun(): WorkflowRunRecord | null {
   104	  const id = workflowState.selectedWorkflowRunId;
   105	  return id ? workflowState.runs.find((run) => run.id === id) ?? null : null;
   106	}
   107	
   108	export function selectedWorkflowNode(): WorkflowRunRecord['nodes'][number] | null {
   109	  const run = selectedWorkflowRun();
   110	  const nodeId = workflowState.selectedNodeId;
   111	  return run && nodeId ? run.nodes.find((node) => node.nodeId === nodeId) ?? null : null;
   112	}
   113	
   114	/** Filtering is presentation state, not a second workflow projection. */
   115	export function filteredWorkflowRuns(): WorkflowRunRecord[] {
   116	  const query = workflowState.query.trim().toLowerCase();
   117	  const filter = workflowState.filter;
   118	  return workflowState.runs.filter((run) => {
   119	    const matchesQuery =
   120	      !query ||
   121	      run.definition.name.toLowerCase().includes(query) ||
   122	      run.workflowId.toLowerCase().includes(query) ||
   123	      run.id.toLowerCase().includes(query);
   124	    if (!matchesQuery) return false;
   125	    if (filter === 'active') return ['queued', 'running', 'paused'].includes(run.state);
   126	    if (filter === 'waiting') return ['waiting-approval', 'waiting-input'].includes(run.state);
   127	    if (filter === 'failed') return run.state === 'failed';
   128	    if (filter === 'completed') return ['completed', 'cancelled'].includes(run.state);
   129	    return true;
   130	  });
   131	}
   132	
   133	export function workflowFilterOptions(): readonly { value: WorkflowFilter; label: string }[] {
   134	  return [
   135	    { value: 'all', label: 'All runs' },
   136	    { value: 'active', label: 'Active' },
   137	    { value: 'waiting', label: 'Waiting' },
   138	    { value: 'failed', label: 'Failed' },
   139	    { value: 'completed', label: 'Completed' }
   140	  ];
   141	}
