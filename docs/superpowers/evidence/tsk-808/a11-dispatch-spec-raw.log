    29	import { listRuntimeContextsFromTauri } from '../../tauriSource.ts';
    30	import {
    31	  applyStackProcesses,
    32	  beginStackLoad,
    33	  commandWithEnv,
    34	  failStackLoad,
    35	  folderName,
    36	  forgetStackRun,
    37	  hydrateStacks,
    38	  markStacksActivated,
    39	  markStacksUnavailable,
    40	  ownedIdForStack,
    41	  recordStackExit,
    42	  recordStackStart,
    43	  setStackInput,
    44	  stackIdForOwnedId,
    45	  stacks,
    46	  type StackDefinition,
    47	  type StackProcess
    48	} from './stackStore.svelte.ts';
    49	
    50	/** Shown when the process list only exists inside the desktop app. */
    51	const DESKTOP_ONLY = 'Running processes can only be read in the desktop app.';
    52	
    53	/**
    54	 * What the panel asks the page to do when the user presses Start.
    55	 *
    56	 * The page answers by making a fresh session in `cwd`, spawning its terminal
    57	 * with `script` as the command it runs, and handing back the session's
    58	 * `ownedId` — or `null` when no terminal could be opened, which the panel
    59	 * reports as a plain sentence.
    60	 */
    61	export interface StackStartRequest {
    62	  /** The saved stack being started. */
    63	  stackId: string;
    64	  /** The folder the command runs in. */
    65	  cwd: string;
    66	  /** The command line to run, exactly as the user typed it. */
    67	  script: string;
    68	  /** What the session should be called in the rail — the stack's name. */
    69	  title: string;
    70	}
    71	
    72	/** The three things the page does on the stack runner's behalf. */
    73	export interface StackHandlers {
    74	  /** Make a session, start `script` in it, answer with its `ownedId`. */
    75	  onStartStack(request: StackStartRequest): Promise<string | null>;
    76	  /** End that session's terminal (the page's `closeTerminal`). */
    77	  onStopStack(ownedId: string): Promise<void>;
    78	  /** Put that session on screen (the page's `selectOwned`). */
    79	  onSelectSession(ownedId: string): void | Promise<void>;
    80	}
    81	
    82	let handlers: Partial<StackHandlers> = {};
