  2733	        .unwrap_or(DEFAULT_GIT_HISTORY_LIMIT)
  2734	        .clamp(1, MAX_GIT_HISTORY_LIMIT);
  2735	    let limit_arg = format!("-n{limit}");
  2736	    let history_output = run_git_text(
  2737	        &root,
  2738	        &[
  2739	            "log",
  2740	            "--decorate=short",
  2741	            "--date=iso-strict",
  2742	            "--format=%h%x1f%H%x1f%s%x1f%an%x1f%cI%x1f%D%x1f%P",
  2743	            limit_arg.as_str(),
  2744	        ],
  2745	    );
  2746	
  2747	    match history_output {
  2748	        Ok(output) => parse_git_commit_history(&output),
  2749	        Err(error) if error.contains("does not have any commits") => Ok(Vec::new()),
  2750	        Err(error) => Err(error),
  2751	    }
  2752	}
