     1	/**
     2	 * Typed frontend contracts for the WorkflowEngine snapshot.
     3	 *
     4	 * `WorkflowRunRecord` and the related records mirror the serde/camelCase
     5	 * shapes in `src-tauri/src/workflow.rs`.  The `*View` types add only stable
     6	 * presentation identity and provenance; they never replace the engine's
     7	 * state/phase with a client-side guess.
     8	 */
     9	
    10	export type WorkflowRunState =
    11	  | 'draft'
    12	  | 'queued'
    13	  | 'running'
    14	  | 'waiting-approval'
    15	  | 'waiting-input'
    16	  | 'paused'
    17	  | 'completed'
    18	  | 'failed'
    19	  | 'cancelled';
    20	
    21	export type WorkflowNodeState =
    22	  | 'blocked'
    23	  | 'ready'
    24	  | 'queued'
    25	  | 'starting'
    26	  | 'running'
    27	  | 'waiting-approval'
    28	  | 'waiting-input'
    29	  | 'completed'
    30	  | 'failed'
    31	  | 'cancelled'
    32	  | 'skipped';
