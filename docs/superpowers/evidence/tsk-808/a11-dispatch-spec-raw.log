  3779	fn is_safe_git_relative_path(path: &str) -> bool {
  3780	    let trimmed = path.trim();
  3781	    let relative_path = Path::new(trimmed);
  3782	    !trimmed.is_empty()
  3783	        && !trimmed.contains('\0')
  3784	        && !relative_path.is_absolute()
  3785	        && relative_path
  3786	            .components()
  3787	            .all(|component| matches!(component, std::path::Component::Normal(_)))
  3788	}
