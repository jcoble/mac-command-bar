  2456	fn source_file_action_command(
  2457	    path: &Path,
  2458	    action: SourceFileAction,
  2459	) -> Result<SourceFileActionCommand, String> {
  2460	    let metadata = std::fs::metadata(path)
  2461	        .map_err(|error| format!("Could not read source metadata: {error}"))?;
  2462	    if !metadata.is_file() {
  2463	        return Err("Source path is not a file".to_string());
  2464	    }
  2465	
  2466	    let path_arg = path.display().to_string();
  2467	    let args = match action {
  2468	        SourceFileAction::Open => vec![path_arg],
  2469	        SourceFileAction::Reveal => vec!["-R".to_string(), path_arg],
  2470	    };
  2471	
  2472	    Ok(SourceFileActionCommand {
  2473	        program: "open".to_string(),
  2474	        args,
  2475	    })
  2476	}
  2477	
  2478	fn path_action_command(path: &Path, action: PathAction) -> Result<SourceFileActionCommand, String> {
  2479	    let metadata = std::fs::metadata(path)
  2480	        .map_err(|error| format!("Could not read path metadata: {error}"))?;
  2481	    if !metadata.is_file() && !metadata.is_dir() {
  2482	        return Err("Path is not a file or directory".to_string());
  2483	    }
  2484	
  2485	    let path_arg = path.display().to_string();
  2486	    let args = match action {
  2487	        PathAction::Open => vec![path_arg],
  2488	        PathAction::Reveal => vec!["-R".to_string(), path_arg],
  2489	    };
  2490	
  2491	    Ok(SourceFileActionCommand {
  2492	        program: "open".to_string(),
  2493	        args,
  2494	    })
  2495	}
