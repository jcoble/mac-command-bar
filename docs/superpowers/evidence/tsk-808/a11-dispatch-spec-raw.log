   145	export function registrationsForRegion(
   146	  registrations: readonly SidePaneRegistration[],
   147	  region: SidePaneRegion
   148	): SidePaneRegistration[] {
   149	  assertValidSidePaneRegistrations(registrations);
   150	  return registrations
   151	    .filter((registration) => registration.region === region)
   152	    .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
   153	}
   154	
   155	export type PaneElementSource =
   156	  | ReadonlyMap<string, HTMLElement>
   157	  | Readonly<Record<string, HTMLElement>>
   158	  | ((registration: SidePaneRegistration) => HTMLElement | null | undefined);
   159	
   160	function elementFor(
   161	  source: PaneElementSource,
   162	  registration: SidePaneRegistration
   163	): HTMLElement | null | undefined {
   164	  if (typeof source === 'function') return source(registration);
   165	  const mapLike = source as ReadonlyMap<string, HTMLElement>;
   166	  if (typeof mapLike.get === 'function') return mapLike.get(registration.id);
   167	  return (source as Readonly<Record<string, HTMLElement>>)[registration.id];
   168	}
   169	
   170	/** Map one validated registration to the existing PaneStack input shape. */
   171	export function sidePaneRegistrationToPaneSpec(
   172	  registration: SidePaneRegistration,
   173	  element: HTMLElement
   174	): PaneSpec {
   175	  assertValidSidePaneRegistrations([registration]);
   176	  if (!element || typeof element !== 'object') {
   177	    throw new TypeError(`Missing DOM element for side pane: ${registration.id}`);
   178	  }
   179	  return {
   180	    id: registration.id.trim(),
   181	    title: registration.title.trim(),
   182	    element,
   183	    size: registration.preferredSize,
   184	    expanded: registration.defaultExpanded,
   185	    minimumSize: registration.minimumSize,
   186	    maximumSize: registration.maximumSize,
   187	    persistent: registration.persistent
   188	  };
   189	}
   190	
   191	/**
   192	 * Map a roster to PaneSpecs without mounting anything. The caller supplies the
   193	 * already-authored parking elements; missing elements are a boundary error.
   194	 */
   195	export function sidePaneRegistrationsToPaneSpecs(
   196	  registrations: readonly SidePaneRegistration[],
   197	  elements: PaneElementSource,
   198	  region?: SidePaneRegion
   199	): PaneSpec[] {
   200	  assertValidSidePaneRegistrations(registrations);
   201	  const selected = region ? registrationsForRegion(registrations, region) : [...registrations];
   202	  return selected.map((registration) => {
   203	    const element = elementFor(elements, registration);
   204	    if (!element) throw new TypeError(`Missing DOM element for side pane: ${registration.id}`);
   205	    return sidePaneRegistrationToPaneSpec(registration, element);
   206	  });
   207	}
   208	
   209	// Short aliases keep the registry pleasant to consume while retaining one
   210	// implementation and one validation path.
   211	export const toPaneSpecs = sidePaneRegistrationsToPaneSpecs;
   212	export const mapSidePaneRegistration = sidePaneRegistrationToPaneSpec;
   213	export const validateSidePaneRegistry = validateSidePaneRegistrations;
   214	export const mapSidePaneRegistrationsToPaneSpecs = sidePaneRegistrationsToPaneSpecs;
