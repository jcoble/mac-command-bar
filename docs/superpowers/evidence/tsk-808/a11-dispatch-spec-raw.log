     1	/**
     2	 * The only workflow module allowed to cross the Tauri boundary.
     3	 *
     4	 * This file deliberately contains no reducer, JSONL reader, phase inference,
     5	 * or optimistic state.  Every command returns the engine's complete typed
     6	 * snapshot; callers land that snapshot in `workflowStore.svelte.ts`.
     7	 */
     8	import { listen, type UnlistenFn } from '@tauri-apps/api/event';
     9	
