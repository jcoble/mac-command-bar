   200	/** The hover text for a changed-file row. */
   201	export function gitFileTitle(file: ProjectGitFileStatus): string {
   202	  const states = [
   203	    file.indexStatus ? `Staged: ${file.indexStatus}` : '',
   204	    file.worktreeStatus ? `On disk: ${file.worktreeStatus}` : ''
   205	  ].filter(Boolean);
   206	  return states.length > 0 ? `${file.relativePath}\n${states.join('\n')}` : file.relativePath;
   207	}
