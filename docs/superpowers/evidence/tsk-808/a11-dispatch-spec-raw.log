    44	/** Register the panel actions. Calling it again replaces them, never doubles. */
    45	export function registerShellCommands(hooks: ShellCommandHooks): () => void {
    46	  const sourceControlUnavailable = () => !gitPanel.activated || gitPanel.desktopOnly;
    47	
    48	  return registerCommands('panels', [
