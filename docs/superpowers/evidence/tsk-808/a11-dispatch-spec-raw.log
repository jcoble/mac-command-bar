   274	  .shell-frame :global(.dv-grid-view),
   275	  .shell-frame :global(.dv-branch-node),
   276	  .shell-frame :global(.dv-view-container),
   277	  .shell-frame :global(.dv-view) {
   278	    min-width: 0;
   279	    min-height: 0;
   280	  }
