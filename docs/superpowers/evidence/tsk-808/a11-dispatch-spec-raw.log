   573	#[tauri::command]
   574	async fn list_source_files(
   575	    app: tauri::AppHandle,
   576	    scan_registry: tauri::State<'_, SourceScanRegistry>,
   577	    root: String,
   578	    limit: Option<usize>,
   579	    query: Option<String>,
   580	    scan_id: Option<String>,
   581	) -> Result<SourceScanResult, String> {
   582	    let cancellation =
   583	        source_scan_cancellation_for_command(&app, &scan_registry, scan_id.as_deref());
   584	    let scan_id_for_cleanup = scan_id.clone();
   585	    let result = tauri::async_runtime::spawn_blocking(move || {
   586	        list_source_files_sync_with_cancellation(
   587	            PathBuf::from(root),
   588	            limit.unwrap_or(DEFAULT_SOURCE_LIST_LIMIT),
   589	            query,
   590	            cancellation,
   591	        )
   592	    })
   593	    .await
   594	    .map_err(|error| format!("Source scan task failed: {error}"))?;
   595	
   596	    if let Some(scan_id) = &scan_id_for_cleanup {
   597	        scan_registry.unregister(scan_id);
   598	    }
   599	
   600	    result
   601	}
