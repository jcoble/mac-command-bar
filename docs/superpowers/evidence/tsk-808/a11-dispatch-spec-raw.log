   144	export interface RequestGuard {
   145	  /** Claim the newest request id; every older one is now superseded. */
   146	  next(): number;
   147	  /** Is `id` still the newest claim? */
   148	  isCurrent(id: number): boolean;
   149	  /** Supersede everything in flight without claiming a new id. */
   150	  invalidate(): void;
   151	}
   152	
   153	/** A monotonic request id, so a slow answer can never overwrite a fast newer one. */
   154	export function createRequestGuard(): RequestGuard {
   155	  let latest = 0;
   156	  return {
   157	    next: () => (latest += 1),
   158	    isCurrent: (id: number) => id === latest,
   159	    invalidate: () => {
   160	      latest += 1;
   161	    }
   162	  };
   163	}
