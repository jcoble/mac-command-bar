  4072	fn branch_task_id(branch: &str) -> Option<String> {
  4073	    task_id_from_text(branch)
  4074	}
  4075	
  4076	fn task_id_from_text(text: &str) -> Option<String> {
  4077	    let lower_text = text.to_ascii_lowercase();
  4078	    for (index, _) in lower_text.match_indices("tsk") {
  4079	        let suffix = lower_text[index + 3..].trim_start_matches(['-', '_', '/', '#', '[', ' ']);
  4080	        let digits: String = suffix
  4081	            .chars()
  4082	            .take_while(|character| character.is_ascii_digit())
  4083	            .collect();
  4084	        if !digits.is_empty() {
  4085	            return Some(format!("TSK-{digits}"));
  4086	        }
  4087	    }
  4088	
  4089	    None
  4090	}
