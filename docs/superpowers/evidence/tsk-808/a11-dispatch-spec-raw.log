   133	export function workflowFilterOptions(): readonly { value: WorkflowFilter; label: string }[] {
   134	  return [
   135	    { value: 'all', label: 'All runs' },
   136	    { value: 'active', label: 'Active' },
   137	    { value: 'waiting', label: 'Waiting' },
   138	    { value: 'failed', label: 'Failed' },
   139	    { value: 'completed', label: 'Completed' }
   140	  ];
   141	}

