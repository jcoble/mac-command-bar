   799	  /** Wait for TerminalSurface to mount the host for `ownedId`.
   800	   *
   801	   * A host that is no longer IN the page is not an answer: a session whose
   802	   * terminal was closed loses its host div, and this map still holds the one it
   803	   * used to have. Building a terminal on that detached element would leave the
   804	   * session running with nothing on screen — so a host that has been taken out
   805	   * of the page is dropped here, and the wait continues for the one Svelte is
   806	   * about to mount in its place. */
   807	  async function hostFor(ownedId: string): Promise<HTMLElement | null> {
   808	    const mounted = (): HTMLElement | null => {
   809	      const host = pendingHosts.get(ownedId);
   810	      if (!host) return null;
   811	      if (host.isConnected) return host;
   812	      pendingHosts.delete(ownedId);
   813	      return null;
   814	    };
   815	    for (let attempt = 0; attempt < 12; attempt += 1) {
   816	      const host = mounted();
   817	      if (host) return host;
   818	      await tick();
   819	      if (attempt > 0) await new Promise((resolve) => setTimeout(resolve, 8));
   820	    }
   821	    return mounted();
   822	  }
