   827	pub(crate) struct WorkflowScheduler;
   828	impl WorkflowScheduler {
   829	    pub fn ready_nodes(run: &WorkflowRunRecord) -> Vec<String> {
   830	        let states: HashMap<_, _> = run
   831	            .nodes
   832	            .iter()
   833	            .map(|node| (node.node_id.as_str(), node.state))
   834	            .collect();
   835	        let mut ready: Vec<_> = run
   836	            .definition
   837	            .nodes
   838	            .iter()
   839	            .filter(|definition| {
   840	                let mut dependencies = definition.depends_on.clone();
   841	                dependencies.extend(
   842	                    run.definition
   843	                        .edges
   844	                        .iter()
   845	                        .filter(|edge| edge.to == definition.id)
   846	                        .map(|edge| edge.from.clone()),
   847	                );
   848	                states.get(definition.id.as_str()) == Some(&WorkflowNodeState::Blocked)
   849	                    && dependencies.iter().all(|dependency| {
   850	                        matches!(
   851	                            states.get(dependency.as_str()),
   852	                            Some(WorkflowNodeState::Completed | WorkflowNodeState::Skipped)
   853	                        )
   854	                    })
   855	            })
   856	            .map(|node| node.id.clone())
   857	            .collect();
   858	        ready.sort();
   859	        ready
   860	    }
   861	}
