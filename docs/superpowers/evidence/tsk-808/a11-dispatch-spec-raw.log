    49	export const PROBLEMS_SIDEBAR_VIEW: SidebarView = {
    50	  id: PROBLEMS_VIEW_ID,
    51	  title: 'Problems'
    52	};
    53	
    54	/** The collapsible pane the tool column builds for it, matching `PANES` in
    55	 * `ShellSidebar.svelte` (`{ id, title }`, one per view). */
    56	export const PROBLEMS_SIDEBAR_PANE: { id: string; title: string } = {
    57	  id: 'problems',
    58	  title: 'Problems'
    59	};
    60	
    61	/**
    62	 * Top to bottom, in the order the activity bar draws them.
    63	 *
    64	 * Problems is always in this list even though its icon usually is not. The tool
    65	 * column builds one container per row here, once, when it mounts; a roster that
    66	 * grew and shrank with a setting would tear those containers down and put them
    67	 * back, losing whatever was in them. So the container is always there and the
    68	 * ACTIVITY BAR decides whether to offer the icon — see `ActivityBar.svelte`,
    69	 * which draws Problems only while the setting asks for it.
    70	 */
    71	export const SIDEBAR_VIEWS: readonly SidebarView[] = [
    72	  { id: 'explorer', title: 'Explorer' },
    73	  { id: 'source-control', title: 'Source control' },
    74	  { id: 'worktrees', title: 'Worktrees' },
    75	  { id: 'stacks', title: 'Run' },
    76	  { id: 'context', title: 'Context' },
    77	  { id: 'agents', title: 'Agents' },
    78	  PROBLEMS_SIDEBAR_VIEW
    79	];
    80	
    81	/** The view a first launch opens on, and the one a reset goes back to. */
    82	export const DEFAULT_SIDEBAR_VIEW: SidebarViewId = 'explorer';
    83	
    84	export const ACTIVE_VIEW_KEY = 'mac-command-bar.next.active-view';
    85	
    86	export function isSidebarViewId(value: unknown): value is SidebarViewId {
    87	  return typeof value === 'string' && SIDEBAR_VIEWS.some((view) => view.id === value);
    88	}
    89	
    90	/** Where one view's pane sizes and folded/open states are remembered. */
    91	export function viewPanesKey(id: SidebarViewId): string {
    92	  return `mac-command-bar.next.view-${id}-panes`;
    93	}
    94	
    95	/**
    96	 * The view to open. Anything unreadable, corrupt, or naming a view that no
    97	 * longer exists comes back as the default — a stored id must never be able to
    98	 * open the column on nothing.
    99	 */
   100	export function readActiveView(storage: LayoutStorage): SidebarViewId {
   101	  const stored = loadLayout<unknown>(storage, ACTIVE_VIEW_KEY);
   102	  return isSidebarViewId(stored) ? stored : DEFAULT_SIDEBAR_VIEW;
   103	}
   104	
   105	/** Remember the open view. False means the write was refused (a full storage);
   106	 * the column carries on regardless — the cost is only that the next launch
   107	 * opens somewhere else. */
   108	export function writeActiveView(storage: LayoutStorage, id: SidebarViewId): boolean {
   109	  return saveLayout(storage, ACTIVE_VIEW_KEY, id);
   110	}
   111	
   112	export function clearActiveView(storage: LayoutStorage): void {
   113	  clearLayout(storage, ACTIVE_VIEW_KEY);
   114	}
