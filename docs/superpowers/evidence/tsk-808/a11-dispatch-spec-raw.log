  4925	fn detect_language(path: &Path) -> String {
  4926	    let file_name = path
  4927	        .file_name()
  4928	        .and_then(|value| value.to_str())
  4929	        .unwrap_or_default()
  4930	        .to_lowercase();
  4931	    if file_name == "dockerfile" || file_name.ends_with(".dockerfile") {
  4932	        return "dockerfile".to_string();
  4933	    }
  4934	    if file_name == "makefile" {
  4935	        return "makefile".to_string();
  4936	    }
  4937	
  4938	    let extension = path
  4939	        .extension()
  4940	        .and_then(|value| value.to_str())
  4941	        .unwrap_or_default()
  4942	        .to_lowercase();
  4943	
  4944	    match extension.as_str() {
  4945	        "cs" => "csharp",
  4946	        "csproj" | "fsproj" | "vbproj" | "props" | "targets" | "xaml" | "xml" => "xml",
  4947	        "swift" => "swift",
  4948	        "rs" => "rust",
  4949	        "ts" => "typescript",
  4950	        "tsx" => "tsx",
  4951	        "js" | "mjs" | "cjs" => "javascript",
  4952	        "jsx" => "jsx",
  4953	        "svelte" => "svelte",
  4954	        "astro" | "html" | "htm" | "vue" => "html",
  4955	        "css" => "css",
  4956	        "scss" => "scss",
  4957	        "less" => "less",
  4958	        "json" | "jsonc" => "json",
  4959	        "md" | "markdown" => "markdown",
  4960	        "mdx" => "mdx",
  4961	        "yaml" | "yml" => "yaml",
  4962	        "toml" => "toml",
  4963	        "ini" | "env" => "ini",
  4964	        "sh" | "bash" | "zsh" => "shell",
  4965	        "ps1" | "psm1" => "powershell",
  4966	        "py" => "python",
  4967	        "rb" => "ruby",
  4968	        "php" => "php",
  4969	        "dart" => "dart",
  4970	        "lua" => "lua",
  4971	        "go" => "go",
  4972	        "java" => "java",
  4973	        "kt" | "kts" => "kotlin",
  4974	        "c" | "cc" | "cpp" | "cxx" | "h" | "hh" | "hpp" | "hxx" => "cpp",
  4975	        "tf" | "tfvars" => "hcl",
  4976	        "proto" => "protobuf",
  4977	        "sql" => "sql",
  4978	        "graphql" | "gql" => "graphql",
  4979	        "fs" | "fsx" => "fsharp",
  4980	        "razor" => "razor",
  4981	        _ => "plain",
  4982	    }
  4983	    .to_string()
  4984	}
