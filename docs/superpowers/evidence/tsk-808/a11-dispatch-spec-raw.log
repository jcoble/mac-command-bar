  5524	    #[test]
  5525	    fn lsp_diagnostics_for_root_collect_every_file_inside_that_root() {
  5526	        let inside_root = PathBuf::from("/repo");
  5527	        let other_root = PathBuf::from("/elsewhere");
  5528	
  5529	        let sessions = vec![
  5530	            (
  5531	                inside_root.clone(),
  5532	                HashMap::from([
  5533	                    (
  5534	                        "file:///repo/src/Later.ts".to_string(),
  5535	                        vec![lsp::SourceLspDiagnostic::for_test(
  5536	                            "warning",
  5537	                            "Unused import.",
  5538	                            2,
  5539	                            1,
  5540	                            Some("/repo/src/Later.ts"),
  5541	                        )],
  5542	                    ),
  5543	                    (
  5544	                        "file:///repo/src/App.ts".to_string(),
  5545	                        vec![
  5546	                            lsp::SourceLspDiagnostic::for_test(
  5547	                                "error",
  5548	                                "Second on the same file.",
  5549	                                9,
  5550	                                4,
  5551	                                Some("/repo/src/App.ts"),
  5552	                            ),
  5553	                            lsp::SourceLspDiagnostic::for_test(
  5554	                                "error",
  5555	                                "First on the same file.",
  5556	                                3,
  5557	                                1,
  5558	                                Some("/repo/src/App.ts"),
  5559	                            ),
  5560	                        ],
  5561	                    ),
  5562	                ]),
  5563	            ),
  5564	            (
  5565	                other_root.clone(),
  5566	                HashMap::from([(
  5567	                    "file:///elsewhere/src/Other.ts".to_string(),
  5568	                    vec![lsp::SourceLspDiagnostic::for_test(
  5569	                        "error",
  5570	                        "Belongs to another project.",
  5571	                        1,
  5572	                        1,
  5573	                        Some("/elsewhere/src/Other.ts"),
  5574	                    )],
  5575	                )]),
  5576	            ),
  5577	        ];
  5578	
  5579	        let collected = lsp::collect_diagnostics_for_root(&sessions, &inside_root);
  5580	
  5581	        assert_eq!(collected.len(), 3);
  5582	        // Grouped by file, then in the order they appear down the file, so a problems
  5583	        // list can render them without sorting again.
  5584	        assert_eq!(collected[0].path.as_deref(), Some("/repo/src/App.ts"));
  5585	        assert_eq!(collected[0].message, "First on the same file.");
  5586	        assert_eq!(collected[1].path.as_deref(), Some("/repo/src/App.ts"));
  5587	        assert_eq!(collected[1].message, "Second on the same file.");
  5588	        assert_eq!(collected[2].path.as_deref(), Some("/repo/src/Later.ts"));
  5589	        assert!(collected
  5590	            .iter()
  5591	            .all(|diagnostic| diagnostic.message != "Belongs to another project."));
  5592	
  5593	        // A root nobody has diagnostics for reports an empty list, not an error.
  5594	        assert!(
  5595	            lsp::collect_diagnostics_for_root(&sessions, &PathBuf::from("/nothing")).is_empty()
  5596	        );
  5597	        assert!(lsp::collect_diagnostics_for_root(&[], &inside_root).is_empty());
  5598	    }
