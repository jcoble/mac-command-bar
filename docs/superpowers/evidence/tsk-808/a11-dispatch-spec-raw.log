  1224	
  1225	/// What this build of the backend can do, by name.
  1226	///
  1227	/// The frontend needs this because some additions are new ARGUMENTS on commands that
  1228	/// already existed. Tauri quietly drops a payload key a command does not declare, so an
  1229	/// older desktop build handed `force: true` runs the ordinary safe removal and reports
  1230	/// success — there is no unknown-command error to catch and nothing else to test. Asking
  1231	/// for this list first is the only way to know before offering the button.
  1232	///
  1233	/// Anything added here is a promise: check the name before offering the feature, and treat
  1234	/// this command being missing as "none of these are available".
  1235	const BACKEND_CAPABILITIES: [&str; 11] = [
  1236	    // `remove_project_worktree` accepts `force`.
  1237	    "worktreeForceRemove",
  1238	    // `kill_playwright_session` stops one process group.
  1239	    "playwrightSessionKill",
  1240	    // `list_source_lsp_diagnostics_for_root` reads a whole project's diagnostics.
  1241	    "lspDiagnosticsForRoot",
  1242	    // `start_terminal_session` accepts `command` and exits with its code.
  1243	    "terminalCommandSpawn",
  1244	    // `count_source_references` counts every requested symbol in one project pass.
  1245	    "referenceCounts",
  1246	    // `kill_process` stops one process the app is showing, by number.
  1247	    "processKill",
  1248	    // `remove_project_worktree` on a worktree whose folder is gone clears only that
  1249	    // one entry's records, instead of every entry whose folder is gone.
  1250	    "worktreePruneSingle",
  1251	    // `set_csharp_language_server_enabled` turns the C# language server off and on.
  1252	    "csharpLanguageServerToggle",
  1253	    // `find_source_lsp_document_symbols` lists a file's symbols using the language
  1254	    // server, which is what gives Rust and Svelte margin counts.
  1255	    "lspDocumentSymbols",
  1256	    // The app sends a `source-lsp-status-changed` event whenever a language server
  1257	    // changes what it is doing, so nothing has to ask on a timer.
  1258	    "lspStatusEvents",
  1259	    // `read_source_lsp_log` hands back what a running language server printed to its
  1260	    // own error output.
  1261	    "lspLog",
  1262	];
  1263	
  1264	/// The event the app sends whenever a language server changes what it is doing.
  1265	const SOURCE_LSP_STATUS_CHANGED_EVENT: &str = "source-lsp-status-changed";
  1266	
  1267	fn backend_capabilities() -> Vec<String> {
  1268	    BACKEND_CAPABILITIES
  1269	        .iter()
  1270	        .map(|capability| capability.to_string())
  1271	        .collect()
  1272	}
  1273	
  1274	#[tauri::command]
  1275	async fn read_backend_capabilities() -> Result<Vec<String>, String> {
  1276	    Ok(backend_capabilities())
  1277	}
