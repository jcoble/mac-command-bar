   173	  const rows: ProblemRow[] = [];
   174	  for (const diagnostic of diagnostics) {
   175	    const row = problemRowFromDiagnostic(diagnostic, root);
   176	    if (row) rows.push(row);
   177	  }
   178	  return rows;
   179	}
