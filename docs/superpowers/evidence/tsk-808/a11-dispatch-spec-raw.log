  2926	fn git_has_staged_changes(root: &Path) -> Result<bool, String> {
  2927	    let root_arg = root.display().to_string();
  2928	    let output = Command::new("git")
  2929	        .arg("-C")
  2930	        .arg(root_arg)
  2931	        .args(["diff", "--cached", "--quiet", "--exit-code"])
  2932	        .output()
  2933	        .map_err(|error| format!("Could not run git diff --cached: {error}"))?;
  2934	
  2935	    if output.status.success() {
  2936	        return Ok(false);
  2937	    }
  2938	
  2939	    if output.status.code() == Some(1) {
  2940	        return Ok(true);
  2941	    }
  2942	
  2943	    let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
  2944	    Err(if stderr.is_empty() {
  2945	        format!("git diff --cached exited with {}", output.status)
  2946	    } else {
  2947	        stderr
  2948	    })
  2949	}
