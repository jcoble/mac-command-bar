  8015	    #[test]
  8016	    fn reference_counts_answer_every_symbol_from_one_walk() {
  8017	        let root = unique_temp_root();
  8018	        std::fs::create_dir_all(root.join("src")).unwrap();
  8019	        std::fs::write(
  8020	            root.join("src/FormatResolver.cs"),
  8021	            [
  8022	                "public sealed class FormatResolver",
  8023	                "{",
  8024	                "    private readonly FormatDetector _detector;",
  8025	                // Two mentions on one line still count as one, matching the
  8026	                // reference list this count stands in for.
  8027	                "    private readonly FormatDetector _other = new FormatDetector();",
  8028	                "    private readonly FormatDetectorFactory _factory;",
  8029	                "}",
  8030	            ]
  8031	            .join("\n"),
  8032	        )
  8033	        .unwrap();
  8034	        std::fs::write(
  8035	            root.join("src/FormatDetector.cs"),
  8036	            ["public sealed class FormatDetector", "{", "}"].join("\n"),
  8037	        )
  8038	        .unwrap();
  8039	        // Skipped by the walk, so its mentions must not be counted.
  8040	        std::fs::create_dir_all(root.join("node_modules/pkg")).unwrap();
  8041	        std::fs::write(
  8042	            root.join("node_modules/pkg/index.ts"),
  8043	            "export const FormatDetector = 1;",
  8044	        )
  8045	        .unwrap();
  8046	
  8047	        let result = count_source_references_sync(
  8048	            root.clone(),
  8049	            vec![
  8050	                "FormatDetector".to_string(),
  8051	                "FormatResolver".to_string(),
  8052	                "MissingSymbol".to_string(),
  8053	            ],
  8054	            Some(5_000),
  8055	        )
  8056	        .unwrap();
  8057	
  8058	        assert!(!result.approximate);
  8059	        assert_eq!(result.scanned_files, 2);
  8060	        assert_eq!(result.counts.get("FormatDetector"), Some(&3));
  8061	        assert_eq!(result.counts.get("FormatResolver"), Some(&1));
  8062	        assert_eq!(result.counts.get("MissingSymbol"), Some(&0));
  8063	
  8064	        std::fs::remove_dir_all(root).unwrap();
  8065	    }
