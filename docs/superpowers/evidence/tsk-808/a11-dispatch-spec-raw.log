   617	
   618	fn source_scan_cancellation_for_command(
   619	    app: &tauri::AppHandle,
   620	    scan_registry: &SourceScanRegistry,
   621	    scan_id: Option<&str>,
   622	) -> SourceScanCancellation {
   623	    let Some(scan_id) = scan_id.filter(|value| !value.trim().is_empty()) else {
   624	        return SourceScanCancellation::none();
   625	    };
   626	
   627	    let cancelled = scan_registry.register(scan_id);
   628	    let app = app.clone();
   629	    let scan_id = scan_id.to_string();
   630	    let progress = Arc::new(move |snapshot: SourceScanStats| {
   631	        let _ = app.emit(
   632	            SOURCE_SCAN_PROGRESS_EVENT,
   633	            SourceScanProgressEvent {
   634	                scan_id: scan_id.clone(),
   635	                visited_entries: snapshot.visited_entries,
   636	                matched_files: snapshot.matched_files,
   637	            },
   638	        );
   639	    });
   640	
   641	    SourceScanCancellation::new(cancelled, Some(progress))
   642	}
