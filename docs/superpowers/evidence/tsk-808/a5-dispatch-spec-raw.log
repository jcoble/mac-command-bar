   595	fn empty_capabilities(provider: AgentConversationProvider) -> AgentCapabilities {
   596	    AgentCapabilities {
   597	        revision: 1,
   598	        provider,
   599	        implementation: AgentImplementation {
   600	            name: "not-initialized".into(),
   601	            version: "0".into(),
   602	        },
   603	        session: AgentSessionCapabilities {
   604	            list: false,
   605	            load: false,
   606	            resume: false,
   607	            close: false,
   608	            steering: false,
   609	        },
   610	        prompt: AgentPromptCapabilities {
   611	            text: true,
   612	            image: false,
   613	            embedded_context: false,
   614	            resource_links: false,
   615	        },
   616	        interaction: AgentInteractionCapabilities {
   617	            permissions: false,
   618	            structured_user_input: false,
   619	            tool_terminals: false,
   620	            plans: false,
   621	            tasks: false,
