   311	export function reconcileOwnedSessions(
   312	  stored: OwnedSession[],
   313	  live: Pick<TerminalSessionInfo, 'sessionId' | 'exited'>[]
   314	): { owned: OwnedSession[]; reattachable: OwnedSession[] } {
   315	  const liveById = new Map(live.map((entry) => [entry.sessionId, entry]));
   316	  const owned: OwnedSession[] = [];
   317	  const reattachable: OwnedSession[] = [];
   318	
   319	  for (const session of stored) {
   320	    const match = session.ptySessionId ? liveById.get(session.ptySessionId) : undefined;
   321	    if (match && !match.exited) {
   322	      const next: OwnedSession = {
   323	        ...session,
   324	        state: 'background',
   325	        executionOwner: 'terminal',
   326	        runtimeState: 'ready'
   327	      };
   328	      owned.push(next);
   329	      reattachable.push(next);
   330	    } else if (match && match.exited) {
   331	      owned.push({ ...session, state: 'exited', executionOwner: 'stopped', runtimeState: 'closed' });
   332	    } else {
   333	      // Keep the terminal id so a failed migration can be retried or diagnosed.
   334	      owned.push({ ...session, state: 'exited', executionOwner: 'stopped', runtimeState: 'closed' });
   335	    }
   336	  }
   337	
   338	  return { owned, reattachable };
   339	}
