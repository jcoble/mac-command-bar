    72	    /// Returns the capability snapshot advertised by the active ACP session. WorkflowEngine uses
    73	    /// this to map role policy onto provider-owned config options without guessing option ids.
    74	    pub fn capabilities(
    75	        &self,
    76	        owned_id: &str,
    77	        generation: u64,
    78	    ) -> Result<AgentCapabilities, String> {
    79	        let sessions = self
    80	            .sessions
