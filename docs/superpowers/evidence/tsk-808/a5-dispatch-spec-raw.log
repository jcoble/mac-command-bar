   250	    pub async fn prompt(
   251	        &self,
   252	        owned_id: &str,
   253	        generation: u64,
   254	        input: AgentPrompt,
   255	    ) -> Result<(), String> {
   256	        let runtime = self.runtime(owned_id, generation)?;
   257	        let started = runtime
   258	            .lock()
   259	            .await
   260	            .prompt(input)

