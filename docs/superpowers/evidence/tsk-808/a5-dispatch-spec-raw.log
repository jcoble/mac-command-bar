   606	  current.executionOwner = snapshot?.owner ?? current.executionOwner;
   607	  current.attachmentIds = snapshot?.attachmentIds ?? current.attachmentIds;
   608	  current.config = snapshot?.config ?? current.config;
   609	  current.telemetry = snapshot?.telemetry ?? current.telemetry;
   610	  if (snapshot?.writerLease?.ownedId === ownedId) current.writerLease = snapshot.writerLease;
   611	  if (snapshot?.writerLeaseTransition?.ownedId === ownedId) {
