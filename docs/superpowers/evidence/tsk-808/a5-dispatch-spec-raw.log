   628	
   629	fn provider_id(provider: AgentConversationProvider) -> &'static str {
   630	    match provider {
   631	        AgentConversationProvider::Codex => "codex",
   632	        AgentConversationProvider::Claude => "claude",
   633	    }
   634	}
   635	fn timestamp_millis() -> u128 {
   636	    SystemTime::now()
   637	        .duration_since(UNIX_EPOCH)
   638	        .map(|duration| duration.as_millis())
   639	        .unwrap_or(0)
   640	}
   641	fn required_id(value: &str, label: &str) -> Result<String, String> {
   642	    let value = value.trim();
   643	    if value.is_empty() {
   644	        Err(format!("{label} is required"))
   645	    } else {
   646	        Ok(value.to_string())
   647	    }
   648	}
   649	fn normalized_optional_id(value: Option<String>) -> Option<String> {
   650	    value.and_then(|value| {
   651	        let value = value.trim();
   652	        (!value.is_empty()).then(|| value.to_string())
   653	    })
   654	}
