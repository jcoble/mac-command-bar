   310	  // they read back as "this session was not looking at a diff" — which is the
   311	  // right answer for them and the safe one in general.
   312	  const diffPath = pathOf(entry.diffPath);
   313	  const diffRoot = pathOf(entry.diffRoot);
   314	  const bothKnown = diffPath !== null && diffRoot !== null;
   315	  const snapshot: SessionWorkspaceSnapshot = {
   316	    openPaths: cappedPaths(stringsOf(entry.openPaths), activePath),
   317	    activePath,
   318	    expandedFolderIds: stringsOf(entry.expandedFolderIds),
   319	    selectedPath: pathOf(entry.selectedPath),
   320	    scrollTop,
   321	    diffPath: bothKnown ? diffPath : null,
   322	    diffRoot: bothKnown ? diffRoot : null
