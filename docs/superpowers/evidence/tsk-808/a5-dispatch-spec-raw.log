    39	impl AgentRuntimeAdapter for AcpRuntimeAdapter {
    40	    async fn initialize(
    41	        &mut self,
    42	        input: InitializeAgentInput,
    43	    ) -> Result<AgentCapabilities, AgentRuntimeError> {
    44	        let mut client = AcpClient::spawn(&self.manifest, &self.cwd, &self.owned_id)?;
    45	        let capabilities = client.initialize(input.provider).await?;
    46	        validate_capabilities(&capabilities)
    47	            .map_err(|message| AgentRuntimeError::new("invalid-capabilities", message))?;
    48	        self.client = Some(client);
    49	        self.capabilities = Some(capabilities.clone());
    50	        Ok(capabilities)
    51	    }
    52	
    53	    async fn new_session(
    54	        &mut self,
    55	        input: NewAgentSession,
    56	    ) -> Result<StartedAgentSession, AgentRuntimeError> {
    57	        self.client_mut()?.new_session(&input.cwd).await
    58	    }
    59	    async fn load_session(
    60	        &mut self,
    61	        input: LoadAgentSession,
    62	    ) -> Result<StartedAgentSession, AgentRuntimeError> {
    63	        self.client_mut()?
    64	            .load_session(&input.cwd, &input.native_session_id)
    65	            .await
    66	    }
    67	    async fn resume_session(
    68	        &mut self,
    69	        input: ResumeAgentSession,
    70	    ) -> Result<StartedAgentSession, AgentRuntimeError> {
    71	        self.client_mut()?
    72	            .resume_session(&input.cwd, &input.native_session_id)
    73	            .await
    74	    }
    75	    async fn prompt(&mut self, input: AgentPrompt) -> Result<StartedTurn, AgentRuntimeError> {
    76	        self.client_mut()?.prompt(input).await
    77	    }
    78	    async fn steer(&mut self, input: AgentSteeringInput) -> Result<(), AgentRuntimeError> {
    79	        self.client_mut()?.steer(input.text).await
    80	    }
    81	    async fn cancel_turn(&mut self, _turn_id: Option<&str>) -> Result<(), AgentRuntimeError> {
    82	        self.client_mut()?.cancel().await
    83	    }
    84	
    85	    async fn set_config(
    86	        &mut self,
    87	        option_id: &str,
    88	        value: AgentConfigValue,
    89	    ) -> Result<Vec<AgentConfigOption>, AgentRuntimeError> {
    90	        let replacement = self.client_mut()?.set_config(option_id, value).await?;
    91	        if let Some(capabilities) = &mut self.capabilities {
    92	            replace_config_options(capabilities, replacement.clone())
    93	                .map_err(|message| AgentRuntimeError::new("invalid-config", message))?;
    94	        }
    95	        Ok(replacement)
    96	    }
    97	
    98	    async fn respond_permission(
    99	        &mut self,
   100	        input: PermissionResponse,
   101	    ) -> Result<(), AgentRuntimeError> {
   102	        let decision = match input.decision {
   103	            super::super::protocol::AgentApprovalDecision::Accept => "selected",
   104	            super::super::protocol::AgentApprovalDecision::Decline => "cancelled",
   105	            super::super::protocol::AgentApprovalDecision::Cancel => "cancelled",
   106	        };
   107	        self.client_mut()?
   108	            .respond_permission(&input.identity.request_id, decision)
   109	            .await
   110	    }
   111	
   112	    async fn respond_user_input(
   113	        &mut self,
   114	        input: UserInputResponse,
   115	    ) -> Result<(), AgentRuntimeError> {
   116	        self.client_mut()?
   117	            .respond_user_input(&input.identity.request_id, input.values, input.cancelled)
   118	            .await
   119	    }
   120	
   121	    async fn close_session(&mut self) -> Result<(), AgentRuntimeError> {
   122	        if let Some(client) = &mut self.client {
   123	            client.close().await?;
   124	        }
   125	        self.client = None;
   126	        Ok(())
   127	    }
   128	}
