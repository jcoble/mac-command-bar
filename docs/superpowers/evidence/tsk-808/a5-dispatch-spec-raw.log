   260	export function stopConversationTerminalProjection(ownedId: string): void {
   261	  if (!terminalProjections.delete(ownedId) || !isTauri()) return;
   262	  void invoke<boolean>('stop_agent_conversation_terminal_projection', { ownedId });
   263	}
   264	
   265	async function resyncConversation(ownedId: string): Promise<void> {
   266	  const existing = resyncing.get(ownedId);
   267	  if (existing) return existing;
   268	  const work = (async () => {
   269	    for (let attempt = 0; attempt < 3; attempt += 1) {
   270	      const snapshot = await invoke<AgentConversationSnapshot | null>(
   271	        'read_agent_conversation_snapshot',
   272	        { ownedId }
   273	      );
   274	      if (!snapshot) return;
   275	      const sequenceBeforeApply = getConversationSession(ownedId)?.lastSequence ?? 0;
   276	      applyAgentConversationSnapshot(snapshot);
   277	      if (sequenceBeforeApply <= snapshot.lastSequence) return;
   278	    }
   279	  })().finally(() => resyncing.delete(ownedId));
   280	  resyncing.set(ownedId, work);
   281	  return work;
   282	}
