   656	#[cfg(test)]
   657	mod tests {
   658	    use super::*;
   659	    use std::fs;
   660	
   661	    fn request(
   662	        root: &str,
   663	        owned_id: &str,
   664	        provider: AgentConversationProvider,
   665	    ) -> EnsureAgentConversationRequest {
   666	        EnsureAgentConversationRequest {
   667	            owned_id: owned_id.into(),
   668	            provider,
   669	            cwd: root.into(),
   670	            native_session_id: None,
   671	        }
   672	    }
   673	    fn temp_root() -> std::path::PathBuf {
   674	        let path = std::env::temp_dir().join(format!("mcb-runtime-{}", uuid::Uuid::new_v4()));
   675	        fs::create_dir_all(&path).unwrap();
   676	        path
   677	    }
   678	
   679	    #[test]
   680	    fn ensure_is_idempotent_and_generation_rejects_stale_writers() {
   681	        let root = temp_root();
   682	        let manager = AgentRuntimeManager::default();
   683	        let first = manager
   684	            .ensure(request(
   685	                root.to_str().unwrap(),
   686	                "owned-a",
   687	                AgentConversationProvider::Codex,
   688	            ))
   689	            .unwrap();
   690	        assert_eq!(
   691	            manager
   692	                .ensure(request(
   693	                    root.to_str().unwrap(),
   694	                    "owned-a",
   695	                    AgentConversationProvider::Codex
   696	                ))
   697	                .unwrap(),
   698	            first
   699	        );
   700	        let changed = manager
   701	            .ensure(request(
   702	                root.to_str().unwrap(),
   703	                "owned-a",
   704	                AgentConversationProvider::Claude,
   705	            ))
   706	            .unwrap();
   707	        assert_eq!(changed.generation, 2);
   708	        assert!(manager
   709	            .emit_payload(
   710	                "owned-a",
   711	                first.generation,
   712	                AgentConversationPayload::Error {
   713	                    code: "stale".into(),
   714	                    message: "stale".into(),
   715	                    recoverable: true
   716	                }
   717	            )
   718	            .is_err());
   719	        fs::remove_dir_all(root).unwrap();
   720	    }
   721	
   722	    #[test]
   723	    fn canonical_sequence_and_snapshot_are_bounded_and_repairable() {
   724	        let root = temp_root();
   725	        let manager = AgentRuntimeManager::default();
   726	        let connection = manager
   727	            .ensure(request(
   728	                root.to_str().unwrap(),
   729	                "owned-a",
   730	                AgentConversationProvider::Codex,
   731	            ))
   732	            .unwrap();
   733	        for index in 0..(SNAPSHOT_EVENT_CAP + 3) {
   734	            manager
   735	                .emit_payload(
   736	                    "owned-a",
   737	                    connection.generation,
   738	                    AgentConversationPayload::Error {
   739	                        code: "fixture".into(),
   740	                        message: index.to_string(),
   741	                        recoverable: true,
   742	                    },
   743	                )
   744	                .unwrap();
   745	        }
   746	        let events = manager.canonical_snapshot("owned-a").unwrap();
   747	        assert_eq!(events.len(), SNAPSHOT_EVENT_CAP);
   748	        assert!(events
   749	            .windows(2)
   750	            .all(|pair| pair[1].sequence == pair[0].sequence + 1));
   751	        fs::remove_dir_all(root).unwrap();
   752	    }
   753	
   754	    #[test]
   755	    fn structured_session_does_not_claim_a_user_pty() {
   756	        let root = temp_root();
   757	        let manager = AgentRuntimeManager::default();
   758	        manager
   759	            .ensure(request(
   760	                root.to_str().unwrap(),
   761	                "owned-a",
   762	                AgentConversationProvider::Codex,
   763	            ))
   764	            .unwrap();
   765	        assert_eq!(
   766	            manager.session_terminal_ownership("owned-a"),
   767	            Some(AgentWriterLeaseOwner::None)
   768	        );
   769	        let terminal_registry = crate::terminal::TerminalRegistry::default();
   770	        assert!(crate::terminal::list_terminal_sessions(&terminal_registry)
   771	            .unwrap()
   772	            .is_empty());
   773	        fs::remove_dir_all(root).unwrap();
   774	    }
   775	
   776	    #[test]
   777	    fn distinct_tool_terminal_identity_is_not_a_user_pty_identity() {
   778	        let first = crate::terminal::ToolTerminalIdentity {
   779	            owned_id: "owned-a".into(),
   780	            turn_id: "turn-a".into(),
   781	            tool_call_id: "tool-a".into(),
   782	            terminal_id: "terminal-a".into(),
