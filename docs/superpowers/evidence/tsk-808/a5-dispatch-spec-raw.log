   128	    pub async fn prompt(&mut self, prompt: AgentPrompt) -> Result<StartedTurn, AgentRuntimeError> {
   129	        let session_id = self.session_id()?;
   130	        let mut blocks = vec![acp::ContentBlock::Text(acp::TextContent::new(prompt.text))];
   131	        blocks.extend(prompt.images.into_iter().map(|image| {
   132	            acp::ContentBlock::Image(acp::ImageContent::new(image.data, image.mime_type))
   133	        }));
   134	        let result = self
   135	            .request(
   136	                "session/prompt",
   137	                &acp::PromptRequest::new(session_id, blocks),
   138	            )
   139	            .await?;
   140	        Ok(StartedTurn {
   141	            turn_id: result
   142	                .get("turnId")
   143	                .and_then(Value::as_str)
   144	                .map(str::to_string),
   145	        })
   146	    }
   147	
   148	    pub async fn steer(&mut self, text: String) -> Result<(), AgentRuntimeError> {
   149	        let session_id = self.session_id()?;
   150	        self.request(
   151	            "session/steer",
   152	            &json!({ "sessionId": session_id, "prompt": [{ "type": "text", "text": text }] }),
   153	        )
   154	        .await?;
   155	        Ok(())
   156	    }
   157	
   158	    pub async fn cancel(&mut self) -> Result<(), AgentRuntimeError> {
   159	        let value = serde_json::to_value(acp::CancelNotification::new(self.session_id()?))
   160	            .map_err(serialization_error)?;
   161	        self.process
   162	            .write_json(&json!({ "jsonrpc": "2.0", "method": "session/cancel", "params": value }))
   163	            .await
   164	            .map_err(transport_error)
   165	    }
