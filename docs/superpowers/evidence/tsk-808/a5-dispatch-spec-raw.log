   348	    pub fn request_tool_terminal<R: tauri::Runtime>(
   349	        &self,
   350	        app: tauri::AppHandle<R>,
   351	        terminal_registry: &crate::terminal::TerminalRegistry,
   352	        generation: u64,
   353	        request: crate::terminal::TerminalStartRequest,
   354	        identity: crate::terminal::ToolTerminalIdentity,
   355	    ) -> Result<crate::terminal::TerminalSessionInfo, String> {
   356	        {
   357	            let sessions = self
   358	                .sessions
   359	                .lock()
   360	                .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   361	            let session = current_session(&sessions, &identity.owned_id, generation)?;
   362	            if session.owner != AgentExecutionOwner::Structured || session.runtime.is_none() {
   363	                return Err(
   364	                    "Tool terminal request is not from a current structured runtime".to_string(),
   365	                );
   366	            }
   367	            if identity.turn_id.trim().is_empty() || identity.tool_call_id.trim().is_empty() {
   368	                return Err("Tool terminal request identity is incomplete".to_string());
   369	            }
   370	        }
   371	        crate::terminal::start_tool_terminal_session(app, terminal_registry, request, identity)
   372	    }
