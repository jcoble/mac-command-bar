    70	  settledAt: string | null;
    71	  /**
    72	   * What the scanner worked out about the session — the branch it is on, the
    73	   * task it belongs to, the pull request it opened. Copied off the scanned
    74	   * record when the session is adopted so a row keeps showing them afterwards,
    75	   * and `null` whenever the scanner found nothing or the session was started
    76	   * here rather than found on disk.
    77	   */
    78	  branch: string | null;
    79	  taskId: string | null;
    80	  pullRequest: string | null;
    81	  /**
    82	   * How many turns of the conversation the scanner saw, and the last one of them
    83	   * already written as the row shows it (`You: …` / `Agent: …`). Copied off the
    84	   * scanned record when the session is adopted, so the row keeps showing them
    85	   * afterwards.
    86	   *
    87	   * The count is a floor, not a total — the scanner reads a bounded window of
    88	   * each transcript. `null` whenever the scanner found no conversation, or the
    89	   * session was started here rather than found on disk.
    90	   */
    91	  messageCount: number | null;
    92	  latestTurnPreview: string | null;
    93	  /**
    94	   * When the scanner last saw anything happen in this conversation, as the
    95	   * stamp it reported. Copied off the scanned record when the session is
    96	   * adopted, so a row can say how old the work is.
    97	   *
    98	   * It is a reading of the transcript on disk taken at adopt time and nothing
    99	   * moves it afterwards — a session started here has none at all. `null`
   100	   * whenever the scanner had nothing to say, and the row then shows no stamp.
   101	   */
   102	  lastActivity: string | null;
   103	};
   104	
   105	const KNOWN_AGENTS: AgentKind[] = ['codex', 'claude', 'gemini', 'opencode'];
   106	const KNOWN_STATES: OwnedSessionState[] = ['live', 'background', 'exited'];
   107	const KNOWN_EXECUTION_OWNERS: AgentExecutionOwner[] = [
   108	  'structured',
   109	  'terminal',
   110	  'transitioning-to-structured',
   111	  'transitioning-to-terminal',
   112	  'stopped'
   113	];
   114	const KNOWN_RUNTIME_STATES: AgentRuntimeState[] = [
   115	  'starting',
   116	  'ready',
   117	  'working',
   118	  'waiting-approval',
   119	  'waiting-input',
   120	  'interrupting',
   121	  'failed',
   122	  'closed'
   123	];
   124	
   125	function defaultMintId(): string {
   126	  return globalThis.crypto.randomUUID();
   127	}
   128	
   129	export function normalizeProvider(provider: string): { agent: AgentKind; viaCmux: boolean } {
   130	  const value = (provider ?? '').trim().toLowerCase();
   131	  const viaCmux = value.startsWith('cmux-');
   132	  const base = viaCmux ? value.slice('cmux-'.length) : value;
   133	  const agent = (KNOWN_AGENTS as string[]).includes(base) ? (base as AgentKind) : 'other';
   134	  return { agent, viaCmux };
   135	}
   136	
   137	export function adoptAgentSession(record: AgentSession, mintId: () => string = defaultMintId): OwnedSession {
   138	  const { agent, viaCmux } = normalizeProvider(record.provider);
   139	  return {
   140	    ownedId: mintId(),
   141	    agent,
   142	    viaCmux,
   143	    source: 'scanned',
   144	    title: record.title,
   145	    projectPath: record.projectPath,
   146	    cwd: record.projectPath ?? '',
   147	    resumeCommand: record.resumeCommands[0] ?? null,
   148	    nativeSessionId: record.id,
   149	    ptySessionId: null,
   150	    state: 'background',
   151	    executionOwner: 'stopped',
   152	    runtimeState: 'closed',
   153	    providerInstanceId: null,
   154	    activeTurnId: null,
   155	    capabilityRevision: 0,
   156	    lastRuntimeError: null,
   157	    completedAt: null,
   158	    settledAt: null,
   159	    branch: isNonEmptyString(record.branchHint) ? record.branchHint : null,
   160	    taskId: isNonEmptyString(record.taskId) ? record.taskId : null,
   161	    pullRequest: isNonEmptyString(record.pullRequestHint) ? record.pullRequestHint : null,
   162	    messageCount: isTurnCount(record.messageCount) ? record.messageCount : null,
   163	    latestTurnPreview: isNonEmptyString(record.latestTurnPreview) ? record.latestTurnPreview : null,
   164	    lastActivity: isNonEmptyString(record.lastActivity) ? record.lastActivity : null,
   165	  };
   166	}
   167	
   168	export function createFreshSession(
   169	  opts: { cwd: string; title?: string },
   170	  mintId: () => string = defaultMintId
   171	): OwnedSession {
   172	  const segments = opts.cwd.split('/').filter((segment) => segment.length > 0);
   173	  const defaultTitle = segments.length > 0 ? segments[segments.length - 1] : opts.cwd;
   174	  return {
   175	    ownedId: mintId(),
   176	    agent: 'other',
   177	    viaCmux: false,
   178	    source: 'fresh',
   179	    title: opts.title ?? defaultTitle,
   180	    projectPath: null,
   181	    cwd: opts.cwd,
   182	    resumeCommand: null,
   183	    nativeSessionId: null,
   184	    ptySessionId: null,
   185	    state: 'background',
   186	    executionOwner: 'stopped',
   187	    runtimeState: 'closed',
   188	    providerInstanceId: null,
   189	    activeTurnId: null,
   190	    capabilityRevision: 0,
   191	    lastRuntimeError: null,
   192	    completedAt: null,
   193	    settledAt: null,
   194	    branch: null,
   195	    taskId: null,
   196	    pullRequest: null,
   197	    messageCount: null,
   198	    latestTurnPreview: null,
   199	    // Deliberately not "now": this field is what the scanner read out of a
   200	    // conversation on disk, and a shell started here has no conversation yet.
   201	    // Its row simply shows no stamp, like every other scanner field above.
   202	    lastActivity: null,
   203	  };
   204	}
   205	
   206	export function serializeOwnedSessions(sessions: OwnedSession[]): string {
   207	  return JSON.stringify(sessions);
   208	}
   209	
   210	function isNonEmptyString(value: unknown): value is string {
   211	  return typeof value === 'string' && value.length > 0;
   212	}
   213	
   214	/**
   215	 * A count of turns worth showing: a whole number, at least one. Zero is nothing
   216	 * to say rather than something to print, so a row shows no count at all instead
   217	 * of "0 messages".
   218	 */
   219	function isTurnCount(value: unknown): value is number {
   220	  return typeof value === 'number' && Number.isInteger(value) && value > 0;
   221	}
   222	
   223	export function parseStoredOwnedSessions(raw: string | null): OwnedSession[] {
   224	  if (!raw) {
   225	    return [];
   226	  }
   227	  let data: unknown;
   228	  try {
   229	    data = JSON.parse(raw);
   230	  } catch {
   231	    return [];
   232	  }
   233	  if (!Array.isArray(data)) {
   234	    return [];
   235	  }
   236	  const result: OwnedSession[] = [];
   237	  for (const entry of data) {
   238	    if (typeof entry !== 'object' || entry === null) {
   239	      continue;
   240	    }
   241	    const candidate = entry as Record<string, unknown>;
   242	    if (!isNonEmptyString(candidate.ownedId) || !isNonEmptyString(candidate.cwd)) {
   243	      continue;
   244	    }
   245	    const agent = (KNOWN_AGENTS as string[]).includes(candidate.agent as string)
   246	      ? (candidate.agent as AgentKind)
   247	      : 'other';
   248	    const state = (KNOWN_STATES as string[]).includes(candidate.state as string)
   249	      ? (candidate.state as OwnedSessionState)
   250	      : 'exited';
   251	    const ptySessionId = isNonEmptyString(candidate.ptySessionId) ? candidate.ptySessionId : null;
   252	    const executionOwner = (KNOWN_EXECUTION_OWNERS as string[]).includes(
   253	      candidate.executionOwner as string
   254	    )
   255	      ? (candidate.executionOwner as AgentExecutionOwner)
   256	      : ptySessionId && state !== 'exited'
   257	        ? 'terminal'
   258	        : 'stopped';
   259	    const runtimeState = (KNOWN_RUNTIME_STATES as string[]).includes(candidate.runtimeState as string)
   260	      ? (candidate.runtimeState as AgentRuntimeState)
   261	      : executionOwner === 'terminal'
   262	        ? 'ready'
   263	        : 'closed';
   264	    result.push({
   265	      ownedId: candidate.ownedId,
   266	      agent,
   267	      viaCmux: candidate.viaCmux === true,
   268	      source: candidate.source === 'fresh' ? 'fresh' : 'scanned',
   269	      title: isNonEmptyString(candidate.title) ? candidate.title : '',
   270	      projectPath: isNonEmptyString(candidate.projectPath) ? candidate.projectPath : null,
   271	      cwd: candidate.cwd,
   272	      resumeCommand: isNonEmptyString(candidate.resumeCommand) ? candidate.resumeCommand : null,
   273	      nativeSessionId: isNonEmptyString(candidate.nativeSessionId) ? candidate.nativeSessionId : null,
   274	      ptySessionId,
   275	      state,
   276	      executionOwner,
   277	      runtimeState,
   278	      providerInstanceId: isNonEmptyString(candidate.providerInstanceId)
   279	        ? candidate.providerInstanceId
   280	        : null,
   281	      activeTurnId: isNonEmptyString(candidate.activeTurnId) ? candidate.activeTurnId : null,
   282	      capabilityRevision: nonNegativeInteger(candidate.capabilityRevision) ?? 0,
   283	      lastRuntimeError: isNonEmptyString(candidate.lastRuntimeError)
   284	        ? candidate.lastRuntimeError
   285	        : null,
   286	      // Sessions saved before this field existed have no value here at all, and
   287	      // that reads exactly like "not done" — which is the right answer for them.
   288	      completedAt: isNonEmptyString(candidate.completedAt) ? candidate.completedAt : null,
   289	      // Same "not there means not settled" reading for records saved before
   290	      // the Settled shelf existed.
   291	      settledAt: isNonEmptyString(candidate.settledAt) ? candidate.settledAt : null,
   292	      // Same story here: a session saved before the scanner sent these, or one
   293	      // the scanner had nothing to say about, simply shows no chips.
   294	      branch: isNonEmptyString(candidate.branch) ? candidate.branch : null,
   295	      taskId: isNonEmptyString(candidate.taskId) ? candidate.taskId : null,
   296	      pullRequest: isNonEmptyString(candidate.pullRequest) ? candidate.pullRequest : null,
   297	      messageCount: isTurnCount(candidate.messageCount) ? candidate.messageCount : null,
   298	      latestTurnPreview: isNonEmptyString(candidate.latestTurnPreview)
   299	        ? candidate.latestTurnPreview
   300	        : null,
   301	      lastActivity: isNonEmptyString(candidate.lastActivity) ? candidate.lastActivity : null,
   302	    });
   303	  }
   304	  return result;
   305	}
   306	
   307	function nonNegativeInteger(value: unknown): number | undefined {
   308	  return typeof value === 'number' && Number.isInteger(value) && value >= 0 ? value : undefined;
   309	}
   310	
   311	export function reconcileOwnedSessions(
   312	  stored: OwnedSession[],
   313	  live: Pick<TerminalSessionInfo, 'sessionId' | 'exited'>[]
   314	): { owned: OwnedSession[]; reattachable: OwnedSession[] } {
   315	  const liveById = new Map(live.map((entry) => [entry.sessionId, entry]));
   316	  const owned: OwnedSession[] = [];
   317	  const reattachable: OwnedSession[] = [];
   318	
   319	  for (const session of stored) {
   320	    const match = session.ptySessionId ? liveById.get(session.ptySessionId) : undefined;
   321	    if (match && !match.exited) {
   322	      const next: OwnedSession = {
   323	        ...session,
   324	        state: 'background',
   325	        executionOwner: 'terminal',
   326	        runtimeState: 'ready'
   327	      };
   328	      owned.push(next);
   329	      reattachable.push(next);
   330	    } else if (match && match.exited) {
   331	      owned.push({ ...session, state: 'exited', executionOwner: 'stopped', runtimeState: 'closed' });
   332	    } else {
   333	      // Keep the terminal id so a failed migration can be retried or diagnosed.
   334	      owned.push({ ...session, state: 'exited', executionOwner: 'stopped', runtimeState: 'closed' });
   335	    }
   336	  }
   337	
   338	  return { owned, reattachable };
   339	}

