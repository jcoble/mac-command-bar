   132	#[derive(Clone, Default)]
   133	pub struct ProviderRegistry {
   134	    manifests: Arc<Vec<(AgentConversationProvider, AgentProviderManifest)>>,
   135	}
   136	
   137	impl ProviderRegistry {
   138	    pub fn bundled_from_environment() -> Result<Self, String> {
   139	        let codex_path = std::env::var_os("MCB_CODEX_ACP_PATH");
   140	        let codex_hash = std::env::var("MCB_CODEX_ACP_SHA256").ok();
   141	        let claude_path = std::env::var_os("MCB_CLAUDE_AGENT_ACP_PATH");
   142	        let claude_hash = std::env::var("MCB_CLAUDE_AGENT_ACP_SHA256").ok();
   143	        match (codex_path, codex_hash, claude_path, claude_hash) {
   144	            (None, None, None, None) => Ok(Self::default()),
   145	            (Some(codex_path), Some(codex_hash), Some(claude_path), Some(claude_hash)) => {
   146	                Self::initial_manifests(
   147	                    codex_path.into(),
   148	                    codex_hash,
   149	                    claude_path.into(),
   150	                    claude_hash,
   151	                )
   152	            }
   153	            _ => Err(
   154	                "Packaged ACP adapter paths and SHA-256 values must be configured together"
   155	                    .to_string(),
   156	            ),
   157	        }
   158	    }
   159	
   160	    pub fn new(
   161	        manifests: impl IntoIterator<Item = (AgentConversationProvider, AgentProviderManifest)>,
   162	    ) -> Result<Self, String> {
   163	        let mut values = Vec::new();
   164	        for (provider, manifest) in manifests {
   165	            validate_manifest(&manifest)?;
   166	            if values.iter().any(|(current, _)| *current == provider) {
   167	                return Err("Provider manifests must have one entry per provider".to_string());
   168	            }
   169	            values.push((provider, manifest));
   170	        }
   171	        Ok(Self {
   172	            manifests: Arc::new(values),
   173	        })
   174	    }
   175	
   176	    pub fn initial_manifests(
   177	        codex_executable: PathBuf,
   178	        codex_hash: String,
   179	        claude_executable: PathBuf,
   180	        claude_hash: String,
   181	    ) -> Result<Self, String> {
   182	        Self::new([
   183	            (
   184	                AgentConversationProvider::Codex,
   185	                AgentProviderManifest {
   186	                    id: "codex-acp".into(),
   187	                    display_name: "Codex".into(),
   188	                    transport: ProviderTransport::AcpStdio,
   189	                    executable: codex_executable,
   190	                    args: Vec::new(),
   191	                    version: CODEX_ACP_VERSION.into(),
   192	                    content_hash: codex_hash,
   193	                    trusted_source: ProviderSource::Bundled,
   194	                },
   195	            ),
   196	            (
   197	                AgentConversationProvider::Claude,
   198	                AgentProviderManifest {
   199	                    id: "claude-agent-acp".into(),
   200	                    display_name: "Claude".into(),
   201	                    transport: ProviderTransport::AcpStdio,
   202	                    executable: claude_executable,
   203	                    args: Vec::new(),
   204	                    version: CLAUDE_AGENT_ACP_VERSION.into(),
   205	                    content_hash: claude_hash,
   206	                    trusted_source: ProviderSource::Bundled,
   207	                },
   208	            ),
   209	        ])
   210	    }
   211	
   212	    pub fn manifest(
   213	        &self,
   214	        provider: AgentConversationProvider,
   215	    ) -> Result<AgentProviderManifest, String> {
   216	        self.manifests
   217	            .iter()
   218	            .find(|(current, _)| *current == provider)
   219	            .map(|(_, manifest)| manifest.clone())
   220	            .ok_or_else(|| "No trusted adapter is registered for this provider".to_string())
   221	    }
   222	
   223	    pub fn manifests(&self) -> Vec<AgentProviderManifest> {
   224	        self.manifests
   225	            .iter()
   226	            .map(|(_, manifest)| manifest.clone())
   227	            .collect()
   228	    }
   229	}
