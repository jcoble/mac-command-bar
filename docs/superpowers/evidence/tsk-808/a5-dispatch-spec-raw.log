   306	    pub async fn set_config(
   307	        &self,
   308	        owned_id: &str,
   309	        generation: u64,
   310	        option_id: &str,
   311	        value: AgentConfigValue,
   312	    ) -> Result<Vec<super::protocol::AgentConfigOption>, String> {
   313	        {
   314	            let sessions = self
   315	                .sessions
   316	                .lock()
   317	                .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   318	            let session = current_session(&sessions, owned_id, generation)?;
   319	            let option = session
   320	                .capabilities
   321	                .config_options
   322	                .iter()
   323	                .find(|option| option.id == option_id)
   324	                .ok_or_else(|| {
   325	                    "Config option was not advertised by the current provider".to_string()
   326	                })?;
   327	            super::capabilities::validate_config_value(option, &value)?;
   328	        }
   329	        let runtime = self.runtime(owned_id, generation)?;
   330	        let replacement = runtime
   331	            .lock()
   332	            .await
   333	            .set_config(option_id, value)
   334	            .await
   335	            .map_err(|error| error.to_string())?;
   336	        let mut sessions = self
   337	            .sessions
   338	            .lock()
   339	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   340	        let session = current_session_mut(&mut sessions, owned_id, generation)?;
   341	        super::capabilities::replace_config_options(
   342	            &mut session.capabilities,
   343	            replacement.clone(),
   344	        )?;
   345	        Ok(replacement)
   346	    }
