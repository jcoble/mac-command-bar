    71	
    72	    /// Returns the capability snapshot advertised by the active ACP session. WorkflowEngine uses
    73	    /// this to map role policy onto provider-owned config options without guessing option ids.
    74	    pub fn capabilities(
    75	        &self,
    76	        owned_id: &str,
    77	        generation: u64,
    78	    ) -> Result<AgentCapabilities, String> {
    79	        let sessions = self
    80	            .sessions
    81	            .lock()
    82	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
    83	        Ok(current_session(&sessions, owned_id, generation)?
    84	            .capabilities
    85	            .clone())
    86	    }
    87	
    88	    pub fn ensure(
    89	        &self,
    90	        request: EnsureAgentConversationRequest,
    91	    ) -> Result<AgentConversationConnection, String> {
    92	        let owned_id = required_id(&request.owned_id, "Owned session id")?;
    93	        let cwd = validated_conversation_cwd(&request.cwd)?
    94	            .display()
    95	            .to_string();
    96	        let mut sessions = self
    97	            .sessions
    98	            .lock()
    99	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   100	        if let Some(current) = sessions.get(&owned_id) {
   101	            if current.provider == request.provider && current.cwd == cwd {
   102	                return Ok(current.connection.clone());
   103	            }
   104	        }
   105	        let prior = sessions.remove(&owned_id);
   106	        let generation = prior
   107	            .as_ref()
   108	            .map(|session| session.generation.saturating_add(1))
   109	            .unwrap_or(1);
   110	        let connection = AgentConversationConnection {
   111	            owned_id: owned_id.clone(),
   112	            provider: request.provider,
   113	            generation,
   114	            native_session_id: normalized_optional_id(request.native_session_id),
   115	            state: ConversationConnectionState::Connecting,
   116	        };
   117	        let provider_instance_id = format!("{}-{generation}", provider_id(request.provider));
   118	        sessions.insert(
   119	            owned_id.clone(),
   120	            ManagedAgentSession {
   121	                owned_id: owned_id.clone(),
   122	                provider: request.provider,
   123	                provider_instance_id,
   124	                native_session_id: connection.native_session_id.clone(),
   125	                generation,
   126	                owner: AgentExecutionOwner::Stopped,
   127	                state: AgentRuntimeState::Closed,
   128	                capabilities: empty_capabilities(request.provider),
   129	                next_sequence: 1,
   130	                active_turn_id: None,
   131	                runtime: None,
   132	                recent_events: VecDeque::new(),
   133	                writer_lease: AgentWriterLease {
   134	                    owned_id,
   135	                    generation,
   136	                    owner: AgentWriterLeaseOwner::None,
   137	                },
   138	                writer_lease_transition: None,
   139	                cwd,
   140	                connection: connection.clone(),
   141	                frontend_events: VecDeque::new(),
   142	                journal: AgentEventJournal::new(JOURNAL_EVENT_CAP),
   143	            },
   144	        );
   145	        Ok(connection)
   146	    }
   147	
   148	    pub async fn activate(
   149	        &self,
   150	        owned_id: &str,
   151	        generation: u64,
   152	    ) -> Result<AgentConversationConnection, String> {
   153	        let (provider, provider_instance_id, cwd, native_session_id) = {
   154	            let sessions = self
   155	                .sessions
   156	                .lock()
   157	                .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   158	            let session = current_session(&sessions, owned_id, generation)?;
   159	            (
   160	                session.provider,
   161	                session.provider_instance_id.clone(),
   162	                std::path::PathBuf::from(&session.cwd),
   163	                session.native_session_id.clone(),
   164	            )
   165	        };
   166	        let manifest = self.providers.manifest(provider)?;
   167	        let mut adapter = AcpRuntimeAdapter::new(manifest, owned_id.to_string(), cwd.clone());
   168	        let capabilities = adapter
   169	            .initialize(InitializeAgentInput {
   170	                provider,
   171	                provider_instance_id,
   172	            })
   173	            .await
   174	            .map_err(|error| error.to_string())?;
   175	        let started = match native_session_id {
   176	            Some(native_session_id) => {
   177	                adapter
   178	                    .resume_session(LoadAgentSession {
   179	                        cwd,
   180	                        native_session_id,
   181	                    })
   182	                    .await
   183	            }
   184	            None => adapter.new_session(NewAgentSession { cwd }).await,
   185	        }
   186	        .map_err(|error| error.to_string())?;
   187	        let runtime = Arc::new(AsyncMutex::new(StructuredRuntimeHandle::Acp(adapter)));
   188	        let mut sessions = self
   189	            .sessions
   190	            .lock()
   191	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   192	        let session = current_session_mut(&mut sessions, owned_id, generation)?;
   193	        session.capabilities = capabilities;
   194	        session.native_session_id = Some(started.native_session_id.clone());
   195	        session.connection.native_session_id = Some(started.native_session_id);
   196	        session.connection.state = ConversationConnectionState::Connected;
   197	        session.owner = AgentExecutionOwner::Structured;
   198	        session.state = AgentRuntimeState::Ready;
   199	        session.writer_lease.owner = AgentWriterLeaseOwner::Structured;
   200	        session.runtime = Some(runtime);
   201	        Ok(session.connection.clone())
   202	    }
   203	
   204	    pub fn emit_payload(
   205	        &self,
   206	        owned_id: &str,
   207	        generation: u64,
   208	        payload: AgentConversationPayload,
   209	    ) -> Result<AgentConversationEvent, String> {
   210	        let mut sessions = self
   211	            .sessions
   212	            .lock()
   213	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   214	        let session = current_session_mut(&mut sessions, owned_id, generation)?;
   215	        let sequence = session.next_sequence;
   216	        session.next_sequence = session.next_sequence.saturating_add(1);
   217	        if let AgentConversationPayload::Connection {
   218	            state,
   219	            native_session_id,
   220	        } = &payload
   221	        {
   222	            session.connection.state = *state;
   223	            if native_session_id.is_some() {
   224	                session.connection.native_session_id = native_session_id.clone();
   225	                session.native_session_id = native_session_id.clone();
   226	            }
   227	        }
   228	        let timestamp_ms = timestamp_millis();
   229	        let frontend_event = AgentConversationEvent {
   230	            owned_id: owned_id.to_string(),
   231	            provider: session.provider,
   232	            generation,
   233	            sequence,
   234	            timestamp_ms,
   235	            payload: payload.clone(),
   236	        };
   237	        let canonical = canonical_event(session, sequence, timestamp_ms, &payload)?;
   238	        session.journal.append(canonical.clone())?;
   239	        session.recent_events.push_back(canonical);
   240	        session.frontend_events.push_back(frontend_event.clone());
   241	        while session.recent_events.len() > SNAPSHOT_EVENT_CAP {
   242	            session.recent_events.pop_front();
   243	        }
   244	        while session.frontend_events.len() > SNAPSHOT_EVENT_CAP {
   245	            session.frontend_events.pop_front();
   246	        }
   247	        Ok(frontend_event)
   248	    }
