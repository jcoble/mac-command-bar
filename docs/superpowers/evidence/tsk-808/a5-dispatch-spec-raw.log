   418	    pub fn snapshot(&self, owned_id: &str) -> Result<Option<AgentConversationSnapshot>, String> {
   419	        let sessions = self
   420	            .sessions
   421	            .lock()
   422	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   423	        Ok(sessions
   424	            .get(owned_id)
   425	            .map(|session| AgentConversationSnapshot {
   426	                connection: session.connection.clone(),
   427	                last_sequence: session.next_sequence.saturating_sub(1),
   428	                events: session.frontend_events.iter().cloned().collect(),
   429	            }))
