   501	    fn drop(&mut self) {
   502	        if Arc::strong_count(&self.sessions) == 1 {
   503	            if let Ok(mut sessions) = self.sessions.lock() {
   504	                sessions.clear();
   505	            }
   506	        }
   507	    }
