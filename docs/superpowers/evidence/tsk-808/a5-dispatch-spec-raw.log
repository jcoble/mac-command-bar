   181	    cwd: opts.cwd,
   182	    resumeCommand: null,
   183	    nativeSessionId: null,
   184	    ptySessionId: null,
   185	    state: 'background',
   186	    executionOwner: 'stopped',
   187	    runtimeState: 'closed',
   188	    providerInstanceId: null,
   189	    activeTurnId: null,
   190	    capabilityRevision: 0,
   191	    lastRuntimeError: null,
   192	    completedAt: null,
   193	    settledAt: null,
   194	    branch: null,
   195	    taskId: null,
   196	    pullRequest: null,
   197	    messageCount: null,
   198	    latestTurnPreview: null,
   199	    // Deliberately not "now": this field is what the scanner read out of a
   200	    // conversation on disk, and a shell started here has no conversation yet.
   201	    // Its row simply shows no stamp, like every other scanner field above.
