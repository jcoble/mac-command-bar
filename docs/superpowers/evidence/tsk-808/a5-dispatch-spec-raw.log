    60	impl AgentRuntimeManager {
    61	    pub fn new(providers: ProviderRegistry) -> Self {
    62	        Self {
    63	            sessions: Arc::new(Mutex::new(HashMap::new())),
    64	            providers: Arc::new(providers),
    65	        }
