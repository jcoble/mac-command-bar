     1	import assert from 'node:assert/strict';
     2	import fs from 'node:fs';
     3	import path from 'node:path';
     4	import { fileURLToPath } from 'node:url';
     5	
     6	const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
     7	const conversation = path.join(root, 'src-tauri/src/agent_conversation');
     8	const projectionPath = path.join(conversation, 'terminal_projection.rs');
     9	const projection = fs.readFileSync(projectionPath, 'utf8');
    10	const productionProjection = projection.split('#[cfg(test)]')[0];
    11	const transcriptRoot = path.join(conversation, 'transcript');
    12	
    13	assert.equal(fs.existsSync(path.join(conversation, 'transcript.rs')), false, 'legacy monolithic transcript reader must be removed');
    14	for (const file of ['mod.rs', 'codex.rs', 'claude.rs']) {
    15	  assert.equal(fs.existsSync(path.join(transcriptRoot, file)), true, `missing transcript/${file}`);
    16	}
    17	assert.match(projection, /canonical_path: Option<PathBuf>/, 'projection caches the canonical path');
    18	assert.match(projection, /identity: Option<FileIdentity>/, 'projection caches file identity');
    19	assert.match(projection, /offset: u64/, 'projection retains its read offset');
    20	assert.match(projection, /partial_line: Vec<u8>/, 'projection retains an incomplete final line');
    21	for (const reason of ['Truncated', 'Rotated', 'Archived', 'Gap', 'Periodic']) {
    22	  assert.match(projection, new RegExp(`ReconcileReason::${reason}`), `missing ${reason.toLowerCase()} reconciliation`);
    23	}
    24	assert.match(projection, /MAX_RECONCILIATION_EVENTS/, 'reconciliation output must be bounded');
    25	assert.match(projection, /impl Drop for TerminalProjectionRegistry/, 'app-state drop must stop all watchers');
    26	assert.match(projection, /previous\.stop\(\)/, 'replacement must stop and join the prior watcher');
    27	assert.match(projection, /watcher\.stop\(\)/, 'explicit stop must stop and join the watcher');
    28	assert.match(projection, /TERMINAL_PROJECTION_EVENT: &str = "agent-conversation-event"/, 'projection must use the canonical frontend event channel');
    29	assert.doesNotMatch(productionProjection, /AgentEventType::(?:TurnStarted|ApprovalRequested|ItemStarted|ItemUpdated)/,
    30	  'durable transcript projection must not invent live turns, approvals, or active item/tool state');
    31	assert.doesNotMatch(productionProjection, /portable_pty|CommandBuilder|spawn_command/,
    32	  'terminal projection must never create a PTY or process');
    33	assert.match(productionProjection, /"historical"\.into\(\), serde_json::Value::Bool\(true\)/,
