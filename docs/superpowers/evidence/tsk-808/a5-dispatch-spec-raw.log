   171	): OwnedSession {
   172	  const segments = opts.cwd.split('/').filter((segment) => segment.length > 0);
   173	  const defaultTitle = segments.length > 0 ? segments[segments.length - 1] : opts.cwd;
   174	  return {
   175	    ownedId: mintId(),
   176	    agent: 'other',
   177	    viaCmux: false,
