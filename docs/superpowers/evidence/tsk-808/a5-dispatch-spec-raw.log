   316	impl TerminalRegistry {
   317	    fn insert(&self, session_id: String, handle: TerminalSessionHandle) -> Result<(), String> {
   318	        let mut sessions = self
   319	            .inner
   320	            .lock()
   321	            .map_err(|_| "Terminal session registry is unavailable".to_string())?;
   322	        sessions.insert(session_id, handle);
   323	        Ok(())
   324	    }
   325	
   326	    /// Kill the child, THEN unregister it — both under one registry lock.
   327	    ///
   328	    /// The ordering is the point. Removing first and killing after meant a failed
   329	    /// kill returned `Err` on a session that no longer existed: the child was
   330	    /// still running but its id was gone, so nothing could list it, close it
   331	    /// again, or reap it. Killing first means the only way a handle leaves the
   332	    /// registry is a kill that actually succeeded (or a tombstone, which has no
   333	    /// child left to kill — see `spawn_terminal_waiter`). On failure the caller
   334	    /// gets the `Err` AND the session stays closable.
   335	    fn kill_and_remove(&self, session_id: &str) -> Result<bool, String> {
   336	        let mut sessions = self
   337	            .inner
   338	            .lock()
   339	            .map_err(|_| "Terminal session registry is unavailable".to_string())?;
   340	        let Some(handle) = sessions.get(session_id) else {
   341	            return Ok(false);
   342	        };
   343	        if !handle.info.exited {
   344	            let mut killer = handle
   345	                .killer
   346	                .lock()
   347	                .map_err(|_| "Terminal killer lock poisoned".to_string())?;
   348	            if let Err(error) = killer.kill() {
   349	                return Err(format!("Failed to kill terminal session: {error}"));
   350	            }
   351	        }
   352	        sessions.remove(session_id);
   353	        Ok(true)
   354	    }
   355	
   356	    fn mark_exited(
   357	        &self,
   358	        session_id: &str,
   359	        exit_code: Option<u32>,
   360	        signal: Option<String>,
   361	    ) -> Result<bool, String> {
   362	        let mut sessions = self
   363	            .inner
   364	            .lock()
   365	            .map_err(|_| "Terminal registry lock poisoned".to_string())?;
   366	        match sessions.get_mut(session_id) {
   367	            Some(handle) => {
   368	                handle.info.exited = true;
   369	                handle.info.exit_code = exit_code;
   370	                handle.info.signal = signal;
   371	                Ok(true)
   372	            }
   373	            None => Ok(false),
   374	        }
   375	    }
   376	}
