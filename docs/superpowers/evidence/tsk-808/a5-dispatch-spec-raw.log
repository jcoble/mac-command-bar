    18	#[tauri::command]
    19	pub async fn ensure_agent_conversation(
    20	    manager: tauri::State<'_, AgentRuntimeManager>,
    21	    request: EnsureAgentConversationRequest,
    22	) -> Result<AgentConversationConnection, String> {
    23	    let connection = manager.ensure(request)?;
    24	    if manager.providers().manifest(connection.provider).is_ok() {
    25	        manager
    26	            .activate(&connection.owned_id, connection.generation)
    27	            .await
    28	    } else {
    29	        // A0 installs the packaged, hash-recorded adapters. Until then the
    30	        // existing connecting response remains available without a fallback PTY.
    31	        Ok(connection)
    32	    }
    33	}
