   226	        assistantLabel={selectedChild?.label ?? active.agent}
   227	        savedScrollTop={conversation.selectedChildId ? conversation.childScrollTopById[conversation.selectedChildId] ?? 0 : conversation.scrollTop}
   228	        emptyText={conversation.selectedChildId ? 'This sub-agent transcript is not available yet.' : 'Start the conversation below.'}
   229	        onScroll={(scrollTop) => {
