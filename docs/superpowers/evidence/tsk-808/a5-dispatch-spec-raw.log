     1	use serde::Serialize;
     2	use std::fs;
     3	use std::path::{Path, PathBuf};
     4	use tauri::Manager;
     5	
     6	const MAX_ATTACHMENT_BYTES: usize = 20 * 1024 * 1024;
     7	
     8	#[derive(Debug, Serialize)]
     9	#[serde(rename_all = "camelCase")]
    10	pub struct SavedConversationAttachment {
    11	    pub id: String,
    12	    pub name: String,
    13	    pub mime_type: String,
    14	    pub path: String,
    15	    pub byte_length: usize,
    16	}
    17	
    18	pub fn save(
    19	    app: &tauri::AppHandle,
    20	    owned_id: &str,
    21	    mime_type: &str,
    22	    bytes: &[u8],
    23	) -> Result<SavedConversationAttachment, String> {
    24	    let owned_id = safe_segment(owned_id, "Owned session id")?;
    25	    let extension = validate_image(mime_type, bytes)?;
    26	    let id = uuid::Uuid::new_v4().to_string();
    27	    let name = format!("screenshot-{id}.{extension}");
    28	    let root = app
    29	        .path()
    30	        .app_data_dir()
    31	        .map_err(|error| format!("Application data directory is unavailable: {error}"))?
    32	        .join("conversation-attachments")
    33	        .join(owned_id);
    34	    fs::create_dir_all(&root)
    35	        .map_err(|error| format!("Could not create attachment folder: {error}"))?;
    36	    let path = root.join(&name);
    37	    fs::write(&path, bytes).map_err(|error| format!("Could not save screenshot: {error}"))?;
    38	    let canonical = path
    39	        .canonicalize()
    40	        .map_err(|error| format!("Could not verify screenshot path: {error}"))?;
    41	    if !canonical.starts_with(canonical_root(&root)?) {
    42	        return Err("Saved screenshot escaped the managed attachment folder".to_string());
    43	    }
    44	    Ok(SavedConversationAttachment {
    45	        id,
    46	        name,
    47	        mime_type: mime_type.to_string(),
    48	        path: canonical.display().to_string(),
    49	        byte_length: bytes.len(),
    50	    })
    51	}
    52	
    53	fn validate_image<'a>(mime_type: &str, bytes: &'a [u8]) -> Result<&'static str, String> {
    54	    let (extension, expected_magic): (&str, &[u8]) = match mime_type {
    55	        "image/png" => ("png", b"\x89PNG\r\n\x1a\n"),
    56	        "image/jpeg" => ("jpg", b"\xff\xd8\xff"),
    57	        "image/gif" => ("gif", b"GIF8"),
    58	        "image/webp" => ("webp", b"RIFF"),
    59	        _ => return Err("Only PNG, JPEG, GIF, and WebP images are supported".to_string()),
    60	    };
    61	    if bytes.is_empty() || bytes.len() > MAX_ATTACHMENT_BYTES {
    62	        return Err("Image must be between 1 byte and 20 MB".to_string());
    63	    }
    64	    if !bytes.starts_with(expected_magic)
    65	        || (mime_type == "image/webp" && bytes.get(8..12) != Some(b"WEBP"))
    66	    {
    67	        return Err("Clipboard image data does not match its declared type".to_string());
    68	    }
    69	    Ok(extension)
    70	}
    71	
    72	fn canonical_root(path: &Path) -> Result<PathBuf, String> {
    73	    path.canonicalize()
    74	        .map_err(|error| format!("Could not verify attachment folder: {error}"))
    75	}
    76	
    77	fn safe_segment<'a>(value: &'a str, label: &str) -> Result<&'a str, String> {
    78	    let value = value.trim();
    79	    if value.is_empty()
    80	        || value.contains('/')
    81	        || value.contains('\\')
    82	        || !value
    83	            .chars()
    84	            .all(|ch| ch.is_ascii_alphanumeric() || ch == '-' || ch == '_')
    85	    {
    86	        return Err(format!("{label} is invalid"));
    87	    }
    88	    Ok(value)
    89	}
    90	
    91	#[cfg(test)]
    92	mod tests {
    93	    use super::{safe_segment, validate_image, MAX_ATTACHMENT_BYTES};
    94	
    95	    #[test]
    96	    fn attachment_session_folder_rejects_path_traversal() {
    97	        assert!(safe_segment("owned-good_1", "Owned session id").is_ok());
    98	        assert!(safe_segment("../outside", "Owned session id").is_err());
    99	    }
   100	
   101	    #[test]
   102	    fn attachment_validation_accepts_supported_image_signatures() {
   103	        assert_eq!(
   104	            validate_image("image/png", b"\x89PNG\r\n\x1a\nrest").unwrap(),
   105	            "png"
   106	        );
   107	        assert_eq!(
   108	            validate_image("image/jpeg", b"\xff\xd8\xffrest").unwrap(),
   109	            "jpg"
   110	        );
   111	        assert_eq!(validate_image("image/gif", b"GIF89a").unwrap(), "gif");
   112	        assert_eq!(
   113	            validate_image("image/webp", b"RIFF0000WEBPrest").unwrap(),
   114	            "webp"
   115	        );
   116	    }
   117	
   118	    #[test]
   119	    fn attachment_validation_rejects_spoofed_unsupported_and_oversized_images() {
   120	        assert!(validate_image("image/png", b"not-a-png").is_err());
   121	        assert!(validate_image("image/svg+xml", b"<svg></svg>").is_err());
   122	        assert!(validate_image("image/png", &vec![0; MAX_ATTACHMENT_BYTES + 1]).is_err());
   123	    }
   124	}
