   432	    pub async fn close(&self, owned_id: &str) -> Result<bool, String> {
   433	        let runtime = {
   434	            let mut sessions = self
   435	                .sessions
   436	                .lock()
   437	                .map_err(|_| "Agent runtime manager is unavailable".to_string())?;
   438	            let Some(session) = sessions.get_mut(owned_id) else {
   439	                return Ok(false);
   440	            };
   441	            session.state = AgentRuntimeState::Closed;
   442	            session.owner = AgentExecutionOwner::Stopped;
   443	            session.writer_lease.owner = AgentWriterLeaseOwner::None;
   444	            session.runtime.take()
   445	        };
   446	        if let Some(runtime) = runtime {
   447	            runtime
   448	                .lock()
   449	                .await
   450	                .close_session()
   451	                .await
   452	                .map_err(|error| error.to_string())?;
   453	        }
   454	        self.sessions
   455	            .lock()
   456	            .map_err(|_| "Agent runtime manager is unavailable".to_string())?
   457	            .remove(owned_id);
   458	        Ok(true)
   459	    }
