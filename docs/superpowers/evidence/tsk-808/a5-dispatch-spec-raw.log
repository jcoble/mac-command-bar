   186	export async function loadConversationCapabilities(
   187	  ownedId: string,
   188	  provider: AgentConversationProvider
   189	): Promise<AgentCapabilities | null> {
   190	  if (!isTauri()) return null;
   191	  try {
   192	    const capabilities = await invoke<AgentCapabilities>('read_agent_conversation_capabilities', { ownedId });
   193	    if (capabilities.provider !== provider) throw new Error('Capability provider does not match this session');
   194	    setConversationCapabilities(ownedId, capabilities);
   195	    return capabilities;
   196	  } catch (error) {
   197	    const message = error instanceof Error ? error.message : String(error);
   198	    setConversationCapabilityError(ownedId, message);
   199	    throw error;
   200	  }
   201	}
