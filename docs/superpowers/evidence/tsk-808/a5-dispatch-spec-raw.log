   183	  function onApprovalDecision(requestId: string, decision: string): void {
   184	    if (!active || (decision !== 'accept' && decision !== 'decline' && decision !== 'cancel')) return;
   185	    void respondToStructuredApproval(active.ownedId, requestId, decision).catch((error) => {
   186	      attachmentError = error instanceof Error ? error.message : String(error);
   187	    });
   188	  }
   189	
   190	  function onInputSubmit(requestId: string, values: Record<string, AgentConfigValue>, cancelled = false): void {
   191	    if (!active) return;
   192	    void respondToStructuredInput(active.ownedId, { requestId, values, cancelled }).catch((error) => {
   193	      attachmentError = error instanceof Error ? error.message : String(error);
   194	    });
   195	  }
   196	
   197	  function openConversationFile(path: string): void {
   198	    const root = (active?.cwd || active?.projectPath || '').replace(/\/+$/, '');
   199	    const candidate = path.trim();
   200	    if (!root || !candidate || candidate.includes('\0') || candidate.split('/').includes('..')) {
   201	      attachmentError = 'The file link is outside the active workspace.';
   202	      return;
   203	    }
   204	    const absolute = candidate.startsWith('/') ? candidate : `${root}/${candidate.replace(/^\.\//, '')}`;
   205	    if (absolute !== root && !absolute.startsWith(`${root}/`)) {
   206	      attachmentError = 'The file link is outside the active workspace.';
   207	      return;
   208	    }
   209	    requestOpenFile({ path: absolute, projectRoot: root });
   210	  }
   211	
   212	  async function changeConfig(optionId: string, value: import('$lib/shell/conversation/conversationTypes.ts').AgentConfigValue): Promise<void> {
   213	    if (!active) return;
   214	    await setConversationConfigOption(active.ownedId, optionId, value).catch(() => undefined);
   215	  }
