    58	    }
    59	    async fn load_session(
    60	        &mut self,
    61	        input: LoadAgentSession,
    62	    ) -> Result<StartedAgentSession, AgentRuntimeError> {
    63	        self.client_mut()?
    64	            .load_session(&input.cwd, &input.native_session_id)
    65	            .await
    66	    }
    67	    async fn resume_session(
    68	        &mut self,
    69	        input: ResumeAgentSession,
    70	    ) -> Result<StartedAgentSession, AgentRuntimeError> {
    71	        self.client_mut()?
    72	            .resume_session(&input.cwd, &input.native_session_id)
    73	            .await
    74	    }
