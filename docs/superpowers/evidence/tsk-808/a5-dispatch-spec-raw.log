   272	    && nonNegativeInteger(value.generation) !== undefined
   273	    && ['structured', 'terminal', 'none'].includes(value.from as string)
   274	    && ['structured', 'terminal', 'none'].includes(value.to as string)
   275	    && ['requested', 'committed', 'failed'].includes(value.state as string)
