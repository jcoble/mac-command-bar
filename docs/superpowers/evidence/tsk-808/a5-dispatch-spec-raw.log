   309	export async function ensureStructuredConversation(input: {
   310	  ownedId: string;
   311	  provider: AgentConversationProvider;
   312	  cwd: string;
   313	  nativeSessionId?: string | null;
   314	}): Promise<AgentConversationConnection | null> {
