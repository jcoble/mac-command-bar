   284	export async function startConversationEvents(): Promise<void> {
   285	  if (!isTauri() || unlisten) return;
   286	  unlisten = await listen<AgentConversationEvent | AgentEvent>('agent-conversation-event', ({ payload }) => {
   287	    applyAgentConversationEvent(payload);
   288	    if (getConversationSession(payload.ownedId)?.desynchronized) {
   289	      void resyncConversation(payload.ownedId);
   290	    }
   291	    if (('kind' in payload.payload && (payload.payload.kind === 'turn' || payload.payload.kind === 'error'))
   292	      || ('type' in payload && ['turn.completed', 'turn.interrupted', 'runtime.error'].includes(payload.type))) {
   293	      setConversationSending(payload.ownedId, false);
   294	    }
   295	  });
   296	}
