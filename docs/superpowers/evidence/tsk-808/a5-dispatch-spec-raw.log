   511	    sessions: &'a HashMap<String, ManagedAgentSession>,
   512	    owned_id: &str,
   513	    generation: u64,
   514	) -> Result<&'a ManagedAgentSession, String> {
   515	    let session = sessions
   516	        .get(owned_id)
   517	        .ok_or_else(|| "Conversation session was not found".to_string())?;
   518	    if session.generation != generation {
   519	        return Err("Conversation connection changed; retry on the current session".to_string());
   520	    }
   521	    Ok(session)
   522	}
