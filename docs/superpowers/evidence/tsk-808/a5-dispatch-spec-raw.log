    10	export type AgentKind = 'codex' | 'claude' | 'gemini' | 'opencode' | 'other';
    11	export type OwnedSessionState = 'live' | 'background' | 'exited';
    12	
    13	export type AgentExecutionOwner =
    14	  | 'structured'
    15	  | 'terminal'
    16	  | 'transitioning-to-structured'
    17	  | 'transitioning-to-terminal'
    18	  | 'stopped';
    19	
    20	export type AgentRuntimeState =
    21	  | 'starting'
    22	  | 'ready'
    23	  | 'working'
    24	  | 'waiting-approval'
    25	  | 'waiting-input'
    26	  | 'interrupting'
    27	  | 'failed'
    28	  | 'closed';
